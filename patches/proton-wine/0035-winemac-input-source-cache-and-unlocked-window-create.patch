+/* Process-wide cache of the current keyboard input source.
+ *
+ * macdrv_get_input_source_info() runs its body under OnMainThread(), i.e. it
+ * hands a block to the Cocoa main thread and waits. A thread that needs Cocoa
+ * for the first time therefore cannot finish initialising unless the main
+ * thread is servicing its run loop -- and an application sitting in a
+ * synchronous call is not. That deadlocks, and because the caller
+ * (create_cocoa_window, via macdrv_WindowPosChanging) holds win_data_mutex,
+ * every other thread that touches window data stops behind it.
+ *
+ * Seen as: a 32-bit DirectShow RenderFile never returns, because quartz's
+ * message thread creates the video renderer's window while the application's
+ * thread blocks inside RenderFile itself. 64-bit only escapes by winning a
+ * race -- it reaches the query before the application blocks.
+ *
+ * The layout is a property of the process and the system, not of a thread, so
+ * it is fetched once (from macdrv_init, where the Cocoa loop has just started
+ * and no application code can be blocking yet) and copied by later threads.
+ * Kept current by macdrv_keyboard_changed, which already receives the new
+ * layout on every thread's event queue.
+ */
+static pthread_mutex_t input_source_mutex = PTHREAD_MUTEX_INITIALIZER;
+static CFDataRef cached_keyboard_layout_uchr;
+static CGEventSourceKeyboardType cached_keyboard_type;
+static bool cached_iso_keyboard;
+static HKL cached_active_keyboard_layout;
+static BOOL input_source_cached;
+
+void macdrv_set_cached_input_source(CFDataRef uchr, CGEventSourceKeyboardType keyboard_type,
+                                    bool iso_keyboard, HKL layout)
+{
+    if (!uchr) return;
+
+    pthread_mutex_lock(&input_source_mutex);
+    if (cached_keyboard_layout_uchr) CFRelease(cached_keyboard_layout_uchr);
+    cached_keyboard_layout_uchr = CFDataCreateCopy(NULL, uchr);
+    cached_keyboard_type = keyboard_type;
+    cached_iso_keyboard = iso_keyboard;
+    cached_active_keyboard_layout = layout;
+    input_source_cached = TRUE;
+    pthread_mutex_unlock(&input_source_mutex);
+}
+
+/* Fill in a thread's keyboard state from the cache. FALSE if it is not warm
+ * yet, in which case the caller falls back to asking the main thread -- the
+ * pre-existing behaviour, so a cold cache is never worse than before. */
+static BOOL init_keyboard_from_cache(struct macdrv_thread_data *data)
+{
+    BOOL ret = FALSE;
+
+    pthread_mutex_lock(&input_source_mutex);
+    if (input_source_cached)
+    {
+        data->keyboard_layout_uchr = CFDataCreateCopy(NULL, cached_keyboard_layout_uchr);
+        data->keyboard_type = cached_keyboard_type;
+        data->iso_keyboard = cached_iso_keyboard;
+        data->active_keyboard_layout = cached_active_keyboard_layout;
+        ret = TRUE;
+    }
+    pthread_mutex_unlock(&input_source_mutex);
+    return ret;
+}
+
+/* Warm the cache. Called from macdrv_init only, where OnMainThread is safe. */
+static void cache_input_source(void)
+{
+    TISInputSourceRef input_source = NULL;
+    CFDataRef uchr = NULL;
+    CGEventSourceKeyboardType keyboard_type = 0;
+    bool iso_keyboard = FALSE;
+
+    macdrv_get_input_source_info(&uchr, &keyboard_type, &iso_keyboard, &input_source);
+    if (!uchr) return;
+
+    macdrv_set_cached_input_source(uchr, keyboard_type, iso_keyboard,
+                                   macdrv_get_hkl_from_source(input_source));
+    CFRelease(uchr);
+    if (input_source) CFRelease(input_source);
+}
+
+
 /***********************************************************************
  *              macdrv_init_thread_data
  */
@@ -523,9 +611,12 @@ struct macdrv_thread_data *macdrv_init_thread_data(void)
         NtTerminateProcess(0, 1);
     }
 
-    macdrv_get_input_source_info(&data->keyboard_layout_uchr, &data->keyboard_type, &data->iso_keyboard, &input_source);
-    data->active_keyboard_layout = macdrv_get_hkl_from_source(input_source);
-    CFRelease(input_source);
+    if (!init_keyboard_from_cache(data))
+    {
+        macdrv_get_input_source_info(&data->keyboard_layout_uchr, &data->keyboard_type, &data->iso_keyboard, &input_source);
+        data->active_keyboard_layout = macdrv_get_hkl_from_source(input_source);
+        CFRelease(input_source);
+    }
     macdrv_compute_keyboard_layout(data);
 
     set_queue_display_fd(macdrv_get_event_queue_fd(data->queue));
