From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Whisky <whisky@local>
Date: Sat, 28 Nov 2026 12:38:00 +0800
Subject: [PATCH] server/registry: avoid null parent member access UB in open_key/create_key

open_key() and create_key() pass `&parent->obj` to open_named_object() /
create_key_object() even when `parent == NULL`. Although `obj` sits at
offset 0 of `struct key`, evaluating `&parent->obj` on a null pointer is
undefined behavior and triggers UBSan (`member access within null pointer
of type 'struct key'`). Pass `parent ? &parent->obj : NULL` explicitly.
---
 server/registry.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/server/registry.c b/server/registry.c
index 1111111..2222222 100644
--- a/server/registry.c
+++ b/server/registry.c
@@ -839,7 +839,7 @@ static struct key *open_key( struct key *parent, const struct unicode_str *name,
 
     if (!(access & KEY_WOW64_64KEY)) attributes |= OBJ_KEY_WOW64;
 
-    if (!(key = open_named_object( &parent->obj, &key_ops, name, attributes ))) return NULL;
+    if (!(key = open_named_object( parent ? &parent->obj : NULL, &key_ops, name, attributes ))) return NULL;
 
     if (!(access & KEY_WOW64_64KEY)) key = grab_wow6432node( key );
     if (debug_level > 1) dump_operation( key, NULL, "Open" );
@@ -865,7 +865,7 @@ static struct key *create_key( struct key *parent, const struct unicode_str *name
 
     if (!(access & KEY_WOW64_64KEY)) attributes |= OBJ_KEY_WOW64;
 
-    if (!(key = create_key_object( &parent->obj, name, attributes, options, current_time, sd )))
+    if (!(key = create_key_object( parent ? &parent->obj : NULL, name, attributes, options, current_time, sd )))
         return NULL;
 
     if (get_error() == STATUS_OBJECT_NAME_EXISTS)
-- 
