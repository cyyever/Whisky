Subject: [PATCH] ntdll/kernelbase: macOS NX compat, Steam AppID env propagation, lsteamclient and steamwebhelper defaults

Consolidated patches:
  - (0008) ntdll: keep DEP on for legacy images by default (macOS)
subj='ntdll: keep DEP on for legacy images by default (macOS)'
  - (0014) kernelbase: append --no-sandbox --in-process-gpu to steamwebhelper.exe
subj='kernelbase: append --no-sandbox --in-process-gpu to steamwebhelper.exe'
  - (0018) ntdll: disable the lsteamclient bridge by default on macOS
subj='ntdll: disable the lsteamclient bridge by default on macOS'
  - (0027) ntdll: propagate SteamAppId/SteamGameId from Windows env to child Unix env

---
diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index fe337dcf..4f7bf301 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -630,6 +630,7 @@ static const WCHAR *hack_append_command_line( const WCHAR *cmd )
         {L"Red Tie Runner.exe", L" --use-angle=gl"},
         {L"UnrealCEFSubProcess.exe", L" --use-gl=swiftshader", "2316580"},
         {L"UnrealCEFSubProcess.exe", L" --use-angle=d3d9", "2684500"},
+        {L"steamwebhelper.exe", L" --no-sandbox --in-process-gpu"},
     };
     unsigned int i;
     char sgi[64];
diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index 52b6e705..24a741c1 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -1156,7 +1156,12 @@ static int use_lsteamclient(void)
 
     if (use != -1) return use;
 
-    use = !get_env( L"PROTON_DISABLE_LSTEAMCLIENT", env, sizeof(env) ) || *env == '0';
+    /* Off unless PROTON_DISABLE_LSTEAMCLIENT=0 asks for it. The bridge redirects
+     * steamclient64/gameoverlayrenderer64 imports to Proton's Linux-host tier0
+     * shims, which can never reach a Linux Steam on macOS -- and against the real
+     * Windows client it strands g_pMemAllocSteam on ntdll stubs this fork does not
+     * have, so steamclient64's DllMain access-violates and Steam says "reinstall". */
+    use = get_env( L"PROTON_DISABLE_LSTEAMCLIENT", env, sizeof(env) ) && *env == '0';
     if (!use)
         ERR("lsteamclient disabled.\n");
     return use;
@@ -1680,9 +1685,22 @@ static WINE_MODREF *alloc_module( HMODULE hModule, const UNICODE_STRING *nt_name
 
     if (!(nt->OptionalHeader.DllCharacteristics & IMAGE_DLLCHARACTERISTICS_NX_COMPAT))
     {
-        ULONG flags = MEM_EXECUTE_OPTION_ENABLE;
-        WARN( "disabling no-exec because of %s\n", debugstr_w(wm->ldr.BaseDllName.Buffer) );
-        NtSetInformationProcess( GetCurrentProcess(), ProcessExecuteFlags, &flags, sizeof(flags) );
+        /* Keep DEP enabled for legacy (non-NX_COMPAT) images; WINE_NX_COMPAT=0
+         * restores upstream behaviour, per program, for a game that needs the
+         * DEP-off legacy handling. Disabling no-exec forces PROT_EXEC on data
+         * pages used by the Metal-backed Vulkan driver. Keep data non-executable
+         * unless the application explicitly needs the legacy behaviour. */
+        UNICODE_STRING nx_name = RTL_CONSTANT_STRING( L"WINE_NX_COMPAT" );
+        WCHAR nx_buf[8];
+        UNICODE_STRING nx_value = { 0, sizeof(nx_buf), nx_buf };
+        NTSTATUS nx_status = RtlQueryEnvironmentVariable_U( NULL, &nx_name, &nx_value );
+
+        if (!nx_status && nx_value.Length == sizeof(WCHAR) && nx_buf[0] == '0')
+        {
+            ULONG flags = MEM_EXECUTE_OPTION_ENABLE;
+            WARN( "disabling no-exec because of %s\n", debugstr_w(wm->ldr.BaseDllName.Buffer) );
+            NtSetInformationProcess( GetCurrentProcess(), ProcessExecuteFlags, &flags, sizeof(flags) );
+        }
     }
     return wm;
 }
diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index ef1ab960..031e718d 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -313,24 +313,83 @@ static unsigned int get_pe_file_info( OBJECT_ATTRIBUTES *attr, UNICODE_STRING *n
 }
 
 
+struct child_unix_env
+{
+    char *winedebug;
+    char *steam_game_id;
+    char *steam_app_id;
+    char *steam_compat_app_id;
+};
+
+static char *dup_unix_env_pair( const char *name, const char *val )
+{
+    size_t nlen = strlen( name ), vlen = strlen( val );
+    char *buf = malloc( nlen + 1 + vlen + 1 );
+
+    if (!buf) return NULL;
+    memcpy( buf, name, nlen );
+    buf[nlen] = '=';
+    memcpy( buf + nlen + 1, val, vlen + 1 );
+    return buf;
+}
+
+static char *extract_unix_env_var( const WCHAR *entry, const WCHAR *wname, size_t wname_len,
+                                   const char *unix_name )
+{
+    const WCHAR *val;
+    DWORD vlen, utf8_len;
+    char *utf8_val, *ret;
+
+    if (wcsnicmp( entry, wname, wname_len ) || entry[wname_len] != '=') return NULL;
+    val = entry + wname_len + 1;
+    if (!*val) return NULL;
+    vlen = wcslen( val );
+    utf8_len = vlen * 3 + 1;
+    if (!(utf8_val = malloc( utf8_len ))) return NULL;
+    ntdll_wcstoumbs( val, vlen + 1, utf8_val, utf8_len, FALSE );
+    ret = dup_unix_env_pair( unix_name, utf8_val );
+    free( utf8_val );
+    return ret;
+}
+
+
 /***********************************************************************
  *           get_env_size
  */
-static ULONG get_env_size( const RTL_USER_PROCESS_PARAMETERS *params, char **winedebug )
+static ULONG get_env_size( const RTL_USER_PROCESS_PARAMETERS *params, struct child_unix_env *unix_env )
 {
+    static const WCHAR WINEDEBUG[] = {'W','I','N','E','D','E','B','U','G','=',0};
+    static const WCHAR SteamGameIdW[] = {'S','t','e','a','m','G','a','m','e','I','d',0};
+    static const WCHAR SteamAppIdW[] = {'S','t','e','a','m','A','p','p','I','d',0};
+    static const WCHAR SteamCompatAppIdW[] =
+        {'S','T','E','A','M','_','C','O','M','P','A','T','_','A','P','P','_','I','D',0};
     WCHAR *ptr = params->Environment;
 
     while (*ptr)
     {
-        static const WCHAR WINEDEBUG[] = {'W','I','N','E','D','E','B','U','G','=',0};
-        if (!*winedebug && !wcsncmp( ptr, WINEDEBUG, ARRAY_SIZE( WINEDEBUG ) - 1 ))
+        if (!unix_env->winedebug && !wcsncmp( ptr, WINEDEBUG, ARRAY_SIZE( WINEDEBUG ) - 1 ))
         {
             DWORD len = wcslen(ptr) * 3 + 1;
-            if ((*winedebug = malloc( len )))
-                ntdll_wcstoumbs( ptr, wcslen(ptr) + 1, *winedebug, len, FALSE );
+            if ((unix_env->winedebug = malloc( len )))
+                ntdll_wcstoumbs( ptr, wcslen(ptr) + 1, unix_env->winedebug, len, FALSE );
         }
+        else if (!unix_env->steam_game_id &&
+                 (unix_env->steam_game_id = extract_unix_env_var( ptr, SteamGameIdW, ARRAY_SIZE(SteamGameIdW) - 1, "SteamGameId" )))
+            ;
+        else if (!unix_env->steam_app_id &&
+                 (unix_env->steam_app_id = extract_unix_env_var( ptr, SteamAppIdW, ARRAY_SIZE(SteamAppIdW) - 1, "SteamAppId" )))
+            ;
+        else if (!unix_env->steam_compat_app_id &&
+                 (unix_env->steam_compat_app_id = extract_unix_env_var( ptr, SteamCompatAppIdW, ARRAY_SIZE(SteamCompatAppIdW) - 1, "STEAM_COMPAT_APP_ID" )))
+            ;
         ptr += wcslen(ptr) + 1;
     }
+    if (!unix_env->steam_game_id && unix_env->steam_app_id)
+        unix_env->steam_game_id = dup_unix_env_pair( "SteamGameId", strchr( unix_env->steam_app_id, '=' ) + 1 );
+    if (!unix_env->steam_app_id && unix_env->steam_game_id)
+        unix_env->steam_app_id = dup_unix_env_pair( "SteamAppId", strchr( unix_env->steam_game_id, '=' ) + 1 );
+    if (!unix_env->steam_compat_app_id && unix_env->steam_app_id)
+        unix_env->steam_compat_app_id = dup_unix_env_pair( "STEAM_COMPAT_APP_ID", strchr( unix_env->steam_app_id, '=' ) + 1 );
     ptr++;
     return (ptr - params->Environment) * sizeof(WCHAR);
 }
@@ -402,7 +461,8 @@ static BOOL is_unix_console_handle( HANDLE handle )
  *           spawn_process
  */
 static NTSTATUS spawn_process( const RTL_USER_PROCESS_PARAMETERS *params, int socketfd,
-                               int unixdir, char *winedebug, const struct pe_image_info *pe_info )
+                               int unixdir, const struct child_unix_env *unix_env,
+                               const struct pe_image_info *pe_info )
 {
     NTSTATUS status = STATUS_SUCCESS;
     int stdin_fd = -1, stdout_fd = -1;
@@ -434,7 +494,10 @@ static NTSTATUS spawn_process( const RTL_USER_PROCESS_PARAMETERS *params, int so
             if (stdin_fd != -1 && stdin_fd != 0) close( stdin_fd );
             if (stdout_fd != -1 && stdout_fd != 1) close( stdout_fd );
 
-            if (winedebug) putenv( winedebug );
+            if (unix_env->winedebug) putenv( unix_env->winedebug );
+            if (unix_env->steam_game_id) putenv( unix_env->steam_game_id );
+            if (unix_env->steam_app_id) putenv( unix_env->steam_app_id );
+            if (unix_env->steam_compat_app_id) putenv( unix_env->steam_compat_app_id );
             if (unixdir != -1)
             {
                 fchdir( unixdir );
@@ -692,7 +755,7 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
     HANDLE file_handle, process_info = 0, process_handle = 0, thread_handle = 0;
     struct object_attributes *objattr;
     data_size_t attr_len;
-    char *winedebug = NULL;
+    struct child_unix_env unix_env = { 0 };
     char *unix_name = NULL;
     struct startup_info_data *startup_info = NULL;
     ULONG startup_info_size, env_size;
@@ -779,7 +842,7 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
     }
     if (!(startup_info = create_startup_info( attr.ObjectName, process_flags, params, &pe_info, &startup_info_size )))
         goto done;
-    env_size = get_env_size( params, &winedebug );
+    env_size = get_env_size( params, &unix_env );
 
     if ((status = alloc_object_attributes( process_attr, &objattr, &attr_len ))) goto done;
 
@@ -884,7 +947,7 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
 
     /* create the child process */
 
-    if ((status = spawn_process( params, socketfd[0], unixdir, winedebug, &pe_info ))) goto done;
+    if ((status = spawn_process( params, socketfd[0], unixdir, &unix_env, &pe_info ))) goto done;
 
     close( socketfd[0] );
     socketfd[0] = -1;
@@ -953,7 +1016,10 @@ done:
     if (socketfd[0] != -1) close( socketfd[0] );
     if (unixdir != -1) close( unixdir );
     free( startup_info );
-    free( winedebug );
+    free( unix_env.winedebug );
+    free( unix_env.steam_game_id );
+    free( unix_env.steam_app_id );
+    free( unix_env.steam_compat_app_id );
     free( unix_name );
     free( nt_name.Buffer );
