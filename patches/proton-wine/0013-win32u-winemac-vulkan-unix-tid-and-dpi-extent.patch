Subject: [PATCH] win32u/winemac: macOS Vulkan unix_tid and DPI-aware surface extent

Consolidated patches:
  - (0023) win32u: provide a macOS get_unix_tid for the vulkan signaller
subj='win32u: provide a macOS get_unix_tid for the vulkan signaller'
  - (0034) winemac,win32u: scale CAMetalLayer contentsScale by window DPI and skip Vulkan fshack double-blit on macOS

---
diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
index 5401c56d..47b8fcc3 100644
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -642,11 +642,28 @@ signal_op_complete:
     return add_sem_wait( wait_info, wait_alloc_count, sem->shared_sem, global_sem_wait_value );
 }
 
+/* gettid(2) is Linux-only. The id is used to label debug output, so the pthread
+ * id truncated to int is as good here, and this keeps the one call site common. */
+#ifdef __APPLE__
+static int get_unix_tid(void)
+{
+    uint64_t tid = 0;
+
+    pthread_threadid_np( NULL, &tid );
+    return (int)tid;
+}
+#else
+static int get_unix_tid(void)
+{
+    return gettid();
+}
+#endif
+
 #define SIGNALLER_INITIAL_WAIT_COUNT 256
 
 static void *signaller_worker( void *arg )
 {
-    int unix_tid = gettid();
+    int unix_tid = get_unix_tid();
     struct vulkan_device *device = arg;
     struct semaphore *sem;
     VkSemaphoreWaitInfo wait_info = { 0 };
@@ -3055,8 +3072,15 @@ fail:
 
 static BOOL surface_get_fshack_dpi( struct surface *surface )
 {
+#ifdef __APPLE__
+    /* On macOS, winemac.drv scales the CAMetalLayer's contentsScale by dpi/raw so
+     * Apple's display compositor scales DPI-unaware swapchains in hardware at zero
+     * GPU cost without Proton's X11 compute-shader fshack double-blit. */
+    return 0;
+#else
     UINT dpi = NtUserGetDpiForWindow( surface->hwnd ), raw = NtUserGetWinMonitorDpi( surface->hwnd, MDT_RAW_DPI );
     return fshack_enabled && dpi != raw ? raw : 0;
+#endif
 }
 
 static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwapchainCreateInfoKHR *create_info,
@@ -3090,24 +3114,12 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     create_info_host.imageExtent.width = max( create_info_host.imageExtent.width, capabilities.minImageExtent.width );
     create_info_host.imageExtent.height = max( create_info_host.imageExtent.height, capabilities.minImageExtent.height );
 
-    /* If the swapchain image size is not equal to the presentation size (e.g. because of DPI virtualization or
-     * display mode change emulation), MoltenVK's vkQueuePresentKHR returns VK_SUBOPTIMAL_KHR.
-     * Create the swapchain with VkSwapchainPresentScalingCreateInfoEXT to avoid this.
-     */
-    if (get_surface_rect( surface->hwnd, &client_rect, NtUserGetWinMonitorDpi( surface->hwnd, MDT_WINE_RAW_DPI ) ) &&
-        !extents_equals( &create_info_host.imageExtent, &client_rect ) &&
-        instance->extensions.has_VK_EXT_surface_maintenance1 &&
-        physical_device->extensions.has_VK_KHR_swapchain_maintenance1)
-    {
-        scaling.scalingBehavior = VK_PRESENT_SCALING_STRETCH_BIT_EXT;
-        create_info_host.pNext = &scaling;
-    }
-
     if (!(swapchain = calloc( 1, sizeof(*swapchain) ))) return VK_ERROR_OUT_OF_HOST_MEMORY;
 
     if ((swapchain->fshack_dpi = surface_get_fshack_dpi( surface )))
     {
         VkSurfaceCapabilitiesKHR caps = {0};
+        VkExtent2D host_extent;
 
         if ((res = instance->p_vkGetPhysicalDeviceSurfaceCapabilitiesKHR( physical_device->host.physical_device,
                                                                           create_info_host.surface, &caps )))
@@ -3120,15 +3132,53 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
         if (!(caps.supportedUsageFlags & VK_IMAGE_USAGE_STORAGE_BIT))
             FIXME( "Swapchain does not support required VK_IMAGE_USAGE_STORAGE_BIT\n" );
 
-        swapchain->host_extents = capabilities.minImageExtent;
-        create_info_host.imageExtent = capabilities.minImageExtent;
+        /* Host WSI backends such as Metal (KosmicKrisp) report minImageExtent = {1, 1}
+         * and expose the actual surface size in currentExtent, whereas X11 sets
+         * minImageExtent == currentExtent. Use currentExtent when defined, falling back
+         * to the raw-DPI client rect if currentExtent is {UINT32_MAX, UINT32_MAX}, and
+         * clamp to [minImageExtent, maxImageExtent].
+         */
+        if (caps.currentExtent.width != ~0u && caps.currentExtent.height != ~0u &&
+            caps.currentExtent.width && caps.currentExtent.height)
+        {
+            host_extent = caps.currentExtent;
+        }
+        else if (get_surface_rect( surface->hwnd, &client_rect, NtUserGetWinMonitorDpi( surface->hwnd, MDT_WINE_RAW_DPI ) ))
+        {
+            host_extent.width = client_rect.right - client_rect.left;
+            host_extent.height = client_rect.bottom - client_rect.top;
+        }
+        else
+        {
+            host_extent = create_info_host.imageExtent;
+        }
+
+        host_extent.width = max( min( host_extent.width, caps.maxImageExtent.width ), caps.minImageExtent.width );
+        host_extent.height = max( min( host_extent.height, caps.maxImageExtent.height ), caps.minImageExtent.height );
+
+        swapchain->host_extents = host_extent;
+        create_info_host.imageExtent = host_extent;
         create_info_host.imageFormat = VK_FORMAT_B8G8R8A8_UNORM;
         create_info_host.imageUsage = VK_IMAGE_USAGE_STORAGE_BIT;
+        create_info_host.flags &= ~VK_SWAPCHAIN_CREATE_MUTABLE_FORMAT_BIT_KHR;
 
         if (create_info->imageFormat != VK_FORMAT_B8G8R8A8_UNORM && create_info->imageFormat != VK_FORMAT_B8G8R8A8_SRGB)
             FIXME( "swapchain image format is not BGRA8 UNORM/SRGB. Things may go badly. %d\n",
                    create_info_host.imageFormat );
     }
+    /* If the swapchain image size is not equal to the presentation size (e.g. because of DPI virtualization or
+     * display mode change emulation), MoltenVK's vkQueuePresentKHR returns VK_SUBOPTIMAL_KHR.
+     * Create the swapchain with VkSwapchainPresentScalingCreateInfoEXT to avoid this.
+     */
+    else if (get_surface_rect( surface->hwnd, &client_rect, NtUserGetWinMonitorDpi( surface->hwnd, MDT_WINE_RAW_DPI ) ) &&
+             !extents_equals( &create_info_host.imageExtent, &client_rect ) &&
+             instance->extensions.has_VK_EXT_surface_maintenance1 &&
+             physical_device->extensions.has_VK_KHR_swapchain_maintenance1)
+    {
+        scaling.pNext = create_info_host.pNext;
+        scaling.scalingBehavior = VK_PRESENT_SCALING_STRETCH_BIT_EXT;
+        create_info_host.pNext = &scaling;
+    }
 
     if ((res = device->p_vkCreateSwapchainKHR( device->host.device, &create_info_host, NULL, &host_swapchain )))
     {
diff --git a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
index 43a0d60b..1da45004 100644
--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -346,12 +346,14 @@ @interface WineBaseView : NSView
 @end
 
 
-@interface WineMetalView : WineBaseView
+@interface WineMetalView : WineBaseView <NSViewLayerContentScaleDelegate>
 {
     id<MTLDevice> _device;
+    CGFloat _dpiRatio;
 }
 
     - (id) initWithFrame:(NSRect)frame device:(id<MTLDevice>)device;
+    - (void) setDpiRatio:(CGFloat)ratio;
 
 @end
 
@@ -964,6 +966,7 @@ - (id) initWithFrame:(NSRect)frame device:(id<MTLDevice>)device
         if (self)
         {
             _device = [device retain];
+            _dpiRatio = 1.0;
             self.wantsLayer = YES;
             self.layerContentsRedrawPolicy = NSViewLayerContentsRedrawNever;
         }
@@ -976,20 +979,36 @@ - (void) dealloc
         [super dealloc];
     }
 
+    - (void) setDpiRatio:(CGFloat)ratio
+    {
+        if (ratio <= 0.0) ratio = 1.0;
+        _dpiRatio = ratio;
+        self.layer.contentsScale = (retina_on ? 2.0 : 1.0) * _dpiRatio;
+        self.layer.magnificationFilter = (_dpiRatio != 1.0) ? kCAFilterLinear : kCAFilterNearest;
+    }
+
     - (void) setRetinaMode:(BOOL)mode
     {
-        self.layer.contentsScale = mode ? 2.0 : 1.0;
+        self.layer.contentsScale = (mode ? 2.0 : 1.0) * (_dpiRatio > 0.0 ? _dpiRatio : 1.0);
         [super setRetinaMode:mode];
     }
 
+    - (BOOL) layer:(CALayer*)layer shouldInheritContentsScale:(CGFloat)newScale fromWindow:(NSWindow*)window
+    {
+        CGFloat desired = (retina_on ? 2.0 : 1.0) * (_dpiRatio > 0.0 ? _dpiRatio : 1.0);
+        if (layer.contentsScale != desired)
+            layer.contentsScale = desired;
+        return NO;
+    }
+
     - (CALayer*) makeBackingLayer
     {
         CAMetalLayer *layer = [CAMetalLayer layer];
         layer.device = _device;
         layer.framebufferOnly = YES;
-        layer.magnificationFilter = kCAFilterNearest;
+        layer.magnificationFilter = (_dpiRatio != 1.0 && _dpiRatio > 0.0) ? kCAFilterLinear : kCAFilterNearest;
         layer.backgroundColor = CGColorGetConstantColor(kCGColorBlack);
-        layer.contentsScale = retina_on ? 2.0 : 1.0;
+        layer.contentsScale = (retina_on ? 2.0 : 1.0) * (_dpiRatio > 0.0 ? _dpiRatio : 1.0);
         return layer;
     }
 
@@ -3998,6 +4017,15 @@ macdrv_metal_view macdrv_view_create_metal_view(macdrv_view v, macdrv_metal_devi
     return (macdrv_metal_view)metalView;
 }
 
+void macdrv_metal_view_set_dpi_ratio(macdrv_metal_view v, double ratio)
+{
+    WineMetalView* view = (WineMetalView*)v;
+
+    OnMainThread(^{
+        [view setDpiRatio:(CGFloat)ratio];
+    });
+}
+
 macdrv_metal_layer macdrv_view_get_metal_layer(macdrv_metal_view v)
 {
     WineMetalView* view = (WineMetalView*)v;
diff --git a/dlls/winemac.drv/macdrv.h b/dlls/winemac.drv/macdrv.h
index 42e675e3..7a75bcd3 100644
--- a/dlls/winemac.drv/macdrv.h
+++ b/dlls/winemac.drv/macdrv.h
@@ -195,6 +195,11 @@ extern BOOL macdrv_SystemParametersInfo(UINT action, UINT int_param, void *ptr_p
     macdrv_view           cocoa_view;
     macdrv_metal_device   metal_device;
     macdrv_metal_view     metal_view;
+    double                metal_dpi_ratio;
+    RECT                  last_rect;
+    macdrv_view           last_superview;
+    macdrv_window         last_cocoa_window;
+    BOOL                  has_last_geom;
 };
 
 static inline struct macdrv_client_surface *impl_from_client_surface(struct client_surface *client)
diff --git a/dlls/winemac.drv/macdrv_cocoa.h b/dlls/winemac.drv/macdrv_cocoa.h
index 6a6b6975..e45ce337 100644
--- a/dlls/winemac.drv/macdrv_cocoa.h
+++ b/dlls/winemac.drv/macdrv_cocoa.h
@@ -525,6 +525,7 @@ extern void macdrv_order_cocoa_window(macdrv_window w, macdrv_window prev,
 extern macdrv_metal_device macdrv_create_metal_device(void);
 extern void macdrv_release_metal_device(macdrv_metal_device d);
 extern macdrv_metal_view macdrv_view_create_metal_view(macdrv_view v, macdrv_metal_device d);
+extern void macdrv_metal_view_set_dpi_ratio(macdrv_metal_view v, double ratio);
 extern macdrv_metal_layer macdrv_view_get_metal_layer(macdrv_metal_view v);
 extern void macdrv_view_release_metal_view(macdrv_metal_view v);
 extern bool macdrv_get_view_backing_size(macdrv_view v, int backing_size[2]);
diff --git a/dlls/winemac.drv/vulkan.c b/dlls/winemac.drv/vulkan.c
index a4012372..62fe82eb 100644
--- a/dlls/winemac.drv/vulkan.c
+++ b/dlls/winemac.drv/vulkan.c
@@ -55,6 +55,14 @@ static VkResult macdrv_vulkan_surface_create(HWND hwnd, BOOL raw, const struct v
     if (!(surface->metal_device = macdrv_create_metal_device())) goto err;
     if (!(surface->metal_view = macdrv_view_create_metal_view(surface->cocoa_view, surface->metal_device))) goto err;
 
+    {
+        UINT dpi = NtUserGetDpiForWindow(hwnd);
+        UINT raw = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+        surface->metal_dpi_ratio = (dpi && raw) ? (double)dpi / (double)raw : 1.0;
+        if (surface->metal_dpi_ratio != 1.0)
+            macdrv_metal_view_set_dpi_ratio(surface->metal_view, surface->metal_dpi_ratio);
+    }
+
     if (instance->p_vkCreateMetalSurfaceEXT)
     {
         VkMetalSurfaceCreateInfoEXT create_info_host;
diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index b97b1751..57ed9513 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -1106,17 +1106,43 @@ static void macdrv_client_surface_update(struct client_surface *client)
     struct macdrv_client_surface *surface = impl_from_client_surface(client);
     HWND hwnd = client->hwnd, toplevel = NtUserGetAncestor(hwnd, GA_ROOT);
     struct macdrv_win_data *data;
+    UINT raw = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
     RECT rect;
 
     TRACE("%s\n", debugstr_client_surface(client));
 
-    NtUserGetClientRect(hwnd, &rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI));
-    NtUserMapWindowPoints(hwnd, toplevel, (POINT *)&rect, 2, NtUserGetWinMonitorDpi(toplevel, MDT_RAW_DPI));
+    NtUserGetClientRect(hwnd, &rect, raw);
+    NtUserMapWindowPoints(hwnd, toplevel, (POINT *)&rect, 2,
+                          toplevel == hwnd ? raw : NtUserGetWinMonitorDpi(toplevel, MDT_RAW_DPI));
 
     if (!(data = get_win_data(toplevel))) return;
     OffsetRect(&rect, data->rects.client.left - data->rects.visible.left, data->rects.client.top - data->rects.visible.top);
-    macdrv_set_view_frame(surface->cocoa_view, cgrect_from_rect(rect));
-    macdrv_set_view_superview(surface->cocoa_view, toplevel == hwnd ? NULL : data->client_view, data->cocoa_window, NULL, NULL);
+    {
+        macdrv_view superview = toplevel == hwnd ? NULL : data->client_view;
+        if (!surface->has_last_geom || !EqualRect(&rect, &surface->last_rect))
+        {
+            macdrv_set_view_frame(surface->cocoa_view, cgrect_from_rect(rect));
+            surface->last_rect = rect;
+        }
+        if (!surface->has_last_geom || superview != surface->last_superview ||
+            data->cocoa_window != surface->last_cocoa_window)
+        {
+            macdrv_set_view_superview(surface->cocoa_view, superview, data->cocoa_window, NULL, NULL);
+            surface->last_superview = superview;
+            surface->last_cocoa_window = data->cocoa_window;
+        }
+        surface->has_last_geom = TRUE;
+    }
+    if (surface->metal_view)
+    {
+        UINT dpi = NtUserGetDpiForWindow(hwnd);
+        double ratio = (dpi && raw) ? (double)dpi / (double)raw : 1.0;
+        if (ratio != surface->metal_dpi_ratio)
+        {
+            surface->metal_dpi_ratio = ratio;
+            macdrv_metal_view_set_dpi_ratio(surface->metal_view, ratio);
+        }
+    }
     release_win_data(data);
 }
 
