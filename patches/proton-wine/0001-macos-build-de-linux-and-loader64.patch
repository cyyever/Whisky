Subject: [PATCH] macos: de-linux ntdll/server/amd_ags_x64, configure loader64 wine64, disable d3dcompiler_47

Consolidated patches:
  - (0001) ntdll, server: de-linux TEB/futex paths and macOS TEB fix
subj='ntdll, server: de-linux TEB/futex paths and macOS TEB fix'
  - (0005) amd_ags_x64: guard libdrm/amdgpu use behind __linux__
subj='amd_ags_x64: guard libdrm/amdgpu use behind __linux__'
  - (0006) loader64: build a 64-bit wine64 loader on macOS
subj='loader64: build a 64-bit wine64 loader on macOS'
  - (0024) configure: do not build Wine's d3dcompiler_47 DLL

---
diff --git a/configure.ac b/configure.ac
index be6e92be..1efa19de 100644
--- a/configure.ac
+++ b/configure.ac
@@ -2138,6 +2138,8 @@ fi
 dnl **** Platform-specific checks ****
 
 AC_SUBST(WINELOADER_PROGRAMS,"wine")
+dnl macOS also builds a 64-bit loader (loader64); keep its program list in step.
+AC_SUBST(WINELOADER64_PROGRAMS,"wine64")
 
 case $host_os in
   linux*)
@@ -2151,6 +2153,7 @@ esac
 if test "$wine_use_preloader" = "yes"
 then
   WINELOADER_PROGRAMS="$WINELOADER_PROGRAMS wine-preloader"
+  WINELOADER64_PROGRAMS="$WINELOADER64_PROGRAMS wine64-preloader"
   AC_DEFINE(HAVE_WINE_PRELOADER, 1, [Define to 1 if the Wine preloader is being used.])
 fi
 
@@ -2656,8 +2659,6 @@ WINE_CONFIG_MAKEFILE(dlls/d3dcompiler_43)
 WINE_CONFIG_MAKEFILE(dlls/d3dcompiler_43/tests)
 WINE_CONFIG_MAKEFILE(dlls/d3dcompiler_46)
 WINE_CONFIG_MAKEFILE(dlls/d3dcompiler_46/tests)
-WINE_CONFIG_MAKEFILE(dlls/d3dcompiler_47)
-WINE_CONFIG_MAKEFILE(dlls/d3dcompiler_47/tests)
 WINE_CONFIG_MAKEFILE(dlls/d3dim)
 WINE_CONFIG_MAKEFILE(dlls/d3dim700)
 WINE_CONFIG_MAKEFILE(dlls/d3drm)
diff --git a/dlls/amd_ags_x64/unixlib.c b/dlls/amd_ags_x64/unixlib.c
index d34a162b..fbfaed9e 100644
--- a/dlls/amd_ags_x64/unixlib.c
+++ b/dlls/amd_ags_x64/unixlib.c
@@ -31,9 +31,11 @@
 #include <fcntl.h>
 #include <errno.h>
 
+#ifdef __linux__
 #include <xf86drm.h>
 #include <amdgpu_drm.h>
 #include <amdgpu.h>
+#endif
 
 #include "ntstatus.h"
 #define WIN32_NO_STATUS
@@ -48,6 +50,8 @@ WINE_DEFAULT_DEBUG_CHANNEL(amd_ags);
 
 #define MAX_DEVICE_COUNT 64
 
+#ifdef __linux__
+
 static unsigned int device_count;
 static struct drm_amdgpu_info_device *amd_info;
 
@@ -276,6 +280,22 @@ static NTSTATUS get_device_info( void *args )
     return STATUS_NOT_FOUND;
 }
 
+#else /* __linux__ */
+
+/* No libdrm/amdgpu outside Linux (e.g. macOS); Apple Silicon has no AMD GPU.
+ * Report no device so games fall back to generic, non-AMD rendering paths. */
+static NTSTATUS init( void *args )
+{
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS get_device_info( void *args )
+{
+    return STATUS_NOT_FOUND;
+}
+
+#endif /* __linux__ */
+
 const unixlib_entry_t __wine_unix_call_funcs[] =
 {
     init,
diff --git a/dlls/ntdll/unix/fsync.c b/dlls/ntdll/unix/fsync.c
index 25d41cac..97968ebc 100644
--- a/dlls/ntdll/unix/fsync.c
+++ b/dlls/ntdll/unix/fsync.c
@@ -61,6 +61,8 @@ WINE_DEFAULT_DEBUG_CHANNEL(fsync);
 #include "poppack.h"
 
 int fsync_enabled;
+
+#ifdef __linux__
 static int current_pid;
 
 /* futex_waitv interface */
@@ -1236,3 +1238,23 @@ NTSTATUS fsync_signal_and_wait( HANDLE signal, HANDLE wait, BOOLEAN alertable,
 
     return fsync_wait_objects( 1, &wait, TRUE, alertable, timeout );
 }
+
+#else  /* !__linux__ : fsync is futex-based (Linux only); stub out so callers
+        * fall back to server-side sync. fsync_enabled stays 0 -> never reached. */
+
+void fsync_init( DWORD pid ) { }
+NTSTATUS fsync_close( HANDLE handle ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS fsync_release_semaphore( HANDLE handle, ULONG count, ULONG *prev ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS fsync_query_semaphore( HANDLE handle, void *info ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS fsync_set_event( HANDLE handle, LONG *prev ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS fsync_reset_event( HANDLE handle, LONG *prev ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS fsync_pulse_event( HANDLE handle, LONG *prev ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS fsync_query_event( HANDLE handle, void *info ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS fsync_release_mutex( HANDLE handle, LONG *prev ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS fsync_query_mutex( HANDLE handle, void *info ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS fsync_wait_objects( DWORD count, const HANDLE *handles, BOOLEAN wait_any,
+                             BOOLEAN alertable, const LARGE_INTEGER *timeout ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS fsync_signal_and_wait( HANDLE signal, HANDLE wait,
+                                BOOLEAN alertable, const LARGE_INTEGER *timeout ) { return STATUS_NOT_IMPLEMENTED; }
+
+#endif  /* __linux__ */
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 2cc53c36..2361c0df 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -38,7 +38,9 @@
 #include <sys/mman.h>
 #include <sys/wait.h>
 #include <unistd.h>
+#ifdef __linux__
 #include <malloc.h>
+#endif
 #include <dlfcn.h>
 #ifdef HAVE_PWD_H
 # include <pwd.h>
@@ -2421,7 +2423,9 @@ static void start_main_thread(void)
     set_thread_teb( teb );
 #endif
 
+#ifdef __linux__
     mallopt( M_PERTURB, 0xff );
+#endif
     init_startup_info();
     *(ULONG_PTR *)&peb->CloudFileFlags = get_image_address();
     set_load_order_app_name( main_wargv[0] );
@@ -2430,7 +2434,9 @@ static void start_main_thread(void)
     load_ntdll();
     load_wow64_ntdll( main_image_info.Machine );
     load_apiset_dll();
+#ifdef __linux__
     mallopt( M_PERTURB, 0 );
+#endif
     server_init_process_done();
 }
 
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index de05faaf..52b87652 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -3098,7 +3098,17 @@ void signal_init_process(void)
 
 void set_thread_teb( TEB *teb )
 {
+#ifdef __APPLE__
+    /* On macOS %gs is shared with the system pthread TSD and is swapped to the
+     * TEB only around Win32 code by the syscall dispatcher / signal handlers.
+     * The current TEB is located via RSP (see get_current_teb), not %gs, so we
+     * must leave %gs pointing at the pthread TSD here -- overwriting it with the
+     * raw TEB breaks the next pthread call. Mainline Wine has no set_thread_teb
+     * for this reason; make it a no-op on macOS. */
+    (void)teb;
+#else
     arch_prctl( ARCH_SET_GS, teb );
+#endif
 }
 
 /***********************************************************************
diff --git a/dlls/ntdll/unix/system.c b/dlls/ntdll/unix/system.c
index f1af6b5e..65999886 100644
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -1284,6 +1284,11 @@ static BOOL logical_proc_info_add_group( DWORD num_cpus, ULONG_PTR mask )
     return TRUE;
 }
 
+#ifndef linux  /* macOS/non-Linux: sysfs (Linux /sys) CPU-topology helpers are unavailable */
+static BOOL sysfs_parse_bitmap(const char *filename, ULONG_PTR *mask) { return FALSE; }
+static void fill_performance_core_info(void) { }
+#endif
+
 #ifdef linux
 
 /* Helper function for counting bitmap values as commonly used by the Linux kernel
diff --git a/loader64/Makefile.in b/loader64/Makefile.in
index cfbe51d4..83d8adf4 100644
--- a/loader64/Makefile.in
+++ b/loader64/Makefile.in
@@ -3,10 +3,11 @@ PARENTSRC = ../loader
 SOURCES = \
 	main.c \
 	preloader.c \
-	preloader_mac.c
+	preloader_mac.c \
+	wine_info.plist.in
 
-PROGRAMS = wine64 wine64-preloader
-INSTALL_LIB = wine64 wine64-preloader
+PROGRAMS = $(WINELOADER64_PROGRAMS)
+INSTALL_LIB = $(WINELOADER64_PROGRAMS)
 UNIX_CFLAGS = -fPIE
 
 preloader_EXTRADEFS = -fno-builtin
@@ -15,6 +16,6 @@ wine64_OBJS = main.o
 wine64_DEPS = $(WINELOADER_DEPENDS)
 wine64_LDFLAGS = $(WINELOADER_LDFLAGS) $(LDEXECFLAGS) $(PTHREAD_LIBS)
 
-wine64_preloader_OBJS = preloader.o
+wine64_preloader_OBJS = preloader.o preloader_mac.o
 wine64_preloader_DEPS = $(WINELOADER_DEPENDS)
 wine64_preloader_LDFLAGS = $(WINEPRELOADER_LDFLAGS)
diff --git a/server/fsync.c b/server/fsync.c
index 7d3ec646..ce4370fd 100644
--- a/server/fsync.c
+++ b/server/fsync.c
@@ -310,7 +310,11 @@ int fsync_grab_shm_idx( unsigned int shm_idx )
 
 static inline int futex_wake( int *addr, int val )
 {
+#ifdef __linux__
     return syscall( __NR_futex, addr, 1, val, NULL, 0, 0 );
+#else
+    return 0;  /* fsync (Linux futex) unavailable on non-Linux; no-op */
+#endif
 }
 
 /* shm layout for events or event-like objects. */
