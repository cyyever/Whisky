Subject: [PATCH] ntdll: macOS builtin/overlay loadorder defaults and native-over-builtin warning

Consolidated patches:
  - (0012) ntdll: force builtin D3D/Vulkan/XAudio2 loadorder and disable Steam overlay on macOS
subj='ntdll: force builtin D3D/Vulkan/XAudio2 loadorder and disable Steam overlay on macOS'
  - (0021) ntdll: say when a native DLL is used instead of the builtin

---
diff --git a/dlls/ntdll/unix/loadorder.c b/dlls/ntdll/unix/loadorder.c
index 722190da..b6a85710 100644
--- a/dlls/ntdll/unix/loadorder.c
+++ b/dlls/ntdll/unix/loadorder.c
@@ -270,6 +270,73 @@ static inline enum loadorder get_env_load_order( const WCHAR *module )
 }
 
 
+/***************************************************************************
+ *	forced_load_order
+ *
+ * Resolve one of the fork's forced-load-order tables, ahead of any registry
+ * lookup. Returns LO_INVALID when `basename` is not in `names`, so the caller
+ * falls through to the normal resolution.
+ *
+ * A bottle's DllOverrides outlive whatever wrote them -- an old Whisky that
+ * dropped DXVK into a game directory as *native*, winetricks, a game's own
+ * installer -- so for the modules this fork ships or must keep out, the
+ * registry cannot be allowed the last word. WINEDLLOVERRIDES still wins: it is
+ * set per run, so it cannot go stale, and it is the lever for A/B-ing a
+ * provider or re-enabling something this fork disables.
+ *
+ * All three spellings get_load_order_value() would have tried are tried here,
+ * in its order: the full module name, "*basename", basename. add_load_order_set()
+ * stores each key verbatim and get_env_load_order() matches it whole, so checking
+ * only the bare name silently ignored "*d3d9=n" -- the form winetricks and most
+ * of the documentation use. Silently is the problem: the TRACE still said "fork
+ * builtin", so an A/B run reads as "the override made no difference to the bug".
+ *
+ * Note this writes '*' into basename[-1], as the registry path below does for
+ * the same reason; it is the same character either way, so the buffer is left
+ * exactly as that path expects to find it.
+ */
+static enum loadorder forced_load_order( const UNICODE_STRING *nt_name, const WCHAR *module,
+                                         WCHAR *basename, const WCHAR * const *names,
+                                         unsigned int count, enum loadorder forced,
+                                         const char *what )
+{
+    enum loadorder ret;
+    unsigned int i;
+
+    for (i = 0; i < count; i++)
+        if (!wcsicmp( basename, names[i] )) break;
+    if (i == count) return LO_INVALID;
+
+    if ((ret = get_env_load_order( module+1 )) == LO_INVALID)
+    {
+        basename[-1] = '*';
+        if ((ret = get_env_load_order( basename-1 )) == LO_INVALID)
+            ret = get_env_load_order( basename );
+    }
+    if (ret != LO_INVALID)
+    {
+        /* Same empty-string problem as below: WINEDLLOVERRIDES="foo=" resolves to
+         * LO_DISABLED, which prints as "", so the A/B that most needs to be
+         * readable traces as "got environment  for ..." with no verdict. */
+        const char *env_lo = debugstr_loadorder( ret );
+
+        TRACE( "got environment %s for %s\n", *env_lo ? env_lo : "(disabled)", debugstr_us(nt_name) );
+    }
+    else
+    {
+        /* debugstr_loadorder(LO_DISABLED) is the empty string, so the disable
+         * case would otherwise trace as "got fork disabled  for ..." -- a double
+         * space and no verdict token to grep for. The builtin case is unchanged
+         * ("b"), so existing logs still match. */
+        const char *lo = debugstr_loadorder( forced );
+
+        ret = forced;
+        TRACE( "got fork %s %s for %s\n", what, *lo ? lo : "(disabled)", debugstr_us(nt_name) );
+    }
+    return ret;
+}
+
+
 /***************************************************************************
  *	open_app_key
  *
@@ -396,6 +463,78 @@ enum loadorder get_load_order( const UNICODE_STRING *nt_name )
     static const WCHAR easyanticheat_x64W[] = {'e','a','s','y','a','n','t','i','c','h','e','a','t','_','x','6','4',0};
     static const WCHAR easyanticheatW[] = {'e','a','s','y','a','n','t','i','c','h','e','a','t',0};
     static const WCHAR soW[] = {'.','s','o',0};
+    /* DXVK, Mullion, winevulkan and FAudio (xaudio2) ship as Wine builtins.
+     * Resolve them ahead of stale registry overrides; explicit environment
+     * overrides still win below. */
+    static const WCHAR d3d9W[]      = {'d','3','d','9',0};
+    static const WCHAR d3d8W[]      = {'d','3','d','8',0};
+    static const WCHAR d3d11W[]     = {'d','3','d','1','1',0};
+    static const WCHAR d3d10coreW[] = {'d','3','d','1','0','c','o','r','e',0};
+    static const WCHAR dxgiW[]      = {'d','x','g','i',0};
+    static const WCHAR vulkan1W[]   = {'v','u','l','k','a','n','-','1',0};
+    static const WCHAR d3d12W[]     = {'d','3','d','1','2',0};
+    static const WCHAR d3d12coreW[] = {'d','3','d','1','2','c','o','r','e',0};
+    static const WCHAR xaudio2_0W[] = {'x','a','u','d','i','o','2','_','0',0};
+    static const WCHAR xaudio2_1W[] = {'x','a','u','d','i','o','2','_','1',0};
+    static const WCHAR xaudio2_2W[] = {'x','a','u','d','i','o','2','_','2',0};
+    static const WCHAR xaudio2_3W[] = {'x','a','u','d','i','o','2','_','3',0};
+    static const WCHAR xaudio2_4W[] = {'x','a','u','d','i','o','2','_','4',0};
+    static const WCHAR xaudio2_5W[] = {'x','a','u','d','i','o','2','_','5',0};
+    static const WCHAR xaudio2_6W[] = {'x','a','u','d','i','o','2','_','6',0};
+    static const WCHAR xaudio2_7W[] = {'x','a','u','d','i','o','2','_','7',0};
+    static const WCHAR xaudio2_8W[] = {'x','a','u','d','i','o','2','_','8',0};
+    static const WCHAR xaudio2_9W[] = {'x','a','u','d','i','o','2','_','9',0};
+    static const WCHAR * const builtin_onlyW[] =
+    {
+        d3d9W, d3d8W, d3d11W, d3d10coreW, dxgiW, vulkan1W,
+        d3d12W, d3d12coreW,
+        xaudio2_0W, xaudio2_1W, xaudio2_2W, xaudio2_3W, xaudio2_4W,
+        xaudio2_5W, xaudio2_6W, xaudio2_7W, xaudio2_8W, xaudio2_9W,
+    };
+
+#ifdef __APPLE__
+    /* Steam's overlay hangs any game it is injected into, under Rosetta. It works
+     * by writing inline hooks over user32's input entry points -- the faulting
+     * address measured in SSFIV was user32+0xa430, eight bytes into
+     * GetAsyncKeyState, in a run of 20-byte jump-table slots that is nothing but
+     * input functions (ClipCursor, EnableScrollBar, GetKeyState,
+     * GetKeyboardState). Those pages are r-x, and Rosetta write-protects the
+     * pages backing its translation cache, so the store traps into Rosetta's own
+     * mach exception server, which retries it forever: two cores at 100%, no
+     * window, no fault ever reaching Wine's SIGSEGV handler and nothing in any
+     * log. Measured 2026-08-09: disabling these two DLLs takes the game from
+     * "never exits, 100% CPU, one segv record" to "no segv records at all".
+     *
+     * Not a game bug and not fixable in the game: the writer is Steam's DLL and
+     * the retry loop is inside Rosetta.
+     *
+     * The cost is the overlay and everything delivered through it -- more than
+     * Shift+Tab, screenshots and the in-game store. Steam Input's controller
+     * configuration and remapping reach a game that does not use the Steamworks
+     * input API through these same in-process hooks, so a legacy title with a
+     * saved controller config gets an unconfigured pad and no explanation. That
+     * is worth knowing in a tree that already ships SDL_JOYSTICK_MFI=0 for
+     * gamepads. Accepted because the alternative is not "overlay on", it is a
+     * game that never starts; revisit if Rosetta stops looping on the retry.
+     * Steam still tracks playtime and achievements.
+     *
+     * To put it back for one run -- also the way to re-test this later -- both
+     * names are needed, since the two DLLs are separate entries here and giving
+     * only the 32-bit one leaves a 64-bit title still disabled:
+     *
+     *     WINEDLLOVERRIDES="gameoverlayrenderer,gameoverlayrenderer64=n"
+     *
+     * macOS-only because Rosetta is what turns the write into an endless loop; the
+     * same hooks are fine natively. */
+    static const WCHAR gameoverlayrendererW[] =
+        {'g','a','m','e','o','v','e','r','l','a','y','r','e','n','d','e','r','e','r',0};
+    static const WCHAR gameoverlayrenderer64W[] =
+        {'g','a','m','e','o','v','e','r','l','a','y','r','e','n','d','e','r','e','r','6','4',0};
+    static const WCHAR * const disabled_onlyW[] =
+    {
+        gameoverlayrendererW, gameoverlayrenderer64W,
+    };
+#endif
 
     static const WCHAR prefixW[] = {'\\','?','?','\\'};
     enum loadorder ret = LO_INVALID;
@@ -479,6 +618,25 @@ enum loadorder get_load_order( const UNICODE_STRING *nt_name )
         }
     }
 
+    /* The fork's D3D/Vulkan builtins, resolved before any registry lookup. A
+     * bottle's DllOverrides outlive whatever wrote them — an old Whisky that
+     * dropped DXVK into a game directory as *native*, winetricks, a game's own
+     * installer — and this tree ships those same modules as builtins, carrying
+     * the "Wine builtin DLL" signature. A stale "d3d9"="native" therefore does
+     * not select a different provider, it makes every candidate unloadable and
+     * the app dies on STATUS_DLL_NOT_FOUND with the DLL sitting right there.
+     * WINEDLLOVERRIDES still wins: it is set per run, so it cannot go stale, and
+     * it is the lever for A/B-ing a provider (e.g. wined3d vs DXVK). */
+    if ((ret = forced_load_order( nt_name, module, basename, builtin_onlyW,
+                                  ARRAY_SIZE(builtin_onlyW), LO_BUILTIN, "builtin" )) != LO_INVALID)
+        goto done;
+
+#ifdef __APPLE__
+    if ((ret = forced_load_order( nt_name, module, basename, disabled_onlyW,
+                                  ARRAY_SIZE(disabled_onlyW), LO_DISABLED, "disabled" )) != LO_INVALID)
+        goto done;
+#endif
+
     /* first explicit module name */
     if ((ret = get_load_order_value( std_key, app_key, module+1 )) != LO_INVALID)
         goto done;
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index d156933a..aea67bd3 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -4040,6 +4040,43 @@ NTSTATUS virtual_map_builtin_module( HANDLE mapping, void **module, SIZE_T *size
     }
     else if (prefer_native && (image_info->dll_charact & IMAGE_DLLCHARACTERISTICS_PREFER_NATIVE))
     {
+        /* The builtin is skipped because a native file is present and the builtin
+         * asks to yield to one -- upstream's per-DLL judgement, often right. But
+         * the application then runs against an implementation this tree neither
+         * builds nor tests, recorded only in a TRACE nobody has on, and
+         * applications install these themselves: SSFIV's DXSETUP drops 89 native
+         * DLLs into the prefix on first launch. A probe compiled into the builtin
+         * xaudio2_7 could never fire for exactly this reason, and the empty log
+         * nearly read as "the game does not use XAudio2".
+         *
+         * Warn, do not override: forcing builtin here would undo that judgement
+         * for every DLL at once. Once per module, best-effort. */
+        {
+            static WCHAR warned[32][64];
+            static unsigned int warned_count;
+            /* nt_name is a counted UNICODE_STRING and is NOT NUL-terminated, so
+             * the basename must be copied out before any wcs* call or
+             * debugstr_w reads it; printing it in place emitted the name
+             * followed by whatever happened to sit after it. */
+            WCHAR base[64];
+            unsigned int total = nt_name.Length / sizeof(WCHAR), off = 0, len, i;
+
+            for (i = 0; i < total; i++) if (nt_name.Buffer[i] == '\\') off = i + 1;
+            len = total - off;
+            if (len >= ARRAY_SIZE(base)) len = ARRAY_SIZE(base) - 1;
+            memcpy( base, nt_name.Buffer + off, len * sizeof(WCHAR) );
+            base[len] = 0;
+
+            for (i = 0; i < warned_count && i < ARRAY_SIZE(warned); i++)
+                if (!wcsicmp( warned[i], base )) break;
+            if (i == warned_count && warned_count < ARRAY_SIZE(warned))
+            {
+                wcscpy( warned[warned_count++], base );
+                ERR_(module)( "%s: using the NATIVE file, ignoring the builtin this "
+                              "tree ships. Set WINEDLLOVERRIDES=%s=b to compare.\n",
+                              debugstr_w(base), debugstr_w(base) );
+            }
+        }
         TRACE_(module)( "%s has prefer-native flag, ignoring builtin\n", debugstr_us(&nt_name) );
         status = STATUS_IMAGE_ALREADY_LOADED;
     }
