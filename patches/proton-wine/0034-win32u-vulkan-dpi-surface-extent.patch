Subject: winemac,win32u: scale CAMetalLayer contentsScale by window DPI and skip Vulkan fshack double-blit on macOS

When a DPI-unaware window (e.g. a 1280x720 D3D9/DXVK game at 96 DPI) runs on a
macOS Retina display (RetinaMode="y", LogPixels=192), Wine maps its 1280x720
logical client area to a 1280x720 pt NSWindow.

Previously, two compounding issues occurred:
  1. winemac.drv hardcoded WineMetalView's CAMetalLayer.contentsScale = 2.0
     whenever RetinaMode="y", making KosmicKrisp's Metal WSI report the layer
     size as 2560x1440 pixels (4x the pixel count of the 96-DPI swapchain) and
     return VK_SUBOPTIMAL_KHR on every frame whenever swapchain extent != layer
     pixel size.
  2. Proton's X11-oriented Vulkan fshack_dpi path in win32u_vkCreateSwapchainKHR()
     tried to paper over that mismatch by allocating a 2560x1440 host swapchain
     (which also broke on Metal WSI because minImageExtent is {1, 1} instead of
     currentExtent) and running a full 2560x1440 compute-shader blit + extra
     vkQueueSubmit on every frame, followed by KosmicKrisp's own 2560x1440
     render-pass blit into the CAMetalDrawable -- doubling 4x-pixel blits and
     driving WindowServer to ~50% CPU.

Fix the architecture at the root on macOS:
  1. winemac.drv: Give WineMetalView a per-view _dpiRatio (default 1.0 for
     DPI-aware apps and Mullion) and conform to NSViewLayerContentScaleDelegate
     so AppKit never overwrites layer.contentsScale back to backingScaleFactor.
     For Vulkan surfaces (macdrv_vulkan_surface_create / macdrv_client_surface_update),
     set _dpiRatio = NtUserGetDpiForWindow(hwnd) / NtUserGetWinMonitorDpi(MDT_RAW_DPI)
     (cached on macdrv_client_surface for zero per-frame main-thread dispatch):
       - DPI-aware windows (dpi == raw): contentsScale = 2.0 (full Retina).
       - DPI-unaware windows (96 vs 192): contentsScale = 1.0, so KosmicKrisp
         sees a matching 1280x720 layer, blits 1/4 the pixels with VK_SUCCESS
         (zero VK_SUBOPTIMAL_KHR), and Apple's display compositor scales
         1280x720 -> 2560x1440 in hardware at zero GPU cost.
  2. win32u: Skip X11 compute-shader fshack_dpi on __APPLE__ in
     surface_get_fshack_dpi(), while retaining the defensive currentExtent,
     mutable-format, and pNext chaining fixes in win32u_vkCreateSwapchainKHR().

Regression: tests/vulkan-dpi-swapchain-test.c (DPI-unaware + --dpi-aware + no-fshack check)

diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -3072,8 +3072,15 @@ fail:
 
 static BOOL surface_get_fshack_dpi( struct surface *surface )
 {
+#ifdef __APPLE__
+    /* On macOS, winemac.drv scales the CAMetalLayer's contentsScale by dpi/raw so
+     * Apple's display compositor scales DPI-unaware swapchains in hardware at zero
+     * GPU cost without Proton's X11 compute-shader fshack double-blit. */
+    return 0;
+#else
     UINT dpi = NtUserGetDpiForWindow( surface->hwnd ), raw = NtUserGetWinMonitorDpi( surface->hwnd, MDT_RAW_DPI );
     return fshack_enabled && dpi != raw ? raw : 0;
+#endif
 }
 
 static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwapchainCreateInfoKHR *create_info,
@@ -3107,24 +3114,12 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     create_info_host.imageExtent.width = max( create_info_host.imageExtent.width, capabilities.minImageExtent.width );
     create_info_host.imageExtent.height = max( create_info_host.imageExtent.height, capabilities.minImageExtent.height );
 
-    /* If the swapchain image size is not equal to the presentation size (e.g. because of DPI virtualization or
-     * display mode change emulation), MoltenVK's vkQueuePresentKHR returns VK_SUBOPTIMAL_KHR.
-     * Create the swapchain with VkSwapchainPresentScalingCreateInfoEXT to avoid this.
-     */
-    if (get_surface_rect( surface->hwnd, &client_rect, NtUserGetWinMonitorDpi( surface->hwnd, MDT_WINE_RAW_DPI ) ) &&
-        !extents_equals( &create_info_host.imageExtent, &client_rect ) &&
-        instance->extensions.has_VK_EXT_surface_maintenance1 &&
-        physical_device->extensions.has_VK_KHR_swapchain_maintenance1)
-    {
-        scaling.scalingBehavior = VK_PRESENT_SCALING_STRETCH_BIT_EXT;
-        create_info_host.pNext = &scaling;
-    }
-
     if (!(swapchain = calloc( 1, sizeof(*swapchain) ))) return VK_ERROR_OUT_OF_HOST_MEMORY;
 
     if ((swapchain->fshack_dpi = surface_get_fshack_dpi( surface )))
     {
         VkSurfaceCapabilitiesKHR caps = {0};
+        VkExtent2D host_extent;
 
         if ((res = instance->p_vkGetPhysicalDeviceSurfaceCapabilitiesKHR( physical_device->host.physical_device,
                                                                           create_info_host.surface, &caps )))
@@ -3137,15 +3132,53 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
         if (!(caps.supportedUsageFlags & VK_IMAGE_USAGE_STORAGE_BIT))
             FIXME( "Swapchain does not support required VK_IMAGE_USAGE_STORAGE_BIT\n" );
 
-        swapchain->host_extents = capabilities.minImageExtent;
-        create_info_host.imageExtent = capabilities.minImageExtent;
+        /* Host WSI backends such as Metal (KosmicKrisp) report minImageExtent = {1, 1}
+         * and expose the actual surface size in currentExtent, whereas X11 sets
+         * minImageExtent == currentExtent. Use currentExtent when defined, falling back
+         * to the raw-DPI client rect if currentExtent is {UINT32_MAX, UINT32_MAX}, and
+         * clamp to [minImageExtent, maxImageExtent].
+         */
+        if (caps.currentExtent.width != ~0u && caps.currentExtent.height != ~0u &&
+            caps.currentExtent.width && caps.currentExtent.height)
+        {
+            host_extent = caps.currentExtent;
+        }
+        else if (get_surface_rect( surface->hwnd, &client_rect, NtUserGetWinMonitorDpi( surface->hwnd, MDT_WINE_RAW_DPI ) ))
+        {
+            host_extent.width = client_rect.right - client_rect.left;
+            host_extent.height = client_rect.bottom - client_rect.top;
+        }
+        else
+        {
+            host_extent = create_info_host.imageExtent;
+        }
+
+        host_extent.width = max( min( host_extent.width, caps.maxImageExtent.width ), caps.minImageExtent.width );
+        host_extent.height = max( min( host_extent.height, caps.maxImageExtent.height ), caps.minImageExtent.height );
+
+        swapchain->host_extents = host_extent;
+        create_info_host.imageExtent = host_extent;
         create_info_host.imageFormat = VK_FORMAT_B8G8R8A8_UNORM;
         create_info_host.imageUsage = VK_IMAGE_USAGE_STORAGE_BIT;
+        create_info_host.flags &= ~VK_SWAPCHAIN_CREATE_MUTABLE_FORMAT_BIT_KHR;
 
         if (create_info->imageFormat != VK_FORMAT_B8G8R8A8_UNORM && create_info->imageFormat != VK_FORMAT_B8G8R8A8_SRGB)
             FIXME( "swapchain image format is not BGRA8 UNORM/SRGB. Things may go badly. %d\n",
                    create_info_host.imageFormat );
     }
+    /* If the swapchain image size is not equal to the presentation size (e.g. because of DPI virtualization or
+     * display mode change emulation), MoltenVK's vkQueuePresentKHR returns VK_SUBOPTIMAL_KHR.
+     * Create the swapchain with VkSwapchainPresentScalingCreateInfoEXT to avoid this.
+     */
+    else if (get_surface_rect( surface->hwnd, &client_rect, NtUserGetWinMonitorDpi( surface->hwnd, MDT_WINE_RAW_DPI ) ) &&
+             !extents_equals( &create_info_host.imageExtent, &client_rect ) &&
+             instance->extensions.has_VK_EXT_surface_maintenance1 &&
+             physical_device->extensions.has_VK_KHR_swapchain_maintenance1)
+    {
+        scaling.pNext = create_info_host.pNext;
+        scaling.scalingBehavior = VK_PRESENT_SCALING_STRETCH_BIT_EXT;
+        create_info_host.pNext = &scaling;
+    }
 
     if ((res = device->p_vkCreateSwapchainKHR( device->host.device, &create_info_host, NULL, &host_swapchain )))
     {
diff --git a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -346,12 +346,14 @@
 @end
 
 
-@interface WineMetalView : WineBaseView
+@interface WineMetalView : WineBaseView <NSViewLayerContentScaleDelegate>
 {
     id<MTLDevice> _device;
+    CGFloat _dpiRatio;
 }
 
     - (id) initWithFrame:(NSRect)frame device:(id<MTLDevice>)device;
+    - (void) setDpiRatio:(CGFloat)ratio;
 
 @end
 
@@ -959,6 +961,7 @@
         if (self)
         {
             _device = [device retain];
+            _dpiRatio = 1.0;
             self.wantsLayer = YES;
             self.layerContentsRedrawPolicy = NSViewLayerContentsRedrawNever;
         }
@@ -971,20 +974,36 @@
         [super dealloc];
     }
 
+    - (void) setDpiRatio:(CGFloat)ratio
+    {
+        if (ratio <= 0.0) ratio = 1.0;
+        _dpiRatio = ratio;
+        self.layer.contentsScale = (retina_on ? 2.0 : 1.0) * _dpiRatio;
+        self.layer.magnificationFilter = (_dpiRatio != 1.0) ? kCAFilterLinear : kCAFilterNearest;
+    }
+
     - (void) setRetinaMode:(BOOL)mode
     {
-        self.layer.contentsScale = mode ? 2.0 : 1.0;
+        self.layer.contentsScale = (mode ? 2.0 : 1.0) * (_dpiRatio > 0.0 ? _dpiRatio : 1.0);
         [super setRetinaMode:mode];
     }
 
+    - (BOOL) layer:(CALayer*)layer shouldInheritContentsScale:(CGFloat)newScale fromWindow:(NSWindow*)window
+    {
+        CGFloat desired = (retina_on ? 2.0 : 1.0) * (_dpiRatio > 0.0 ? _dpiRatio : 1.0);
+        if (layer.contentsScale != desired)
+            layer.contentsScale = desired;
+        return NO;
+    }
+
     - (CALayer*) makeBackingLayer
     {
         CAMetalLayer *layer = [CAMetalLayer layer];
         layer.device = _device;
         layer.framebufferOnly = YES;
-        layer.magnificationFilter = kCAFilterNearest;
+        layer.magnificationFilter = (_dpiRatio != 1.0 && _dpiRatio > 0.0) ? kCAFilterLinear : kCAFilterNearest;
         layer.backgroundColor = CGColorGetConstantColor(kCGColorBlack);
-        layer.contentsScale = retina_on ? 2.0 : 1.0;
+        layer.contentsScale = (retina_on ? 2.0 : 1.0) * (_dpiRatio > 0.0 ? _dpiRatio : 1.0);
         return layer;
     }
 
@@ -3993,6 +4012,15 @@
     return (macdrv_metal_view)metalView;
 }
 
+void macdrv_metal_view_set_dpi_ratio(macdrv_metal_view v, double ratio)
+{
+    WineMetalView* view = (WineMetalView*)v;
+
+    OnMainThread(^{
+        [view setDpiRatio:(CGFloat)ratio];
+    });
+}
+
 macdrv_metal_layer macdrv_view_get_metal_layer(macdrv_metal_view v)
 {
     WineMetalView* view = (WineMetalView*)v;
