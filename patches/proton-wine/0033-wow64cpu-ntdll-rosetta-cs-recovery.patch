Subject: wow64cpu,ntdll: recover Rosetta 2 32<->64 far-jump CS mismatches

Under Apple Silicon Rosetta 2, when one thread unmaps executable memory
(e.g. FreeLibrary -> NtUnmapViewOfSection -> anon_mmap_fixed(PROT_NONE),
as Microsoft's native d3dx9_43.dll does in a tight loop loading/unloading
d3dcompiler_43.dll during Street Fighter IV startup) while other 32-bit
WoW64 threads execute 32<->64 far jumps (ljmp) through wow64cpu.dll,
Rosetta 2's cross-thread JIT invalidation can lose the CS segment switch
in both directions:

  1. 32->64 entry (syscall_32to64 / unix_call_32to64): the thread lands
     at the 64-bit entry point with CS still set to cs32_sel (0x107).
     Previously, xchgq %r14,%rsp and register saves ran first, decoding
     in 32-bit mode as `dec %esp; xchg %esi,%esp` (clobbering %esp to 0)
     and corrupting the 32-bit stack frame before `movl cs32_sel(%rip),%edx`
     faulted reading absolute address 0x5ecd -> nested exception on signal
     stack -> abort_thread(1) while holding a critical section -> deadlock.

  2. 64->32 fast return (`ljmp *(%r14)`): the thread returns to 32-bit
     code with CS still set to cs64_sel (0x2b), crashing inside 32-bit
     code with an invalid stack frame.

Fix both directions at zero steady-state cost:
  - In wow64cpu.dll, hoist `movl cs32_sel(%rip), %edx` + `movl %edx, 0xbc(%r13)`
    to the very first instructions of syscall_32to64 and unix_call_32to64.
    In 64-bit mode this is a normal RIP-relative load (same total instruction
    count). If Rosetta 2 drops the CS switch and enters in 32-bit mode,
    `8b 15 <disp32>` decodes as an absolute read of <disp32> (< 0x10000,
    always unmapped) and faults on instruction #0 with zero side effects.
  - In ntdll's macOS segv_handler, detect that exact zero-side-effect
    prologue fault (verifying WoW64, CS == cs32_sel, data read fault < 64KB,
    R13 == cpu_area + 4, R14 within 64-bit stack, and the 16-byte wow64cpu
    prologue signature on the instruction page), restore CS = cs64_sel, and
    resume cleanly in 64-bit mode.
  - In wow64cpu.dll, use `iretq` instead of `ljmp *(%r14)` on the 64->32
    fast-return path (matching the full-context return path), which avoids
    the Rosetta 2 64->32 far-jump CS bug completely.

Regression: tests/wow64-rosetta-cs-recovery-test.c (32-bit PE, 4 workers
calling Sleep(0) inside a critical section while the main thread runs 200
LoadLibrary/FreeLibrary cycles). Unpatched deadlocks in <1s; patched
recovers every CS mismatch and passes 5/5 runs.


diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 87e7539..1a96c5c 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2541,6 +2541,56 @@ static BOOL handle_foreign_thread_fault( int signal )
     raise( signal );
     return TRUE;
 }
+
+/***********************************************************************
+ *           handle_rosetta_wow64_cs_fault
+ *
+ * Rosetta 2 on Apple Silicon has a concurrency bug when one thread unmaps or
+ * invalidates executable pages (e.g. FreeLibrary -> NtUnmapViewOfSection) while
+ * another 32-bit WoW64 thread executes a 32->64 far jump into wow64cpu.dll:
+ * the target thread lands at syscall_32to64 or unix_call_32to64 with CS still
+ * set to cs32_sel instead of cs64_sel.
+ *
+ * wow64cpu places `movl cs32_sel(%rip), %edx` (8b 15 <disp32>) as the very
+ * first instruction of both entry points, followed by `movl %edx, 0xbc(%r13)`
+ * and `xchgq %r14, %rsp`. In 64-bit mode it is a normal RIP-relative load; in
+ * 32-bit mode it decodes as an absolute read of <disp32> (< 0x10000, always
+ * unmapped), faulting with zero side effects. Detect that exact state here,
+ * restore CS to cs64_sel, and resume cleanly in 64-bit mode.
+ */
+static BOOL handle_rosetta_wow64_cs_fault( ucontext_t *ucontext, void *fault_addr )
+{
+    static const BYTE tail_sig[10] = { 0x41, 0x89, 0x95, 0xbc, 0x00, 0x00, 0x00, 0x4c, 0x87, 0xf4 };
+    const BYTE *rip;
+    ULONG32 disp;
+    TEB *teb;
+    void *cpu_area;
+
+    if (!is_wow64() || CS_sig(ucontext) != cs32_sel) return FALSE;
+    /* Must be a data read fault on the unmapped low 64KB page (neither write nor fetch). */
+    if ((ERROR_sig(ucontext) & 0x12) || (ULONG_PTR)fault_addr >= 0x10000) return FALSE;
+
+    teb = NtCurrentTeb();
+    cpu_area = teb->TlsSlots[WOW64_TLS_CPURESERVED];
+    if (!cpu_area || R13_sig(ucontext) != (ULONG_PTR)cpu_area + 4) return FALSE;
+    if ((void *)R14_sig(ucontext) < teb->DeallocationStack ||
+        (void *)R14_sig(ucontext) >= teb->Tib.StackBase)
+        return FALSE;
+
+    rip = (const BYTE *)RIP_sig(ucontext);
+    if ((ULONG_PTR)rip < 0x10000 || (ULONG_PTR)rip >= 0x100000000ULL) return FALSE;
+    /* Ensure the 16-byte prologue check stays on the already-fetched instruction page. */
+    if (((ULONG_PTR)rip & (page_size - 1)) > page_size - 16) return FALSE;
+    if (rip[0] != 0x8b || rip[1] != 0x15) return FALSE;
+    memcpy( &disp, rip + 2, sizeof(disp) );
+    if ((ULONG_PTR)disp != (ULONG_PTR)fault_addr) return FALSE;
+    if (memcmp( rip + 6, tail_sig, sizeof(tail_sig) )) return FALSE;
+
+    TRACE_(seh)( "Rosetta WoW64 32->64 CS mismatch at %p (cs=%x -> %x), recovering\n",
+                 rip, (unsigned)CS_sig(ucontext), (unsigned)cs64_sel );
+    CS_sig(ucontext) = cs64_sel;
+    return TRUE;
+}
 #endif
 
 /**********************************************************************
@@ -2605,6 +2655,13 @@ static void segv_handler( int signal, siginfo_t *siginfo, void *sigcontext )
             RIP_sig(ucontext) = (intptr_t)steamclient_addr;
             return;
         }
+#ifdef __APPLE__
+        if (handle_rosetta_wow64_cs_fault( ucontext, siginfo->si_addr ))
+        {
+            leave_handler( ucontext );
+            return;
+        }
+#endif
 
         rec.NumberParameters = 2;
         rec.ExceptionInformation[0] = (ERROR_sig(ucontext) >> 1) & 0x09;
