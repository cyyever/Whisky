Subject: server,ntdll: fix FD_WRITE re-arming on non-WSAEWOULDBLOCK send errors and trim socket_get_events overhead

1. server/sock.c (send_socket_completion_callback): Only clear AFD_POLL_WRITE
   and reselect when iosb->status == STATUS_DEVICE_NOT_READY (WSAEWOULDBLOCK),
   matching Windows Winsock2 / AFD semantics. Clearing on any error re-arms
   FD_WRITE immediately on UDP ENETUNREACH / EMSGSIZE failures, spinning
   pollers such as SteamNetworkingSockets.
2. server/sock.c (DECL_HANDLER(socket_get_events)): Remove the redundant
   sock_reselect(sock) call (clearing pending_events does not alter
   sock_get_poll_events()) and return reply->options = get_fd_options(sock->fd)
   in the existing 4-byte reply padding (regenerated by tools/make_requests).
3. dlls/ntdll/unix/socket.c (IOCTL_AFD_GET_EVENTS): Drop the redundant
   server_get_unix_fd() + close(fd) lookup and use reply->options directly.

Regression: tests/ws2_32-fd-write-rearm-test.c

diff --git a/dlls/ntdll/unix/socket.c b/dlls/ntdll/unix/socket.c
index 2b089108..ffae8da6 100644
--- a/dlls/ntdll/unix/socket.c
+++ b/dlls/ntdll/unix/socket.c
@@ -1785,21 +1785,21 @@ NTSTATUS sock_ioctl( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, void *apc
                 break;
             }
 
-            if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, &options )))
-                return status;
-            if (needs_close) close( fd );
-
             SERVER_START_REQ( socket_get_events )
             {
                 req->handle = wine_server_obj_handle( handle );
                 req->event = wine_server_obj_handle( reset_event );
                 wine_server_set_reply( req, params->status, sizeof(params->status) );
                 if (!(status = wine_server_call( req )))
+                {
                     params->flags = reply->flags;
+                    options = reply->options;
+                }
             }
             SERVER_END_REQ;
 
-            file_complete_async( handle, options, event, apc, apc_user, io, status, 0 );
+            if (!status)
+                file_complete_async( handle, options, event, apc, apc_user, io, status, 0 );
             return status;
         }
 
diff --git a/server/protocol.def b/server/protocol.def
index b2d67ff9..80248639 100644
--- a/server/protocol.def
+++ b/server/protocol.def
@@ -1775,6 +1775,7 @@ enum server_fd_type
     obj_handle_t event;         /* event to reset */
 @REPLY
     unsigned int flags;         /* event mask */
+    unsigned int options;       /* device open options */
     VARARG(status,uints);       /* array of status codes */
 @END
 
diff --git a/server/sock.c b/server/sock.c
index 5f9b15a9..318aafd1 100644
--- a/server/sock.c
+++ b/server/sock.c
@@ -4063,9 +4063,11 @@ static void send_socket_completion_callback( void *private )
     struct iosb *iosb = send_req->iosb;
     struct sock *sock = send_req->sock;
 
-    if (iosb->status != STATUS_SUCCESS)
+    if (iosb->status == STATUS_DEVICE_NOT_READY)
     {
-        /* send() calls only clear and reselect events if unsuccessful. */
+        /* Per Winsock2 / AFD semantics, FD_WRITE is only re-armed after a send
+         * fails with WSAEWOULDBLOCK (STATUS_DEVICE_NOT_READY), not on hard
+         * errors like ENETUNREACH or EMSGSIZE. */
         sock->pending_events &= ~AFD_POLL_WRITE;
         sock->reported_events &= ~AFD_POLL_WRITE;
         sock_reselect( sock );
@@ -4207,11 +4209,11 @@ DECL_HANDLER(socket_get_events)
     }
 
     reply->flags = sock->pending_events & sock->mask;
+    reply->options = get_fd_options( sock->fd );
     for (i = 0; i < ARRAY_SIZE( status ); ++i)
         status[i] = sock_get_ntstatus( sock->errors[i] );
 
     sock->pending_events &= ~sock->mask;
-    sock_reselect( sock );
 
     if (event)
     {
