Subject: opengl32: copy context attributes safely before calling the driver

Catch attribute-list access faults locally so the WGL wrapper can unlock.
Copy complete name/value pairs, including zero values, and pass the owned
copy to the driver. Release the allocated context on copy failure.

--- a/dlls/opengl32/unix_wgl.c
+++ b/dlls/opengl32/unix_wgl.c
@@ -624,19 +624,34 @@
 #endif
 }
 
-static int *memdup_attribs( const int *attribs )
+static BOOL memdup_attribs( const int *attribs, int **ret )
 {
     const int *attr;
     size_t size;
-    int *copy;
-
-    if (!(attr = attribs)) return NULL;
-    while (*attr++) { /* nothing */ }
-
-    size = (attr - attribs) * sizeof(*attr);
-    if (!(copy = malloc( size ))) return NULL;
-    memcpy( copy, attribs, size );
-    return copy;
+    int *volatile copy = NULL;
+
+    *ret = NULL;
+    if (!attribs) return TRUE;
+    __TRY
+    {
+        for (attr = attribs; *attr; attr += 2) { /* name/value pairs */ }
+        size = (attr - attribs + 1) * sizeof(*attr);
+        if ((copy = malloc( size ))) memcpy( copy, attribs, size );
+    }
+    __EXCEPT
+    {
+        free( copy );
+        RtlSetLastWin32Error( ERROR_NOACCESS );
+        return FALSE;
+    }
+    __ENDTRY
+    if (!copy)
+    {
+        RtlSetLastWin32Error( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    *ret = copy;
+    return TRUE;
 }
 
