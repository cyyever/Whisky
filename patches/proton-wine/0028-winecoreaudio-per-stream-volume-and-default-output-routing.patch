+static NTSTATUS unix_set_sample_rate(void *args)
+{
+    struct set_sample_rate_params *params = args;
+    struct coreaudio_stream *stream = handle_get_stream(params->stream);
+    AudioStreamBasicDescription old_desc, new_desc;
+    BOOL was_started;
+    OSStatus sc;
+
+    if(!(params->rate > 0.0f) || params->rate > 768000.0f){
+        params->result = E_INVALIDARG;
+        return STATUS_SUCCESS;
+    }
+
+    os_unfair_lock_lock(&stream->lock);
+    if(stream->invalidated){
+        os_unfair_lock_unlock(&stream->lock);
+        params->result = AUDCLNT_E_DEVICE_INVALIDATED;
+        return STATUS_SUCCESS;
+    }
+    if(stream->flow != eRender || !stream->unit){
+        os_unfair_lock_unlock(&stream->lock);
+        params->result = E_NOTIMPL;
+        return STATUS_SUCCESS;
+    }
+    old_desc = stream->dev_desc;
+    new_desc = old_desc;
+    new_desc.mSampleRate = (Float64)params->rate;
+    was_started = stream->unit_started;
+    os_unfair_lock_unlock(&stream->lock);
+
+    if(was_started) AudioOutputUnitStop(stream->unit);
+    AudioUnitUninitialize(stream->unit);
+    sc = AudioUnitSetProperty(stream->unit, kAudioUnitProperty_StreamFormat,
+            kAudioUnitScope_Input, 0, &new_desc, sizeof(new_desc));
+    if(sc == noErr)
+        sc = AudioUnitInitialize(stream->unit);
+    if(sc != noErr){
+        AudioUnitUninitialize(stream->unit);
+        AudioUnitSetProperty(stream->unit, kAudioUnitProperty_StreamFormat,
+                kAudioUnitScope_Input, 0, &old_desc, sizeof(old_desc));
+        if(AudioUnitInitialize(stream->unit) == noErr && was_started){
+            if(AudioOutputUnitStart(stream->unit) != noErr){
+                os_unfair_lock_lock(&stream->lock);
+                stream->unit_started = FALSE;
+                os_unfair_lock_unlock(&stream->lock);
+            }
+        }else if(was_started){
+            os_unfair_lock_lock(&stream->lock);
+            stream->unit_started = FALSE;
+            os_unfair_lock_unlock(&stream->lock);
+        }
+        params->result = osstatus_to_hresult(sc);
+        return STATUS_SUCCESS;
+    }
+    if(was_started && AudioOutputUnitStart(stream->unit) != noErr){
+        os_unfair_lock_lock(&stream->lock);
+        stream->unit_started = FALSE;
+        os_unfair_lock_unlock(&stream->lock);
+    }
+
+    os_unfair_lock_lock(&stream->lock);
+    stream->dev_desc.mSampleRate = new_desc.mSampleRate;
