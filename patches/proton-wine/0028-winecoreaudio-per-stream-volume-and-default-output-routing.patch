--- /dev/null
+++ b/dlls/winecoreaudio.drv/volume_scale.h
@@ -0,0 +1,142 @@
+/*
+ * Per-stream PCM volume scaling helpers for winecoreaudio.drv.
+ * Kept header-only with zero Wine/CoreAudio dependencies so host unit tests
+ * can exercise the exact production implementation across all PCM formats.
+ */
+#ifndef __WINECOREAUDIO_VOLUME_SCALE_H
+#define __WINECOREAUDIO_VOLUME_SCALE_H
+
+#include <stdint.h>
+
+enum ca_sample_format
+{
+    CA_FMT_OTHER = 0,
+    CA_FMT_FLOAT32,
+    CA_FMT_PCM8,
+    CA_FMT_PCM16,
+    CA_FMT_PCM24,
+    CA_FMT_PCM32,
+};
+
+static inline float ca_clamp_gain(float v)
+{
+    return (v > 0.0f) ? v : 0.0f;
+}
+
+static inline void ca_compute_channel_gains(unsigned int nch, float master,
+        const float *session_vols, const float *stream_vols,
+        float *out_gains, int *out_unity, int *out_muted)
+{
+    int all_unity = 1, all_muted = 1;
+    unsigned int ch;
+
+    master = ca_clamp_gain(master);
+    for (ch = 0; ch < nch; ++ch)
+    {
+        float sv = session_vols ? ca_clamp_gain(session_vols[ch]) : 1.0f;
+        float cv = stream_vols ? ca_clamp_gain(stream_vols[ch]) : 1.0f;
+        float g = master * sv * cv;
+
+        if (!(g > 0.0f)) g = 0.0f;
+        out_gains[ch] = g;
+        if (g != 1.0f) all_unity = 0;
+        if (g != 0.0f) all_muted = 0;
+    }
+    *out_unity = all_unity;
+    *out_muted = all_muted;
+}
+
+static inline void ca_scale_pcm_frames(void *buf, unsigned int frames,
+        unsigned int nch, enum ca_sample_format fmt, const float *gains)
+{
+    unsigned int f, ch;
+
+    if (!frames || !nch || !gains) return;
+
+    switch (fmt)
+    {
+    case CA_FMT_FLOAT32:
+    {
+        float *s = (float *)buf;
+        for (f = 0; f < frames; ++f)
+            for (ch = 0; ch < nch; ++ch)
+                s[f * nch + ch] *= gains[ch];
+        break;
+    }
+    case CA_FMT_PCM16:
+    {
+        int16_t *s = (int16_t *)buf;
+        for (f = 0; f < frames; ++f)
+        {
+            for (ch = 0; ch < nch; ++ch)
+            {
+                unsigned int idx = f * nch + ch;
+                double v = (double)s[idx] * (double)gains[ch];
+                if (v > 32767.0) v = 32767.0;
+                else if (v < -32768.0) v = -32768.0;
+                s[idx] = (int16_t)(v >= 0.0 ? v + 0.5 : v - 0.5);
+            }
+        }
+        break;
+    }
+    case CA_FMT_PCM24:
+    {
+        uint8_t *p = (uint8_t *)buf;
+        for (f = 0; f < frames; ++f)
+        {
+            for (ch = 0; ch < nch; ++ch)
+            {
+                unsigned int off = (f * nch + ch) * 3;
+                int32_t raw = (int32_t)p[off]
+                            | ((int32_t)p[off + 1] << 8)
+                            | ((int32_t)(int8_t)p[off + 2] << 16);
+                double v = (double)raw * (double)gains[ch];
+                int32_t out;
+                if (v > 8388607.0) v = 8388607.0;
+                else if (v < -8388608.0) v = -8388608.0;
+                out = (int32_t)(v >= 0.0 ? v + 0.5 : v - 0.5);
+                p[off]     = (uint8_t)(out & 0xff);
+                p[off + 1] = (uint8_t)((out >> 8) & 0xff);
+                p[off + 2] = (uint8_t)((out >> 16) & 0xff);
+            }
+        }
+        break;
+    }
+    case CA_FMT_PCM32:
+    {
+        int32_t *s = (int32_t *)buf;
+        for (f = 0; f < frames; ++f)
+        {
+            for (ch = 0; ch < nch; ++ch)
+            {
+                unsigned int idx = f * nch + ch;
+                double v = (double)s[idx] * (double)gains[ch];
+                if (v > 2147483647.0) v = 2147483647.0;
+                else if (v < -2147483648.0) v = -2147483648.0;
+                s[idx] = (int32_t)(v >= 0.0 ? v + 0.5 : v - 0.5);
+            }
+        }
+        break;
+    }
+    case CA_FMT_PCM8:
+    {
+        uint8_t *s = (uint8_t *)buf;
+        for (f = 0; f < frames; ++f)
+        {
+            for (ch = 0; ch < nch; ++ch)
+            {
+                unsigned int idx = f * nch + ch;
+                double v = ((double)s[idx] - 128.0) * (double)gains[ch] + 128.0;
+                if (v > 255.0) v = 255.0;
+                else if (v < 0.0) v = 0.0;
+                s[idx] = (uint8_t)(v + 0.5);
+            }
+        }
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+#endif /* __WINECOREAUDIO_VOLUME_SCALE_H */
