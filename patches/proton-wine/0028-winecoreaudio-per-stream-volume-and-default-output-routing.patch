+static enum ca_sample_format ca_sample_format_from_wave(const WAVEFORMATEX *fmt)
+{
+    const WAVEFORMATEXTENSIBLE *fmtex = (const WAVEFORMATEXTENSIBLE *)fmt;
+    BOOL is_float = (fmt->wFormatTag == WAVE_FORMAT_IEEE_FLOAT) ||
+        (fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+         IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_IEEE_FLOAT));
+    BOOL is_pcm = (fmt->wFormatTag == WAVE_FORMAT_PCM) ||
+        (fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+         IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_PCM));
+
+    if (is_float && fmt->wBitsPerSample == 32) return CA_FMT_FLOAT32;
+    if (is_pcm)
+    {
+        switch (fmt->wBitsPerSample)
+        {
+        case 8:  return CA_FMT_PCM8;
+        case 16: return CA_FMT_PCM16;
+        case 24: return CA_FMT_PCM24;
+        case 32: return CA_FMT_PCM32;
+        }
+    }
+    return CA_FMT_OTHER;
+}
+
+static AudioDeviceID get_default_device(EDataFlow flow)
+{
+    AudioDeviceID dev_id = kAudioObjectUnknown;
+    UInt32 size = sizeof(dev_id);
+    AudioObjectPropertyAddress addr = {
+        flow == eCapture ? kAudioHardwarePropertyDefaultInputDevice
+                         : kAudioHardwarePropertyDefaultOutputDevice,
+        kAudioObjectPropertyScopeGlobal,
+        kAudioObjectPropertyElementMain,
+    };
+
+    if (AudioObjectGetPropertyData(kAudioObjectSystemObject, &addr, 0, NULL, &size, &dev_id) != noErr)
+        return kAudioObjectUnknown;
+    return dev_id;
+}
+
+/* Native CoreAudio dispatch callback: MUST NOT call Wine Nt* syscalls. */
+static OSStatus ca_device_alive_cb(AudioObjectID obj, UInt32 num_addrs,
+        const AudioObjectPropertyAddress *addrs, void *user)
+{
+    struct coreaudio_stream *stream = user;
+    UInt32 alive = 1, size = sizeof(alive);
+    const AudioObjectPropertyAddress addr = {
+        kAudioDevicePropertyDeviceIsAlive,
+        kAudioObjectPropertyScopeGlobal,
+        kAudioObjectPropertyElementMain,
+    };
+    OSStatus sc = AudioObjectGetPropertyData(obj, &addr, 0, NULL, &size, &alive);
+
+    (void)num_addrs;
+    (void)addrs;
+    if (sc != noErr || !alive)
+    {
+        BOOL wake = FALSE;
+        os_unfair_lock_lock(&stream->lock);
+        stream->invalidated = TRUE;
+        stream->playing = FALSE;
+        wake = stream->cb_sem_valid;
+        os_unfair_lock_unlock(&stream->lock);
+        if (wake)
+            semaphore_signal(stream->cb_sem);
+    }
+    return noErr;
+}
