+static BOOL device_has_scope_channels(AudioDeviceID dev_id, AudioObjectPropertyScope scope)
+{
+    AudioObjectPropertyAddress addr = {
+        kAudioDevicePropertyStreamConfiguration,
+        scope,
+        kAudioObjectPropertyElementMain,
+    };
+    UInt32 size = 0, i;
+    AudioBufferList *buffers;
+    BOOL has_channels = FALSE;
+
+    if(AudioObjectGetPropertyDataSize(dev_id, &addr, 0, NULL, &size) != noErr || !size)
+        return FALSE;
+    buffers = malloc(size);
+    if(!buffers) return FALSE;
+    if(AudioObjectGetPropertyData(dev_id, &addr, 0, NULL, &size, buffers) == noErr){
+        for(i = 0; i < buffers->mNumberBuffers; ++i){
+            if(buffers->mBuffers[i].mNumberChannels > 0){
+                has_channels = TRUE;
+                break;
+            }
+        }
+    }
+    free(buffers);
+    return has_channels;
+}
+
+static EndpointFormFactor get_device_form_factor(AudioDeviceID dev_id, EDataFlow flow)
+{
+    AudioObjectPropertyAddress addr;
+    UInt32 data_source = 0, transport = 0, size;
+
+    addr.mSelector = kAudioDevicePropertyDataSource;
+    addr.mScope = get_scope(flow);
+    addr.mElement = kAudioObjectPropertyElementMain;
+    size = sizeof(data_source);
+    if(AudioObjectGetPropertyData(dev_id, &addr, 0, NULL, &size, &data_source) == noErr){
+        switch(data_source){
+        case 0x6864706e: /* 'hdpn' */
+            return Headphones;
+        case 0x6973706b: /* 'ispk' */
+        case 0x6573706b: /* 'espk' */
+            return Speakers;
+        case 0x6c696e65: /* 'line' */
+            return LineLevel;
+        case 0x73706466: /* 'spdf' */
+            return SPDIF;
+        case 0x696d6963: /* 'imic' */
+        case 0x656d6963: /* 'emic' */
+            return Microphone;
+        }
+    }
+
+    addr.mSelector = kAudioDevicePropertyTransportType;
+    addr.mScope = kAudioObjectPropertyScopeGlobal;
+    addr.mElement = kAudioObjectPropertyElementMain;
+    size = sizeof(transport);
+    if(AudioObjectGetPropertyData(dev_id, &addr, 0, NULL, &size, &transport) == noErr){
+        switch(transport){
+        case kAudioDeviceTransportTypeHDMI:
+        case kAudioDeviceTransportTypeDisplayPort:
+            return DigitalAudioDisplayDevice;
+        case kAudioDeviceTransportTypeBluetooth:
+        case kAudioDeviceTransportTypeBluetoothLE:
+            if(device_has_scope_channels(dev_id, kAudioDevicePropertyScopeInput) &&
+               device_has_scope_channels(dev_id, kAudioDevicePropertyScopeOutput))
+                return Headset;
+            return flow == eCapture ? Headset : Headphones;
+        case kAudioDeviceTransportTypeAirPlay:
+            return Speakers;
+        }
+    }
+
+    return flow == eCapture ? Microphone : Speakers;
+}
