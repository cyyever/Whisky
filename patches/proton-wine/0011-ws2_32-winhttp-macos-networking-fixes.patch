Subject: [PATCH] ws2_32/winhttp: macOS IPv4/hosts lookup fixes and skip DHCP-disabled adapters

Consolidated patches:
  - (0013) ws2_32: prefix hosts resolution, IPv4-only default, and WSALookupServiceBegin semi-stub
subj='ws2_32: prefix hosts resolution, IPv4-only default, and WSALookupServiceBegin semi-stub'
  - (0016) winhttp: skip adapters without DHCP when detecting WPAD

---
diff --git a/dlls/winhttp/session.c b/dlls/winhttp/session.c
index 22f209ff..8faf2b3c 100644
--- a/dlls/winhttp/session.c
+++ b/dlls/winhttp/session.c
@@ -1551,7 +1551,7 @@ static WCHAR *detect_autoproxyconfig_url_dhcp(void)
         TRACE( "adapter '%s' type %lu dhcpv4 enabled %d\n", wine_dbgstr_w(name), ptr->IfType, ptr->Dhcpv4Enabled );
 
         if (ptr->IfType == IF_TYPE_SOFTWARE_LOOPBACK) continue;
-        /* FIXME: also skip adapters where DHCP is disabled */
+        if (!ptr->Dhcpv4Enabled) continue;
 
         size = 256;
         if (!(buf = malloc( size ))) goto done;
diff --git a/dlls/ws2_32/protocol.c b/dlls/ws2_32/protocol.c
index 3e91ab80..2fd275ca 100644
--- a/dlls/ws2_32/protocol.c
+++ b/dlls/ws2_32/protocol.c
@@ -167,6 +167,91 @@ static BOOL eac_download_hack(void)
     return eac_download_hack_enabled;
 }
 
+/* Case-insensitive ASCII comparison of two host names. */
+static BOOL host_name_equal( const char *a, const char *b )
+{
+    for (; *a && *b; a++, b++)
+    {
+        char ca = *a, cb = *b;
+        if (ca >= 'A' && ca <= 'Z') ca += 'a' - 'A';
+        if (cb >= 'A' && cb <= 'Z') cb += 'a' - 'A';
+        if (ca != cb) return FALSE;
+    }
+    return !*a && !*b;
+}
+
+/* Standard Windows getaddrinfo consults %SystemRoot%\system32\drivers\etc\hosts
+ * before querying DNS; Wine hands the name straight to the host resolver and skips
+ * that file. Restore the lookup so a prefix can pin a name to an IP locally — used
+ * to give Steam a stable, non-DNS address for its login/CM hosts on networks where
+ * UDP DNS is unreliable (poisoned or filtered), entirely inside the prefix with no change
+ * to the host's /etc/hosts. Matches names case-insensitively and honours an explicit
+ * AF_INET/AF_INET6 hint; the matched IP literal is copied into @out. */
+static BOOL hosts_file_lookup( const char *node, const struct addrinfo *hints, char *out, int outlen )
+{
+    int want = hints ? hints->ai_family : AF_UNSPEC;
+    char path[MAX_PATH], *buf, *p;
+    DWORD size, read_len;
+    HANDLE file;
+    BOOL found = FALSE;
+
+    if (!node || !node[0]) return FALSE;
+    if (!GetWindowsDirectoryA( path, sizeof(path) - 32 )) return FALSE;
+    lstrcatA( path, "\\system32\\drivers\\etc\\hosts" );
+    file = CreateFileA( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    size = GetFileSize( file, NULL );
+    if (size == INVALID_FILE_SIZE || size > 0x100000 || !(buf = malloc( size + 1 )))
+    {
+        CloseHandle( file );
+        return FALSE;
+    }
+    if (!ReadFile( file, buf, size, &read_len, NULL )) read_len = 0;
+    buf[read_len] = 0;
+    CloseHandle( file );
+
+    p = buf;
+    while (*p && !found)
+    {
+        char *ip, *ip_end, *name, saved;
+
+        while (*p == ' ' || *p == '\t') p++;
+        if (!*p || *p == '#' || *p == '\n' || *p == '\r') goto next_line;
+        ip = p;
+        while (*p && *p != ' ' && *p != '\t' && *p != '\n' && *p != '\r') p++;
+        ip_end = p;
+        while (*p && *p != '\n' && *p != '\r')
+        {
+            while (*p == ' ' || *p == '\t') p++;
+            if (!*p || *p == '#' || *p == '\n' || *p == '\r') break;
+            name = p;
+            while (*p && *p != ' ' && *p != '\t' && *p != '\n' && *p != '\r') p++;
+            saved = *p;
+            *p = 0;
+            if (host_name_equal( name, node ))
+            {
+                char saved_ip = *ip_end;
+                BOOL is_v6;
+                *ip_end = 0;
+                is_v6 = strchr( ip, ':' ) != NULL;
+                if (!((want == AF_INET && is_v6) || (want == AF_INET6 && !is_v6)))
+                {
+                    lstrcpynA( out, ip, outlen );
+                    found = TRUE;
+                }
+                *ip_end = saved_ip;
+            }
+            *p = saved;
+            if (found) break;
+        }
+    next_line:
+        while (*p && *p != '\n') p++;
+        if (*p) p++;
+    }
+    free( buf );
+    return found;
+}
+
 /***********************************************************************
  *      getaddrinfo   (ws2_32.@)
  */
@@ -219,6 +304,28 @@ int WINAPI getaddrinfo( const char *node, const char *service,
         }
     }
 
+    if (node && node[0] && (!hints || !(hints->ai_flags & AI_NUMERICHOST)))
+    {
+        char hostip[64];
+
+        if (hosts_file_lookup( node, hints, hostip, sizeof(hostip) ))
+        {
+            struct addrinfo numeric;
+
+            if (hints) numeric = *hints;
+            else memset( &numeric, 0, sizeof(numeric) );
+            numeric.ai_flags |= AI_NUMERICHOST;
+            TRACE( "resolved %s from hosts file to %s\n", debugstr_a(node), debugstr_a(hostip) );
+            ret = do_getaddrinfo( hostip, service, &numeric, info );
+            if (!ret)
+            {
+                free( fqdn );
+                free( nodev6 );
+                goto done;
+            }
+        }
+    }
+
     ret = do_getaddrinfo( node, service, hints, info );
 
     if (ret && (!hints || !(hints->ai_flags & AI_NUMERICHOST)) && node)
@@ -2125,9 +2232,9 @@ int WINAPI WSAGetServiceClassNameByClassIdW( GUID *class, WCHAR *service, DWORD
  */
 int WINAPI WSALookupServiceBeginA( WSAQUERYSETA *query, DWORD flags, HANDLE *lookup )
 {
-    FIXME( "(%p %#lx %p) Stub!\n", query, flags, lookup );
-    SetLastError( WSA_NOT_ENOUGH_MEMORY );
-    return -1;
+    FIXME( "(%p %#lx %p) semi-stub: returning empty result set\n", query, flags, lookup );
+    *lookup = (HANDLE)(ULONG_PTR)1;
+    return 0;
 }
 
 
@@ -2136,9 +2243,9 @@ int WINAPI WSALookupServiceBeginA( WSAQUERYSETA *query, DWORD flags, HANDLE *loo
  */
 int WINAPI WSALookupServiceBeginW( WSAQUERYSETW *query, DWORD flags, HANDLE *lookup )
 {
-    FIXME( "(%p %#lx %p) Stub!\n", query, flags, lookup );
-    SetLastError( WSA_NOT_ENOUGH_MEMORY );
-    return -1;
+    FIXME( "(%p %#lx %p) semi-stub: returning empty result set\n", query, flags, lookup );
+    *lookup = (HANDLE)(ULONG_PTR)1;
+    return 0;
 }
 
 
diff --git a/dlls/ws2_32/unixlib.c b/dlls/ws2_32/unixlib.c
index e0e1263e..4b71d560 100644
--- a/dlls/ws2_32/unixlib.c
+++ b/dlls/ws2_32/unixlib.c
@@ -704,7 +704,7 @@ static NTSTATUS unix_getaddrinfo( void *args )
     struct addrinfo *unix_info, *src;
     struct WS_addrinfo *dst, *prev = NULL;
     unsigned int needed_size = 0;
-    int ret;
+    int ret, force_v4 = 0;
 
     /* servname tweak required by OSX and BSD kernels */
     if (service && !service[0]) service = "0";
@@ -751,7 +751,27 @@ static NTSTATUS unix_getaddrinfo( void *args )
         }
     }
 
-    ret = getaddrinfo( params->node, service, hints ? &unix_hints : NULL, &unix_info );
+    /* IPv4-only resolution unless WINE_DISABLE_IPV6=0. On a network with no
+     * working IPv6, Steam resolves its CM/directory hosts (api.steampowered.com,
+     * *.steamserver.net) to dead IPv6 addresses, connects, and hangs at login
+     * (STATUS_HOST_UNREACHABLE 0xc000023d). Pinning ai_family to AF_INET makes
+     * getaddrinfo return only A records, so steamclient takes the IPv4 path.
+     *
+     * Only when the caller expressed no preference. An app that asks for
+     * AF_INET6 has said something specific, and answering with A records would
+     * be a wrong answer rather than a narrowed one -- it would get addresses it
+     * cannot use, or EAI_* for an IPv6 literal, with no way to tell why. This is
+     * a default for the ambiguous case, not an override of an explicit one. */
+    {
+        const char *no_v6 = getenv( "WINE_DISABLE_IPV6" );
+        if ((!no_v6 || no_v6[0] != '0') && unix_hints.ai_family == AF_UNSPEC)
+        {
+            unix_hints.ai_family = AF_INET;
+            force_v4 = 1;
+        }
+    }
+
+    ret = getaddrinfo( params->node, service, (hints || force_v4) ? &unix_hints : NULL, &unix_info );
     if (ret)
         return addrinfo_err_from_unix( ret );
 
