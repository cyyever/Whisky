+ * fast paths, msync). static inline in the header rather than exported from
+ * sync.c because sync.c's definitions sit inside
+ * `#if defined(USE_FUTEX) || defined(HAVE_KQUEUE)`, and a backend should not
+ * depend on another backend's build being configured in. */
+static inline LONGLONG get_absolute_timeout( const LARGE_INTEGER *timeout )
+{
+    LARGE_INTEGER now;
+
+    if (timeout->QuadPart >= 0) return timeout->QuadPart;
+    NtQuerySystemTime( &now );
+    return now.QuadPart - timeout->QuadPart;
+}
+
+static inline LONGLONG update_timeout( ULONGLONG end )
+{
+    LARGE_INTEGER now;
+    LONGLONG timeleft;
+
+    NtQuerySystemTime( &now );
+    timeleft = end - now.QuadPart;
+    if (timeleft < 0) timeleft = 0;
+    return timeleft;
+}
