+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include "msync_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msync);
+
+/* Poll interval (100ns units) for a wait set that mixes msync and server
+ * objects. Only mixed waits take this path (never a game hot path), so a small
+ * latency is irrelevant. */
+#define MSYNC_MIXED_POLL_INTERVAL (2 * 10000)  /* 2 ms  -- initial poll */
+#define MSYNC_MIXED_POLL_MAX      (16 * 10000) /* 16 ms -- idle backoff cap */
+
+/* Handle a wait-any set that mixes msync objects with pure-server objects
+ * (named pipes, async I/O, completion ports, processes, ...).
+ *
+ * Upstream msync -- and fsync -- merely log a FIXME here and then wait on the
+ * fast objects only, silently ignoring the server objects. That deadlocks
+ * whenever a server object is the one that gets signaled: RPC / RpcSs startup,
+ * MSI (wine-mono) installs, and service-startup handshakes all do exactly this
+ * (WaitForMultipleObjects of an msync event together with a named pipe). fsync
+ * avoids it because the server hands every object an in-proc-sync fd it can
+ * wait on; msync objects have no such server-side representation, so we cannot
+ * simply delegate the whole set to server_wait().
+ *
+ * Instead we poll: repeatedly grab any ready msync object in userspace (fast),
+ * and between checks do a short server_wait() on just the server subset so the
+ * server can wake us when one of those signals. `objs[i]==NULL` marks a server
+ * object (msync_get_object() left it NULL); non-NULL marks an msync object. */
+static NTSTATUS msync_wait_mixed_any( DWORD count, const HANDLE *handles,
+    struct msync **objs, BOOLEAN alertable, const LARGE_INTEGER *timeout, ULONGLONG end,
+    int current_tid )
+{
+    union select_op select_op;
+    unsigned int server_map[MAXIMUM_WAIT_OBJECTS];
+    unsigned int server_count = 0, flags, i;
+    int *apc_addr;
+    LONGLONG interval = MSYNC_MIXED_POLL_INTERVAL;
+    LARGE_INTEGER diag_start = {0};
+    NTSTATUS ret;
+
+    flags = SELECT_INTERRUPTIBLE | (alertable ? SELECT_ALERTABLE : 0);
+
+    select_op.wait.op = SELECT_WAIT;
+    for (i = 0; i < count; i++)
+    {
+        if (!objs[i]) /* server object */
+        {
+            select_op.wait.handles[server_count] = wine_server_obj_handle( handles[i] );
+            server_map[server_count] = i;
+            server_count++;
+        }
+    }
+
+    /* ntdll_get_thread_data() is an out-of-line call on the unix side
+     * (NtCurrentTeb() -> pthread_getspecific), and it is `pure`, not `const`, so
+     * the compiler cannot hoist it past this loop's atomics. Resolve it once. */
+    apc_addr = alertable ? ntdll_get_thread_data()->msync_apc_addr : NULL;
+
+    while (1)
+    {
+        LARGE_INTEGER poll;
+        LONGLONG left = interval;
+
+        if (apc_addr && __atomic_load_n( apc_addr, __ATOMIC_SEQ_CST ))
+            return msync_run_apcs( TRUE );
+
+        /* 1. Try to grab any ready msync object (userspace, fast). */
+        for (i = 0; i < count; i++)
+        {
+            NTSTATUS status;
+
+            if (!objs[i]) continue;  /* server object, handled by the poll below */
+            status = msync_try_grab( objs[i], current_tid );
+            if (status == STATUS_SUCCESS) return i;
+            if (status == STATUS_ABANDONED) return STATUS_ABANDONED_WAIT_0 + i;
+        }
+
+        /* 2. Bound the poll interval by the overall deadline. */
+        if (timeout)
+        {
+            LARGE_INTEGER now;
+            NtQuerySystemTime( &now );
+            left = end - now.QuadPart;
+            if (left <= 0) return STATUS_TIMEOUT;
+            if (left > interval) left = interval;
+        }
+        poll.QuadPart = -left; /* relative timeout */
+
+        /* 3. Let the server wake us if a server object signals. */
+        ret = server_wait( &select_op,
+            offsetof( union select_op, wait.handles[server_count] ), flags, &poll );
+
+        if (ret < server_count) return server_map[ret];
+        if (ret >= STATUS_ABANDONED_WAIT_0 && ret < STATUS_ABANDONED_WAIT_0 + server_count)
+            return STATUS_ABANDONED_WAIT_0 + server_map[ret - STATUS_ABANDONED_WAIT_0];
+        if (ret == STATUS_USER_APC || ret == STATUS_KERNEL_APC) return ret;
+        /* Only a poll timeout means "recheck"; propagate any real error. */
+        if (ret != STATUS_TIMEOUT) return ret;
+
+        /* Diagnostic: flag a single mixed wait that never wakes (a lost wakeup,
+         * as opposed to legitimately blocking) -- logged once per process. This
+         * is cheap (the poll already backs off) and is the only place a stuck
+         * msync+server wait would show up, so keep it as a debug aid. */
+        if (!diag_start.QuadPart)
+            NtQuerySystemTime( &diag_start );
+        else
+        {
+            LARGE_INTEGER now2;
+            NtQuerySystemTime( &now2 );
+            if (now2.QuadPart - diag_start.QuadPart > 50000000 /* 5s */)
+            {
+                static int stall_logged;
+                if (!stall_logged) { stall_logged = 1;
+                    ERR("mixed wait looping >5s (possible lost wakeup): count=%u server_count=%u\n",
+                        count, server_count);
+                    for (i = 0; i < count; i++)
+                    {
+                        if (!objs[i])
+                            ERR("  [%u] SERVER handle=%p\n", i, handles[i]);
+                        else
+                            ERR("  [%u] msync type=%d signaled=%d handle=%p\n", i, objs[i]->type,
+                                __atomic_load_n( (int *)objs[i]->shm, __ATOMIC_SEQ_CST ), handles[i]);
+                    } }
+            }
+        }
+
+        /* Back off so an idle mixed wait doesn't busy-poll the server forever. */
+        if (interval < MSYNC_MIXED_POLL_MAX) interval *= 2;
+    }
+}
+
+/* Wait-all over a set that mixes msync objects with pure-server objects.
+ *
+ * The wait-any sibling above can take objects one at a time and return; wait-all
+ * has to end up holding everything or nothing, across two mechanisms that cannot
+ * be committed together. Only one ordering works: acquire the msync side first,
+ * because msync_ungrab() can put it back, and the server side last with a single
+ * zero-timeout SELECT_WAIT_ALL, which the server treats as all-or-nothing and so
+ * can never leave it half-consumed. If that probe reports nothing ready we
+ * release the msync objects and go round again.
+ *
+ * Without this the set fell into the pure-msync wait-all loop, whose `if (!obj)
+ * continue` skips every server object -- so a wait-all over an event and a named
+ * pipe returned SUCCESS with the pipe unsignaled.
+ *
+ * The sleep between rounds deliberately passes no handles: a SELECT_WAIT over the
+ * server subset would consume one (an auto-reset event, a semaphore) that we then
+ * could not give back if the msync side was not also ready. So this path trades
+ * up to MSYNC_MIXED_POLL_MAX of latency for that safety -- bWaitAll over a mixed
+ * set is rare enough that this is the right trade.
+ *
+ * It makes the same temporary-acquisition bargain the pure-msync wait-all already
+ * documents: another thread can briefly fail to take an object we are holding and
+ * about to give back. */
+static NTSTATUS msync_wait_mixed_all( DWORD count, const HANDLE *handles,
+    struct msync **objs, BOOLEAN alertable, ULONGLONG *end, int current_tid )
+{
+    static const LARGE_INTEGER zero = {0};
+    union select_op select_op;
+    unsigned int server_count = 0, flags, i;
+    LONGLONG interval = MSYNC_MIXED_POLL_INTERVAL;
+    int *apc_addr;
+    NTSTATUS ret;
+
+    flags = SELECT_INTERRUPTIBLE | (alertable ? SELECT_ALERTABLE : 0);
+
+    select_op.wait.op = SELECT_WAIT_ALL;
+    for (i = 0; i < count; i++)
+        if (!objs[i]) select_op.wait.handles[server_count++] = wine_server_obj_handle( handles[i] );
+
+    apc_addr = alertable ? ntdll_get_thread_data()->msync_apc_addr : NULL;
+
+    while (1)
+    {
+        LARGE_INTEGER poll;
+        LONGLONG left = interval;
+        BOOL abandoned = FALSE;
+
+        if (apc_addr && __atomic_load_n( apc_addr, __ATOMIC_SEQ_CST ))
+            return msync_run_apcs( TRUE );
+
+        /* 1. Peek: are all the msync objects ready? No side effects, so there is
+         *    nothing to undo if one is not. */
+        for (i = 0; i < count; i++)
+            if (objs[i] && !msync_ready( objs[i], current_tid )) break;
+
+        if (i == count)
+        {
+            /* 2. Take the msync side. This is the rollbackable half. */
+            for (i = 0; i < count; i++)
+            {
+                NTSTATUS grabbed;
+
+                if (!objs[i]) continue;
+                grabbed = msync_try_grab( objs[i], current_tid );
+                if (grabbed == STATUS_ABANDONED) abandoned = TRUE;
+                else if (grabbed != STATUS_SUCCESS) break;
+            }
+
+            if (i == count)
+            {
+                /* 3. Then the server side, all-or-nothing and non-blocking. */
+                ret = server_wait( &select_op,
+                    offsetof( union select_op, wait.handles[server_count] ), flags, &zero );
+
+                if (ret == STATUS_SUCCESS)
+                    return abandoned ? STATUS_ABANDONED : STATUS_SUCCESS;
+                if (ret == STATUS_ABANDONED)
+                    return STATUS_ABANDONED;
+                if (ret != STATUS_TIMEOUT)
+                {
+                    /* A real error or an APC: give the msync side back first. */
+                    for (i = 0; i < count; i++)
+                        if (objs[i]) msync_ungrab( objs[i] );
+                    return ret;
+                }
+            }
+
+            /* Could not complete: put back exactly what we took. */
+            while (i--)
+                if (objs[i]) msync_ungrab( objs[i] );
+        }
+
+        /* 4. Sleep, bounded by the overall deadline. */
+        if (end)
+        {
+            LARGE_INTEGER now;
+
+            NtQuerySystemTime( &now );
+            left = *end - now.QuadPart;
+            if (left <= 0) return STATUS_TIMEOUT;
+            if (left > interval) left = interval;
+        }
+        poll.QuadPart = -left;
+
+        ret = server_wait( NULL, 0, flags, &poll );
+        if (ret != STATUS_TIMEOUT) return ret;
+
+        if (interval < MSYNC_MIXED_POLL_MAX) interval *= 2;
+    }
+}
+
+/* Does this (possibly generic) access mask grant SYNCHRONIZE, i.e. the right to
+ * wait on the object? Mirrors the server generic mapping (msync_map_access):
+ * SYNCHRONIZE is conferred by the explicit SYNCHRONIZE bit (also present in every
+ * *_ALL_ACCESS constant), GENERIC_EXECUTE, GENERIC_ALL, or MAXIMUM_ALLOWED. */
+static inline int msync_can_wait( unsigned int access )
+{
+    return (access & (SYNCHRONIZE | GENERIC_EXECUTE | GENERIC_ALL | MAXIMUM_ALLOWED)) != 0;
+}
+
+/* Woken by a user APC rather than by anything in the wait set. */
+static NTSTATUS msync_wait_user_apc(void)
+{
+    TRACE("Woken up by user APC.\n");
+
+    /* msync_run_apcs() maps the zero-timeout TIMEOUT to STATUS_USER_APC, which
+     * is also the right answer when a system APC woke the APC fd before SIGUSR1
+     * arrived and poll() therefore did not report EINTR. */
+    return msync_run_apcs( TRUE );
+}
+
+/* Wait-any over a pure-msync set: scan for anything ready, otherwise block on
+ * the whole set and scan again. */
+static NTSTATUS msync_wait_any(
+    DWORD count, const HANDLE *handles, struct msync **objs, struct msync *apc_obj,
+    BOOLEAN alertable, const LARGE_INTEGER *timeout, ULONGLONG end, int current_tid )
+{
+    DWORD waitcount;
+    int i, ret;
+
+    while (1)
+    {
+        /* Try to grab anything. */
+
+        if (alertable)
+        {
+            /* We must check this first! The server may set an event that
+             * we're waiting on, but we need to return STATUS_USER_APC. */
+            if (__atomic_load_n( (int *)apc_obj->shm, __ATOMIC_SEQ_CST ))
+                return msync_wait_user_apc();
+        }
+
+        for (i = 0; i < count; i++)
+        {
+            struct msync *obj = objs[i];
+            NTSTATUS status;
+
+            if (!obj) continue;
+
+            if (!obj->type)
+            {
+                /* Someone probably closed an object while waiting on it. */
+                WARN("Handle %p has type 0; was it closed?\n", handles[i]);
+                return STATUS_INVALID_HANDLE;
+            }
+
+            status = msync_try_grab( obj, current_tid );
+            if (status == STATUS_SUCCESS)
+            {
+                TRACE("Woken up by handle %p [%d].\n", handles[i], i);
+                return i;
+            }
+            if (status == STATUS_ABANDONED)
+            {
+                TRACE("Woken up by abandoned mutex %p [%d].\n", handles[i], i);
+                return STATUS_ABANDONED_WAIT_0 + i;
+            }
+            if (status == STATUS_OBJECT_TYPE_MISMATCH)
+            {
+                ERR("Invalid type %#x for handle %p.\n", obj->type, handles[i]);
+                assert(0);
+            }
+        }
+
+        if (alertable)
+        {
+            /* We already checked if it was signaled; don't bother doing it again. */
+            objs[i] = apc_obj;
+            i++;
+        }
+        waitcount = i;
+
+        /* Looks like everything is contended, so wait. */
+
+        if (timeout && !timeout->QuadPart)
+        {
+            /* Unlike esync, we already know that we've timed out, so we
+             * can avoid a syscall. */
+            TRACE("Wait timed out.\n");
+            return STATUS_TIMEOUT;
+        }
+
+        ret = msync_wait_multiple( objs, waitcount, timeout ? &end : NULL, current_tid );
+
+        if (ret == STATUS_TIMEOUT)
+        {
+            TRACE("Wait timed out.\n");
+            return STATUS_TIMEOUT;
+        }
+    } /* while (1) */
+}
+
+/* Wait-all over a pure-msync set. Trickier, and fortunately less common: wait
+ * in sequence on every object, then try to grab them all in a tight loop; if
+ * that fails, put back whatever was taken and start over. */
+static NTSTATUS msync_wait_all(
+    DWORD count, const HANDLE *handles, struct msync **objs,
+    BOOLEAN alertable, const LARGE_INTEGER *timeout, ULONGLONG end, int current_tid )
+{
+    int i;
+
+    /* Wait-all is a little trickier to implement correctly. Fortunately,
+     * it's not as common.
+     *
+     * The idea is basically just to wait in sequence on every object in the
+     * set. Then when we're done, try to grab them all in a tight loop. If
+     * that fails, release any resources we've grabbed (and yes, we can
+     * reliably do this—it's just mutexes and semaphores that we have to
+     * put back, and in both cases we just put back 1), and if any of that
+     * fails we start over.
+     *
+     * What makes this inherently bad is that we might temporarily grab a
+     * resource incorrectly. Hopefully it'll be quick (and hey, it won't
+     * block on wineserver) so nobody will notice. Besides, consider: if
+     * object A becomes signaled but someone grabs it before we can grab it
+     * and everything else, then they could just as well have grabbed it
+     * before it became signaled. Similarly if object A was signaled and we
+     * were blocking on object B, then B becomes available and someone grabs
+     * A before we can, then they might have grabbed A before B became
+     * signaled. In either case anyone who tries to wait on A or B will be
+     * waiting for an instant while we put things back. */
+
+    while (1)
+    {
+        BOOL abandoned = FALSE;
+
+        /* First step: try to wait on each object in sequence. */
+
+        for (i = 0; i < count; i++)
+        {
+            struct msync *obj = objs[i];
+            NTSTATUS status = STATUS_SUCCESS;
+
+            if (!obj) continue;
+
+            if (!obj->type)
+            {
+                /* Closed while we were assembling the set. Fail it here, as
+                 * the wait-any branch does: msync_try_grab() would report a
+                 * type mismatch, and the grab loop would retry forever. */
+                WARN("Handle %p has type 0; was it closed?\n", handles[i]);
+                return STATUS_INVALID_HANDLE;
+            }
+
+            /* msync_ready() covers every type, including an abandoned mutex
+             * (tid == ~0), which is ready: msync_do_single_wait() returns
+             * STATUS_PENDING for one immediately, so treating it as not-ready
+             * here would spin. */
+            while (!msync_ready( obj, current_tid ))
+            {
+                status = msync_do_single_wait( obj, timeout ? &end : NULL, alertable, current_tid );
+                if (status != STATUS_PENDING)
+                    break;
+            }
+
+            if (status == STATUS_TIMEOUT)
+            {
+                TRACE("Wait timed out.\n");
+                return STATUS_TIMEOUT;
+            }
+            else if (status == STATUS_USER_APC)
+                return msync_wait_user_apc();
+        }
+
+        /* If we got here and we haven't timed out, that means all of the
+         * handles were signaled. Check to make sure they still are. */
+        for (i = 0; i < count; i++)
+            if (objs[i] && !msync_ready( objs[i], current_tid )) break;
+        if (i < count) continue;   /* one went away again -- start over */
+
+        /* Yep, still signaled. Now quick, grab everything. */
+        for (i = 0; i < count; i++)
+        {
+            struct msync *obj = objs[i];
+            NTSTATUS grabbed;
+
+            if (!obj) continue;
+            /* This re-tests manual-reset events and the queue too:
+             * msync_try_grab() consumes nothing for those, but it does report
+             * STATUS_PENDING if one was reset since the check above, and a
+             * wait-all must not return with an unsignaled object in the set.
+             * Retrying is what the "still signaled" loop above would answer,
+             * just with a tighter window. */
+            grabbed = msync_try_grab( obj, current_tid );
+            if (grabbed == STATUS_ABANDONED)
+                abandoned = TRUE;
+            else if (grabbed != STATUS_SUCCESS)
+                break;
+        }
+
+        if (i < count)   /* too slow -- put back what we took and start over */
+        {
+            while (i--)
+                if (objs[i]) msync_ungrab( objs[i] );
+            continue;
+        }
+
+        if (abandoned)
+        {
+            TRACE("Wait successful, but some object(s) were abandoned.\n");
+            return STATUS_ABANDONED;
+        }
+        TRACE("Wait successful.\n");
+        return STATUS_SUCCESS;
+    } /* while (1) */
+}
+
+static NTSTATUS __msync_wait_objects( DWORD count, const HANDLE *handles,
+    BOOLEAN wait_any, BOOLEAN alertable, const LARGE_INTEGER *timeout )
+{
+    __thread static int current_tid = 0;
+    __thread static struct msync *objs[MAXIMUM_WAIT_OBJECTS + 1];
+    struct msync apc_obj;
+    int has_msync = 0, has_server = 0;
+    LONGLONG timeleft;
+    ULONGLONG end;
+    int i, ret;
+    /* One resolution for the whole call: see the note in msync_wait_mixed_any(). */
+    struct ntdll_thread_data *thread_data = ntdll_get_thread_data();
+
+    if (!current_tid) current_tid = GetCurrentThreadId();
+
+    /* Grab the APC idx if we don't already have it. */
+    if (alertable && !thread_data->msync_apc_addr)
+    {
+        unsigned int idx = 0;
+        SERVER_START_REQ( get_msync_apc_idx )
+        {
+            if (!(ret = wine_server_call( req )))
+                idx = reply->shm_idx;
+        }
+        SERVER_END_REQ;
+
+        if (idx)
+        {
+            struct event *apc_event = msync_get_shm( idx );
+            thread_data->msync_apc_addr = &apc_event->signaled;
+            thread_data->msync_apc_idx = idx;
+        }
+        else
+        {
+            /* Downgrade rather than NULL-check at each use below: an alertable
+             * wait that cannot see its own APCs is the worse failure. They still
+             * arrive through the SIGUSR1/EINTR path in msync_wait_single(); we
+             * just cannot return STATUS_USER_APC for one. Not handed to the
+             * server either -- server_wait() on an msync object hits
+             * no_add_queue and busy-returns STATUS_OBJECT_TYPE_MISMATCH. */
+            static int warned;
+            if (!warned++) ERR("no msync APC index; waiting non-alertably\n");
+            alertable = FALSE;
+        }
+    }
+
+    if (timeout)
+    {
+        if (timeout->QuadPart == TIMEOUT_INFINITE)
+            timeout = NULL;
+        else if (timeout->QuadPart > 0)
+            end = timeout->QuadPart;
+        else
+        {
+            LARGE_INTEGER now;
+            NtQuerySystemTime( &now );
+            end = now.QuadPart - timeout->QuadPart;
+        }
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        ret = msync_get_object( handles[i], &objs[i] );
+        if (ret == STATUS_SUCCESS)
+        {
+            has_msync = 1;
+            /* Windows requires SYNCHRONIZE access to wait on an object. msync
+             * caches the object per handle and the fast wait path never consults
+             * the server, so a handle opened with restricted rights (e.g.
+             * GENERIC_READ|GENERIC_WRITE, no SYNCHRONIZE) would otherwise wait
+             * successfully. Deny it here to match the server oracle (kernel32
+             * sync test:300, and its cascade :330 where the extra bogus
+             * acquisition unbalances the mutex recursion count). */
+            if (!msync_can_wait( objs[i]->access ))
+                return STATUS_ACCESS_DENIED;
+        }
+        else if (ret == STATUS_NOT_IMPLEMENTED)
+            has_server = 1;
+        else
+            return ret;
+    }
+
+    if (has_msync && has_server)
+    {
+        /* A wait set mixing msync and server objects cannot be handled by
+         * either mechanism alone; poll both. (A mixed set always has count >= 2,
+         * so it is a wait-any unless the caller asked for wait-all.) */
+        if (wait_any || count <= 1)
+            return msync_wait_mixed_any( count, handles, objs, alertable,
+                                         timeout, timeout ? end : 0, current_tid );
+
+        return msync_wait_mixed_all( count, handles, objs, alertable,
+                                     timeout ? &end : NULL, current_tid );
+    }
+    else if (has_server)
+        return STATUS_NOT_IMPLEMENTED;
+
+    if (TRACE_ON(msync))
+    {
+        TRACE("Waiting for %s of %d handles:", wait_any ? "any" : "all", count);
+        for (i = 0; i < count; i++)
+            TRACE(" %p", handles[i]);
+
+        if (count && objs[count - 1] && objs[count - 1]->type == MSYNC_QUEUE)
+            TRACE(" or driver events");
+        if (alertable)
+            TRACE(", alertable");
+
+        if (!timeout)
+            TRACE(", timeout = INFINITE.\n");
+        else
+        {
+            timeleft = update_timeout( end );
+            TRACE(", timeout = %ld.%07ld sec.\n",
+                (long) (timeleft / TICKSPERSEC), (long) (timeleft % TICKSPERSEC));
+        }
+    }
+
+    if (wait_any || count <= 1)
+    {
+        /* Only wait-any takes one from here; wait-all reaches its APC object
+         * through msync_do_single_wait(). */
+        if (alertable) msync_init_apc_obj( &apc_obj, thread_data );
+
+        return msync_wait_any( count, handles, objs, &apc_obj, alertable, timeout,
+                               timeout ? end : 0, current_tid );
+    }
+
+    return msync_wait_all( count, handles, objs, alertable, timeout,
+                           timeout ? end : 0, current_tid );
+}
+
+/* Like esync, we need to let the server know when we are doing a message wait,
+ * and when we are done with one, so that all of the code surrounding hung
+ * queues works, and we also need this for WaitForInputIdle().
+ *
+ * Unlike esync, we can't wait on the queue fd itself locally. Instead we let
+ * the server do that for us, the way it normally does. This could actually
+ * work for esync too, and that might be better. */
+static void server_set_msgwait( int in_msgwait )
+{
+    SERVER_START_REQ( msync_msgwait )
+    {
+        req->in_msgwait = in_msgwait;
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+}
+
+/* This is a very thin wrapper around the proper implementation above. The
+ * purpose is to make sure the server knows when we are doing a message wait.
+ * This is separated into a wrapper function since there are at least a dozen
+ * exit paths from msync_wait_objects(). */
+NTSTATUS msync_wait_objects( DWORD count, const HANDLE *handles, BOOLEAN wait_any,
+                             BOOLEAN alertable, const LARGE_INTEGER *timeout )
+{
+    BOOL msgwait = FALSE;
+    struct msync *obj;
+    NTSTATUS ret;
+
+    if (count && !msync_get_object( handles[count - 1], &obj ) && obj->type == MSYNC_QUEUE)
+    {
+        msgwait = TRUE;
+        server_set_msgwait( 1 );
+    }
+
+    ret = __msync_wait_objects( count, handles, wait_any, alertable, timeout );
+
+    if (msgwait)
+        server_set_msgwait( 0 );
+
+    return ret;
+}
+
+NTSTATUS msync_signal_and_wait( HANDLE signal, HANDLE wait, BOOLEAN alertable,
+    const LARGE_INTEGER *timeout )
+{
+    struct msync *obj;
+    NTSTATUS ret;
+
+    if ((ret = msync_get_object( signal, &obj ))) return ret;
+
+    switch (obj->type)
+    {
+    case MSYNC_SEMAPHORE:
+        ret = msync_release_semaphore( signal, 1, NULL );
+        break;
+    case MSYNC_AUTO_EVENT:
+    case MSYNC_MANUAL_EVENT:
+        ret = msync_set_event( signal, NULL );
+        break;
+    case MSYNC_MUTEX:
+        ret = msync_release_mutex( signal, NULL );
+        break;
+    default:
+        return STATUS_OBJECT_TYPE_MISMATCH;
+    }
+    if (ret) return ret;
+
+    ret = msync_wait_objects( 1, &wait, TRUE, alertable, timeout );
+
+    /* Past the signal there is no way back. STATUS_NOT_IMPLEMENTED here means
+     * only that `wait` is a pure server object; returning it would send the
+     * caller down the server path, which signals a SECOND time -- and cannot,
+     * since an msync object carries no_signal, so it would answer
+     * STATUS_OBJECT_TYPE_MISMATCH for an operation whose signal half already
+     * happened. Do the server half of the wait ourselves: it is the only part
+     * of this the server can do. */
+    if (ret == STATUS_NOT_IMPLEMENTED)
+        ret = server_wait_for_object( wait, alertable, timeout );
+
+    return ret;
+}
diff --git a/dlls/ntdll/unix/msync_shm.c b/dlls/ntdll/unix/msync_shm.c
new file mode 100644
index 00000000000..a6f18f60d40
--- /dev/null
+++ b/dlls/ntdll/unix/msync_shm.c
@@ -0,0 +1,295 @@
+/*
+ * mach semaphore-based synchronization objects
+ *
+ * Copyright (C) 2018 Zebediah Figura
+ * Copyright (C) 2023 Marc-Aurel Zent
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include "msync_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msync);
+
+#define MAX_POOL_SEMAPHORES 1024
+
+struct semaphore_memory_pool
+{
+    semaphore_t semaphores[MAX_POOL_SEMAPHORES];
+    semaphore_t *free_semaphores[MAX_POOL_SEMAPHORES];
+    unsigned int count;
+    unsigned int total;
+    os_unfair_lock lock;
+};
+
+static struct semaphore_memory_pool *pool;
+
+static void semaphore_pool_init(void)
+{
+    unsigned int i;
+
+    pool = malloc( sizeof(struct semaphore_memory_pool) );
+
+    pool->lock = OS_UNFAIR_LOCK_INIT;
+
+    for (i = 0; i < MAX_POOL_SEMAPHORES; i++)
+    {
+        pool->free_semaphores[i] = &pool->semaphores[i];
+    }
+
+    pool->count = 0;
+    pool->total = 0;
+}
+
+semaphore_t *msync_semaphore_pool_alloc(void)
+{
+    semaphore_t *new_semaphore;
+    kern_return_t kr;
+
+    os_unfair_lock_lock(&pool->lock);
+
+    if (pool->count == 0)
+    {
+        if (pool->total < MAX_POOL_SEMAPHORES)
+        {
+            TRACE("Dynamically growing semaphore pool\n");
+            kr = semaphore_create(mach_task_self(), &pool->semaphores[pool->total], SYNC_POLICY_FIFO, 0);
+            if (kr != KERN_SUCCESS)
+                ERR("Cannot create dynamic semaphore: %#x %s\n", kr, mach_error_string(kr));
+
+            new_semaphore = &pool->semaphores[pool->total];
+            pool->total++;
+
+            os_unfair_lock_unlock(&pool->lock);
+
+            return new_semaphore;
+        }
+        else
+        {
+            os_unfair_lock_unlock(&pool->lock);
+
+            WARN("Semaphore pool exhausted, consider increasing MAX_POOL_SEMAPHORES\n");
+            new_semaphore = malloc(sizeof(semaphore_t));
+            kr = semaphore_create(mach_task_self(), new_semaphore, SYNC_POLICY_FIFO, 0);
+            if (kr != KERN_SUCCESS)
+                ERR("Cannot create dynamic semaphore: %#x %s\n", kr, mach_error_string(kr));
+
+            return new_semaphore;
+        }
+    }
+
+    new_semaphore = pool->free_semaphores[pool->count - 1];
+    pool->count--;
+
+    os_unfair_lock_unlock(&pool->lock);
+
+    return new_semaphore;
+}
+
+void msync_semaphore_pool_free(semaphore_t *sem)
+{
+    os_unfair_lock_lock(&pool->lock);
+
+    if (sem < pool->semaphores || sem >= pool->semaphores + MAX_POOL_SEMAPHORES)
+    {
+        os_unfair_lock_unlock(&pool->lock);
+
+        semaphore_destroy(mach_task_self(), *sem);
+        free(sem);
+
+        return;
+    }
+
+    /* The pool never shrinks, deliberately. ->total is a high-water mark into a
+     * FIXED array: alloc hands out &semaphores[total] and increments it, so
+     * decrementing it does not release anything -- it re-points the next alloc at
+     * a slot that is still in use. semaphore_create() then overwrites that slot's
+     * port name while a waiter holds a pointer to it, and since the waiter re-reads
+     * *sem at semaphore_wait() -- after server_register_wait() already handed the
+     * old port to the wineserver -- the signal goes to the old port and the waiter
+     * blocks forever.
+     *
+     * (A shrink that only ever destroyed the top-most slots, and only when they
+     * were all free, could work; the ports are the bounded resource and there are
+     * at most MAX_POOL_SEMAPHORES of them, so it is not worth the risk.) */
+    pool->free_semaphores[pool->count] = sem;
+    pool->count++;
+
+    os_unfair_lock_unlock(&pool->lock);
+}
+
+int do_msync(void)
+{
+#ifdef __APPLE__
+    /* msync (__ulock) is the default fast-sync on macOS; the wineserver fallback
+     * is slower/less reliable, so default on. WINEMSYNC=0 forces it off (debug). */
+    static int cached = -1;
+    if (cached == -1)
+    {
+        const char *env = getenv( "WINEMSYNC" );
+        cached = env ? atoi( env ) : 1;
+    }
+    return cached;
+#else
+    static int once;
+    if (!once++)
+        FIXME("mach semaphores not supported on this platform.\n");
+    return 0;
+#endif
+}
+
+/* Per-type routing: which object classes use msync, and which fall through to the
+ * wineserver. This is the inner refinement of do_msync() above -- sync.c gates
+ * every entry point on that first -- so both live here, next to each other.
+ *
+ * Read once, at init, rather than lazily: a setenv() from another thread would
+ * otherwise be able to change the answer mid-process, and two processes that
+ * disagree about a named object's type cannot share it.
+ *
+ * DO NOT delete these as leftover debugging. WINEMSYNC_NO_MANUALEVENT=1 is set
+ * unconditionally for every bottle (WhiskyKit/.../Wine/Wine.swift) as the shipped
+ * workaround for the manual-event spin; removing that gate regresses Steam to a
+ * 100%-CPU spin. The other gates really are bisection levers.
+ *
+ * A gate is NOT a way to identify which object class owns a bug: routing a class
+ * to the server makes any wait set that mixes it with the message queue take the
+ * polling path in msync_select.c, and a polling loop cannot hang no matter what
+ * the underlying defect is. A gate that "fixes" a hang has only shown that the
+ * pure-msync blocking path is involved. */
+static int type_disabled[MSYNC_QUEUE + 1];
+
+static void read_type_gates(void)
+{
+    static const struct { enum msync_type type; const char *name; } gates[] =
+    {
+        { MSYNC_SEMAPHORE,    "WINEMSYNC_NO_SEMAPHORE" },
+        { MSYNC_MUTEX,        "WINEMSYNC_NO_MUTEX" },
+        { MSYNC_AUTO_EVENT,   "WINEMSYNC_NO_AUTOEVENT" },
+        { MSYNC_MANUAL_EVENT, "WINEMSYNC_NO_MANUALEVENT" },
+    };
+    unsigned int i;
+    const char *e;
+
+    for (i = 0; i < sizeof(gates) / sizeof(gates[0]); i++)
+    {
+        e = getenv( gates[i].name );
+        type_disabled[gates[i].type] = (e && *e != '0');
+    }
+
+    if ((e = getenv( "WINEMSYNC_NO_EVENT" )) && *e != '0')
+        type_disabled[MSYNC_AUTO_EVENT] = type_disabled[MSYNC_MANUAL_EVENT] = 1;
+}
+
+int msync_type_enabled( enum msync_type type )
+{
+    return type <= MSYNC_QUEUE ? !type_disabled[type] : 1;
+}
+
+static char shm_name[MSYNC_SHM_NAME_LEN];
+/* zero_new_pages stays clear: the wineserver creates the file and owns the
+ * contents of a page; a client must not clear one it happens to map first. */
+static struct msync_shm_map shm_map;
+mach_port_t msync_server_port;
+
+/* msync_shm_slot() is not internally synchronised and any thread can land here. */
+static os_unfair_lock shm_addrs_lock = OS_UNFAIR_LOCK_INIT;
+
+void *msync_get_shm( unsigned int idx )
+{
+    struct msync_shm_map_info info;
+    void *ret;
+
+    os_unfair_lock_lock( &shm_addrs_lock );
+
+    ret = msync_shm_slot( &shm_map, idx, &info );
+
+    if (info.grow_failed)
+        ERR("Failed to grow shm_addrs array to size %d.\n", info.new_size);
+    else if (info.mmap_failed)
+        ERR("Failed to map page %d (offset %#lx).\n", info.entry, info.entry * shm_map.pagesize);
+    else if (info.mapped)
+        TRACE("Mapping page %d at %p.\n", info.entry, info.mapped);
+
+    os_unfair_lock_unlock( &shm_addrs_lock );
+
+    return ret;
+}
+
+void msync_init(void)
+{
+    struct stat st;
+    mach_port_t bootstrap_port;
+
+    if (!do_msync())
+    {
+        /* make sure the server isn't running with WINEMSYNC */
+        HANDLE handle;
+        NTSTATUS ret;
+
+        ret = create_msync( 0, &handle, 0, NULL, 0, 0 );
+        if (ret != STATUS_NOT_IMPLEMENTED)
+        {
+            ERR("Server is running with WINEMSYNC but this process is not, please enable WINEMSYNC or restart wineserver.\n");
+            exit(1);
+        }
+
+        return;
+    }
+
+    if (stat( config_dir, &st ) == -1)
+        ERR("Cannot stat %s\n", config_dir);
+
+    msync_shm_name( shm_name, st.st_ino );
+
+    if ((shm_map.fd = shm_open( shm_name, O_RDWR, 0644 )) == -1)
+    {
+        /* probably the server isn't running with WINEMSYNC, tell the user and bail */
+        if (errno == ENOENT)
+            ERR("Failed to open msync shared memory file; make sure no stale wineserver instances are running without WINEMSYNC.\n");
+        else
+            ERR("Failed to initialize shared memory: %s\n", strerror( errno ));
+        exit(1);
+    }
+
+    shm_map.pagesize = sysconf( _SC_PAGESIZE );
+
+    shm_map.addrs = calloc( 128, sizeof(shm_map.addrs[0]) );
+    shm_map.addrs_size = 128;
+
+    read_type_gates();
+    semaphore_pool_init();
+
+    /* Bootstrap mach wineserver communication */
+
+    if (task_get_special_port(mach_task_self(), TASK_BOOTSTRAP_PORT, &bootstrap_port) != KERN_SUCCESS)
+    {
+        ERR("Failed task_get_special_port\n");
+        exit(1);
+    }
+
+    if (bootstrap_look_up(bootstrap_port, (char *)msync_bootstrap_name( shm_name ),
+                          &msync_server_port) != KERN_SUCCESS)
+    {
+        ERR("Failed bootstrap_look_up for %s\n", msync_bootstrap_name( shm_name ));
+        exit(1);
+    }
+
+}
diff --git a/dlls/ntdll/unix/msync_wait.c b/dlls/ntdll/unix/msync_wait.c
new file mode 100644
index 00000000000..2db166b8dec
--- /dev/null
+++ b/dlls/ntdll/unix/msync_wait.c
@@ -0,0 +1,409 @@
+/*
+ * mach semaphore-based synchronization objects
+ *
+ * Copyright (C) 2018 Zebediah Figura
+ * Copyright (C) 2023 Marc-Aurel Zent
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include "msync_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msync);
+
+
+static inline mach_timespec_t convert_to_mach_time( LONGLONG win32_time )
+{
+    mach_timespec_t ret;
+
+    ret.tv_sec = win32_time / (ULONGLONG)TICKSPERSEC;
+    ret.tv_nsec = (win32_time % TICKSPERSEC) * 100;
+    return ret;
+}
+
+typedef struct
+{
+    mach_msg_header_t header;
+    mach_msg_body_t body;
+    mach_msg_port_descriptor_t descriptor;
+} mach_register_message_prolog_t;
+
+typedef struct
+{
+    mach_register_message_prolog_t prolog;
+    unsigned int shm_idx[MAXIMUM_WAIT_OBJECTS + 1];
+} mach_register_message_t;
+
+typedef struct
+{
+    mach_msg_header_t header;
+    unsigned int shm_idx[MAXIMUM_WAIT_OBJECTS + 1];
+} mach_unregister_message_t;
+
+
+/* Only the wait registration sends a complex (port-carrying) message. */
+static const mach_msg_bits_t msgh_bits_complex_send = MACH_MSGH_BITS_SET(
+                MACH_MSG_TYPE_COPY_SEND, 0, 0, MACH_MSGH_BITS_COMPLEX);
+
+static inline mach_msg_return_t server_register_wait( semaphore_t sem, unsigned int msgh_id,
+                                         struct msync **wait_objs, const int count )
+{
+    int i, is_mutex;
+    mach_msg_return_t mr;
+    __thread static mach_register_message_t message;
+
+    message.prolog.header.msgh_remote_port = msync_server_port;
+    message.prolog.header.msgh_bits = msgh_bits_complex_send;
+    message.prolog.header.msgh_id = msgh_id;
+
+    message.prolog.body.msgh_descriptor_count = 1;
+
+    message.prolog.descriptor.name = sem;
+    message.prolog.descriptor.disposition = MACH_MSG_TYPE_COPY_SEND;
+    message.prolog.descriptor.type = MACH_MSG_PORT_DESCRIPTOR;
+
+    for (i = 0; i < count; i++)
+    {
+        is_mutex = wait_objs[i]->type == MSYNC_MUTEX ? 1 : 0;
+        message.shm_idx[i] = wait_objs[i]->shm_idx | (is_mutex << 28);
+        __atomic_add_fetch( msync_regcount( wait_objs[i] ), 1, __ATOMIC_SEQ_CST );
+    }
+
+    message.prolog.header.msgh_size = sizeof(mach_register_message_prolog_t) +
+                                      count * sizeof(unsigned int);
+
+    mr = mach_msg2( (mach_msg_header_t *)&message, MACH_SEND_MSG, message.prolog.header.msgh_size,
+                     0, MACH_PORT_NULL, MACH_MSG_TIMEOUT_NONE, 0 );
+
+    if (mr != MACH_MSG_SUCCESS)
+        ERR("Failed to send server register wait: %#x\n", mr);
+
+    return mr;
+}
+
+/* Take one off an object's registered-waiter count, without going below zero. */
+static inline void drop_registration( struct msync *obj )
+{
+    int old_val, new_val;
+
+    do
+    {
+        old_val = __atomic_load_n( msync_regcount( obj ), __ATOMIC_SEQ_CST );
+        if (old_val <= 0) break;
+        new_val = old_val - 1;
+    } while (!__atomic_compare_exchange_n( msync_regcount( obj ), &old_val,
+                                           new_val, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ));
+}
+
+/* Undo the counts server_register_wait() bumped, for the case where the
+ * registration message never reached the server -- server_remove_wait() would
+ * be wrong to send when nothing was ever registered. */
+static inline void release_registrations( struct msync **wait_objs, const int count )
+{
+    int i;
+
+    for (i = 0; i < count; i++)
+        drop_registration( wait_objs[i] );
+}
+
+static inline void server_remove_wait( unsigned int msgh_id, struct msync **wait_objs, const int count )
+{
+    int i;
+    mach_msg_return_t mr;
+    __thread static mach_unregister_message_t message;
+
+    message.header.msgh_remote_port = msync_server_port;
+    message.header.msgh_bits = msgh_bits_send;
+    message.header.msgh_id = msgh_id;
+
+    for (i = 0; i < count; i++)
+    {
+        drop_registration( wait_objs[i] );
+        message.shm_idx[i] = wait_objs[i]->shm_idx;
+    }
+
+    message.header.msgh_size = sizeof(mach_msg_header_t) +
+                               count * sizeof(unsigned int);
+
+    mr = mach_msg2( (mach_msg_header_t *)&message, MACH_SEND_MSG, message.header.msgh_size,
+                     0, MACH_PORT_NULL, MACH_MSG_TIMEOUT_NONE, 0 );
+
+    if (mr != MACH_MSG_SUCCESS)
+        ERR("Failed to send server remove wait: %#x\n", mr);
+}
+
+static NTSTATUS destroyed_wait( ULONGLONG *end )
+{
+    if (end)
+    {
+        usleep( update_timeout( *end ) / 10 );
+        return STATUS_TIMEOUT;
+    }
+    pause();
+    return STATUS_PENDING;
+}
+
+static inline int is_destroyed( struct msync **objs, int count)
+{
+    int i;
+
+    for (i = 0; i < count; i++)
+        if (__atomic_load_n( msync_alive( objs[i] ), __ATOMIC_RELAXED ))
+            return 0;
+
+    return 1;
+}
+
+/* A system APC (e.g. APC_ASYNC_IO from a socket/file async completion) is
+ * delivered by SIGUSR1, which interrupts a msync fast-wait (-EINTR/KERN_ABORTED).
+ * The fast path can't see it (only user APCs get an shm event), so without this it
+ * loops on the spurious wakeup and the APC never runs -- the async never finalizes
+ * and the awaited object is never signaled (Steam socket I/O hangs; WINEMSYNC=0
+ * works because server_select does run system APCs). A zero-timeout interruptible
+ * server_wait runs any pending system APC, which then signals the awaited object. */
+NTSTATUS msync_run_apcs( BOOLEAN alertable )
+{
+    static const LARGE_INTEGER zero = {0};
+    NTSTATUS ret = server_wait( NULL, 0,
+                                SELECT_INTERRUPTIBLE | (alertable ? SELECT_ALERTABLE : 0), &zero );
+
+    /* A zero-timeout wait that ran a user APC still reports TIMEOUT; the caller
+     * needs to hear STATUS_USER_APC. Getting this fixup wrong at one site is a
+     * silently swallowed APC, which is why it lives here and not at each site. */
+    if (alertable && ret == STATUS_TIMEOUT) ret = STATUS_USER_APC;
+    return ret;
+}
+
+static inline NTSTATUS msync_wait_single( struct msync *wait_obj,
+                                          ULONGLONG *end, int tid )
+{
+    int ret, val;
+    void *addr = wait_obj->shm;
+    ULONGLONG ns_timeleft = 0;
+
+    do
+    {
+        val = msync_wait_value( wait_obj, tid );
+
+        if (__atomic_load_n( (int *)addr, __ATOMIC_ACQUIRE ) != val)
+            return STATUS_PENDING;
+
+        if (end)
+        {
+            ns_timeleft = update_timeout( *end ) * 100;
+            if (!ns_timeleft) return STATUS_TIMEOUT;
+        }
+        ret = __ulock_wait2( UL_COMPARE_AND_WAIT_SHARED | ULF_NO_ERRNO, addr, val, ns_timeleft, 0 );
+        if (ret == -EINTR) msync_run_apcs( FALSE );
+    } while (ret == -EINTR);
+
+    if (ret == -ETIMEDOUT)
+        return STATUS_TIMEOUT;
+
+    if (is_destroyed( &wait_obj, 1 ))
+        return destroyed_wait( end );
+
+    return STATUS_SUCCESS;
+}
+
+static inline int resize_wait_objs( struct msync **wait_objs, struct msync **objs, int count )
+{
+    int read_index, write_index = 0;
+
+    for (read_index = 0; read_index < count; read_index++)
+    {
+        if (wait_objs[read_index] &&
+            __atomic_load_n( msync_alive( wait_objs[read_index] ), __ATOMIC_RELAXED ))
+        {
+            objs[write_index] = wait_objs[read_index];
+            write_index++;
+        }
+    }
+
+    return write_index;
+}
+
+static inline int check_shm_contention( struct msync **wait_objs,
+                                        int count, int tid )
+{
+    int i;
+
+    for (i = 0; i < count; i++)
+        if (msync_ready( wait_objs[i], tid )) return 1;
+
+    return 0;
+}
+
+NTSTATUS msync_wait_multiple( struct msync **wait_objs,
+                                     int count, ULONGLONG *end, int tid )
+{
+    semaphore_t *sem;
+    kern_return_t kr;
+    mach_msg_return_t mr;
+    unsigned int msgh_id;
+    __thread static struct msync *objs[MAXIMUM_WAIT_OBJECTS + 1];
+
+    count = resize_wait_objs( wait_objs, objs, count );
+
+    if (count == 1) return msync_wait_single( objs[0], end, tid );
+    if (!count) return destroyed_wait( end );
+
+    if (check_shm_contention( objs, count, tid ))
+        return STATUS_PENDING;
+
+    sem = msync_semaphore_pool_alloc();
+    /* msgh_id carries the object count in its low 8 bits (count <=
+     * MAXIMUM_WAIT_OBJECTS + 1) and the thread id in the remaining 24. That fits
+     * because the server hands out thread ids densely and recycles them
+     * (alloc_ptid() in server/process.c: id = (index + 8) * 4 over an array of
+     * live entries), so reaching 2^24 would take ~4M simultaneously live
+     * threads. If that ever changes the truncation is silent, and a tid that
+     * aliased another thread's would make remove_sem() unregister the wrong
+     * semaphore -- a lost wakeup -- so say so once rather than never. */
+    if (tid >> 24)
+    {
+        static int warned;
+        if (!warned) { warned = 1; ERR("thread id %#x exceeds 24 bits; msync waits may be lost\n", tid); }
+    }
+    msgh_id = (tid << 8) | count;
+    mr = server_register_wait( *sem, msgh_id, objs, count );
+
+    if (mr != MACH_MSG_SUCCESS)
+    {
+        /* The os failed to send the mach message, which is either because
+         * we lost the wineserver process or the semaphore from msync_semaphore_pool_alloc
+         * is not valid...
+         * To avoid pooling in a dead port, recreate it here.
+         * Worst case, this will behave effectively like a spinlock.
+         *
+         * server_register_wait() bumps each object's registered-waiter count
+         * before it sends, so a failed send has to be undone by hand -- nothing
+         * else ever brings the count back down. */
+        release_registrations( objs, count );
+        semaphore_destroy( mach_task_self(), *sem );
+
+        if ((kr = semaphore_create( mach_task_self(), sem, SYNC_POLICY_FIFO, 0 )) != KERN_SUCCESS)
+            ERR("Cannot create semaphore: %#x %s\n", kr, mach_error_string(kr));
+        else if ((mr = server_register_wait( *sem, msgh_id, objs, count )) != MACH_MSG_SUCCESS)
+            release_registrations( objs, count );
+
+        if (mr != MACH_MSG_SUCCESS)
+        {
+            msync_semaphore_pool_free( sem );
+            return STATUS_PENDING;
+        }
+    }
+
+    /* Close the register/signal race: an object can be signaled between the
+     * check_shm_contention() above and server_register_wait() taking effect.
+     * signal_all() only wakes registered waiters (it skips the wakeup mach msg
+     * when obj->shm[3] == 0) and that msg can also race our registration on the
+     * wineserver's port -- but signal_all() sets the shm signaled-state
+     * synchronously (shared memory) *before* sending it. So re-check the shm now
+     * that we are registered; if a signal already landed, bail to re-poll rather
+     * than block forever on a wakeup that already fired. */
+    if (check_shm_contention( objs, count, tid ))
+    {
+        server_remove_wait( msgh_id, objs, count );
+        msync_semaphore_pool_free( sem );
+        return STATUS_PENDING;
+    }
+
+    do
+    {
+        if (end)
+            kr = semaphore_timedwait( *sem,
+                        convert_to_mach_time( update_timeout( *end ) ) );
+        else
+            kr = semaphore_wait( *sem );
+        if (kr == KERN_ABORTED) msync_run_apcs( FALSE );
+    } while (kr == KERN_ABORTED);
+
+    if (is_destroyed( objs, count ))
+    {
+        /* destroy_all_internal() on the server already dropped every registration
+         * for these slots and zeroed their waiter counts, so there is nothing to
+         * unregister -- and doing it anyway would decrement a slot the server may
+         * have since recycled to a different object, silently costing its waiter
+         * the wakeup. Nothing holds send rights to `sem` either, so the pool is
+         * safe to return it to. */
+        msync_semaphore_pool_free( sem );
+        return destroyed_wait( end );
+    }
+
+    /* Unregister BEFORE returning the semaphore to the pool: until the server has
+     * processed this, it still holds send rights to `sem` for every object in the
+     * set, and a signal on any of them would bump the count of a semaphore that by
+     * then belongs to a different wait. */
+    server_remove_wait( msgh_id, objs, count );
+    msync_semaphore_pool_free( sem );
+
+    switch (kr) {
+        case KERN_SUCCESS:
+            return STATUS_SUCCESS;
+        case KERN_OPERATION_TIMED_OUT:
+            if (check_shm_contention( objs, count, tid ))
+                return STATUS_PENDING;
+            return STATUS_TIMEOUT;
+        case KERN_TERMINATED:
+            return destroyed_wait( end );
+        default:
+            ERR("Unexpected kernel return code: %#x %s\n", kr, mach_error_string( kr ));
+            return STATUS_PENDING;
+    }
+}
+
+NTSTATUS msync_do_single_wait( struct msync *obj, ULONGLONG *end, BOOLEAN alertable, int tid )
+{
+    NTSTATUS status;
+    struct msync *wait_objs[2];
+    /* Resolved once: it is an out-of-line pthread_getspecific, and `pure` rather
+     * than `const`, so the compiler cannot hoist a second call past the atomics. */
+    struct ntdll_thread_data *thread_data = ntdll_get_thread_data();
+
+    wait_objs[0] = obj;
+
+    /* A NULL apc_addr means the server would not hand this thread an APC index
+     * and __msync_wait_objects() downgraded the wait; hold that here too, so a
+     * caller arriving by another route cannot dereference it. */
+    if (alertable && thread_data->msync_apc_addr)
+    {
+        struct msync apc_obj;
+        int *apc_addr = thread_data->msync_apc_addr;
+
+        msync_init_apc_obj( &apc_obj, thread_data );
+
+        if (__atomic_load_n( apc_addr, __ATOMIC_SEQ_CST ))
+            return STATUS_USER_APC;
+
+        wait_objs[1] = &apc_obj;
+
+        status = msync_wait_multiple( wait_objs, 2, end, tid );
+
+        if (__atomic_load_n( apc_addr, __ATOMIC_SEQ_CST ))
+            return STATUS_USER_APC;
+    }
+    else
+    {
+        status = msync_wait_multiple( wait_objs, 1, end, tid );
+    }
+    return status;
+}
