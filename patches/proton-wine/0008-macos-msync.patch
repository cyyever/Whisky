+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+
+#ifndef __WINE_NTDLL_MSYNC_PRIVATE_H
+#define __WINE_NTDLL_MSYNC_PRIVATE_H
+
+/* Internals shared by the msync implementation files:
+ *
+ *   msync_shm.c     shared-memory mapping, the mach semaphore pool, init
+ *   msync_obj.c     the per-handle object cache and the typed Nt* entry points
+ *   msync_wait.c    the blocking primitives (__ulock and mach-semaphore waits)
+ *   msync_select.c  the wait-set strategies built on top of them
+ *
+ * msync.h is the interface ntdll's sync.c uses; this is the one the four files
+ * above share with each other. It is self-contained apart from config.h, which
+ * has to come first in the .c file.
+ */
+
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#ifdef HAVE_SYS_STAT_H
+# include <sys/stat.h>
+#endif
+#ifdef HAVE_SYS_SYSCALL_H
+# include <sys/syscall.h>
+#endif
+#ifdef __APPLE__
+# include <mach/mach_init.h>
+# include <mach/mach_port.h>
+# include <mach/message.h>
+# include <mach/port.h>
+# include <mach/task.h>
+# include <mach/semaphore.h>
+# include <mach/mach_error.h>
+# include <servers/bootstrap.h>
+# include <os/lock.h>
+#endif
+#include <sched.h>
+#include <unistd.h>
+#include <pthread.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "wine/debug.h"
+#include "wine/server.h"
+
+#include "unix_private.h"
+#include "msync.h"
+/* shm name/layout/mapping and the wake protocol, shared with server/msync.c */
+#include "wine/msync_abi.h"
+
+#define ULF_NO_ERRNO                0x01000000
+
+/* __ulock_wait2 exists since macOS 11; we only target non-EOL macOS, so link it
+ * directly rather than dlsym'ing it with a slow Mach-semaphore fallback. */
+extern int __ulock_wait2( uint32_t operation, void *addr, uint64_t value,
+                          uint64_t timeout_ns, uint64_t value2 );
+
+/*
+ * Faster to directly do the syscall and inline everything, taken and slightly adapted
+ * from xnu/libsyscall/mach/mach_msg.c
+ */
+
+static inline mach_msg_return_t mach_msg2( mach_msg_header_t *data, uint64_t option64,
+    mach_msg_size_t send_size, mach_msg_size_t rcv_size, mach_port_t rcv_name, uint64_t timeout,
+    uint32_t priority)
+{
+    /* Route through the public mach_msg() rather than the raw mach_msg2_trap:
+     * under Rosetta the dlsym'd raw trap is invoked through an untranslated
+     * pointer and crashes. libSystem's mach_msg() is translated correctly.
+     * (priority is always 0 here, so it maps to a NULL notify port.) */
+    (void)priority;
+    /* mach_msg() takes 32-bit option/timeout; assert no lossy narrowing. */
+    assert( !(option64 >> 32) );
+    assert( timeout <= 0xffffffff );
+    return mach_msg( data, (mach_msg_option_t)option64, send_size, rcv_size,
+                     rcv_name, (mach_msg_timeout_t)timeout, MACH_PORT_NULL );
+}
+
+/* this is a lot, but running out cripples performance */
+struct msync
+{
+    void *shm;              /* pointer to shm section */
+    enum msync_type type;
+    unsigned int shm_idx;
+    unsigned int access;    /* granted (possibly generic) access mask for this handle */
+};
+
+/* Not a real msync_type: a sentinel cached for handles the server reported as
+ * having no msync shadow (server-only objects: pipes, sockets, processes, ...).
+ * It lets msync_get_object() skip the get_msync_idx round-trip on repeated waits --
+ * without it, polling a mixed wait-set (e.g. Steam's IPC pipes) issues one
+ * server round-trip per handle per poll, starving the reader. Cleared by
+ * msync_close() on handle close like any entry, so handle reuse stays correct. */
+#define MSYNC_SERVER_ONLY ((enum msync_type)0xff)
+/* It shares ->type with the real types, so it must not collide with one. Zero is
+ * the third reserved value: msync_close() zeroes ->type, and ->type doubles as
+ * the atomic claim word for a cache slot (see add_to_list). */
+C_ASSERT( MSYNC_QUEUE < 0xff );
+
+/* The shm payload of each object type. */
+struct semaphore
+{
+    int count;
+    int max;
+};
+C_ASSERT(sizeof(struct semaphore) == 8);
+
+struct event
+{
+    int signaled;
+    int unused;
+};
+C_ASSERT(sizeof(struct event) == 8);
+
+struct mutex
+{
+    int tid;
+    int count;  /* recursion count */
+};
+C_ASSERT(sizeof(struct mutex) == 8);
+
+/* The readiness word is at offset 0 in every payload. msync_ready() reads it as
+ * a bare int without knowing the type, msync_wait_single() hands the same
+ * address to __ulock_wait2(), and the wineserver's registration re-check reads
+ * it the same way -- so this is a cross-process ABI invariant, not a local
+ * convenience. Check it rather than trusting the field order above. */
+C_ASSERT( offsetof(struct semaphore, count)    == 0 );
+C_ASSERT( offsetof(struct event,     signaled) == 0 );
+C_ASSERT( offsetof(struct mutex,     tid)      == 0 );
+
+/* ---- type safety ----------------------------------------------------------
+ *
+ * obj->shm is a void * whose real type is decided by obj->type, and nothing in
+ * the type system connects the two: every payload is 8 bytes, so casting one to
+ * another is silent. A cross-type operation must answer
+ * STATUS_OBJECT_TYPE_MISMATCH, the way Windows and the wineserver path do -- not
+ * read the wrong fields, and certainly not write them (a mutex's owner tid and
+ * an event's signaled flag are the same 4 bytes). Route every cast through
+ * these predicates, and check the type at every entry point that takes a HANDLE.
+ *
+ * There is deliberately no asserting accessor to go with them. obj->type lives
+ * in the shared per-handle cache, so re-reading it to assert after the caller
+ * has branched on it just adds a window in which a concurrent close-and-reuse
+ * turns a returned status into an abort() of the whole process. The callers
+ * below each read it once and cast. */
+
+static inline int msync_type_is_semaphore( enum msync_type type )
+{
+    return type == MSYNC_SEMAPHORE;
+}
+
+static inline int msync_type_is_mutex( enum msync_type type )
+{
+    return type == MSYNC_MUTEX;
+}
+
+/* The two types a caller can create and set/reset/pulse. Narrower than
+ * msync_type_is_event(): the *_SERVER variants and the message queue are
+ * event-shaped but are not user-settable events. */
+static inline int msync_type_is_settable_event( enum msync_type type )
+{
+    return type == MSYNC_AUTO_EVENT || type == MSYNC_MANUAL_EVENT;
+}
+
+/* The rest of the shm slot, addressed from an object rather than from a bare
+ * shm pointer; the layout itself is in wine/msync_abi.h. */
+static inline int *msync_alive( const struct msync *obj )    { return msync_shm_alive( obj->shm ); }
+static inline int *msync_regcount( const struct msync *obj ) { return msync_shm_regcount( obj->shm ); }
+
+/* ---- readiness / consume / put-back: one definition per object type --------
+ *
+ * These, together with msync_wait_value() above, are the only place the
+ * semantics of an object type are encoded ON THIS SIDE, and every client wait
+ * path goes through them. There is exactly one more encoding, and it is across
+ * the process boundary so no header can share it: the wineserver's registration
+ * TOCTTOU re-check (server/msync.c, the registration branch of
+ * mach_message_pump) open-codes msync_ready() fused with !msync_alive(). Change
+ * mutex readiness here -- how `~0` abandoned is treated, say -- and that must
+ * change too, or the server registers a waiter for an object this side already
+ * considers ready, which is a lost wakeup. Keep it that way: a lost wakeup IS a
+ * disagreement between "the signaler thinks it woke everyone" and "the waiter
+ * thinks it is not ready", so a second encoding of "ready" is a second chance
+ * to disagree. */
+
+/* The value __ulock_wait2() parks on: it sleeps while the readiness word still
+ * equals this. Zero for everything level-triggered; for a mutex it is the
+ * current owner, or this thread's id when the mutex is free or abandoned --
+ * which makes the caller's pre-wait compare fail, so it re-scans and grabs the
+ * mutex instead of parking on it. */
+static inline int msync_wait_value( const struct msync *obj, int tid )
+{
+    int val;
+
+    if (obj->type != MSYNC_MUTEX) return 0;
+    val = __atomic_load_n( (const int *)obj->shm, __ATOMIC_ACQUIRE );
+    return (!val || val == ~0) ? tid : val;
+}
+
+/* The thread's pending-APC flag, dressed as an auto-event so it can join a wait
+ * set. msync_apc_addr points at that event's ->signaled, which is the event's
+ * own address -- the offsetof C_ASSERT above, not luck. */
+static inline void msync_init_apc_obj( struct msync *obj, struct ntdll_thread_data *data )
+{
+    obj->type    = MSYNC_AUTO_EVENT;
+    obj->shm     = (void *)data->msync_apc_addr;
+    obj->shm_idx = data->msync_apc_idx;
+}
+
+/* Peek: is this object ready for `tid` right now? No side effects. */
+static inline int msync_ready( const struct msync *obj, int tid )
+{
+    int val = __atomic_load_n( (const int *)obj->shm, __ATOMIC_SEQ_CST );
+
+    if (obj->type == MSYNC_MUTEX)
+        return val == 0 || val == ~0 || val == tid;
+
+    return val != 0;
+}
+
+/* Consume: try to take ownership / one count, atomically. The switch below is
+ * itself the type check, so the payload casts here are bare -- the asserting
+ * accessors are for the handle-taking entry points, which have no such proof.
+ *   STATUS_SUCCESS   - taken
+ *   STATUS_ABANDONED - taken, previous owner died without releasing (mutex only)
+ *   STATUS_PENDING   - not available
+ * Manual-reset events and the message queue are level-triggered, so "taking"
+ * them consumes nothing and leaves them signaled. */
+static inline NTSTATUS msync_try_grab( struct msync *obj, int tid )
+{
+    switch (obj->type)
+    {
+    case MSYNC_SEMAPHORE:
+    {
+        struct semaphore *semaphore = obj->shm;
+        int current = __atomic_load_n( &semaphore->count, __ATOMIC_ACQUIRE );
+
+        if (current && __atomic_compare_exchange_n( &semaphore->count, &current,
+                current - 1, 0, __ATOMIC_RELEASE, __ATOMIC_RELAXED ))
+            return STATUS_SUCCESS;
+        return STATUS_PENDING;
+    }
+    case MSYNC_MUTEX:
+    {
+        struct mutex *mutex = obj->shm;
+        int owner = 0;
+
+        if (__atomic_load_n( &mutex->tid, __ATOMIC_ACQUIRE ) == tid)
+        {
+            mutex->count++;
+            return STATUS_SUCCESS;
+        }
+        if (__atomic_compare_exchange_n( &mutex->tid, &owner, tid, 0,
+                __ATOMIC_ACQ_REL, __ATOMIC_RELAXED ))
+        {
+            mutex->count = 1;
+            return STATUS_SUCCESS;
+        }
+        /* the failed CAS left the observed owner in `owner` */
+        if (owner == ~0 && __atomic_compare_exchange_n( &mutex->tid, &owner, tid, 0,
+                __ATOMIC_ACQ_REL, __ATOMIC_RELAXED ))
+        {
+            mutex->count = 1;
+            return STATUS_ABANDONED;
+        }
+        return STATUS_PENDING;
+    }
+    case MSYNC_AUTO_EVENT:
+    case MSYNC_AUTO_SERVER:
+    {
+        struct event *event = obj->shm;
+        int signaled = 1;
+
+        if (__atomic_compare_exchange_n( &event->signaled, &signaled, 0, 0,
+                __ATOMIC_ACQ_REL, __ATOMIC_RELAXED ))
+            return STATUS_SUCCESS;
+        return STATUS_PENDING;
+    }
+    case MSYNC_MANUAL_EVENT:
+    case MSYNC_MANUAL_SERVER:
+    case MSYNC_QUEUE:
+    {
+        struct event *event = obj->shm;
+
+        if (__atomic_load_n( &event->signaled, __ATOMIC_ACQUIRE ))
+            return STATUS_SUCCESS;
+        return STATUS_PENDING;
+    }
+    default:
+        /* Not a type we know how to consume. Distinct from STATUS_PENDING so a
+         * caller that has the handle around can report it; the mixed-wait scan
+         * just treats it as "not ready", which is what it did before. */
+        return STATUS_OBJECT_TYPE_MISMATCH;
+    }
+}
+
+/* Put back exactly what msync_try_grab() took, for the wait-all path when a
+ * later object in the set turns out not to be available after all. */
+static inline void msync_ungrab( struct msync *obj )
+{
+    switch (obj->type)
+    {
+    case MSYNC_MUTEX:
+    {
+        struct mutex *mutex = obj->shm;
+
+        /* A recursive acquire only bumped the count; a fresh one took ownership.
+         * HACK: an abandoned mutex is not restored to the abandoned state, but
+         * fixing that is probably more trouble than it's worth. */
+        if (mutex->count > 1)
+            mutex->count--;
+        else
+        {
+            mutex->count = 0;
+            __atomic_store_n( &mutex->tid, 0, __ATOMIC_SEQ_CST );
+        }
+        break;
+    }
+    case MSYNC_SEMAPHORE:
+    {
+        struct semaphore *semaphore = obj->shm;
+        __atomic_fetch_add( &semaphore->count, 1, __ATOMIC_SEQ_CST );
+        break;
+    }
+    case MSYNC_AUTO_EVENT:
+    case MSYNC_AUTO_SERVER:
+    {
+        struct event *event = obj->shm;
+        __atomic_store_n( &event->signaled, 1, __ATOMIC_SEQ_CST );
+        break;
+    }
+    default:
+        break;  /* level-triggered: nothing was consumed */
+    }
+}
+
+
+static const mach_msg_bits_t msgh_bits_send = MACH_MSGH_BITS_REMOTE(MACH_MSG_TYPE_COPY_SEND);
+
+/* ---- msync_shm.c ---------------------------------------------------------- */
+extern void *msync_get_shm( unsigned int idx );
+extern int msync_type_enabled( enum msync_type type );
+extern semaphore_t *msync_semaphore_pool_alloc(void);
+extern void msync_semaphore_pool_free( semaphore_t *sem );
+extern mach_port_t msync_server_port;
+
+/* ---- msync_obj.c ---------------------------------------------------------- */
+extern NTSTATUS msync_get_object( HANDLE handle, struct msync **obj );
+/* Unprefixed, unlike its neighbours: SERVER_START_REQ( create_msync ) builds the
+ * request/reply struct names from this identifier. */
+extern NTSTATUS create_msync( enum msync_type type, HANDLE *handle, ACCESS_MASK access,
+                              const OBJECT_ATTRIBUTES *attr, int low, int high );
+
+/* ---- msync_wait.c --------------------------------------------------------- */
+extern NTSTATUS msync_run_apcs( BOOLEAN alertable );
+extern NTSTATUS msync_wait_multiple( struct msync **wait_objs, int count,
+                                     ULONGLONG *end, int tid );
+extern NTSTATUS msync_do_single_wait( struct msync *obj, ULONGLONG *end,
+                                BOOLEAN alertable, int tid );
+
+#endif /* __WINE_NTDLL_MSYNC_PRIVATE_H */
