diff --git a/dlls/ntdll/unix/msync_obj.c b/dlls/ntdll/unix/msync_obj.c
new file mode 100644
index 00000000000..e98f50178b9
--- /dev/null
+++ b/dlls/ntdll/unix/msync_obj.c
@@ -0,0 +1,567 @@
+/*
+ * mach semaphore-based synchronization objects
+ *
+ * Copyright (C) 2018 Zebediah Figura
+ * Copyright (C) 2023 Marc-Aurel Zent
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include "msync_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msync);
+
+/* We'd like lookup to be fast. To that end, we use a static list indexed by handle.
+ * This is copied and adapted from the fd cache code. */
+
+
+/* A power of two on purpose: handle_to_index() divides and mods by this on every
+ * lookup, and struct msync is 24 bytes, so the natural 65536/sizeof() would be
+ * 2730 and cost two 64-bit divq per get_object() in an unoptimised build.
+ * 2048 * MSYNC_LIST_ENTRIES still covers 524288 handles. (fsync.c keeps the
+ * upstream form; this is a deliberate local divergence.) */
+#define MSYNC_LIST_BLOCK_SIZE  2048
+#define MSYNC_LIST_ENTRIES     256
+
+static struct msync *msync_list[MSYNC_LIST_ENTRIES];
+static struct msync msync_list_initial_block[MSYNC_LIST_BLOCK_SIZE];
+
+static inline UINT_PTR handle_to_index( HANDLE handle, UINT_PTR *entry )
+{
+    UINT_PTR idx = (((UINT_PTR)handle) >> 2) - 1;
+    *entry = idx / MSYNC_LIST_BLOCK_SIZE;
+    return idx % MSYNC_LIST_BLOCK_SIZE;
+}
+
+static struct msync *add_to_list( HANDLE handle, enum msync_type type, unsigned int shm_idx,
+                                  unsigned int access )
+{
+    UINT_PTR entry, idx = handle_to_index( handle, &entry );
+    void *shm = (type == MSYNC_SERVER_ONLY) ? NULL : msync_get_shm( shm_idx );
+
+    if (entry >= MSYNC_LIST_ENTRIES)
+    {
+        FIXME( "too many allocated handles, not caching %p\n", handle );
+        return NULL;
+    }
+
+    if (!msync_list[entry])  /* do we need to allocate a new block of entries? */
+    {
+        if (!entry) msync_list[0] = msync_list_initial_block;
+        else
+        {
+            void *ptr = anon_mmap_alloc( MSYNC_LIST_BLOCK_SIZE * sizeof(struct msync),
+                                         PROT_READ | PROT_WRITE );
+            if (ptr == MAP_FAILED) return NULL;
+            msync_list[entry] = ptr;
+        }
+    }
+
+    if (!__sync_val_compare_and_swap((int *)&msync_list[entry][idx].type, 0, type ))
+    {
+        msync_list[entry][idx].shm = shm;
+        msync_list[entry][idx].shm_idx = shm_idx;
+        msync_list[entry][idx].access = access;
+    }
+
+    return &msync_list[entry][idx];
+}
+
+static struct msync *get_cached_object( HANDLE handle )
+{
+    UINT_PTR entry, idx = handle_to_index( handle, &entry );
+
+    if (entry >= MSYNC_LIST_ENTRIES || !msync_list[entry]) return NULL;
+    if (!msync_list[entry][idx].type) return NULL;
+
+    return &msync_list[entry][idx];
+}
+
+/* Gets an object. This is either a proper msync object (i.e. an event,
+ * semaphore, etc. created using create_msync) or a generic synchronizable
+ * server-side object which the server will signal (e.g. a process, thread,
+ * message queue, etc.) */
+NTSTATUS msync_get_object( HANDLE handle, struct msync **obj )
+{
+    NTSTATUS ret = STATUS_SUCCESS;
+    unsigned int shm_idx = 0;
+    enum msync_type type;
+
+    if ((*obj = get_cached_object( handle )))
+    {
+        if ((*obj)->type == MSYNC_SERVER_ONLY) { *obj = NULL; return STATUS_NOT_IMPLEMENTED; }
+        return STATUS_SUCCESS;
+    }
+
+    if ((INT_PTR)handle < 0)
+    {
+        /* We can deal with pseudo-handles, but it's just easier this way */
+        return STATUS_NOT_IMPLEMENTED;
+    }
+
+    /* We need to try grabbing it from the server. */
+    SERVER_START_REQ( get_msync_idx )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        if (!(ret = wine_server_call( req )))
+        {
+            shm_idx = reply->shm_idx;
+            type    = reply->type;
+        }
+    }
+    SERVER_END_REQ;
+
+    if (ret)
+    {
+        /* A server-only object (no msync shadow): remember it so future waits
+         * don't re-query the server for the same handle. */
+        if (ret == STATUS_NOT_IMPLEMENTED)
+            add_to_list( handle, MSYNC_SERVER_ONLY, 0, 0 );
+        else
+            WARN("Failed to retrieve shm index for handle %p, status %#x.\n", handle, ret);
+        *obj = NULL;
+        return ret;
+    }
+
+    TRACE("Got shm index %d for handle %p.\n", shm_idx, handle);
+    /* This resolution path is only reached for handles not opened through the
+     * msync create/open wrappers (e.g. duplicated handles). The server's
+     * get_msync_idx handler already required SYNCHRONIZE to hand us the shm idx,
+     * so this handle can be waited on; record full access (its exact granted
+     * mask is unknown here, but SYNCHRONIZE is guaranteed present). */
+    /* Not STATUS_NOT_IMPLEMENTED when the cache cannot be extended: that would
+     * route a real msync object onto server_wait, whose no_add_queue sync
+     * answers STATUS_OBJECT_TYPE_MISMATCH in a busy-return storm -- the failure
+     * the SERVER_ONLY invalidation below exists to prevent. */
+    if (!(*obj = add_to_list( handle, type, shm_idx, ~0u ))) return STATUS_NO_MEMORY;
+    return ret;
+}
+
+NTSTATUS msync_close( HANDLE handle )
+{
+    UINT_PTR entry, idx = handle_to_index( handle, &entry );
+
+    TRACE("%p.\n", handle);
+
+    if (entry < MSYNC_LIST_ENTRIES && msync_list[entry])
+    {
+        if (__atomic_exchange_n( &msync_list[entry][idx].type, 0, __ATOMIC_SEQ_CST ))
+            return STATUS_SUCCESS;
+    }
+
+    return STATUS_INVALID_HANDLE;
+}
+
+/* Drop a stale "server-only" negative-cache entry so the next msync_get_object()
+ * re-queries the server. A handle cached as MSYNC_SERVER_ONLY can go stale when
+ * the server-only object it named is closed server-side (bypassing msync_close)
+ * and its handle number is reused for an msync object; the stale entry then
+ * forces the new msync object onto server_wait, whose no_add_queue sync returns
+ * STATUS_OBJECT_TYPE_MISMATCH -> a busy-return storm. Returns TRUE if such an
+ * entry was dropped (so the caller knows a retry via msync may now succeed). */
+BOOL msync_invalidate_server_only( HANDLE handle )
+{
+    UINT_PTR entry, idx = handle_to_index( handle, &entry );
+    int type;
+
+    if (entry >= MSYNC_LIST_ENTRIES || !msync_list[entry]) return FALSE;
+    type = __atomic_load_n( (int *)&msync_list[entry][idx].type, __ATOMIC_SEQ_CST );
+    if (type != (int)MSYNC_SERVER_ONLY) return FALSE;
+    /* only clear if still SERVER_ONLY (don't clobber a concurrent reclassify) */
+    return __sync_bool_compare_and_swap( (int *)&msync_list[entry][idx].type,
+                                         (int)MSYNC_SERVER_ONLY, 0 );
+}
+
+NTSTATUS create_msync( enum msync_type type, HANDLE *handle,
+    ACCESS_MASK access, const OBJECT_ATTRIBUTES *attr, int low, int high )
+{
+    NTSTATUS ret;
+    data_size_t len;
+    struct object_attributes *objattr;
+    unsigned int shm_idx;
+
+    if ((ret = alloc_object_attributes( attr, &objattr, &len ))) return ret;
+
+    SERVER_START_REQ( create_msync )
+    {
+        req->access = access;
+        req->low    = low;
+        req->high   = high;
+        req->type   = type;
+        wine_server_add_data( req, objattr, len );
+        ret = wine_server_call( req );
+        if (!ret || ret == STATUS_OBJECT_NAME_EXISTS)
+        {
+            *handle = wine_server_ptr_handle( reply->handle );
+            shm_idx = reply->shm_idx;
+            type    = reply->type;
+        }
+    }
+    SERVER_END_REQ;
+
+    if (!ret || ret == STATUS_OBJECT_NAME_EXISTS)
+    {
+        add_to_list( *handle, type, shm_idx, access );
+        TRACE("-> handle %p, shm index %d.\n", *handle, shm_idx);
+    }
+
+    free( objattr );
+    return ret;
+}
+
+static NTSTATUS open_msync( enum msync_type type, HANDLE *handle,
+    ACCESS_MASK access, const OBJECT_ATTRIBUTES *attr )
+{
+    NTSTATUS ret;
+    unsigned int shm_idx;
+
+    SERVER_START_REQ( open_msync )
+    {
+        req->access     = access;
+        req->attributes = attr->Attributes;
+        req->rootdir    = wine_server_obj_handle( attr->RootDirectory );
+        req->type       = type;
+        if (attr->ObjectName)
+            wine_server_add_data( req, attr->ObjectName->Buffer, attr->ObjectName->Length );
+        if (!(ret = wine_server_call( req )))
+        {
+            *handle = wine_server_ptr_handle( reply->handle );
+            type = reply->type;
+            shm_idx = reply->shm_idx;
+        }
+    }
+    SERVER_END_REQ;
+
+    if (!ret)
+    {
+        add_to_list( *handle, type, shm_idx, access );
+        TRACE("-> handle %p, shm index %u.\n", *handle, shm_idx);
+    }
+    return ret;
+}
+
+/* Fetch a handle's object together with its typed payload, refusing the handle
+ * unless it names the expected type. Windows and the wineserver both answer
+ * STATUS_OBJECT_TYPE_MISMATCH for a cross-type operation (NtReleaseSemaphore on
+ * a mutex, NtResetEvent on a semaphore, ...). Going through these means the
+ * payload is unreachable without the check, so a new entry point cannot forget
+ * it -- and forgetting it is not a wrong status but a wrong write: a mutex's
+ * owner tid and an event's signaled flag are the same four bytes. */
+static NTSTATUS get_semaphore_object( HANDLE handle, struct msync **obj, struct semaphore **out )
+{
+    NTSTATUS ret;
+
+    if ((ret = msync_get_object( handle, obj ))) return ret;
+    if (!msync_type_is_semaphore( (*obj)->type )) return STATUS_OBJECT_TYPE_MISMATCH;
+    *out = (*obj)->shm;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS get_mutex_object( HANDLE handle, struct msync **obj, struct mutex **out )
+{
+    NTSTATUS ret;
+
+    if ((ret = msync_get_object( handle, obj ))) return ret;
+    if (!msync_type_is_mutex( (*obj)->type )) return STATUS_OBJECT_TYPE_MISMATCH;
+    *out = (*obj)->shm;
+    return STATUS_SUCCESS;
+}
+
+/* Settable events only: the *_SERVER variants and the message queue share the
+ * payload layout but are not things NtSetEvent and friends may touch. */
+static NTSTATUS get_event_object( HANDLE handle, struct msync **obj, struct event **out )
+{
+    NTSTATUS ret;
+
+    if ((ret = msync_get_object( handle, obj ))) return ret;
+    if (!msync_type_is_settable_event( (*obj)->type )) return STATUS_OBJECT_TYPE_MISMATCH;
+    *out = (*obj)->shm;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_create_semaphore( HANDLE *handle, ACCESS_MASK access,
+    const OBJECT_ATTRIBUTES *attr, LONG initial, LONG max )
+{
+    TRACE("name %s, initial %d, max %d.\n",
+        attr ? debugstr_us(attr->ObjectName) : "<no name>", initial, max);
+
+    if (!msync_type_enabled( MSYNC_SEMAPHORE )) return STATUS_NOT_IMPLEMENTED;
+
+    return create_msync( MSYNC_SEMAPHORE, handle, access, attr, initial, max );
+}
+
+NTSTATUS msync_open_semaphore( HANDLE *handle, ACCESS_MASK access,
+    const OBJECT_ATTRIBUTES *attr )
+{
+    NTSTATUS ret;
+
+    TRACE("name %s.\n", debugstr_us(attr->ObjectName));
+
+    ret = open_msync( MSYNC_SEMAPHORE, handle, access, attr );
+    if (ret == STATUS_OBJECT_TYPE_MISMATCH) return STATUS_NOT_IMPLEMENTED;
+    return ret;
+}
+
+static inline void signal_all( struct msync *obj )
+{
+    /* Thread-local, unlike the server's single copy: any thread can signal. */
+    __thread static mach_msg_header_t send_header;
+
+    if (!msync_signal_wake( &send_header, obj->shm_idx, obj->shm, msync_server_port ))
+        return;
+
+    mach_msg2( &send_header, MACH_SEND_MSG, send_header.msgh_size, 0,
+               MACH_PORT_NULL, MACH_MSG_TIMEOUT_NONE, 0 );
+}
+
+NTSTATUS msync_release_semaphore( HANDLE handle, ULONG count, ULONG *prev )
+{
+    struct msync *obj;
+    struct semaphore *semaphore;
+    ULONG current;
+    NTSTATUS ret;
+
+    TRACE("%p, %d, %p.\n", handle, count, prev);
+
+    if ((ret = get_semaphore_object( handle, &obj, &semaphore ))) return ret;
+
+    do
+    {
+        current = semaphore->count;
+        if (count + current > semaphore->max)
+            return STATUS_SEMAPHORE_LIMIT_EXCEEDED;
+    } while (__sync_val_compare_and_swap( &semaphore->count, current, count + current ) != current);
+
+    if (prev) *prev = current;
+
+    signal_all( obj );
+
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_query_semaphore( HANDLE handle, void *info, ULONG *ret_len )
+{
+    struct msync *obj;
+    struct semaphore *semaphore;
+    SEMAPHORE_BASIC_INFORMATION *out = info;
+    NTSTATUS ret;
+
+    TRACE("handle %p, info %p, ret_len %p.\n", handle, info, ret_len);
+
+    if ((ret = get_semaphore_object( handle, &obj, &semaphore ))) return ret;
+
+    out->CurrentCount = semaphore->count;
+    out->MaximumCount = semaphore->max;
+    if (ret_len) *ret_len = sizeof(*out);
+
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_create_event( HANDLE *handle, ACCESS_MASK access,
+    const OBJECT_ATTRIBUTES *attr, EVENT_TYPE event_type, BOOLEAN initial )
+{
+    enum msync_type type = (event_type == SynchronizationEvent ? MSYNC_AUTO_EVENT : MSYNC_MANUAL_EVENT);
+
+    if (!msync_type_enabled( type )) return STATUS_NOT_IMPLEMENTED;
+
+    TRACE("name %s, %s-reset, initial %d.\n",
+        attr ? debugstr_us(attr->ObjectName) : "<no name>",
+        event_type == NotificationEvent ? "manual" : "auto", initial);
+
+    return create_msync( type, handle, access, attr, initial, 0xdeadbeef );
+}
+
+NTSTATUS msync_open_event( HANDLE *handle, ACCESS_MASK access,
+    const OBJECT_ATTRIBUTES *attr )
+{
+    NTSTATUS ret;
+
+    TRACE("name %s.\n", debugstr_us(attr->ObjectName));
+
+    ret = open_msync( MSYNC_AUTO_EVENT, handle, access, attr );
+    /* Open-by-name can't know auto vs manual up front. If the named event was
+     * created as a SERVER object (its type routed off msync), the msync open
+     * reports a type mismatch -- translate to NOT_IMPLEMENTED so NtOpenEvent
+     * falls through to the server open_event and resolves it correctly. */
+    if (ret == STATUS_OBJECT_TYPE_MISMATCH) return STATUS_NOT_IMPLEMENTED;
+    return ret;
+}
+
+NTSTATUS msync_set_event( HANDLE handle, LONG *prev )
+{
+    struct event *event;
+    struct msync *obj;
+    LONG current;
+    NTSTATUS ret;
+
+    TRACE("%p.\n", handle);
+
+    if ((ret = get_event_object( handle, &obj, &event ))) return ret;
+
+    if (!(current = __atomic_exchange_n( &event->signaled, 1, __ATOMIC_SEQ_CST )))
+        signal_all( obj );
+
+    if (prev) *prev = current;
+
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_reset_event( HANDLE handle, LONG *prev )
+{
+    struct event *event;
+    struct msync *obj;
+    LONG current;
+    NTSTATUS ret;
+
+    TRACE("%p.\n", handle);
+
+    if ((ret = get_event_object( handle, &obj, &event ))) return ret;
+
+    current = __atomic_exchange_n( &event->signaled, 0, __ATOMIC_SEQ_CST );
+
+    if (prev) *prev = current;
+
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_pulse_event( HANDLE handle, LONG *prev )
+{
+    struct event *event;
+    struct msync *obj;
+    NTSTATUS ret;
+    LONG current;
+
+    TRACE("%p.\n", handle);
+
+    /* If the handle can't be resolved as an msync object (e.g. it names a
+     * server-only object such as a keyed event, or lacks the SYNCHRONIZE access
+     * that get_msync_idx demands), fall through to the server so it can apply the
+     * correct per-op semantics -- NtPulseEvent on a non-event must yield
+     * STATUS_OBJECT_TYPE_MISMATCH, not the raw STATUS_ACCESS_DENIED msync would
+     * otherwise surface (ntdll sync test:338). A wrong *type*, though, is a
+     * mismatch that msync can answer itself. */
+    if ((ret = get_event_object( handle, &obj, &event )))
+        return ret == STATUS_OBJECT_TYPE_MISMATCH ? ret : STATUS_NOT_IMPLEMENTED;
+
+    /* This isn't really correct; an application could miss the write.
+     * Unfortunately we can't really do much better. Fortunately this is rarely
+     * used (and publicly deprecated). */
+    if (!(current = __atomic_exchange_n( &event->signaled, 1, __ATOMIC_SEQ_CST )))
+        signal_all( obj );
+
+    /* Try to give other threads a chance to wake up. Hopefully erring on this
+     * side is the better thing to do... */
+    sched_yield();
+
+    __atomic_store_n( &event->signaled, 0, __ATOMIC_SEQ_CST );
+
+    if (prev) *prev = current;
+
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_query_event( HANDLE handle, void *info, ULONG *ret_len )
+{
+    struct event *event;
+    struct msync *obj;
+    EVENT_BASIC_INFORMATION *out = info;
+    NTSTATUS ret;
+
+    TRACE("handle %p, info %p, ret_len %p.\n", handle, info, ret_len);
+
+    if ((ret = get_event_object( handle, &obj, &event ))) return ret;
+
+    out->EventState = event->signaled;
+    out->EventType = (obj->type == MSYNC_AUTO_EVENT ? SynchronizationEvent : NotificationEvent);
+    if (ret_len) *ret_len = sizeof(*out);
+
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_create_mutex( HANDLE *handle, ACCESS_MASK access,
+    const OBJECT_ATTRIBUTES *attr, BOOLEAN initial )
+{
+    TRACE("name %s, initial %d.\n",
+        attr ? debugstr_us(attr->ObjectName) : "<no name>", initial);
+
+    if (!msync_type_enabled( MSYNC_MUTEX )) return STATUS_NOT_IMPLEMENTED;
+
+    return create_msync( MSYNC_MUTEX, handle, access, attr,
+        initial ? GetCurrentThreadId() : 0, initial ? 1 : 0 );
+}
+
+NTSTATUS msync_open_mutex( HANDLE *handle, ACCESS_MASK access,
+    const OBJECT_ATTRIBUTES *attr )
+{
+    NTSTATUS ret;
+
+    TRACE("name %s.\n", debugstr_us(attr->ObjectName));
+
+    ret = open_msync( MSYNC_MUTEX, handle, access, attr );
+    if (ret == STATUS_OBJECT_TYPE_MISMATCH) return STATUS_NOT_IMPLEMENTED;
+    return ret;
+}
+
+NTSTATUS msync_release_mutex( HANDLE handle, LONG *prev )
+{
+    struct mutex *mutex;
+    struct msync *obj;
+    NTSTATUS ret;
+
+    TRACE("%p, %p.\n", handle, prev);
+
+    if ((ret = get_mutex_object( handle, &obj, &mutex ))) return ret;
+
+    if (mutex->tid != GetCurrentThreadId()) return STATUS_MUTANT_NOT_OWNED;
+
+    /* Return the Windows signal-state (1 - recursion), matching query_mutex's
+     * CurrentCount and the server path (NtReleaseMutant does 1 - reply->prev_count
+     * for server mutexes). Returning the raw recursion count here made
+     * NtReleaseMutant report the wrong previous count (ntdll/kernel32 sync tests). */
+    if (prev) *prev = 1 - mutex->count;
+
+    if (!--mutex->count)
+    {
+        __atomic_store_n( &mutex->tid, 0, __ATOMIC_SEQ_CST );
+        signal_all( obj );
+    }
+
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_query_mutex( HANDLE handle, void *info, ULONG *ret_len )
+{
+    struct msync *obj;
+    struct mutex *mutex;
+    MUTANT_BASIC_INFORMATION *out = info;
+    NTSTATUS ret;
+
+    TRACE("handle %p, info %p, ret_len %p.\n", handle, info, ret_len);
+
+    if ((ret = get_mutex_object( handle, &obj, &mutex ))) return ret;
+
+    out->CurrentCount = 1 - mutex->count;
+    out->OwnedByCaller = (mutex->tid == GetCurrentThreadId());
+    out->AbandonedState = (mutex->tid == ~0);
+    if (ret_len) *ret_len = sizeof(*out);
+
+    return STATUS_SUCCESS;
+}
