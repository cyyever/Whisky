+/* mach_semaphore_map is indexed by raw pointer arithmetic and get_shm() will
+ * grow its table and mmap any offset you name, so an index must be checked
+ * before either. Most arrive off the receive port, which is published through
+ * the bootstrap server -- anything in the session can send to it, so treat every
+ * field of a message as hostile. The check lives with the tables rather than at
+ * the message boundary so a future caller cannot forget it. 0 is "no shm". */
+static inline int valid_shm_idx( unsigned int idx )
+{
+    return idx && idx < MAX_INDEX;
+}
+
+static inline void add_sem( unsigned int shm_idx, semaphore_t sem, int tid )
+{
+    struct sem_node *new_node;
+    struct sem_list *list;
+
+    if (!valid_shm_idx( shm_idx )) return;
+
+    list = mach_semaphore_map + shm_idx;
+    new_node = pool_alloc();
+    new_node->sem = sem;
+    new_node->tid = tid;
+
+    new_node->next = list->head;
+    list->head = new_node;
+}
+
+/* Drop every registration this thread holds on shm_idx, not just the first.
+ * A thread can only be inside one wait at a time, so one node is the normal
+ * case, but the client can name the same object twice in a single wait set and
+ * nothing rejects it. Removing all of them makes this idempotent, which is what
+ * keeps the tid match safe: a node left behind would be indistinguishable from
+ * the thread's next registration, and signalling it would wake the wrong wait. */
+static inline void remove_sem( unsigned int shm_idx, int tid )
+{
+    struct sem_node *current, *next, *prev = NULL;
+    struct sem_list *list;
+
+    if (!valid_shm_idx( shm_idx )) return;
+
+    list = mach_semaphore_map + shm_idx;
+    current = list->head;
+    while (current != NULL)
+    {
+        next = current->next;
+        if (current->tid == tid)
+        {
+            if (prev == NULL)
+                list->head = next;
+            else
+                prev->next = next;
+            pool_free(current);
+        }
+        else prev = current;
+        current = next;
+    }
+}
+
+static void *get_shm( unsigned int idx );
+
+/* Local spellings of the shm slot accessors; the layout is in wine/msync_abi.h. */
+static inline int *msync_alive( void *shm )    { return msync_shm_alive( shm ); }
+static inline int *msync_regcount( void *shm ) { return msync_shm_regcount( shm ); }
+
+/* get_shm() for an index that has not been validated yet. */
+static inline void *get_valid_shm( unsigned int idx )
+{
+    return valid_shm_idx( idx ) ? get_shm( idx ) : NULL;
+}
+
+static inline void destroy_all_internal( unsigned int shm_idx )
+{
+    struct sem_node *current, *temp;
+    struct sem_list *list;
+    int *shm;
+
+    if (!valid_shm_idx( shm_idx )) return;
+
+    list = mach_semaphore_map + shm_idx;
+    shm = get_shm( shm_idx );
+
+    if (shm)  /* NULL if its page could not be mapped; the sem list still needs freeing */
+    {
+        __atomic_store_n( msync_alive( shm ), 0, __ATOMIC_SEQ_CST );
+        __atomic_store_n( msync_regcount( shm ), 0, __ATOMIC_SEQ_CST );
+        __ulock_wake( UL_COMPARE_AND_WAIT_SHARED | ULF_WAKE_ALL, (void *)shm, 0 );
+    }
+    current = list->head;
+    list->head = NULL;
+
+    while (current)
+    {
+        semaphore_destroy( mach_task_self(), current->sem );
+        temp = current;
+        current = current->next;
+        pool_free(temp);
+    }
+}
+
+static inline void signal_all_internal( unsigned int shm_idx )
+{
+    struct sem_node *current, *temp;
+    struct sem_list *list;
+
+    if (!valid_shm_idx( shm_idx )) return;
+
+    list = mach_semaphore_map + shm_idx;
+    current = list->head;
+    list->head = NULL;
+
+    while (current)
+    {
+        semaphore_signal( current->sem );
+        semaphore_destroy( mach_task_self(), current->sem );
+        temp = current;
+        current = current->next;
+        pool_free(temp);
+    }
+}
+
+/* ---- the mach wire format -------------------------------------------------
+ *
+ * Everything the pump receives is one of two message families, told apart by
+ * size, and msgh_id is packed differently in each. The client half of the
+ * encoding lives in dlls/ntdll/unix/msync_wait.c (register/unregister) and
+ * msync_obj.c (the header-only signal); both sides must agree.
+ *
+ * Header-only (msgh_size == sizeof(mach_msg_header_t)) -- signal or destroy an
+ * index. No body, the whole payload is the id:
+ *
+ *     msgh_id = shm_idx | (destroy ? 1 << 28 : 0)
+ *
+ * shm_idx is at most 28 bits (MAX_INDEX), which is what leaves bit 28 free.
+ * Encoded by signal_all() / destroy_all(), decoded by take_flag_bit28().
+ *
+ * Register / unregister -- a body of shm_idx entries follows the header, and a
+ * complex message additionally carries the waiting thread's mach semaphore send
+ * right (complex == register, plain == unregister):
+ *
+ *     msgh_id    = (tid << 8) | count
+ *     shm_idx[i] = index | (is_mutex ? 1 << 28 : 0)   -- register only
+ *
+ * count is bounded by MAXIMUM_WAIT_OBJECTS + 1 so it fits in 8 bits. Decoded by
+ * decode_msgh_id(); the per-entry mutex bit, again by take_flag_bit28(), which
+ * is why that helper is called on two unrelated fields. The bit is needed
+ * because the message carries no type and the pump must redo the client's
+ * readiness check, which differs for a mutex. Unregister has no such check to
+ * redo, so server_remove_wait() sends the index bare and the pump does not
+ * strip anything.
+ *
+ * None of it is trusted -- see valid_shm_idx().
+ *
+ * The server sends its own signal/destroy messages through the same port rather
+ * than touching mach_semaphore_map directly: the port's ordering is what gives
+ * them sequential consistency against client register/unregister.
+ */
+static inline mach_msg_return_t destroy_all( unsigned int shm_idx )
+{
+    static mach_msg_header_t send_header;
+    send_header.msgh_bits = MACH_MSGH_BITS_REMOTE(MACH_MSG_TYPE_COPY_SEND);
+    send_header.msgh_id = shm_idx | (1 << 28);
+    send_header.msgh_size = sizeof(send_header);
+    send_header.msgh_remote_port = receive_port;
+
+    return mach_msg2( &send_header, MACH_SEND_MSG, send_header.msgh_size,
+                0, MACH_PORT_NULL, MACH_MSG_TIMEOUT_NONE, 0);
+}
+
+static inline mach_msg_return_t signal_all( unsigned int shm_idx, int *shm )
+{
+    /* One shared copy, unlike the client's thread-local one: only the main
+     * server thread signals. */
+    static mach_msg_header_t send_header;
+
+    if (!msync_signal_wake( &send_header, shm_idx, shm, receive_port ))
+        return MACH_MSG_SUCCESS;
+
+    return mach_msg2( &send_header, MACH_SEND_MSG, send_header.msgh_size,
+                0, MACH_PORT_NULL, MACH_MSG_TIMEOUT_NONE, 0 );
+}
+
+typedef struct
+{
+    mach_msg_header_t header;
+    mach_msg_body_t body;
+    mach_msg_port_descriptor_t descriptor;
+    unsigned int shm_idx[MAXIMUM_WAIT_OBJECTS + 1];
+    mach_msg_trailer_t trailer;
+} mach_register_message_t;
+
+typedef struct
+{
+    mach_msg_header_t header;
+    unsigned int shm_idx[MAXIMUM_WAIT_OBJECTS + 1];
+    mach_msg_trailer_t trailer;
+} mach_unregister_message_t;
+
+static inline mach_msg_return_t receive_mach_msg( mach_register_message_t *buffer )
+{
+    return mach_msg2( (mach_msg_header_t *)buffer, MACH_RCV_MSG, 0,
+            sizeof(*buffer), receive_port, MACH_MSG_TIMEOUT_NONE, 0 );
+}
+
+static inline void decode_msgh_id( unsigned int msgh_id, unsigned int *tid, unsigned int *count )
+{
+    *tid = msgh_id >> 8;
+    *count = msgh_id & 0xFF;
+}
+
+/* Take the flag out of a packed field: return bit 28 and clear it in place,
+ * leaving the bare index behind. What the flag means depends on which field it
+ * came from -- see the wire format above. */
+static inline unsigned int take_flag_bit28( unsigned int *value )
+{
+    unsigned int flag = (*value >> 28) & 1;
+    *value &= ~(1 << 28);
+    return flag;
+}
+
+static void *mach_message_pump( void *args )
+{
+    int i, val;
+    unsigned int tid, count, is_mutex;
+    int *addr;
+    mach_msg_return_t mr;
+    semaphore_t sem;
+    mach_register_message_t receive_message = { 0 };
+    mach_unregister_message_t *mach_unregister_message;
+    sigset_t set;
+
+    sigfillset( &set );
+    pthread_sigmask( SIG_BLOCK, &set, NULL );
+
+    for (;;)
+    {
+        mr = receive_mach_msg( &receive_message );
+        if (mr != MACH_MSG_SUCCESS)
+        {
+            fprintf( stderr, "msync: failed to receive message\n");
+            continue;
+        }
+
+        /*
+         * A message with no body is a signal_all or destroy_all operation: the
+         * shm_idx is the msgh_id and bit 28 picks the operation.
+         */
+        if (receive_message.header.msgh_size == sizeof(mach_msg_header_t))
+        {
+            unsigned int idx = receive_message.header.msgh_id;
+            unsigned int destroy = take_flag_bit28( &idx );
+
+            if (destroy) destroy_all_internal( idx );
+            else signal_all_internal( idx );
+            continue;
+        }
+
+        /*
+         * A message with a body which is not complex means this is a
+         * server_remove_wait operation
+         */
+        decode_msgh_id( receive_message.header.msgh_id, &tid, &count );
+
+        /* Indices are checked where they are used; count is not, and it decides
+         * how far into the body we read. It is 8 bits on the wire, so a hostile
+         * one is 4x the array. */
+        if (count > ARRAY_SIZE(receive_message.shm_idx)) continue;
+
+        if (!MACH_MSGH_BITS_IS_COMPLEX(receive_message.header.msgh_bits))
+        {
+            mach_unregister_message = (mach_unregister_message_t *)&receive_message;
+            for (i = 0; i < count; i++)
+                remove_sem( mach_unregister_message->shm_idx[i], tid );
+
+            continue;
+        }
+
+        /*
+         * Finally server_register_wait
+         */
+        sem = receive_message.descriptor.name;
+        for (i = 0; i < count; i++)
+        {
+            unsigned int idx = receive_message.shm_idx[i];
+            int wake;
+
+            is_mutex = take_flag_bit28( &idx );
+
+            if (!(addr = (int *)get_valid_shm( idx )))
+            {
+                /* Nothing at that index. Wake rather than skip the entry: the
+                 * sender is parked on `sem` and would never hear about an entry
+                 * we dropped silently, and the send right would leak with it. */
+                wake = 1;
+            }
+            else
+            {
+                /* The client had a TOCTTOU we need to fix */
+                val = __atomic_load_n( addr, __ATOMIC_SEQ_CST );
+                wake = (is_mutex && (val == 0 || val == ~0 || val == tid)) || (!is_mutex && val != 0)
+                       || !__atomic_load_n( msync_alive( addr ), __ATOMIC_SEQ_CST );
+            }
+
+            if (wake)
+            {
+                semaphore_signal( sem );
+                semaphore_destroy( mach_task_self(), sem );
+                continue;
+            }
+            add_sem( idx, sem, tid );
+        }
+    }
+
+    return NULL;
+}
+
+#endif
+
+int do_msync(void)
+{
+#ifdef __APPLE__
+    /* Default on to match the client-side do_msync (dlls/ntdll/unix/msync_shm.c);
+     * WINEMSYNC=0 forces the (unreliable) server fallback for debugging. */
+    static int cached = -1;
+    if (cached == -1)
+    {
+        const char *env = getenv( "WINEMSYNC" );
+        cached = env ? atoi( env ) : 1;
+    }
+    return cached;
+#else
+    return 0;
+#endif
+}
+
+static char shm_name[MSYNC_SHM_NAME_LEN];
+static const off_t shm_size = MAX_INDEX * MSYNC_SHM_SLOT_SIZE;
+/* zero_new_pages: this side creates the file, so it starts each page from a
+ * known state; a client mapping the same page must leave it alone. */
+static struct msync_shm_map shm_map = { .zero_new_pages = 1 };
+static pthread_t message_thread;
+
+static int is_msync_initialized;
+
+static void cleanup(void)
+{
+    close( shm_map.fd );
+    if (shm_unlink( shm_name ) == -1)
+        perror( "shm_unlink" );
+}
+
+static void set_thread_policy_qos( mach_port_t mach_thread_id )
+{
+    thread_extended_policy_data_t extended_policy;
+    thread_precedence_policy_data_t precedence_policy;
+    int throughput_qos, latency_qos;
+    kern_return_t kr;
+
+    latency_qos = LATENCY_QOS_TIER_0;
+    kr = thread_policy_set( mach_thread_id, THREAD_LATENCY_QOS_POLICY,
+                            (thread_policy_t)&latency_qos,
+                            THREAD_LATENCY_QOS_POLICY_COUNT);
+    if (kr != KERN_SUCCESS)
+        fprintf( stderr, "msync: error setting thread latency QoS.\n" );
+
+    throughput_qos = THROUGHPUT_QOS_TIER_0;
+    kr = thread_policy_set( mach_thread_id, THREAD_THROUGHPUT_QOS_POLICY,
+                            (thread_policy_t)&throughput_qos,
+                            THREAD_THROUGHPUT_QOS_POLICY_COUNT);
+    if (kr != KERN_SUCCESS)
+        fprintf( stderr, "msync: error setting thread throughput QoS.\n" );
+
+    extended_policy.timeshare = 0;
+    kr = thread_policy_set( mach_thread_id, THREAD_EXTENDED_POLICY,
+                            (thread_policy_t)&extended_policy,
+                            THREAD_EXTENDED_POLICY_COUNT );
+    if (kr != KERN_SUCCESS)
+        fprintf( stderr, "msync: error setting extended policy\n" );
+
+    precedence_policy.importance = 63;
+    kr = thread_policy_set( mach_thread_id, THREAD_PRECEDENCE_POLICY,
+                            (thread_policy_t)&precedence_policy,
+                            THREAD_PRECEDENCE_POLICY_COUNT );
+    if (kr != KERN_SUCCESS)
+        fprintf( stderr, "msync: error setting precedence policy\n" );
+}
+
+void msync_init(void)
+{
+#ifdef __APPLE__
+    struct stat st;
+    mach_port_t bootstrap_port;
+    mach_port_limits_t limits;
+    int *shm;
+
+    if (fstat( config_dir_fd, &st ) == -1)
+        fatal_error( "cannot stat config dir\n" );
+
+    msync_shm_name( shm_name, st.st_ino );
+
+    if (!shm_unlink( shm_name ))
+        fprintf( stderr, "msync: warning: a previous shm file %s was not properly removed\n", shm_name );
+
+    shm_map.fd = shm_open( shm_name, O_RDWR | O_CREAT | O_EXCL, 0644 );
+    if (shm_map.fd == -1)
+        perror( "shm_open" );
+
+    shm_map.pagesize = sysconf( _SC_PAGESIZE );
+
+    shm_map.addrs = calloc( 128, sizeof(shm_map.addrs[0]) );
+    shm_map.addrs_size = 128;
+
+    if (ftruncate( shm_map.fd, shm_size ) == -1)
+    {
+        perror( "ftruncate" );
+        fatal_error( "could not initialize shared memory\n" );
+    }
+
+    shm = get_shm( 0 );
+    __atomic_store_n( msync_alive( shm ), 1, __ATOMIC_SEQ_CST );
+
+    /* Bootstrap mach server message pump */
+
+    MACH_CHECK_ERROR(mach_port_allocate(mach_task_self(), MACH_PORT_RIGHT_RECEIVE, &receive_port), "mach_port_allocate");
+
+    MACH_CHECK_ERROR(mach_port_insert_right(mach_task_self(), receive_port, receive_port, MACH_MSG_TYPE_MAKE_SEND), "mach_port_insert_right");
+
+    limits.mpl_qlimit = 50;
+
+    if (getenv("WINEMSYNC_QLIMIT"))
+        limits.mpl_qlimit = atoi(getenv("WINEMSYNC_QLIMIT"));
+
+    MACH_CHECK_ERROR(mach_port_set_attributes( mach_task_self(), receive_port, MACH_PORT_LIMITS_INFO,
+                                        (mach_port_info_t)&limits, MACH_PORT_LIMITS_INFO_COUNT), "mach_port_set_attributes");
+
+    MACH_CHECK_ERROR(task_get_special_port(mach_task_self(), TASK_BOOTSTRAP_PORT, &bootstrap_port), "task_get_special_port");
+
+    MACH_CHECK_ERROR(bootstrap_register2(bootstrap_port, (char *)msync_bootstrap_name( shm_name ),
+                                         receive_port, 0), "bootstrap_register2");
+
+    pool_init();
+
+    if (pthread_create( &message_thread, NULL, mach_message_pump, NULL ))
+    {
+        perror("pthread_create");
+        fatal_error( "could not create mach message pump thread\n" );
+    }
+
+    set_thread_policy_qos( pthread_mach_thread_np( message_thread )) ;
+
+    fprintf( stderr, "msync: bootstrapped mach port on %s.\n", msync_bootstrap_name( shm_name ) );
+
+    is_msync_initialized = 1;
+
+    fprintf( stderr, "msync: up and running.\n" );
+
+    atexit( cleanup );
+#endif
+}
+
+static struct list mutex_list = LIST_INIT(mutex_list);
+
+struct msync
+{
+    struct object  obj;
+    unsigned int   shm_idx;
+    enum msync_type type;
+    struct list     mutex_entry;
+};
+
+static void msync_dump( struct object *obj, int verbose );
+static unsigned int msync_get_msync_idx( struct object *obj, enum msync_type *type );
+static unsigned int msync_map_access( struct object *obj, unsigned int access );
+static void msync_destroy( struct object *obj );
+
+const struct object_ops msync_ops =
+{
+    sizeof(struct msync),      /* size */
+    &no_type,                  /* type */
+    msync_dump,                /* dump */
+    no_add_queue,              /* add_queue */
+    NULL,                      /* remove_queue */
+    NULL,                      /* signaled */
+    msync_get_msync_idx,       /* get_msync_idx */
+    NULL,                      /* satisfied */
+    no_signal,                 /* signal */
+    no_get_fd,                 /* get_fd */
+    default_get_sync,          /* get_sync */
+    msync_map_access,          /* map_access */
+    default_get_sd,            /* get_sd */
+    default_set_sd,            /* set_sd */
+    no_get_full_name,          /* get_full_name */
+    no_lookup_name,            /* lookup_name */
+    directory_link_name,       /* link_name */
+    default_unlink_name,       /* unlink_name */
+    no_open_file,              /* open_file */
+    no_kernel_obj_list,        /* get_kernel_obj_list */
+    no_close_handle,           /* close_handle */
+    msync_destroy              /* destroy */
+};
+
+static void msync_dump( struct object *obj, int verbose )
+{
+    struct msync *msync = (struct msync *)obj;
+    assert( obj->ops == &msync_ops );
+    fprintf( stderr, "msync idx=%d\n", msync->shm_idx );
+}
+
+static unsigned int msync_get_msync_idx( struct object *obj, enum msync_type *type)
+{
+    struct msync *msync = (struct msync *)obj;
+    *type = msync->type;
+    return msync->shm_idx;
+}
+
+static unsigned int msync_map_access( struct object *obj, unsigned int access )
+{
+    /* Sync objects have the same flags. */
+    if (access & GENERIC_READ)    access |= STANDARD_RIGHTS_READ | EVENT_QUERY_STATE;
+    if (access & GENERIC_WRITE)   access |= STANDARD_RIGHTS_WRITE | EVENT_MODIFY_STATE;
+    if (access & GENERIC_EXECUTE) access |= STANDARD_RIGHTS_EXECUTE | SYNCHRONIZE;
+    if (access & GENERIC_ALL)     access |= STANDARD_RIGHTS_ALL | EVENT_QUERY_STATE | EVENT_MODIFY_STATE;
+    return access & ~(GENERIC_READ | GENERIC_WRITE | GENERIC_EXECUTE | GENERIC_ALL);
+}
+
+static void msync_destroy( struct object *obj )
+{
+    struct msync *msync = (struct msync *)obj;
+    if (msync->type == MSYNC_MUTEX)
+        list_remove( &msync->mutex_entry );
+#ifdef __APPLE__
+    msync_destroy_semaphore( msync->shm_idx );
+#endif
+}
+
+/* Unlocked, unlike the client's msync_get_shm(), which takes a lock around the
+ * same helper: the request path is single-threaded, and the only other caller
+ * is the mach message pump, which touches indices the request path has already
+ * mapped. Adding a lock here would be a change of behaviour, not a cleanup. */
+static void *get_shm( unsigned int idx )
+{
+    struct msync_shm_map_info info;
+    void *ret = msync_shm_slot( &shm_map, idx, &info );
+
+    if (info.grow_failed)
+        fprintf( stderr, "msync: couldn't expand shm_addrs array to size %d\n", info.new_size );
+    else if (info.mmap_failed)
+    {
+        fprintf( stderr, "msync: failed to map page %d (offset %#lx): ",
+                 info.entry, info.entry * shm_map.pagesize );
+        perror( "mmap" );
+    }
+    else if (info.mapped && debug_level)
+        fprintf( stderr, "msync: Mapping page %d at %p.\n", info.entry, info.mapped );
+
+    return ret;
+}
+
+static unsigned int shm_idx_counter = 1;
+
+unsigned int msync_alloc_shm( int low, int high )
+{
+#ifdef __APPLE__
+    int shm_idx, tries = 0;
+    int *shm;
+
+    /* this is arguably a bit of a hack, but we need some way to prevent
+     * allocating shm for the master socket */
+    if (!is_msync_initialized)
+        return 0;
+
+    shm_idx = shm_idx_counter;
+
+    for(;;)
+    {
+        shm = get_shm( shm_idx );
+        if (!__atomic_load_n( msync_alive( shm ), __ATOMIC_SEQ_CST ))
+            break;
+
+        shm_idx = (shm_idx + 1) % MAX_INDEX;
+        if (tries++ > MAX_INDEX)
+        {
+            /* The ftruncate call can only be successfully done with a non-zero length
+             * once per shared memory region with XNU. We need to terminate now.
+             * Also, we initialized with more than what is reasonable anyways... */
+            fatal_error( "too many msync objects\n" );
+        }
+    }
+    __atomic_store_n( msync_alive( shm ), 1, __ATOMIC_SEQ_CST );
+    assert(mach_semaphore_map[shm_idx].head == NULL);
+    shm_idx_counter = (shm_idx + 1) % MAX_INDEX;
+
+
+    assert(shm);
+    shm[0] = low;
+    shm[1] = high;
+
+    return shm_idx;
+#else
+    return 0;
+#endif
+}
+
+static int type_matches( enum msync_type type1, enum msync_type type2 )
+{
+    return (type1 == type2) ||
+           ((type1 == MSYNC_AUTO_EVENT || type1 == MSYNC_MANUAL_EVENT) &&
+            (type2 == MSYNC_AUTO_EVENT || type2 == MSYNC_MANUAL_EVENT));
+}
+
+struct msync *create_msync( struct object *root, const struct unicode_str *name,
+    unsigned int attr, int low, int high, enum msync_type type,
+    const struct security_descriptor *sd )
+{
+#ifdef __APPLE__
+    struct msync *msync;
+
+    if ((msync = create_named_object( root, &msync_ops, name, attr, sd )))
+    {
+        if (get_error() != STATUS_OBJECT_NAME_EXISTS)
+        {
+            /* initialize it if it didn't already exist */
+
+            /* Initialize the shared memory portion. We want to do this on the
+             * server side to avoid a potential though unlikely race whereby
+             * the same object is opened and used between the time it's created
+             * and the time its shared memory portion is initialized. */
+
+            msync->shm_idx = msync_alloc_shm( low, high );
+            msync->type = type;
+            if (type == MSYNC_MUTEX)
+                list_add_tail( &mutex_list, &msync->mutex_entry );
+        }
+        else
+        {
+            /* validate the type */
+            if (!type_matches( type, msync->type ))
+            {
+                release_object( &msync->obj );
+                set_error( STATUS_OBJECT_TYPE_MISMATCH );
+                return NULL;
+            }
+        }
+    }
+
+    return msync;
+#else
+    set_error( STATUS_NOT_IMPLEMENTED );
+    return NULL;
+#endif
+}
+
+/* shm layout for events or event-like objects. */
+struct msync_event
+{
+    int signaled;
+    int unused;
+};
+
+/* The payload occupies the first 8 bytes of a 16-byte slot (msync_alive() and
+ * msync_regcount() own the other two ints), and its readiness word is at offset
+ * 0: waiters park on the slot address itself with __ulock_wait2(), and the
+ * registration re-check in mach_message_pump() reads it as a bare int without
+ * knowing the type. Both are true of the client's mirror of these structs in
+ * dlls/ntdll/unix/msync_private.h, which carries the same assertions -- this is
+ * a cross-process ABI, so check it here rather than trusting the field order. */
+C_ASSERT( sizeof(struct msync_event) == 8 );
+C_ASSERT( offsetof(struct msync_event, signaled) == 0 );
+
+void msync_signal_all( unsigned int shm_idx )
+{
+    struct msync_event *event;
+
+    if (debug_level)
+        fprintf( stderr, "msync_signal_all: index %u\n", shm_idx );
+
+    if (!shm_idx)
+        return;
+
+    event = get_shm( shm_idx );
+    if (!__atomic_exchange_n( &event->signaled, 1, __ATOMIC_SEQ_CST ))
+        signal_all( shm_idx, (int *)event );
+}
+
+/* The shm index a client blocks on for a server-side object, or 0 if it has none.
+ *
+ * Two sources. Normally the object's inproc_sync shadow; that is the ntsync
+ * mechanism, stubbed out on macOS (get_obj_inproc_sync() is unconditionally -1
+ * there, see server/inproc_sync.c), so on this platform the fallback is what
+ * fires.
+ *
+ * The fallback is the object's own get_msync_idx, and it is admitted for exactly
+ * one object: the msg_queue. The queue is the one object with a real
+ * server-side sync -- hence no inproc shadow and no index from the branch above
+ * -- that ALSO owns a dedicated msync shm and hands it to clients (see the
+ * get_msync_idx handler). Its two paths are kept in step by queue.c signalling
+ * both (signal_sync/reset_sync for server waiters, msync_wake_up/msync_clear for
+ * msync waiters); without this fallback the msync half is dropped and a GUI
+ * message wait never wakes. It stays gated to the queue so that no other
+ * server-backed object's dormant msync path is touched. */
+static unsigned int object_msync_idx( struct object *obj )
+{
+    enum msync_type type;
+    int inproc_type, idx;
+
+    if ((idx = get_obj_inproc_sync( obj, &inproc_type )) > 0) return idx;
+    if (!is_msg_queue( obj )) return 0;
+    return obj->ops->get_msync_idx( obj, &type );
+}
+
+void msync_wake_up( struct object *obj )
+{
+    unsigned int idx;
+
+    if (debug_level)
+        fprintf( stderr, "msync_wake_up: object %p\n", obj );
+
+    if ((idx = object_msync_idx( obj ))) msync_signal_all( idx );
+}
+
+void msync_destroy_semaphore( unsigned int shm_idx )
+{
+    if (!shm_idx) return;
+
+    destroy_all( shm_idx );
+}
+
+void msync_clear_shm( unsigned int shm_idx )
+{
+    struct msync_event *event;
+
+    if (debug_level)
+        fprintf( stderr, "msync_clear_shm: index %u\n", shm_idx );
+
+    if (!shm_idx)
+        return;
+
+    event = get_shm( shm_idx );
+    __atomic_store_n( &event->signaled, 0, __ATOMIC_SEQ_CST );
+}
+
+void msync_clear( struct object *obj )
+{
+    unsigned int idx;
+
+    if (debug_level)
+        fprintf( stderr, "msync_clear: object %p\n", obj );
+
+    /* Symmetric with msync_wake_up(): the same index goes unsignaled, so a
+     * level-triggered client wait sees the transition instead of spinning on a
+     * stale signaled flag. */
+    if ((idx = object_msync_idx( obj ))) msync_clear_shm( idx );
+}
+
+void msync_set_event( struct msync *msync )
+{
+    struct msync_event *event = get_shm( msync->shm_idx );
+    assert( msync->obj.ops == &msync_ops );
+
+    if (!__atomic_exchange_n( &event->signaled, 1, __ATOMIC_SEQ_CST ))
+        signal_all( msync->shm_idx, (int *)event );
+}
+
+void msync_reset_event( struct msync *msync )
+{
+    struct msync_event *event = get_shm( msync->shm_idx );
+    assert( msync->obj.ops == &msync_ops );
+
+    __atomic_store_n( &event->signaled, 0, __ATOMIC_SEQ_CST );
+}
+
+/* Read the signaled state of an msync event object. Used by the event_op /
+ * query_event request handlers on the msync branch, where the object is a
+ * struct msync (not a struct event) so its ->sync field must never be touched. */
+int msync_get_event_state( struct msync *msync )
+{
+    struct msync_event *event = get_shm( msync->shm_idx );
+    assert( msync->obj.ops == &msync_ops );
+
+    return __atomic_load_n( &event->signaled, __ATOMIC_SEQ_CST );
+}
+
+/* Whether an msync event object is manual-reset (vs auto-reset). */
+int msync_is_manual_event( struct msync *msync )
+{
+    assert( msync->obj.ops == &msync_ops );
+
+    return msync->type == MSYNC_MANUAL_EVENT;
+}
+
+struct mutex
+{
+    int tid;
+    int count;  /* recursion count */
+};
+
+/* Same invariant as struct msync_event above: 8-byte payload, readiness (here
+ * the owner tid) first. */
+C_ASSERT( sizeof(struct mutex) == 8 );
+C_ASSERT( offsetof(struct mutex, tid) == 0 );
+
+void msync_abandon_mutexes( struct thread *thread )
+{
+    struct msync *msync;
+
+    LIST_FOR_EACH_ENTRY( msync, &mutex_list, struct msync, mutex_entry )
+    {
+        struct mutex *mutex = get_shm( msync->shm_idx );
+
+        if (mutex->tid == thread->id)
+        {
+            if (debug_level)
+                fprintf( stderr, "msync_abandon_mutexes() idx=%d\n", msync->shm_idx );
+            mutex->tid = ~0;
+            mutex->count = 0;
+            signal_all ( msync->shm_idx, (int *)mutex );
+        }
+    }
+}
+
+DECL_HANDLER(create_msync)
+{
+    struct msync *msync;
+    struct unicode_str name;
+    struct object *root;
+    const struct security_descriptor *sd;
+    const struct object_attributes *objattr = get_req_object_attributes( &sd, &name, &root );
+
+    if (!do_msync())
+    {
+        set_error( STATUS_NOT_IMPLEMENTED );
+        return;
+    }
+
+    if (!objattr) return;
+
+    if ((msync = create_msync( root, &name, objattr->attributes, req->low,
+                               req->high, req->type, sd )))
+    {
+        if (get_error() == STATUS_OBJECT_NAME_EXISTS)
+            reply->handle = alloc_handle( current->process, msync, req->access, objattr->attributes );
+        else
+            reply->handle = alloc_handle_no_access_check( current->process, msync,
+                                                          req->access, objattr->attributes );
+
+        reply->shm_idx = msync->shm_idx;
+        reply->type = msync->type;
+        release_object( msync );
+    }
+
+    if (root) release_object( root );
+}
+
+DECL_HANDLER(open_msync)
+{
+    struct unicode_str name = get_req_unicode_str();
+
+    reply->handle = open_object( current->process, req->rootdir, req->access,
+                                 &msync_ops, &name, req->attributes );
+
+    if (reply->handle)
+    {
+        struct msync *msync;
+
+        if (!(msync = (struct msync *)get_handle_obj( current->process, reply->handle,
+                                                      0, &msync_ops )))
+            return;
+
+        if (!type_matches( req->type, msync->type ))
+        {
+            set_error( STATUS_OBJECT_TYPE_MISMATCH );
+            release_object( msync );
+            return;
+        }
+
+        reply->type = msync->type;
+        reply->shm_idx = msync->shm_idx;
+        release_object( msync );
+    }
+}
+
+/* Retrieve the index of a shm section which will be signaled by the server. */
+DECL_HANDLER(get_msync_idx)
+{
+    struct object *obj, *sync;
+    enum msync_type type;
+    unsigned int idx = 0;
+
+    if (!(obj = get_handle_obj( current->process, req->handle, SYNCHRONIZE, NULL )))
+        return;
+
+    /* Hand the client an msync shm index for objects that cannot be waited
+     * server-side -- i.e. pure msync primitives (events/mutexes/sems created via
+     * create_msync), whose sync is the object itself with add_queue == no_add_queue.
+     * That identity is what default_get_sync() hands back on macOS; a shadow
+     * inproc_sync there would instead push server waits into no_add_queue ->
+     * STATUS_OBJECT_TYPE_MISMATCH (Steam's "stalled pipe"), see the note there.
+     *
+     * process/thread stay on SERVER waits: their sync is a server event_sync with a
+     * real add_queue and they have no msync path the server keeps in step. */
+    sync = get_obj_sync( obj );
+    if (obj->ops->get_msync_idx && sync->ops->add_queue == no_add_queue)
+        idx = obj->ops->get_msync_idx( obj, &type );
+    release_object( sync );
+
+    /* Plus any object the server itself resolves to an msync index -- the msg_queue,
+     * whose dual signal path object_msync_idx() explains. Waiting on it client-side
+     * makes a MsgWait a pure msync wait rather than a polling msync+server mixed
+     * wait. Read the index back from the object's own op so the reply's type comes
+     * from the same call. */
+    if (!idx && object_msync_idx( obj ) && obj->ops->get_msync_idx)
+        idx = obj->ops->get_msync_idx( obj, &type );
+
+    if (idx)
+    {
+        reply->shm_idx = idx;
+        reply->type = type;
+    }
+    else
+    {
+        if (debug_level)
+        {
+            fprintf( stderr, "%04x: msync: can't wait on object: ", current->id );
+            obj->ops->dump( obj, 0 );
+        }
+        set_error( STATUS_NOT_IMPLEMENTED );
+    }
+
+    release_object( obj );
+}
+
+DECL_HANDLER(get_msync_apc_idx)
+{
+    reply->shm_idx = current->msync_apc_idx;
+}
