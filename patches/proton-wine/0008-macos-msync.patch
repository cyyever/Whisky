new file mode 100644
index 00000000000..8736a2714fd
--- /dev/null
+++ b/include/wine/msync_abi.h
@@ -0,0 +1,226 @@
+/*
+ * msync definitions shared by the ntdll and wineserver halves
+ *
+ * Copyright (C) 2018 Zebediah Figura
+ * Copyright (C) 2023 Marc-Aurel Zent
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_MSYNC_ABI_H
+#define __WINE_MSYNC_ABI_H
+
+/* msync is implemented twice, in two binaries that have to meet in the middle:
+ * dlls/ntdll/unix/msync_*.c in every client process and server/msync.c in the
+ * wineserver. They share one shm file and one mach port, so the shm file's
+ * name, the layout of a slot in it, and the protocol for waking a waiter are
+ * agreements between processes -- an agreement encoded twice is an agreement
+ * that can drift. This header holds the parts both halves must spell the same
+ * way; everything is static inline, so it costs no link-time coupling.
+ *
+ * What deliberately stays on each side is policy rather than agreement: the
+ * client serialises its mapping table with a lock (many threads) while the
+ * server does not (one thread reaches this code), and each reports failures
+ * through its own channel -- ntdll's ERR() versus the server's perror().
+ */
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <sys/mman.h>
+
+#ifdef __APPLE__
+# include <mach/message.h>
+# include <mach/port.h>
+#endif
+
+/* ---- the shm file's name --------------------------------------------------
+ *
+ * Keyed on the config directory's inode, so each prefix gets its own shm file
+ * and its own mach service, and two prefixes running at once cannot collide.
+ * The two halves reach that inode differently -- the client stat()s config_dir,
+ * the server fstat()s the fd it already holds -- but must derive a byte-identical
+ * name from it, since that name is how they find each other.
+ */
+
+/* "/wine-" + up to 16 hex digits of inode + "-msync" + NUL, exactly. */
+#define MSYNC_SHM_NAME_LEN 29
+
+static inline void msync_shm_name( char *name, unsigned long long ino )
+{
+    /* An inode too wide for a long is printed as two halves, so that the name
+     * stays inside MSYNC_SHM_NAME_LEN either way. */
+    if (ino != (unsigned long)ino)
+        snprintf( name, MSYNC_SHM_NAME_LEN, "/wine-%lx%08lx-msync",
+                  (unsigned long)(ino >> 32), (unsigned long)ino );
+    else
+        snprintf( name, MSYNC_SHM_NAME_LEN, "/wine-%lx-msync", (unsigned long)ino );
+}
+
+/* The same name serves as the mach service name, minus the leading slash:
+ * shm_open() wants the slash, bootstrap_register2()/bootstrap_look_up() reject
+ * it. Both halves must agree on which spelling goes where or the client looks
+ * up a service the server never registered. */
+static inline const char *msync_bootstrap_name( const char *shm_name )
+{
+    return shm_name + 1;
+}
+
+/* ---- the layout of a slot -------------------------------------------------
+ *
+ * One slot per object, 16 bytes: [0..1] the type-specific payload, whose first
+ * int is the readiness word every waiter parks on with __ulock_wait2(); [2] the
+ * alive flag; [3] the number of waiters currently registered with the server's
+ * mach message pump. The stride is how both halves turn an object index into a
+ * file offset, so it is as much a part of the ABI as the field order.
+ */
+#define MSYNC_SHM_SLOT_SIZE 16
+
+static inline int *msync_shm_alive( void *shm )    { return (int *)shm + 2; }
+static inline int *msync_shm_regcount( void *shm ) { return (int *)shm + 3; }
+
+/* ---- mapping the shm file -------------------------------------------------
+ *
+ * Both halves map the file one page at a time, on demand, and keep the mapped
+ * pages in a table indexed by page number. The table grows by doubling and is
+ * never shrunk: a mapping, once made, stays for the life of the process, so a
+ * pointer handed out by msync_shm_slot() remains valid.
+ */
+struct msync_shm_map
+{
+    void **addrs;           /* mapped page per entry, NULL until first touched */
+    int    addrs_size;      /* length of the addrs array */
+    long   pagesize;
+    int    fd;
+    int    zero_new_pages;  /* see below */
+};
+
+/* Everything about a msync_shm_slot() call its caller might want to report.
+ * The two halves log through different channels, so the diagnostics are left
+ * outside and only the mechanism is shared. */
+struct msync_shm_map_info
+{
+    int   entry;        /* page the slot lives in */
+    int   new_size;     /* size the table was grown to, 0 if it was not grown */
+    void *mapped;       /* page mapped by this call, NULL if already mapped */
+    int   grow_failed;
+    int   mmap_failed;
+};
+
+/* Address of slot `idx`, mapping its page if this is its first use. Returns
+ * NULL on failure, with the reason in *info.
+ *
+ * Not internally synchronised: a caller with more than one thread must hold its
+ * own lock across the call, since the table can be reallocated here.
+ */
+static inline void *msync_shm_slot( struct msync_shm_map *map, unsigned int idx,
+                                    struct msync_shm_map_info *info )
+{
+    int entry  = (idx * MSYNC_SHM_SLOT_SIZE) / map->pagesize;
+    int offset = (idx * MSYNC_SHM_SLOT_SIZE) % map->pagesize;
+
+    memset( info, 0, sizeof(*info) );
+    info->entry = entry;
+
+    if (entry >= map->addrs_size)
+    {
+        int new_size = map->addrs_size * 2 > entry + 1 ? map->addrs_size * 2 : entry + 1;
+
+        info->new_size = new_size;
+        if (!(map->addrs = realloc( map->addrs, new_size * sizeof(map->addrs[0]) )))
+        {
+            info->grow_failed = 1;
+            return NULL;
+        }
+        memset( map->addrs + map->addrs_size, 0,
+                (new_size - map->addrs_size) * sizeof(map->addrs[0]) );
+        map->addrs_size = new_size;
+    }
+
+    if (!map->addrs[entry])
+    {
+        void *addr = mmap( NULL, map->pagesize, PROT_READ | PROT_WRITE, MAP_SHARED,
+                           map->fd, entry * map->pagesize );
+
+        if (addr == MAP_FAILED)
+        {
+            info->mmap_failed = 1;
+            return NULL;
+        }
+        info->mapped = addr;
+
+        /* Publish with a CAS rather than a store: the caller's lock, where there
+         * is one, does not extend across processes, and the loser of the race
+         * must give back its own mapping rather than leak it. */
+        if (__sync_val_compare_and_swap( &map->addrs[entry], 0, addr ))
+            munmap( addr, map->pagesize );
+        else if (map->zero_new_pages)
+        {
+            /* Only the half that creates the file clears a page the first time
+             * it maps one; for anyone else the page is already in use by
+             * whoever allocated the indices on it. */
+            memset( addr, 0, map->pagesize );
+        }
+    }
+
+    return (char *)map->addrs[entry] + offset;
+}
+
+#ifdef __APPLE__
+
+/* ---- waking waiters -------------------------------------------------------
+ */
+
+#define UL_COMPARE_AND_WAIT_SHARED  0x3
+#define ULF_WAKE_ALL                0x00000100
+
+extern int __ulock_wake( uint32_t operation, void *addr, uint64_t wake_value );
+
+/* Wake everyone waiting on an object whose readiness word was just set.
+ *
+ * There are two kinds of waiter and a signaller must reach both. A thread
+ * waiting on this object alone parks on the readiness word itself and is woken
+ * by __ulock_wake(). A thread waiting on several objects at once cannot park on
+ * any one word, so it registers a mach semaphore with the server's message pump
+ * and is woken by a header-only message naming the index (the wire format is
+ * documented in server/msync.c). Slot [3] counts the registered ones, so zero
+ * means there is nobody the message would reach and it can be skipped -- which
+ * is the common case, and the reason this is worth a shared helper rather than
+ * an unconditional send.
+ *
+ * Fills `header` and returns 1 when the message is needed. The caller sends it
+ * itself, through its own port -- the client's send right to the server, the
+ * server's own receive port, which it posts to so that its own signals are
+ * ordered against client registrations -- and with its own mach_msg2() wrapper.
+ */
+static inline int msync_signal_wake( mach_msg_header_t *header, unsigned int shm_idx,
+                                     void *shm, mach_port_t port )
+{
+    __ulock_wake( UL_COMPARE_AND_WAIT_SHARED | ULF_WAKE_ALL, shm, 0 );
+
+    if (!__atomic_load_n( msync_shm_regcount( shm ), __ATOMIC_ACQUIRE ))
+        return 0;
+
+    header->msgh_bits = MACH_MSGH_BITS_REMOTE( MACH_MSG_TYPE_COPY_SEND );
+    header->msgh_id = shm_idx;
+    header->msgh_size = sizeof(*header);
+    header->msgh_remote_port = port;
+    return 1;
+}
+
+#endif /* __APPLE__ */
+
+#endif /* __WINE_MSYNC_ABI_H */
