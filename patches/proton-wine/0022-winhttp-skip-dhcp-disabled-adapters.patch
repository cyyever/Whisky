Subject: winhttp: skip adapters without DHCP when detecting WPAD

WinHttpDetectAutoProxyConfigUrl's DHCP probe does not apply to adapters with
DHCPv4 disabled. Skip them instead of making a synchronous DHCP request for
every virtual or manually configured interface.

diff --git a/dlls/winhttp/session.c b/dlls/winhttp/session.c
--- a/dlls/winhttp/session.c
+++ b/dlls/winhttp/session.c
@@ -1550,7 +1550,7 @@ static WCHAR *detect_autoproxyconfig_url_dhcp(void)
         TRACE( "adapter '%s' type %lu dhcpv4 enabled %d\n", wine_dbgstr_w(name), ptr->IfType, ptr->Dhcpv4Enabled );
 
         if (ptr->IfType == IF_TYPE_SOFTWARE_LOOPBACK) continue;
-        /* FIXME: also skip adapters where DHCP is disabled */
+        if (!ptr->Dhcpv4Enabled) continue;
 
         size = 256;
         if (!(buf = malloc( size ))) goto done;
