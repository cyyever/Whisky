Subject: ntdll: classify macOS faulting threads without reading pthread TLS

Wine signal handlers may enter with GS pointing at the Windows TEB. Calling
pthread_getspecific before init_handler restores Unix TLS can misclassify a
Windows thread and hang while handling a recoverable access violation.

Use sigaltstack to verify Wine's aligned signal-stack allocation and size
without dereferencing an inferred TEB or accessing pthread TLS. Clear the
alignment flag before entering libc, as init_handler normally does. Native
threads still take the default signal action before any Wine TEB access.

Regression: tests/signal-thread-guard-test.c recovers a PAGE_NOACCESS fault
on the initial thread and a CreateThread worker. The original guard hangs
before the first recovery; the stack-based guard completes both cases.

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2512,6 +2512,38 @@
 }
 
 
+#ifdef __APPLE__
+/***********************************************************************
+ *           handle_foreign_thread_fault
+ *
+ * Wine's signal stack shares an aligned allocation with the TEB. A native
+ * thread has no such stack, so init_handler() cannot safely derive its TEB.
+ * Check the kernel's alternate-stack description without touching pthread
+ * TLS: GS may still point at the Windows TEB until init_handler() restores it.
+ * Native faults retain the default action instead of entering Wine handlers.
+ */
+static BOOL handle_foreign_thread_fault( int signal )
+{
+    struct sigaction sa;
+    stack_t stack;
+
+    clear_alignment_flag();
+    /* GS can still point at the Windows TEB here. Do not use pthread TLS
+     * until init_handler() has restored the Unix thread environment. */
+    if (!sigaltstack( NULL, &stack ) && (stack.ss_flags & SS_ONSTACK) &&
+        stack.ss_sp == (char *)get_current_teb() + teb_size &&
+        stack.ss_size == signal_stack_size)
+        return FALSE;
+
+    sa.sa_handler = SIG_DFL;
+    sa.sa_flags = 0;
+    sigemptyset( &sa.sa_mask );
+    sigaction( signal, &sa, NULL );
+    raise( signal );
+    return TRUE;
+}
+#endif
+
 /**********************************************************************
  *		segv_handler
  *
@@ -2582,6 +2614,11 @@
     struct xcontext context;
     void *steamclient_addr = NULL;
 
+#ifdef __APPLE__
+    /* First statement in the body: init_handler() further down resets GSBASE,
+     * and a foreign thread must return before reaching it. */
+    if (handle_foreign_thread_fault( signal )) return;
+#endif
     /* cpuid fault may happen in native thread. */
     if (TRAP_sig(ucontext) == TRAP_x86_PROTFLT && siginfo->si_code == 0x80 && !ERROR_sig(ucontext)
         && handle_cpuid_fault( (ULONG_PTR *)&RIP_sig(ucontext), (ULONG_PTR *)&RAX_sig(ucontext),
@@ -2688,7 +2725,12 @@
  */
 static void trap_handler( int signal, siginfo_t *siginfo, void *sigcontext )
 {
-    ucontext_t *ucontext = init_handler( sigcontext );
+    ucontext_t *ucontext;
+
+#ifdef __APPLE__
+    if (handle_foreign_thread_fault( signal )) return;
+#endif
+    ucontext = init_handler( sigcontext );
     EXCEPTION_RECORD rec = { 0 };
     struct xcontext context;
 
@@ -2722,7 +2764,12 @@
  */
 static void fpe_handler( int signal, siginfo_t *siginfo, void *sigcontext )
 {
-    ucontext_t *ucontext = init_handler( sigcontext );
+    ucontext_t *ucontext;
+
+#ifdef __APPLE__
+    if (handle_foreign_thread_fault( signal )) return;
+#endif
+    ucontext = init_handler( sigcontext );
     EXCEPTION_RECORD rec = { .ExceptionAddress = (void *)RIP_sig(ucontext) };
     struct xcontext context;
 
