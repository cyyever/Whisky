+#ifdef __APPLE__
+/***********************************************************************
+ *           handle_foreign_thread_fault
+ *
+ * Wine's signal stack shares an aligned allocation with the TEB. A native
+ * thread has no such stack, so init_handler() cannot safely derive its TEB.
+ * Check the kernel's alternate-stack description without touching pthread
+ * TLS: GS may still point at the Windows TEB until init_handler() restores it.
+ * Native faults retain the default action instead of entering Wine handlers.
+ */
+static BOOL handle_foreign_thread_fault( int signal )
+{
+    struct sigaction sa;
+    stack_t stack;
+
+    clear_alignment_flag();
+    /* GS can still point at the Windows TEB here. Do not use pthread TLS
+     * until init_handler() has restored the Unix thread environment. */
+    if (!sigaltstack( NULL, &stack ) && (stack.ss_flags & SS_ONSTACK) &&
+        stack.ss_sp == (char *)get_current_teb() + teb_size &&
+        stack.ss_size == signal_stack_size)
+        return FALSE;
+
+    sa.sa_handler = SIG_DFL;
+    sa.sa_flags = 0;
+    sigemptyset( &sa.sa_mask );
+    sigaction( signal, &sa, NULL );
+    raise( signal );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           handle_rosetta_wow64_cs_fault
+ *
+ * Rosetta 2 on Apple Silicon has a concurrency bug when one thread unmaps or
+ * invalidates executable pages (e.g. FreeLibrary -> NtUnmapViewOfSection) while
+ * another 32-bit WoW64 thread executes a 32->64 far jump into wow64cpu.dll:
+ * the target thread lands at syscall_32to64 or unix_call_32to64 with CS still
+ * set to cs32_sel instead of cs64_sel.
+ *
+ * wow64cpu places `movl cs32_sel(%rip), %edx` (8b 15 <disp32>) as the very
+ * first instruction of both entry points, followed by `movl %edx, 0xbc(%r13)`
+ * and `xchgq %r14, %rsp`. In 64-bit mode it is a normal RIP-relative load; in
+ * 32-bit mode it decodes as an absolute read of <disp32> (< 0x10000, always
+ * unmapped), faulting with zero side effects. Detect that exact state here,
+ * restore CS to cs64_sel, and resume cleanly in 64-bit mode.
+ */
+static BOOL handle_rosetta_wow64_cs_fault( ucontext_t *ucontext, void *fault_addr )
+{
+    static const BYTE tail_sig[10] = { 0x41, 0x89, 0x95, 0xbc, 0x00, 0x00, 0x00, 0x4c, 0x87, 0xf4 };
+    const BYTE *rip;
+    ULONG32 disp;
+    TEB *teb;
+    void *cpu_area;
+
+    if (!is_wow64() || CS_sig(ucontext) != cs32_sel) return FALSE;
+    /* Must be a data read fault on the unmapped low 64KB page (neither write nor fetch). */
+    if ((ERROR_sig(ucontext) & 0x12) || (ULONG_PTR)fault_addr >= 0x10000) return FALSE;
+
+    teb = NtCurrentTeb();
+    cpu_area = teb->TlsSlots[WOW64_TLS_CPURESERVED];
+    if (!cpu_area || R13_sig(ucontext) != (ULONG_PTR)cpu_area + 4) return FALSE;
+    if ((void *)R14_sig(ucontext) < teb->DeallocationStack ||
+        (void *)R14_sig(ucontext) >= teb->Tib.StackBase)
+        return FALSE;
+
+    rip = (const BYTE *)RIP_sig(ucontext);
+    if ((ULONG_PTR)rip < 0x10000 || (ULONG_PTR)rip >= 0x100000000ULL) return FALSE;
+    /* Ensure the 16-byte prologue check stays on the already-fetched instruction page. */
+    if (((ULONG_PTR)rip & (page_size - 1)) > page_size - 16) return FALSE;
+    if (rip[0] != 0x8b || rip[1] != 0x15) return FALSE;
+    memcpy( &disp, rip + 2, sizeof(disp) );
+    if ((ULONG_PTR)disp != (ULONG_PTR)fault_addr) return FALSE;
+    if (memcmp( rip + 6, tail_sig, sizeof(tail_sig) )) return FALSE;
+
+    TRACE_(seh)( "Rosetta WoW64 32->64 CS mismatch at %p (cs=%x -> %x), recovering\n",
+                 rip, (unsigned)CS_sig(ucontext), (unsigned)cs64_sel );
+    CS_sig(ucontext) = cs64_sel;
+    return TRUE;
+}
+#endif
