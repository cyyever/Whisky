+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include "msync_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msync);
+
+int msync_enabled;
+
+#ifdef __APPLE__
+
+static pthread_key_t msync_sem_key;
+
+static void msync_sem_destructor( void *ptr )
+{
+    semaphore_t *sem = ptr;
+    if (sem)
+    {
+        if (*sem != MACH_PORT_NULL)
+            semaphore_destroy( mach_task_self(), *sem );
+        free( sem );
+    }
+}
+
+static void semaphore_pool_init(void)
+{
+    if (pthread_key_create( &msync_sem_key, msync_sem_destructor ))
+        ERR( "Failed to create msync semaphore TLS key\n" );
+}
+
+semaphore_t *msync_thread_semaphore(void)
+{
+    semaphore_t *sem = pthread_getspecific( msync_sem_key );
+    if (!sem)
+    {
+        kern_return_t kr;
+        sem = malloc( sizeof(*sem) );
+        if (!sem) return NULL;
+        *sem = MACH_PORT_NULL;
+        kr = semaphore_create( mach_task_self(), sem, SYNC_POLICY_FIFO, 0 );
+        if (kr != KERN_SUCCESS)
+        {
+            ERR( "Cannot create thread semaphore: %#x %s\n", kr, mach_error_string( kr ) );
+            free( sem );
+            return NULL;
+        }
+        pthread_setspecific( msync_sem_key, sem );
+    }
+    return sem;
+}
+
+static char shm_name[MSYNC_SHM_NAME_LEN];
+static struct msync_shm_map shm_map;
+mach_port_t msync_server_port;
+
+void *msync_get_shm( unsigned int idx )
+{
+    struct msync_shm_map_info info;
+    void *ret = msync_shm_slot( &shm_map, idx, &info );
+
+    if (info.mmap_failed)
+        ERR( "Failed to map page %d (offset %#lx).\n", info.entry, info.entry * shm_map.pagesize );
+    else if (info.mapped)
+        TRACE( "Mapping page %d at %p.\n", info.entry, info.mapped );
+
+    return ret;
+}
+
+void msync_init(void)
+{
+    struct stat st;
+    mach_port_t bootstrap_port;
+    int fd;
+    long pagesize;
+
+    if (stat( config_dir, &st ) == -1)
+        ERR( "Cannot stat %s\n", config_dir );
+
+    msync_shm_name( shm_name, st.st_ino );
+
+    if ((fd = shm_open( shm_name, O_RDWR, 0644 )) == -1)
+    {
+        ERR( "Failed to open msync shared memory %s: %s\n", shm_name, strerror( errno ) );
+        exit( 1 );
+    }
+    fcntl( fd, F_SETFD, FD_CLOEXEC );
+
+    pagesize = sysconf( _SC_PAGESIZE );
+    if (!msync_shm_map_init( &shm_map, fd, pagesize ))
+    {
+        ERR( "Failed to allocate msync shm page table\n" );
+        exit( 1 );
+    }
+
+    semaphore_pool_init();
+
+    if (task_get_special_port( mach_task_self(), TASK_BOOTSTRAP_PORT, &bootstrap_port ) != KERN_SUCCESS)
+    {
+        ERR( "Failed task_get_special_port\n" );
+        exit( 1 );
+    }
+
+    if (bootstrap_look_up( bootstrap_port, (char *)msync_bootstrap_name( shm_name ),
+                           &msync_server_port ) != KERN_SUCCESS)
+    {
+        mach_port_deallocate( mach_task_self(), bootstrap_port );
+        ERR( "Failed bootstrap_look_up for %s\n", msync_bootstrap_name( shm_name ) );
+        exit( 1 );
+    }
+    mach_port_deallocate( mach_task_self(), bootstrap_port );
+
+    msync_enabled = 1;
+}
+
+#else /* !__APPLE__ */
+
+void *msync_get_shm( unsigned int idx ) { return NULL; }
+void msync_init(void) {}
+
+#endif /* __APPLE__ */
diff --git a/dlls/ntdll/unix/msync_wait.c b/dlls/ntdll/unix/msync_wait.c
new file mode 100644
index 00000000..584d0ac9
--- /dev/null
+++ b/dlls/ntdll/unix/msync_wait.c
@@ -0,0 +1,388 @@
+/*
+ * mach semaphore-based synchronization objects (blocking wait primitives)
+ *
+ * Copyright (C) 2018 Zebediah Figura
+ * Copyright (C) 2023 Marc-Aurel Zent
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
