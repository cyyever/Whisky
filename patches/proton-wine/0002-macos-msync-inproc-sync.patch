+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_MSYNC_ABI_H
+#define __WINE_MSYNC_ABI_H
+
+/* msync is implemented as a Wine 10 inproc_sync backend on macOS, mirroring
+ * Proton's fsync integration: server/inproc_sync.c creates an msync shm slot
+ * for every waitable server object (events, mutexes, semaphores, queues, fds,
+ * threads, processes, timers, alert_sync) and hands its index to clients via
+ * the standard get_inproc_sync_fd / get_inproc_alert_fd requests.
+ *
+ * This header holds the cross-process ABI shared between server/msync.c and
+ * dlls/ntdll/unix/msync_*.c: shm naming, slot layout, lock-free page mapping,
+ * and waiter wake protocol.
+ */
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <sys/mman.h>
+
+#ifdef __APPLE__
+# include <mach/message.h>
+# include <mach/port.h>
+#endif
+
+/* Matches FSYNC_* values in server/protocol.def so get_inproc_sync_fd's
+ * reply->type carries the exact type without changing server_protocol.h. */
+enum msync_type
+{
+    MSYNC_SEMAPHORE     = 1,
+    MSYNC_AUTO_EVENT    = 2,
+    MSYNC_MANUAL_EVENT  = 3,
+    MSYNC_MUTEX         = 4,
+    MSYNC_AUTO_SERVER   = 5,
+    MSYNC_MANUAL_SERVER = 6,
+};
+
+/* "/wine-" + up to 16 hex digits of inode + "-msync" + NUL, exactly. */
+#define MSYNC_SHM_NAME_LEN 29
+
+static inline void msync_shm_name( char *name, unsigned long long ino )
+{
+    if (ino != (unsigned long)ino)
+        snprintf( name, MSYNC_SHM_NAME_LEN, "/wine-%lx%08lx-msync",
+                  (unsigned long)(ino >> 32), (unsigned long)ino );
+    else
+        snprintf( name, MSYNC_SHM_NAME_LEN, "/wine-%lx-msync", (unsigned long)ino );
+}
+
+/* Mach bootstrap service name (no leading slash). */
+static inline const char *msync_bootstrap_name( const char *shm_name )
+{
+    return shm_name + 1;
+}
+
+/* Fixed upper bound on shm slots: on XNU ftruncate() can only be called once
+ * on a POSIX shm fd. 1M * 16 bytes = 16 MiB virtual (lazily faulted), which
+ * needs only 1024 page-table pointers (8 KiB) on 16 KiB Apple Silicon pages
+ * (or 4096 pointers = 32 KiB on 4 KiB pages). Pre-allocating the pointer table
+ * completely eliminates realloc() races between threads. */
+#define MSYNC_MAX_INDEX     0x100000u
+#define MSYNC_SHM_SLOT_SIZE 16u
+
+/* One 16-byte slot per object:
+ *   [0..1] type-specific payload; word [0] is always the readiness word
+ *          (__ulock_wait2 parks on it, mach_message_pump re-checks it).
+ *   [2]    alive flag (1 = live, 0 = free/destroyed).
+ *   [3]    registered multi-waiter count on the server's mach message pump. */
+static inline int *msync_shm_alive( void *shm )    { return (int *)shm + 2; }
+static inline int *msync_shm_regcount( void *shm ) { return (int *)shm + 3; }
+
+struct msync_shm_map
+{
+    void **addrs;      /* pre-allocated to full page count; never realloc'd */
+    int    addrs_size; /* total pages covering MSYNC_MAX_INDEX slots */
+    long   pagesize;
+    int    fd;
+};
+
+struct msync_shm_map_info
+{
+    int   entry;
+    void *mapped;
+    int   mmap_failed;
+};
+
+static inline int msync_shm_map_init( struct msync_shm_map *map, int fd, long pagesize )
+{
+    size_t total_bytes = (size_t)MSYNC_MAX_INDEX * MSYNC_SHM_SLOT_SIZE;
+    int num_pages = (int)((total_bytes + (size_t)pagesize - 1) / (size_t)pagesize);
+
+    map->fd = fd;
+    map->pagesize = pagesize;
+    map->addrs_size = num_pages;
+    map->addrs = calloc( (size_t)num_pages, sizeof(map->addrs[0]) );
+    return map->addrs != NULL;
+}
+
+/* Lock-free, thread-safe page lookup & lazy mmap. Never reallocates map->addrs. */
+static inline void *msync_shm_slot( struct msync_shm_map *map, unsigned int idx,
+                                    struct msync_shm_map_info *info )
+{
+    int entry  = (int)(((size_t)idx * MSYNC_SHM_SLOT_SIZE) / (size_t)map->pagesize);
+    int offset = (int)(((size_t)idx * MSYNC_SHM_SLOT_SIZE) % (size_t)map->pagesize);
+    void *page;
+
+    memset( info, 0, sizeof(*info) );
+    info->entry = entry;
+
+    if (entry < 0 || entry >= map->addrs_size)
+        return NULL;
+
+    page = __atomic_load_n( &map->addrs[entry], __ATOMIC_ACQUIRE );
+    if (!page)
+    {
+        void *addr = mmap( NULL, (size_t)map->pagesize, PROT_READ | PROT_WRITE, MAP_SHARED,
+                           map->fd, (off_t)entry * map->pagesize );
+        void *expected = NULL;
+
+        if (addr == MAP_FAILED)
+        {
+            info->mmap_failed = 1;
+            return NULL;
+        }
+
+        if (__atomic_compare_exchange_n( &map->addrs[entry], &expected, addr, 0,
+                                         __ATOMIC_RELEASE, __ATOMIC_ACQUIRE ))
+        {
+            page = addr;
+            info->mapped = addr;
+        }
+        else
+        {
+            munmap( addr, (size_t)map->pagesize );
+            page = expected;
+        }
+    }
+
+    return (char *)page + offset;
+}
+
+#ifdef __APPLE__
+
+#define UL_COMPARE_AND_WAIT_SHARED  0x3
+#define ULF_WAKE_ALL                0x00000100
+
+extern int __ulock_wake( uint32_t operation, void *addr, uint64_t wake_value );
+
+static inline int msync_signal_wake( mach_msg_header_t *header, unsigned int shm_idx,
+                                     void *shm, mach_port_t port )
+{
+    __ulock_wake( UL_COMPARE_AND_WAIT_SHARED | ULF_WAKE_ALL, shm, 0 );
+
+    if (!__atomic_load_n( msync_shm_regcount( shm ), __ATOMIC_ACQUIRE ))
+        return 0;
+
+    header->msgh_bits = MACH_MSGH_BITS_REMOTE( MACH_MSG_TYPE_COPY_SEND );
+    header->msgh_id = shm_idx;
+    header->msgh_size = sizeof(*header);
+    header->msgh_remote_port = port;
+    return 1;
+}
+
+#endif /* __APPLE__ */
+
+#endif /* __WINE_MSYNC_ABI_H */
