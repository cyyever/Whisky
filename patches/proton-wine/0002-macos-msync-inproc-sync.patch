+
+#ifndef __WINE_NTDLL_MSYNC_PRIVATE_H
+#define __WINE_NTDLL_MSYNC_PRIVATE_H
+
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#ifdef HAVE_SYS_STAT_H
+# include <sys/stat.h>
+#endif
+#ifdef HAVE_SYS_SYSCALL_H
+# include <sys/syscall.h>
+#endif
+#ifdef __APPLE__
+# include <mach/mach_init.h>
+# include <mach/mach_port.h>
+# include <mach/message.h>
+# include <mach/port.h>
+# include <mach/task.h>
+# include <mach/semaphore.h>
+# include <mach/mach_error.h>
+# include <servers/bootstrap.h>
+#endif
+#include <sched.h>
+#include <unistd.h>
+#include <pthread.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "wine/debug.h"
+#include "wine/server.h"
+
+#include "unix_private.h"
+#include "msync.h"
+#include "wine/msync_abi.h"
+
+/* Verify enum msync_type stays byte-identical to server/protocol.def's FSYNC_* */
+C_ASSERT( (int)MSYNC_SEMAPHORE     == (int)FSYNC_SEMAPHORE );
+C_ASSERT( (int)MSYNC_AUTO_EVENT    == (int)FSYNC_AUTO_EVENT );
+C_ASSERT( (int)MSYNC_MANUAL_EVENT  == (int)FSYNC_MANUAL_EVENT );
+C_ASSERT( (int)MSYNC_MUTEX         == (int)FSYNC_MUTEX );
+C_ASSERT( (int)MSYNC_AUTO_SERVER   == (int)FSYNC_AUTO_SERVER );
+C_ASSERT( (int)MSYNC_MANUAL_SERVER == (int)FSYNC_MANUAL_SERVER );
+
+extern pthread_mutex_t fd_cache_mutex;
+extern int get_inproc_alert_fd(void);
+
+#ifdef __APPLE__
+
+#define ULF_NO_ERRNO 0x01000000
+
+extern int __ulock_wait2( uint32_t operation, void *addr, uint64_t value,
+                          uint64_t timeout_ns, uint64_t value2 );
+
+static inline mach_msg_return_t mach_msg2( mach_msg_header_t *data, uint64_t option64,
+    mach_msg_size_t send_size, mach_msg_size_t rcv_size, mach_port_t rcv_name, uint64_t timeout,
+    uint32_t priority )
+{
+    (void)priority;
+    assert( !(option64 >> 32) );
+    assert( timeout <= 0xffffffff );
+    return mach_msg( data, (mach_msg_option_t)option64, send_size, rcv_size,
+                     rcv_name, (mach_msg_timeout_t)timeout, MACH_PORT_NULL );
+}
+
+#endif /* __APPLE__ */
+
+struct msync
+{
+    void *shm;
+    enum msync_type type;
+    unsigned int shm_idx;
+    unsigned int access;
+};
+
+struct semaphore
+{
+    int count;
+    int max;
+};
+C_ASSERT( sizeof(struct semaphore) == 8 );
+C_ASSERT( offsetof(struct semaphore, count) == 0 );
+
+struct event
+{
+    int signaled;
+    int unused;
+};
+C_ASSERT( sizeof(struct event) == 8 );
+C_ASSERT( offsetof(struct event, signaled) == 0 );
+
+struct mutex
+{
+    int tid;
+    int count;
+};
+C_ASSERT( sizeof(struct mutex) == 8 );
+C_ASSERT( offsetof(struct mutex, tid) == 0 );
+
+static inline int msync_type_is_semaphore( enum msync_type type )
+{
+    return type == MSYNC_SEMAPHORE;
+}
+
+static inline int msync_type_is_mutex( enum msync_type type )
+{
+    return type == MSYNC_MUTEX;
+}
+
+static inline int msync_type_is_settable_event( enum msync_type type )
+{
+    return type == MSYNC_AUTO_EVENT || type == MSYNC_MANUAL_EVENT;
+}
+
+static inline int *msync_alive( const struct msync *obj )    { return msync_shm_alive( obj->shm ); }
+static inline int *msync_regcount( const struct msync *obj ) { return msync_shm_regcount( obj->shm ); }
+
+static inline LONGLONG update_timeout( ULONGLONG end )
+{
+    LARGE_INTEGER now;
+    NtQuerySystemTime( &now );
+    if ((ULONGLONG)now.QuadPart >= end) return 0;
+    return (LONGLONG)(end - (ULONGLONG)now.QuadPart);
+}
+
+static inline int msync_wait_value( const struct msync *obj, int tid )
+{
+    int val;
+
+    if (obj->type != MSYNC_MUTEX) return 0;
+    val = __atomic_load_n( (const int *)obj->shm, __ATOMIC_ACQUIRE );
+    return (!val || val == ~0) ? tid : val;
+}
+
+static inline int msync_ready( const struct msync *obj, int tid )
+{
+    int val = __atomic_load_n( (const int *)obj->shm, __ATOMIC_SEQ_CST );
+
+    if (obj->type == MSYNC_MUTEX)
+        return val == 0 || val == ~0 || val == tid;
+
+    return val != 0;
+}
+
+static inline NTSTATUS msync_try_grab( struct msync *obj, int tid )
+{
+    switch (obj->type)
+    {
+    case MSYNC_SEMAPHORE:
+    {
+        struct semaphore *semaphore = obj->shm;
+        int current = __atomic_load_n( &semaphore->count, __ATOMIC_ACQUIRE );
+
+        if (current && __atomic_compare_exchange_n( &semaphore->count, &current,
+                current - 1, 0, __ATOMIC_RELEASE, __ATOMIC_RELAXED ))
+            return STATUS_SUCCESS;
+        return STATUS_PENDING;
+    }
+    case MSYNC_MUTEX:
+    {
+        struct mutex *mutex = obj->shm;
+        int owner = 0;
+
+        if (__atomic_load_n( &mutex->tid, __ATOMIC_ACQUIRE ) == tid)
+        {
+            mutex->count++;
+            return STATUS_SUCCESS;
+        }
+        if (__atomic_compare_exchange_n( &mutex->tid, &owner, tid, 0,
+                __ATOMIC_ACQ_REL, __ATOMIC_RELAXED ))
+        {
+            mutex->count = 1;
+            return STATUS_SUCCESS;
+        }
+        if (owner == ~0 && __atomic_compare_exchange_n( &mutex->tid, &owner, tid, 0,
+                __ATOMIC_ACQ_REL, __ATOMIC_RELAXED ))
+        {
+            mutex->count = 1;
+            return STATUS_ABANDONED;
+        }
+        return STATUS_PENDING;
+    }
+    case MSYNC_AUTO_EVENT:
+    case MSYNC_AUTO_SERVER:
+    {
+        struct event *event = obj->shm;
+        int signaled = 1;
+
+        if (__atomic_compare_exchange_n( &event->signaled, &signaled, 0, 0,
+                __ATOMIC_ACQ_REL, __ATOMIC_RELAXED ))
+            return STATUS_SUCCESS;
+        return STATUS_PENDING;
+    }
+    case MSYNC_MANUAL_EVENT:
+    case MSYNC_MANUAL_SERVER:
+    {
+        struct event *event = obj->shm;
+
+        if (__atomic_load_n( &event->signaled, __ATOMIC_ACQUIRE ))
+            return STATUS_SUCCESS;
+        return STATUS_PENDING;
+    }
+    default:
+        return STATUS_OBJECT_TYPE_MISMATCH;
+    }
+}
+
+static inline void msync_ungrab( struct msync *obj )
+{
+    switch (obj->type)
+    {
+    case MSYNC_MUTEX:
+    {
+        struct mutex *mutex = obj->shm;
+        if (mutex->count > 1)
+            mutex->count--;
+        else
+        {
+            mutex->count = 0;
+            __atomic_store_n( &mutex->tid, 0, __ATOMIC_SEQ_CST );
+        }
+        break;
+    }
+    case MSYNC_SEMAPHORE:
+    {
+        struct semaphore *semaphore = obj->shm;
+        __atomic_fetch_add( &semaphore->count, 1, __ATOMIC_SEQ_CST );
+        break;
+    }
+    case MSYNC_AUTO_EVENT:
+    case MSYNC_AUTO_SERVER:
+    {
+        struct event *event = obj->shm;
+        __atomic_store_n( &event->signaled, 1, __ATOMIC_SEQ_CST );
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+#ifdef __APPLE__
+static const mach_msg_bits_t msgh_bits_send = MACH_MSGH_BITS_REMOTE( MACH_MSG_TYPE_COPY_SEND );
+extern semaphore_t *msync_thread_semaphore(void);
+extern mach_port_t msync_server_port;
+#endif
+
+extern void *msync_get_shm( unsigned int idx );
+extern NTSTATUS msync_get_object( HANDLE handle, struct msync *out );
+extern NTSTATUS msync_run_apcs( BOOLEAN alertable );
+extern NTSTATUS msync_wait_multiple( struct msync **wait_objs, int count,
+                                     ULONGLONG *end, int tid );
+extern NTSTATUS msync_do_single_wait( struct msync *obj, struct msync *apc_obj,
+                                      ULONGLONG *end, BOOLEAN alertable, int tid );
+
+#endif /* __WINE_NTDLL_MSYNC_PRIVATE_H */
diff --git a/dlls/ntdll/unix/msync_select.c b/dlls/ntdll/unix/msync_select.c
new file mode 100644
index 00000000..3f753f7f
--- /dev/null
+++ b/dlls/ntdll/unix/msync_select.c
@@ -0,0 +1,330 @@
+/*
+ * mach semaphore-based synchronization objects (wait-any / wait-all / signal-and-wait)
+ *
+ * Copyright (C) 2018 Zebediah Figura
+ * Copyright (C) 2023 Marc-Aurel Zent
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include "msync_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msync);
+
+#ifdef __APPLE__
+
+static NTSTATUS msync_wait_user_apc(void)
+{
+    TRACE( "Woken up by user APC.\n" );
+    return msync_run_apcs( TRUE );
+}
+
+static NTSTATUS msync_wait_any(
+    DWORD count, const HANDLE *handles, struct msync **objs, struct msync *apc_obj,
+    BOOLEAN alertable, const LARGE_INTEGER *timeout, ULONGLONG end, int current_tid )
+{
+    DWORD waitcount;
+    int i, ret;
+
+    while (1)
+    {
+        if (alertable)
+        {
+            if (__atomic_load_n( (int *)apc_obj->shm, __ATOMIC_SEQ_CST ))
+                return msync_wait_user_apc();
+        }
+
+        for (i = 0; i < (int)count; i++)
+        {
+            struct msync *obj = objs[i];
+            NTSTATUS status;
+
+            if (!obj) continue;
+
+            status = msync_try_grab( obj, current_tid );
+            if (status == STATUS_SUCCESS)
+            {
+                TRACE( "Woken up by handle %p [%d].\n", handles[i], i );
+                return i;
+            }
+            if (status == STATUS_ABANDONED)
+            {
+                TRACE( "Woken up by abandoned mutex %p [%d].\n", handles[i], i );
+                return STATUS_ABANDONED_WAIT_0 + i;
+            }
+            if (status == STATUS_OBJECT_TYPE_MISMATCH)
+            {
+                ERR( "Invalid type %#x for handle %p.\n", obj->type, handles[i] );
+                assert( 0 );
+            }
+        }
+
+        if (alertable)
+        {
+            objs[i] = apc_obj;
+            i++;
+        }
+        waitcount = i;
+
+        if (timeout && !timeout->QuadPart)
+        {
+            TRACE( "Wait timed out.\n" );
+            return STATUS_TIMEOUT;
+        }
+
+        ret = msync_wait_multiple( objs, waitcount, timeout ? &end : NULL, current_tid );
+        if (ret == STATUS_TIMEOUT)
+        {
+            TRACE( "Wait timed out.\n" );
+            return STATUS_TIMEOUT;
+        }
+    }
+}
+
+static NTSTATUS msync_wait_all(
+    DWORD count, const HANDLE *handles, struct msync **objs, struct msync *apc_obj,
+    BOOLEAN alertable, const LARGE_INTEGER *timeout, ULONGLONG end, int current_tid )
+{
+    int i;
+
+    while (1)
+    {
+        BOOL abandoned = FALSE;
+
+        if (alertable && __atomic_load_n( (int *)apc_obj->shm, __ATOMIC_SEQ_CST ))
+            return msync_wait_user_apc();
+
+        for (i = 0; i < (int)count; i++)
+        {
+            struct msync *obj = objs[i];
+            NTSTATUS status = STATUS_SUCCESS;
+
+            if (!obj) continue;
+
+            while (!msync_ready( obj, current_tid ))
+            {
+                if (timeout && !timeout->QuadPart)
+                    return STATUS_TIMEOUT;
+                status = msync_do_single_wait( obj, apc_obj, timeout ? &end : NULL, alertable, current_tid );
+                if (status != STATUS_PENDING)
+                    break;
+            }
+
+            if (status == STATUS_TIMEOUT)
+            {
+                TRACE( "Wait timed out.\n" );
+                return STATUS_TIMEOUT;
+            }
+            if (status == STATUS_USER_APC)
+                return msync_wait_user_apc();
+        }
+
+        for (i = 0; i < (int)count; i++)
+            if (objs[i] && !msync_ready( objs[i], current_tid )) break;
+        if (i < (int)count) continue;
+
+        for (i = 0; i < (int)count; i++)
+        {
+            struct msync *obj = objs[i];
+            NTSTATUS grabbed;
+
+            if (!obj) continue;
+            grabbed = msync_try_grab( obj, current_tid );
+            if (grabbed == STATUS_ABANDONED)
+                abandoned = TRUE;
+            else if (grabbed != STATUS_SUCCESS)
+                break;
+        }
+
+        if (i < (int)count)
+        {
+            while (i--)
+                if (objs[i]) msync_ungrab( objs[i] );
+            continue;
+        }
+
+        if (abandoned)
+        {
+            TRACE( "Wait successful, but some object(s) were abandoned.\n" );
+            return STATUS_ABANDONED;
+        }
+        TRACE( "Wait successful.\n" );
+        return STATUS_SUCCESS;
+    }
+}
+
+static BOOL init_apc_obj( struct msync *apc_obj )
+{
+    int idx = get_inproc_alert_fd();
+    void *shm;
+
+    if (idx <= 0) return FALSE;
+    shm = msync_get_shm( (unsigned int)idx );
+    if (!shm) return FALSE;
+
+    apc_obj->type    = MSYNC_MANUAL_SERVER;
+    apc_obj->shm_idx = (unsigned int)idx;
+    apc_obj->shm     = shm;
+    apc_obj->access  = SYNCHRONIZE;
+    return TRUE;
+}
+
+NTSTATUS msync_wait_objects( DWORD count, const HANDLE *handles, BOOLEAN wait_any,
+                             BOOLEAN alertable, const LARGE_INTEGER *timeout )
+{
+    struct msync objs_storage[MAXIMUM_WAIT_OBJECTS + 1];
+    struct msync *objs[MAXIMUM_WAIT_OBJECTS + 1];
+    struct msync apc_obj = { 0 };
+    int current_tid = (int)GetCurrentThreadId();
+    ULONGLONG end = 0;
+    DWORD i;
+    NTSTATUS ret;
+
+    if (alertable && !init_apc_obj( &apc_obj ))
+    {
+        static int warned;
+        if (!warned++) ERR( "no msync alert_sync index; waiting non-alertably\n" );
+        alertable = FALSE;
+    }
+
+    if (timeout)
+    {
+        if (timeout->QuadPart == TIMEOUT_INFINITE)
+            timeout = NULL;
+        else if (timeout->QuadPart > 0)
+            end = (ULONGLONG)timeout->QuadPart;
+        else
+        {
+            LARGE_INTEGER now;
+            NtQuerySystemTime( &now );
+            end = (ULONGLONG)now.QuadPart - (ULONGLONG)timeout->QuadPart;
+        }
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        ret = msync_get_object( handles[i], &objs_storage[i] );
+        if (ret) return ret;
+
+        if (!(objs_storage[i].access & SYNCHRONIZE))
+            return STATUS_ACCESS_DENIED;
+
+        objs[i] = &objs_storage[i];
+    }
+
+    /* Windows rejects duplicate handles in a WaitAll set. */
+    if (!wait_any && count > 1)
+    {
+        DWORD j;
+        for (i = 0; i < count; i++)
+            for (j = i + 1; j < count; j++)
+                if (handles[i] == handles[j])
+                    return STATUS_INVALID_PARAMETER;
+    }
+
+    if (TRACE_ON(msync))
+    {
+        TRACE( "Waiting for %s of %u handles:", wait_any ? "any" : "all", count );
+        for (i = 0; i < count; i++) TRACE( " %p", handles[i] );
+        if (alertable) TRACE( ", alertable" );
+        if (!timeout) TRACE( ", timeout = INFINITE.\n" );
+        else
+        {
+            LONGLONG timeleft = update_timeout( end );
+            TRACE( ", timeout = %ld.%07ld sec.\n",
+                   (long)(timeleft / TICKSPERSEC), (long)(timeleft % TICKSPERSEC) );
+        }
+    }
+
+    if (wait_any || count <= 1)
+        return msync_wait_any( count, handles, objs, &apc_obj, alertable, timeout, end, current_tid );
+
+    return msync_wait_all( count, handles, objs, &apc_obj, alertable, timeout, end, current_tid );
+}
+
+NTSTATUS msync_signal_and_wait( HANDLE signal, HANDLE wait, BOOLEAN alertable,
+                                const LARGE_INTEGER *timeout )
+{
+    struct msync sig_obj, wait_obj;
+    NTSTATUS ret;
+
+    /* Validate both handles (type + access) BEFORE signaling, matching Windows
+     * and inproc_signal_and_wait() in sync.c. If either handle has no
+     * inproc_sync (e.g. KeyedEvent), return STATUS_NOT_IMPLEMENTED to fall back
+     * to server_wait(). */
+    ret = msync_get_object( signal, &sig_obj );
+    if (ret) return ret;
+
+    switch (sig_obj.type)
+    {
+    case MSYNC_SEMAPHORE:
+        if (!(sig_obj.access & SEMAPHORE_MODIFY_STATE)) return STATUS_ACCESS_DENIED;
+        break;
+    case MSYNC_AUTO_EVENT:
+    case MSYNC_MANUAL_EVENT:
+        if (!(sig_obj.access & EVENT_MODIFY_STATE)) return STATUS_ACCESS_DENIED;
+        break;
+    case MSYNC_MUTEX:
+        if (!(sig_obj.access & SYNCHRONIZE)) return STATUS_ACCESS_DENIED;
+        break;
+    default:
+        return STATUS_OBJECT_TYPE_MISMATCH;
+    }
+
+    ret = msync_get_object( wait, &wait_obj );
+    if (ret) return ret;
+    if (!(wait_obj.access & SYNCHRONIZE)) return STATUS_ACCESS_DENIED;
+
+    switch (sig_obj.type)
+    {
+    case MSYNC_SEMAPHORE:
+        ret = msync_release_semaphore( signal, 1, NULL );
+        break;
+    case MSYNC_AUTO_EVENT:
+    case MSYNC_MANUAL_EVENT:
+        ret = msync_set_event( signal, NULL );
+        break;
+    case MSYNC_MUTEX:
+        ret = msync_release_mutex( signal, NULL );
+        break;
+    default:
+        return STATUS_OBJECT_TYPE_MISMATCH;
+    }
+    if (ret) return ret;
+
+    return msync_wait_objects( 1, &wait, TRUE, alertable, timeout );
+}
+
+#else /* !__APPLE__ */
+
+NTSTATUS msync_wait_objects( DWORD count, const HANDLE *handles, BOOLEAN wait_any,
+                             BOOLEAN alertable, const LARGE_INTEGER *timeout )
+{
+    return STATUS_NOT_IMPLEMENTED;
+}
+
+NTSTATUS msync_signal_and_wait( HANDLE signal, HANDLE wait, BOOLEAN alertable,
+                                const LARGE_INTEGER *timeout )
+{
+    return STATUS_NOT_IMPLEMENTED;
+}
+
+#endif /* __APPLE__ */
