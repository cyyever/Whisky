+#include "winternl.h"
+
+#include "handle.h"
+#include "process.h"
+#include "request.h"
+#include "thread.h"
+#include "msync.h"
+#include "wine/msync_abi.h"
+
+#define MAX_INDEX MSYNC_MAX_INDEX
+
+static int is_msync_initialized;
+
+int do_msync(void)
+{
+#ifdef __APPLE__
+    static int cached = -1;
+    if (cached == -1)
+    {
+        const char *env = getenv( "WINEMSYNC" );
+        cached = env ? atoi( env ) : 1;
+    }
+    return cached;
+#else
+    return 0;
+#endif
+}
+
+int msync_is_ready(void)
+{
+    return is_msync_initialized;
+}
+
+#ifdef __APPLE__
+
+#define MACH_CHECK_ERROR(ret, operation) \
+    if (ret != KERN_SUCCESS) \
+        fprintf( stderr, "msync: error: %s failed with %d: %s\n", \
+            operation, ret, mach_error_string(ret) );
+
+extern kern_return_t bootstrap_register2( mach_port_t bp, name_t service_name, mach_port_t sp, int flags );
+
+static inline mach_msg_return_t mach_msg2( mach_msg_header_t *data, uint64_t option64,
+    mach_msg_size_t send_size, mach_msg_size_t rcv_size, mach_port_t rcv_name, uint64_t timeout,
+    uint32_t priority )
+{
+    (void)priority;
+    return mach_msg( data, (mach_msg_option_t)option64, send_size, rcv_size,
+                     rcv_name, (mach_msg_timeout_t)timeout, MACH_PORT_NULL );
+}
+
+static mach_port_name_t receive_port;
+
+struct sem_node;
+
+struct wait_group
+{
+    semaphore_t sem;
+    unsigned int refcount;
+    int signaled;
+    int tid;
+    struct sem_node *nodes_head;
+    struct wait_group *active_prev;
+    struct wait_group *active_next;
+};
+
+struct sem_node
+{
+    struct sem_node *next;
+    struct sem_node *prev;
+    struct sem_node *group_next;
+    struct sem_node *group_prev;
+    struct wait_group *group;
+    unsigned int shm_idx;
+    int tid;
+};
+
+#define MAX_POOL_NODES  16384
+#define MAX_POOL_GROUPS 4096
+
+struct node_memory_pool
+{
+    struct sem_node *nodes;
+    struct sem_node **free_nodes;
+    unsigned int count;
+    struct wait_group *groups;
+    struct wait_group **free_groups;
+    unsigned int group_count;
+};
+
+static struct node_memory_pool *pool;
+static struct wait_group *active_groups_head;
+
+static void pool_init(void)
+{
+    unsigned int i;
+    pool = malloc( sizeof(struct node_memory_pool) );
+    pool->nodes = malloc( MAX_POOL_NODES * sizeof(struct sem_node) );
+    pool->free_nodes = malloc( MAX_POOL_NODES * sizeof(struct sem_node *) );
+    pool->count = MAX_POOL_NODES;
+
+    for (i = 0; i < MAX_POOL_NODES; i++)
+        pool->free_nodes[i] = &pool->nodes[i];
+
+    pool->groups = malloc( MAX_POOL_GROUPS * sizeof(struct wait_group) );
+    pool->free_groups = malloc( MAX_POOL_GROUPS * sizeof(struct wait_group *) );
+    pool->group_count = MAX_POOL_GROUPS;
+
+    for (i = 0; i < MAX_POOL_GROUPS; i++)
+        pool->free_groups[i] = &pool->groups[i];
+}
+
+static inline struct sem_node *pool_alloc(void)
+{
+    if (pool->count == 0)
+        return malloc( sizeof(struct sem_node) );
+    return pool->free_nodes[--pool->count];
+}
+
+static inline void pool_free( struct sem_node *node )
+{
+    if (node < pool->nodes || node >= pool->nodes + MAX_POOL_NODES)
+    {
+        free( node );
+        return;
+    }
+    pool->free_nodes[pool->count++] = node;
+}
+
+static inline struct wait_group *group_pool_alloc(void)
+{
+    if (pool->group_count == 0)
+        return malloc( sizeof(struct wait_group) );
+    return pool->free_groups[--pool->group_count];
+}
+
+static inline void group_pool_free( struct wait_group *group )
+{
+    if (group < pool->groups || group >= pool->groups + MAX_POOL_GROUPS)
+    {
+        free( group );
+        return;
+    }
+    pool->free_groups[pool->group_count++] = group;
+}
+
+static inline void active_group_add( struct wait_group *group )
+{
+    group->active_prev = NULL;
+    group->active_next = active_groups_head;
+    if (active_groups_head)
+        active_groups_head->active_prev = group;
+    active_groups_head = group;
+}
+
+static inline void active_group_remove( struct wait_group *group )
+{
+    if (group->active_prev)
+        group->active_prev->active_next = group->active_next;
+    else
+        active_groups_head = group->active_next;
+    if (group->active_next)
+        group->active_next->active_prev = group->active_prev;
+    group->active_prev = NULL;
+    group->active_next = NULL;
+}
+
+static inline void wait_group_signal( struct wait_group *group )
+{
+    if (!group->signaled)
+    {
+        group->signaled = 1;
+        semaphore_signal( group->sem );
+    }
+}
+
+static inline void wait_group_release( struct wait_group *group )
+{
+    if (--group->refcount == 0)
+    {
+        active_group_remove( group );
+        mach_port_deallocate( mach_task_self(), group->sem );
+        group_pool_free( group );
+    }
+}
+
+struct sem_list
+{
+    struct sem_node *head;
+};
+
+static struct sem_list mach_semaphore_map[MAX_INDEX];
+
+static inline int valid_shm_idx( unsigned int idx )
+{
+    return idx && idx < MAX_INDEX;
+}
+
+static inline void add_sem( unsigned int shm_idx, struct wait_group *group, int tid )
+{
+    struct sem_node *new_node;
+    struct sem_list *list;
+
+    if (!valid_shm_idx( shm_idx )) return;
+
+    list = mach_semaphore_map + shm_idx;
+    new_node = pool_alloc();
+    new_node->group = group;
+    new_node->shm_idx = shm_idx;
+    new_node->tid = tid;
+
+    new_node->prev = NULL;
+    new_node->next = list->head;
+    if (list->head)
+        list->head->prev = new_node;
+    list->head = new_node;
+
+    new_node->group_prev = NULL;
+    new_node->group_next = group->nodes_head;
+    if (group->nodes_head)
+        group->nodes_head->group_prev = new_node;
+    group->nodes_head = new_node;
+}
+
+static inline void unlink_sem_node( struct sem_node *node )
+{
+    struct sem_list *list = mach_semaphore_map + node->shm_idx;
+    struct wait_group *group = node->group;
+
+    if (node->prev)
+        node->prev->next = node->next;
+    else
+        list->head = node->next;
+    if (node->next)
+        node->next->prev = node->prev;
+
+    if (node->group_prev)
+        node->group_prev->group_next = node->group_next;
+    else
+        group->nodes_head = node->group_next;
+    if (node->group_next)
+        node->group_next->group_prev = node->group_prev;
+
+    wait_group_release( group );
+    pool_free( node );
+}
+
+static inline void remove_sem( unsigned int shm_idx, int tid )
+{
+    struct sem_node *current, *next;
+
+    if (!valid_shm_idx( shm_idx )) return;
+
+    current = mach_semaphore_map[shm_idx].head;
+    while (current != NULL)
+    {
+        next = current->next;
+        if (current->tid == tid)
+            unlink_sem_node( current );
+        current = next;
+    }
+}
+
+static void *get_shm( unsigned int idx );
+
+static inline int *msync_alive( void *shm )    { return msync_shm_alive( shm ); }
+static inline int *msync_regcount( void *shm ) { return msync_shm_regcount( shm ); }
+
+static inline void *get_valid_shm( unsigned int idx )
+{
+    return valid_shm_idx( idx ) ? get_shm( idx ) : NULL;
+}
+
+static inline void drop_regcount( int *shm )
+{
+    int old_val, new_val;
+
+    if (!shm) return;
+    do
+    {
+        old_val = __atomic_load_n( msync_regcount( shm ), __ATOMIC_SEQ_CST );
+        if (old_val <= 0) break;
+        new_val = old_val - 1;
+    } while (!__atomic_compare_exchange_n( msync_regcount( shm ), &old_val,
+                                           new_val, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ));
+}
+
+/* Reclaim any Mach semaphore send rights and sem_nodes left behind when a
+ * client thread dies abnormally (SIGKILL / TerminateProcess / crash) while
+ * blocked in msync_wait_multiple(). */
+static inline void cleanup_tid_internal( int tid )
+{
+    struct wait_group *group = active_groups_head;
+
+    while (group)
+    {
+        struct wait_group *next_group = group->active_next;
+        if (group->tid == tid)
+        {
+            while (group->nodes_head)
+            {
+                struct sem_node *node = group->nodes_head;
+                drop_regcount( (int *)get_valid_shm( node->shm_idx ) );
+                unlink_sem_node( node );
+            }
+        }
+        group = next_group;
+    }
+}
+
+static inline void destroy_all_internal( unsigned int shm_idx )
+{
+    struct sem_node *current;
+    struct sem_list *list;
+    int *shm;
+
+    if (!valid_shm_idx( shm_idx )) return;
+
+    list = mach_semaphore_map + shm_idx;
+    shm = get_shm( shm_idx );
+
+    /* Drain the waiter list and zero regcount BEFORE publishing alive = 0 so
+     * msync_alloc_shm() wrapping around to this slot can never race with our
+     * cleanup or observe a non-NULL mach_semaphore_map[shm_idx].head. */
+    while ((current = list->head) != NULL)
+    {
+        wait_group_signal( current->group );
+        unlink_sem_node( current );
+    }
+
+    if (shm)
+    {
+        __atomic_store_n( msync_regcount( shm ), 0, __ATOMIC_RELAXED );
+        __atomic_store_n( msync_alive( shm ), 0, __ATOMIC_SEQ_CST );
+        __ulock_wake( UL_COMPARE_AND_WAIT_SHARED | ULF_WAKE_ALL, (void *)shm, 0 );
+    }
+}
+
+static inline void signal_all_internal( unsigned int shm_idx )
+{
+    struct sem_node *current;
+    struct sem_list *list;
+
+    if (!valid_shm_idx( shm_idx )) return;
+
+    list = mach_semaphore_map + shm_idx;
+    while ((current = list->head) != NULL)
+    {
+        wait_group_signal( current->group );
+        unlink_sem_node( current );
+    }
+}
+
+#define MSYNC_MSG_DESTROY_FLAG     (1u << 28)
+#define MSYNC_MSG_CLEANUP_TID_FLAG (1u << 29)
+
+static inline mach_msg_return_t destroy_all( unsigned int shm_idx )
+{
+    mach_msg_header_t send_header = { 0 };
+    send_header.msgh_bits = MACH_MSGH_BITS_REMOTE( MACH_MSG_TYPE_COPY_SEND );
+    send_header.msgh_id = shm_idx | MSYNC_MSG_DESTROY_FLAG;
+    send_header.msgh_size = sizeof(send_header);
+    send_header.msgh_remote_port = receive_port;
+
+    return mach_msg2( &send_header, MACH_SEND_MSG, send_header.msgh_size,
+                      0, MACH_PORT_NULL, MACH_MSG_TIMEOUT_NONE, 0 );
+}
+
+static inline mach_msg_return_t signal_all( unsigned int shm_idx, int *shm )
+{
+    mach_msg_header_t send_header = { 0 };
+
+    if (!msync_signal_wake( &send_header, shm_idx, shm, receive_port ))
+        return MACH_MSG_SUCCESS;
+
+    return mach_msg2( &send_header, MACH_SEND_MSG, send_header.msgh_size,
+                      0, MACH_PORT_NULL, MACH_MSG_TIMEOUT_NONE, 0 );
+}
+
+void msync_cleanup_thread( thread_id_t tid )
+{
+    mach_msg_header_t send_header = { 0 };
+
+    if (!is_msync_initialized || !tid || (tid & ~0x0fffffffu)) return;
+
+    send_header.msgh_bits = MACH_MSGH_BITS_REMOTE( MACH_MSG_TYPE_COPY_SEND );
+    send_header.msgh_id = (unsigned int)tid | MSYNC_MSG_CLEANUP_TID_FLAG;
+    send_header.msgh_size = sizeof(send_header);
+    send_header.msgh_remote_port = receive_port;
+
+    mach_msg2( &send_header, MACH_SEND_MSG, send_header.msgh_size,
+               0, MACH_PORT_NULL, MACH_MSG_TIMEOUT_NONE, 0 );
+}
+
+typedef struct
+{
+    mach_msg_header_t header;
+    mach_msg_body_t body;
+    mach_msg_port_descriptor_t descriptor;
+    unsigned int shm_idx[MAXIMUM_WAIT_OBJECTS + 1];
+    mach_msg_trailer_t trailer;
+} mach_register_message_t;
+
+typedef struct
+{
+    mach_msg_header_t header;
+    unsigned int shm_idx[MAXIMUM_WAIT_OBJECTS + 1];
+    mach_msg_trailer_t trailer;
+} mach_unregister_message_t;
+
+static inline mach_msg_return_t receive_mach_msg( mach_register_message_t *buffer )
+{
+    return mach_msg2( (mach_msg_header_t *)buffer, MACH_RCV_MSG, 0,
+                      sizeof(*buffer), receive_port, MACH_MSG_TIMEOUT_NONE, 0 );
+}
+
+static inline void decode_msgh_id( unsigned int msgh_id, unsigned int *tid, unsigned int *count )
+{
+    *tid = msgh_id >> 8;
+    *count = msgh_id & 0xFF;
+}
+
+static inline unsigned int take_flag_bit28( unsigned int *value )
+{
+    unsigned int flag = (*value >> 28) & 1;
+    *value &= ~(1 << 28);
+    return flag;
+}
+
+static void *mach_message_pump( void *args )
+{
+    int i, val;
+    unsigned int tid, count, is_mutex;
+    int *addr;
+    mach_msg_return_t mr;
+    semaphore_t sem;
+    mach_register_message_t receive_message = { 0 };
+    mach_unregister_message_t *mach_unregister_message;
+    sigset_t set;
+
+    sigfillset( &set );
+    pthread_sigmask( SIG_BLOCK, &set, NULL );
+
+    for (;;)
+    {
+        mr = receive_mach_msg( &receive_message );
+        if (mr != MACH_MSG_SUCCESS)
+        {
+            fprintf( stderr, "msync: failed to receive message\n" );
+            continue;
+        }
+
+        if (receive_message.header.msgh_size == sizeof(mach_msg_header_t))
+        {
+            unsigned int id = receive_message.header.msgh_id;
+
+            if (id & MSYNC_MSG_CLEANUP_TID_FLAG)
+                cleanup_tid_internal( (int)(id & ~MSYNC_MSG_CLEANUP_TID_FLAG) );
+            else if (id & MSYNC_MSG_DESTROY_FLAG)
+                destroy_all_internal( id & ~MSYNC_MSG_DESTROY_FLAG );
+            else
+                signal_all_internal( id );
+            continue;
+        }
+
+        decode_msgh_id( receive_message.header.msgh_id, &tid, &count );
+
+        if (!count || count > ARRAY_SIZE(receive_message.shm_idx))
+        {
+            if (MACH_MSGH_BITS_IS_COMPLEX( receive_message.header.msgh_bits ))
+                mach_port_deallocate( mach_task_self(), receive_message.descriptor.name );
+            continue;
+        }
+
+        if (!MACH_MSGH_BITS_IS_COMPLEX( receive_message.header.msgh_bits ))
+        {
+            mach_unregister_message = (mach_unregister_message_t *)&receive_message;
+            for (i = 0; i < (int)count; i++)
+                remove_sem( mach_unregister_message->shm_idx[i], tid );
+            continue;
+        }
+
+        sem = receive_message.descriptor.name;
+        {
+            int wake = 0;
+            unsigned int indices[MAXIMUM_WAIT_OBJECTS + 1];
+
+            for (i = 0; i < (int)count; i++)
+            {
+                unsigned int idx = receive_message.shm_idx[i];
+
+                is_mutex = take_flag_bit28( &idx );
+                indices[i] = idx;
+
+                if (!(addr = (int *)get_valid_shm( idx )))
+                {
+                    wake = 1;
+                    break;
+                }
+                val = __atomic_load_n( addr, __ATOMIC_SEQ_CST );
+                if ((is_mutex && (val == 0 || val == ~0 || val == (int)tid)) ||
+                    (!is_mutex && val != 0) ||
+                    !__atomic_load_n( msync_alive( addr ), __ATOMIC_SEQ_CST ))
+                {
+                    wake = 1;
+                    break;
+                }
+            }
+
+            if (wake)
+            {
+                semaphore_signal( sem );
+                mach_port_deallocate( mach_task_self(), sem );
+                continue;
+            }
+
+            {
+                struct wait_group *group = group_pool_alloc();
+                group->sem = sem;
+                group->refcount = count;
+                group->signaled = 0;
+                group->tid = (int)tid;
+                group->nodes_head = NULL;
+                active_group_add( group );
+
+                for (i = 0; i < (int)count; i++)
+                    add_sem( indices[i], group, tid );
+            }
+        }
+    }
+
+    return NULL;
+}
+
+static char shm_name[MSYNC_SHM_NAME_LEN];
+static const off_t shm_size = (off_t)MAX_INDEX * MSYNC_SHM_SLOT_SIZE;
+static struct msync_shm_map shm_map;
+static pthread_t message_thread;
+
+struct retained_mutex
+{
+    struct list  entry;
+    unsigned int shm_idx;
+};
+
+static struct list retained_mutexes = LIST_INIT( retained_mutexes );
+
+static void cleanup(void)
+{
+    struct retained_mutex *ret, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( ret, next, &retained_mutexes, struct retained_mutex, entry )
+    {
+        list_remove( &ret->entry );
+        free( ret );
+    }
+
+    close( shm_map.fd );
+    if (shm_unlink( shm_name ) == -1)
+        perror( "shm_unlink" );
+}
+
+static void set_thread_policy_qos( mach_port_t mach_thread_id )
+{
+    thread_extended_policy_data_t extended_policy;
+    thread_precedence_policy_data_t precedence_policy;
+    int throughput_qos, latency_qos;
+    kern_return_t kr;
+
+    latency_qos = LATENCY_QOS_TIER_0;
+    kr = thread_policy_set( mach_thread_id, THREAD_LATENCY_QOS_POLICY,
+                            (thread_policy_t)&latency_qos,
+                            THREAD_LATENCY_QOS_POLICY_COUNT );
+    if (kr != KERN_SUCCESS)
+        fprintf( stderr, "msync: error setting thread latency QoS.\n" );
+
+    throughput_qos = THROUGHPUT_QOS_TIER_0;
+    kr = thread_policy_set( mach_thread_id, THREAD_THROUGHPUT_QOS_POLICY,
+                            (thread_policy_t)&throughput_qos,
+                            THREAD_THROUGHPUT_QOS_POLICY_COUNT );
+    if (kr != KERN_SUCCESS)
+        fprintf( stderr, "msync: error setting thread throughput QoS.\n" );
+
+    extended_policy.timeshare = 0;
+    kr = thread_policy_set( mach_thread_id, THREAD_EXTENDED_POLICY,
+                            (thread_policy_t)&extended_policy,
+                            THREAD_EXTENDED_POLICY_COUNT );
+    if (kr != KERN_SUCCESS)
+        fprintf( stderr, "msync: error setting extended policy\n" );
+
+    precedence_policy.importance = 63;
+    kr = thread_policy_set( mach_thread_id, THREAD_PRECEDENCE_POLICY,
+                            (thread_policy_t)&precedence_policy,
+                            THREAD_PRECEDENCE_POLICY_COUNT );
+    if (kr != KERN_SUCCESS)
+        fprintf( stderr, "msync: error setting precedence policy\n" );
+}
+
+void msync_init(void)
+{
+    struct stat st;
+    mach_port_t bootstrap_port;
+    mach_port_limits_t limits;
+    int fd, *shm;
+    long pagesize;
+
+    if (fstat( config_dir_fd, &st ) == -1)
+        fatal_error( "cannot stat config dir\n" );
+
+    msync_shm_name( shm_name, st.st_ino );
+
+    if (!shm_unlink( shm_name ))
+        fprintf( stderr, "msync: warning: a previous shm file %s was not properly removed\n", shm_name );
+
+    fd = shm_open( shm_name, O_RDWR | O_CREAT | O_EXCL, 0644 );
+    if (fd == -1)
+    {
+        perror( "shm_open" );
+        fatal_error( "could not open msync shared memory\n" );
+    }
+    fcntl( fd, F_SETFD, FD_CLOEXEC );
+
+    if (ftruncate( fd, shm_size ) == -1)
+    {
+        perror( "ftruncate" );
+        fatal_error( "could not initialize shared memory\n" );
+    }
+
+    pagesize = sysconf( _SC_PAGESIZE );
+    if (!msync_shm_map_init( &shm_map, fd, pagesize ))
+        fatal_error( "could not allocate msync shm page table\n" );
+
+    shm = get_shm( 0 );
+    __atomic_store_n( msync_alive( shm ), 1, __ATOMIC_SEQ_CST );
+
+    MACH_CHECK_ERROR( mach_port_allocate( mach_task_self(), MACH_PORT_RIGHT_RECEIVE, &receive_port ),
+                      "mach_port_allocate" );
+    MACH_CHECK_ERROR( mach_port_insert_right( mach_task_self(), receive_port, receive_port, MACH_MSG_TYPE_MAKE_SEND ),
+                      "mach_port_insert_right" );
+
+    /* Generous default queue limit prevents sender-side mach_msg() stalls
+     * under multi-threaded burst signaling while remaining bounded. */
+    limits.mpl_qlimit = 1024;
+    if (getenv( "WINEMSYNC_QLIMIT" ))
+    {
+        int q = atoi( getenv( "WINEMSYNC_QLIMIT" ) );
+        if (q > 0) limits.mpl_qlimit = q;
+    }
+
+    MACH_CHECK_ERROR( mach_port_set_attributes( mach_task_self(), receive_port, MACH_PORT_LIMITS_INFO,
+                                                (mach_port_info_t)&limits, MACH_PORT_LIMITS_INFO_COUNT ),
+                      "mach_port_set_attributes" );
+
+    MACH_CHECK_ERROR( task_get_special_port( mach_task_self(), TASK_BOOTSTRAP_PORT, &bootstrap_port ),
+                      "task_get_special_port" );
+    MACH_CHECK_ERROR( bootstrap_register2( bootstrap_port, (char *)msync_bootstrap_name( shm_name ),
+                                           receive_port, 0 ),
+                      "bootstrap_register2" );
+    mach_port_deallocate( mach_task_self(), bootstrap_port );
+
+    pool_init();
+
+    if (pthread_create( &message_thread, NULL, mach_message_pump, NULL ))
+    {
+        perror( "pthread_create" );
+        fatal_error( "could not create mach message pump thread\n" );
+    }
+
+    set_thread_policy_qos( pthread_mach_thread_np( message_thread ) );
+
+    fprintf( stderr, "msync: bootstrapped mach port on %s.\n", msync_bootstrap_name( shm_name ) );
+    is_msync_initialized = 1;
+    fprintf( stderr, "msync: up and running.\n" );
+
+    atexit( cleanup );
+}
+
+static void *get_shm( unsigned int idx )
+{
+    struct msync_shm_map_info info;
+    void *ret = msync_shm_slot( &shm_map, idx, &info );
+
+    if (info.mmap_failed)
+    {
+        fprintf( stderr, "msync: failed to map page %d (offset %#lx): ",
+                 info.entry, info.entry * shm_map.pagesize );
+        perror( "mmap" );
+    }
+    else if (info.mapped && debug_level)
+        fprintf( stderr, "msync: Mapping page %d at %p.\n", info.entry, info.mapped );
+
+    return ret;
+}
+
+static unsigned int shm_idx_counter = 1;
+
+unsigned int msync_alloc_shm( int low, int high )
+{
+    unsigned int shm_idx, tries = 0;
+    int *shm;
+
+    if (!is_msync_initialized)
+        return 0;
+
+    shm_idx = shm_idx_counter;
+
+    for (;;)
+    {
+        if (!shm_idx) shm_idx = 1;
+        shm = get_shm( shm_idx );
+        if (!shm) fatal_error( "msync: failed to map shm slot %u\n", shm_idx );
+        if (!__atomic_load_n( msync_alive( shm ), __ATOMIC_ACQUIRE ))
+            break;
+
+        shm_idx = (shm_idx + 1) % MAX_INDEX;
+        if (++tries > MAX_INDEX)
+            fatal_error( "too many msync objects\n" );
+    }
+
+    assert( mach_semaphore_map[shm_idx].head == NULL );
+    shm_idx_counter = (shm_idx + 1) % MAX_INDEX;
+
+    /* Initialize payload and regcount BEFORE publishing alive = 1. */
+    __atomic_store_n( &shm[0], low, __ATOMIC_RELAXED );
+    __atomic_store_n( &shm[1], high, __ATOMIC_RELAXED );
+    __atomic_store_n( msync_regcount( shm ), 0, __ATOMIC_RELAXED );
+    __atomic_store_n( msync_alive( shm ), 1, __ATOMIC_SEQ_CST );
+
+    return shm_idx;
+}
+
+struct msync_event
+{
+    int signaled;
+    int unused;
+};
+C_ASSERT( sizeof(struct msync_event) == 8 );
+C_ASSERT( offsetof(struct msync_event, signaled) == 0 );
+
+struct msync_mutex
+{
+    int tid;
+    int count;
+};
+C_ASSERT( sizeof(struct msync_mutex) == 8 );
+C_ASSERT( offsetof(struct msync_mutex, tid) == 0 );
+
+void msync_signal_all( unsigned int shm_idx )
+{
+    struct msync_event *event;
+
+    if (debug_level)
+        fprintf( stderr, "msync_signal_all: index %u\n", shm_idx );
+
+    if (!valid_shm_idx( shm_idx )) return;
+
+    event = get_shm( shm_idx );
+    if (!__atomic_exchange_n( &event->signaled, 1, __ATOMIC_SEQ_CST ))
+        signal_all( shm_idx, (int *)event );
+}
+
+void msync_clear_shm( unsigned int shm_idx )
+{
+    struct msync_event *event;
+
+    if (debug_level)
+        fprintf( stderr, "msync_clear_shm: index %u\n", shm_idx );
+
+    if (!valid_shm_idx( shm_idx )) return;
+
+    event = get_shm( shm_idx );
+    __atomic_store_n( &event->signaled, 0, __ATOMIC_SEQ_CST );
+}
+
+void msync_destroy_semaphore( unsigned int shm_idx )
+{
+    if (!valid_shm_idx( shm_idx )) return;
+    destroy_all( shm_idx );
+}
+
+/* Keep an OWNED mutex's shm alive past its last-handle-close so a killed owner
+ * can still abandon it and wake any blocked waiter with STATUS_ABANDONED.
+ * Note: use get_ptid_entry() (not get_thread_from_id()) so we neither bump the
+ * thread refcount nor clobber the current request's error code. */
+void msync_destroy_mutex( unsigned int shm_idx )
+{
+    struct msync_mutex *mutex;
+    int tid;
+
+    if (!valid_shm_idx( shm_idx )) return;
+
+    mutex = get_shm( shm_idx );
+    tid = __atomic_load_n( &mutex->tid, __ATOMIC_SEQ_CST );
+    if (tid && tid != ~0 && get_ptid_entry( (unsigned int)tid ))
+    {
+        struct retained_mutex *ret = malloc( sizeof(*ret) );
+        if (ret)
+        {
+            ret->shm_idx = shm_idx;
+            list_add_tail( &retained_mutexes, &ret->entry );
+            return;
+        }
+    }
+
+    destroy_all( shm_idx );
+}
+
+void msync_abandon_mutex( unsigned int shm_idx, thread_id_t tid )
+{
+    struct msync_mutex *mutex;
+
+    if (!valid_shm_idx( shm_idx )) return;
+
+    mutex = get_shm( shm_idx );
+    if (__atomic_load_n( &mutex->tid, __ATOMIC_SEQ_CST ) == (int)tid)
+    {
+        if (debug_level)
+            fprintf( stderr, "msync_abandon_mutex: idx=%u tid=%04x\n", shm_idx, tid );
+        mutex->count = 0;
+        __atomic_store_n( &mutex->tid, ~0, __ATOMIC_SEQ_CST );
+        signal_all( shm_idx, (int *)mutex );
+    }
+}
+
+void msync_abandon_retained_mutexes( thread_id_t tid )
+{
+    struct retained_mutex *ret, *next;
+
+    /* Reclaim previously abandoned (or dead-owner) retained mutexes on a later
+     * thread exit, after any woken waiter has had a chance to observe
+     * STATUS_ABANDONED. */
+    LIST_FOR_EACH_ENTRY_SAFE( ret, next, &retained_mutexes, struct retained_mutex, entry )
+    {
+        struct msync_mutex *mutex = get_shm( ret->shm_idx );
+        int owner = __atomic_load_n( &mutex->tid, __ATOMIC_SEQ_CST );
+
+        if (owner == 0 || owner == ~0 || !get_ptid_entry( (unsigned int)owner ))
+        {
+            list_remove( &ret->entry );
+            destroy_all( ret->shm_idx );
+            free( ret );
+        }
+    }
+
+    LIST_FOR_EACH_ENTRY( ret, &retained_mutexes, struct retained_mutex, entry )
+        msync_abandon_mutex( ret->shm_idx, tid );
+}
+
+#else /* !__APPLE__ */
+
+void msync_init(void) {}
+unsigned int msync_alloc_shm( int low, int high ) { return 0; }
+void msync_signal_all( unsigned int shm_idx ) {}
+void msync_clear_shm( unsigned int shm_idx ) {}
+void msync_destroy_semaphore( unsigned int shm_idx ) {}
+void msync_destroy_mutex( unsigned int shm_idx ) {}
+void msync_abandon_mutex( unsigned int shm_idx, thread_id_t tid ) {}
+void msync_abandon_retained_mutexes( thread_id_t tid ) {}
+void msync_cleanup_thread( thread_id_t tid ) {}
+
+#endif /* __APPLE__ */
