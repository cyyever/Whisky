--- /dev/null
+++ b/dlls/ntdll/unix/msync_obj.c
@@ -0,0 +1,420 @@
+/*
+ * mach semaphore-based synchronization objects (inproc_sync client cache & ops)
+ *
+ * Copyright (C) 2018 Zebediah Figura
+ * Copyright (C) 2023 Marc-Aurel Zent
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include "msync_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(msync);
+
+#ifdef __APPLE__
+
+/* Per-handle lock-free cache: each slot packs {type (8b), shm_idx (24b),
+ * access (32b)} into a single atomic uint64_t so readers can never observe a
+ * torn combination of old shm_idx/access with a new type.
+ *
+ * Block allocation and server lookups (get_inproc_sync_fd) run under
+ * fd_cache_mutex — the exact same mutex NtClose() holds around msync_close() +
+ * close_handle — closing the close-vs-populate race completely. */
+#define MSYNC_LIST_BLOCK_SIZE  8192
+#define MSYNC_LIST_ENTRIES     64
+
+static uint64_t *msync_list[MSYNC_LIST_ENTRIES];
+static uint64_t msync_list_initial_block[MSYNC_LIST_BLOCK_SIZE];
+
+static inline UINT_PTR handle_to_index( HANDLE handle, UINT_PTR *entry )
+{
+    UINT_PTR idx = (wine_server_obj_handle( handle ) >> 2) - 1;
+    *entry = idx / MSYNC_LIST_BLOCK_SIZE;
+    return idx % MSYNC_LIST_BLOCK_SIZE;
+}
+
+static inline BOOL is_pseudo_handle( HANDLE handle )
+{
+    return ((ULONG)(ULONG_PTR)handle >= 0xfffffffa);
+}
+
+static inline uint64_t pack_cache_entry( enum msync_type type, unsigned int shm_idx, unsigned int access )
+{
+    assert( (unsigned int)type <= 0xffu );
+    assert( shm_idx < (1u << 24) );
+    return ((uint64_t)(unsigned int)type << 56) | ((uint64_t)shm_idx << 32) | (uint64_t)access;
+}
+
+static inline void unpack_cache_entry( uint64_t packed, struct msync *out )
+{
+    out->type    = (enum msync_type)(packed >> 56);
+    out->shm_idx = (unsigned int)((packed >> 32) & 0xffffffu);
+    out->access  = (unsigned int)(packed & 0xffffffffu);
+    out->shm     = msync_get_shm( out->shm_idx );
+}
+
+/* Caller must hold fd_cache_mutex. */
+static void add_to_list( HANDLE handle, enum msync_type type, unsigned int shm_idx, unsigned int access )
+{
+    UINT_PTR entry, idx;
+    uint64_t *block;
+
+    if (is_pseudo_handle( handle )) return;
+
+    idx = handle_to_index( handle, &entry );
+    if (entry >= MSYNC_LIST_ENTRIES)
+    {
+        FIXME( "too many allocated handles, not caching %p\n", handle );
+        return;
+    }
+
+    block = __atomic_load_n( &msync_list[entry], __ATOMIC_RELAXED );
+    if (!block)
+    {
+        if (!entry) block = msync_list_initial_block;
+        else
+        {
+            void *ptr = anon_mmap_alloc( MSYNC_LIST_BLOCK_SIZE * sizeof(uint64_t),
+                                         PROT_READ | PROT_WRITE );
+            if (ptr == MAP_FAILED) return;
+            block = ptr;
+        }
+        __atomic_store_n( &msync_list[entry], block, __ATOMIC_RELEASE );
+    }
+
+    __atomic_store_n( &block[idx], pack_cache_entry( type, shm_idx, access ), __ATOMIC_RELEASE );
+}
+
+static BOOL get_cached_object( HANDLE handle, struct msync *out )
+{
+    UINT_PTR entry, idx;
+    uint64_t *block, packed;
+
+    if (!handle || is_pseudo_handle( handle )) return FALSE;
+
+    idx = handle_to_index( handle, &entry );
+    if (entry >= MSYNC_LIST_ENTRIES) return FALSE;
+
+    block = __atomic_load_n( &msync_list[entry], __ATOMIC_ACQUIRE );
+    if (!block) return FALSE;
+
+    packed = __atomic_load_n( &block[idx], __ATOMIC_ACQUIRE );
+    if (!packed) return FALSE;
+
+    unpack_cache_entry( packed, out );
+    return out->shm != NULL;
+}
+
+NTSTATUS msync_get_object( HANDLE handle, struct msync *out )
+{
+    NTSTATUS ret = STATUS_SUCCESS;
+    unsigned int shm_idx = 0, access = 0;
+    enum msync_type type = 0;
+    sigset_t sigset;
+
+    if (!handle) return STATUS_INVALID_HANDLE;
+
+    if (get_cached_object( handle, out )) return STATUS_SUCCESS;
+
+    server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
+    if (get_cached_object( handle, out ))
+    {
+        server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+        return STATUS_SUCCESS;
+    }
+
+    SERVER_START_REQ( get_inproc_sync_fd )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        ret = wine_server_call( req );
+        access = reply->access;
+        if (!ret)
+        {
+            shm_idx = reply->fsync_shm_idx;
+            type    = (enum msync_type)reply->type;
+        }
+    }
+    SERVER_END_REQ;
+
+    if (!ret)
+    {
+        void *shm = msync_get_shm( shm_idx );
+        if (!shm) ret = STATUS_NO_MEMORY;
+        else
+        {
+            add_to_list( handle, type, shm_idx, access );
+            out->shm     = shm;
+            out->type    = type;
+            out->shm_idx = shm_idx;
+            out->access  = access;
+        }
+    }
+    else
+    {
+        out->shm     = NULL;
+        out->type    = 0;
+        out->shm_idx = 0;
+        out->access  = access;
+    }
+
+    server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+
+    if (!ret)
+        TRACE( "Got shm index %u type %u access %#x for handle %p.\n", shm_idx, type, access, handle );
+
+    return ret;
+}
+
+/* Caller holds fd_cache_mutex (invoked from close_inproc_sync). */
+NTSTATUS msync_close( HANDLE handle )
+{
+    UINT_PTR entry, idx;
+    uint64_t *block;
+
+    TRACE( "%p.\n", handle );
+
+    if (!handle || is_pseudo_handle( handle )) return STATUS_INVALID_HANDLE;
+
+    idx = handle_to_index( handle, &entry );
+    if (entry < MSYNC_LIST_ENTRIES &&
+        (block = __atomic_load_n( &msync_list[entry], __ATOMIC_ACQUIRE )))
+    {
+        if (__atomic_exchange_n( &block[idx], 0, __ATOMIC_SEQ_CST ))
+            return STATUS_SUCCESS;
+    }
+
+    return STATUS_INVALID_HANDLE;
+}
+
+static inline void signal_all( const struct msync *obj )
+{
+    __thread static mach_msg_header_t send_header;
+
+    if (!msync_signal_wake( &send_header, obj->shm_idx, obj->shm, msync_server_port ))
+        return;
+
+    mach_msg2( &send_header, MACH_SEND_MSG, send_header.msgh_size, 0,
+               MACH_PORT_NULL, MACH_MSG_TIMEOUT_NONE, 0 );
+}
+
+static NTSTATUS get_typed_object( HANDLE handle, int (*type_ok)(enum msync_type),
+                                  ACCESS_MASK required_access, struct msync *out )
+{
+    NTSTATUS ret = msync_get_object( handle, out );
+
+    if (ret == STATUS_NOT_IMPLEMENTED)
+        return STATUS_OBJECT_TYPE_MISMATCH;
+    if (ret) return ret;
+
+    if (!type_ok( out->type )) return STATUS_OBJECT_TYPE_MISMATCH;
+    if ((out->access & required_access) != required_access) return STATUS_ACCESS_DENIED;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_release_semaphore( HANDLE handle, ULONG count, ULONG *prev )
+{
+    struct msync obj;
+    struct semaphore *semaphore;
+    ULONG current;
+    NTSTATUS ret;
+
+    TRACE( "%p, %u, %p.\n", handle, count, prev );
+
+    if ((ret = get_typed_object( handle, msync_type_is_semaphore, SEMAPHORE_MODIFY_STATE, &obj )))
+        return ret;
+
+    if (!count) return STATUS_INVALID_PARAMETER;
+
+    semaphore = obj.shm;
+    do
+    {
+        current = __atomic_load_n( &semaphore->count, __ATOMIC_ACQUIRE );
+        if (count > (ULONG)semaphore->max - current)
+            return STATUS_SEMAPHORE_LIMIT_EXCEEDED;
+    } while (!__atomic_compare_exchange_n( &semaphore->count, (int *)&current, (int)(current + count),
+                                           0, __ATOMIC_SEQ_CST, __ATOMIC_RELAXED ));
+
+    if (prev) *prev = current;
+
+    signal_all( &obj );
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_query_semaphore( HANDLE handle, void *info )
+{
+    struct msync obj;
+    struct semaphore *semaphore;
+    SEMAPHORE_BASIC_INFORMATION *out = info;
+    NTSTATUS ret;
+
+    TRACE( "handle %p, info %p.\n", handle, info );
+
+    if ((ret = get_typed_object( handle, msync_type_is_semaphore, SEMAPHORE_QUERY_STATE, &obj )))
+        return ret;
+
+    semaphore = obj.shm;
+    out->CurrentCount = __atomic_load_n( &semaphore->count, __ATOMIC_ACQUIRE );
+    out->MaximumCount = semaphore->max;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_set_event( HANDLE handle, LONG *prev )
+{
+    struct msync obj;
+    struct event *event;
+    LONG current;
+    NTSTATUS ret;
+
+    TRACE( "%p.\n", handle );
+
+    if ((ret = get_typed_object( handle, msync_type_is_settable_event, EVENT_MODIFY_STATE, &obj )))
+        return ret;
+
+    event = obj.shm;
+    if (!(current = __atomic_exchange_n( &event->signaled, 1, __ATOMIC_SEQ_CST )))
+        signal_all( &obj );
+
+    if (prev) *prev = current;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_reset_event( HANDLE handle, LONG *prev )
+{
+    struct msync obj;
+    struct event *event;
+    LONG current;
+    NTSTATUS ret;
+
+    TRACE( "%p.\n", handle );
+
+    if ((ret = get_typed_object( handle, msync_type_is_settable_event, EVENT_MODIFY_STATE, &obj )))
+        return ret;
+
+    event = obj.shm;
+    current = __atomic_exchange_n( &event->signaled, 0, __ATOMIC_SEQ_CST );
+
+    if (prev) *prev = current;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_pulse_event( HANDLE handle, LONG *prev )
+{
+    struct msync obj;
+    struct event *event;
+    LONG current;
+    NTSTATUS ret;
+
+    TRACE( "%p.\n", handle );
+
+    if ((ret = get_typed_object( handle, msync_type_is_settable_event, EVENT_MODIFY_STATE, &obj )))
+        return ret;
+
+    event = obj.shm;
+    if (!(current = __atomic_exchange_n( &event->signaled, 1, __ATOMIC_SEQ_CST )))
+        signal_all( &obj );
+
+    sched_yield();
+
+    __atomic_store_n( &event->signaled, 0, __ATOMIC_SEQ_CST );
+
+    if (prev) *prev = current;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_query_event( HANDLE handle, void *info )
+{
+    struct msync obj;
+    struct event *event;
+    EVENT_BASIC_INFORMATION *out = info;
+    NTSTATUS ret;
+
+    TRACE( "handle %p, info %p.\n", handle, info );
+
+    if ((ret = get_typed_object( handle, msync_type_is_settable_event, EVENT_QUERY_STATE, &obj )))
+        return ret;
+
+    event = obj.shm;
+    out->EventState = __atomic_load_n( &event->signaled, __ATOMIC_ACQUIRE );
+    out->EventType  = (obj.type == MSYNC_AUTO_EVENT ? SynchronizationEvent : NotificationEvent);
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_release_mutex( HANDLE handle, LONG *prev )
+{
+    struct msync obj;
+    struct mutex *mutex;
+    NTSTATUS ret;
+
+    TRACE( "%p, %p.\n", handle, prev );
+
+    if ((ret = get_typed_object( handle, msync_type_is_mutex, 0, &obj )))
+        return ret;
+
+    mutex = obj.shm;
+    if (__atomic_load_n( &mutex->tid, __ATOMIC_ACQUIRE ) != (int)GetCurrentThreadId())
+        return STATUS_MUTANT_NOT_OWNED;
+
+    if (prev) *prev = 1 - mutex->count;
+
+    if (!--mutex->count)
+    {
+        __atomic_store_n( &mutex->tid, 0, __ATOMIC_SEQ_CST );
+        signal_all( &obj );
+    }
+
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS msync_query_mutex( HANDLE handle, void *info )
+{
+    struct msync obj;
+    struct mutex *mutex;
+    MUTANT_BASIC_INFORMATION *out = info;
+    NTSTATUS ret;
+    int tid;
+
+    TRACE( "handle %p, info %p.\n", handle, info );
+
+    if ((ret = get_typed_object( handle, msync_type_is_mutex, MUTANT_QUERY_STATE, &obj )))
+        return ret;
+
+    mutex = obj.shm;
+    tid = __atomic_load_n( &mutex->tid, __ATOMIC_ACQUIRE );
+    out->CurrentCount   = (tid && tid != ~0) ? (1 - mutex->count) : 1;
+    out->OwnedByCaller  = (tid == (int)GetCurrentThreadId());
+    out->AbandonedState = (tid == ~0);
+    return STATUS_SUCCESS;
+}
+
+#else /* !__APPLE__ */
+
+NTSTATUS msync_close( HANDLE handle ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS msync_get_object( HANDLE handle, struct msync *out ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS msync_release_semaphore( HANDLE handle, ULONG count, ULONG *prev ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS msync_query_semaphore( HANDLE handle, void *info ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS msync_set_event( HANDLE handle, LONG *prev ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS msync_reset_event( HANDLE handle, LONG *prev ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS msync_pulse_event( HANDLE handle, LONG *prev ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS msync_query_event( HANDLE handle, void *info ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS msync_release_mutex( HANDLE handle, LONG *prev ) { return STATUS_NOT_IMPLEMENTED; }
+NTSTATUS msync_query_mutex( HANDLE handle, void *info ) { return STATUS_NOT_IMPLEMENTED; }
+
+#endif /* __APPLE__ */
