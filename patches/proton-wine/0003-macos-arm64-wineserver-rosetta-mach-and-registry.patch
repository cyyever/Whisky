diff --git a/server/thread.c b/server/thread.c
index 4ac38e26..157b77d1 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -2203,6 +2203,9 @@ DECL_HANDLER(queue_apc)
     case APC_UNMAP_VIEW:
         process = get_process_from_handle( req->handle, PROCESS_VM_OPERATION );
         break;
+    case APC_FLUSH_ICACHE:
+        process = get_process_from_handle( req->handle, PROCESS_VM_WRITE );
