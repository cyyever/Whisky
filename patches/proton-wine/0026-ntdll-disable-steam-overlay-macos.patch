index 45d7a3f7466..3a5b69081f9 100644
--- a/dlls/ntdll/unix/loadorder.c
+++ b/dlls/ntdll/unix/loadorder.c
@@ -270,6 +270,60 @@ static inline enum loadorder get_env_load_order( const WCHAR *module )
 }
 
 
+/***************************************************************************
+ *	forced_load_order
+ *
+ * Resolve one of the fork's forced-load-order tables, ahead of any registry
+ * lookup. Returns LO_INVALID when `basename` is not in `names`, so the caller
+ * falls through to the normal resolution.
+ *
+ * A bottle's DllOverrides outlive whatever wrote them -- an old Whisky that
+ * dropped DXVK into a game directory as *native*, winetricks, a game's own
+ * installer -- so for the modules this fork ships or must keep out, the
+ * registry cannot be allowed the last word. WINEDLLOVERRIDES still wins: it is
+ * set per run, so it cannot go stale, and it is the lever for A/B-ing a
+ * provider or re-enabling something this fork disables.
+ *
+ * All three spellings get_load_order_value() would have tried are tried here,
+ * in its order: the full module name, "*basename", basename. add_load_order_set()
+ * stores each key verbatim and get_env_load_order() matches it whole, so checking
+ * only the bare name silently ignored "*d3d9=n" -- the form winetricks and most
+ * of the documentation use. Silently is the problem: the TRACE still said "fork
+ * builtin", so an A/B run reads as "the override made no difference to the bug".
+ *
+ * Note this writes '*' into basename[-1], as the registry path below does for
+ * the same reason; it is the same character either way, so the buffer is left
+ * exactly as that path expects to find it.
+ */
+static enum loadorder forced_load_order( const UNICODE_STRING *nt_name, const WCHAR *module,
+                                         WCHAR *basename, const WCHAR * const *names,
+                                         unsigned int count, enum loadorder forced,
+                                         const char *what )
+{
+    enum loadorder ret;
+    unsigned int i;
+
+    for (i = 0; i < count; i++)
+        if (!wcsicmp( basename, names[i] )) break;
+    if (i == count) return LO_INVALID;
+
+    if ((ret = get_env_load_order( module+1 )) == LO_INVALID)
+    {
+        basename[-1] = '*';
+        if ((ret = get_env_load_order( basename-1 )) == LO_INVALID)
+            ret = get_env_load_order( basename );
+    }
+    if (ret != LO_INVALID)
+        TRACE( "got environment %s for %s\n", debugstr_loadorder(ret), debugstr_us(nt_name) );
+    else
+    {
+        ret = forced;
+        TRACE( "got fork %s %s for %s\n", what, debugstr_loadorder(ret), debugstr_us(nt_name) );
+    }
+    return ret;
+}
+
