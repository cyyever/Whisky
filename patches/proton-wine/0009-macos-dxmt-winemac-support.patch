Subject: winemac.drv: export a Metal-view entry point for DXMT (macOS)

DXMT needs one thing from this driver: a CAMetalLayer for an HWND. Wine has no
public interface for that -- its supported graphics boundaries are OpenGL,
Vulkan and GDI -- so DXMT resolves driver-internal symbols with
dlsym(RTLD_DEFAULT), being written against 3Shain's own Wine fork. Without
something to resolve, DXMT treats the missing view as a broken Wine: it logs
"your Wine has no exported symbols needed by DXMT" and calls abort().

Export two functions for it:

    int  macdrv_dxmt_create_metal_view(UINT64 hwnd, UINT64 device,
                                       UINT64 *view, UINT64 *layer);
    void macdrv_dxmt_release_metal_view(UINT64 view);

Scalar arguments only. An earlier version of this patch instead exported a
"macdrv_functions" table plus a struct in the 8.16-era layout DXMT's copy
expected; every field of both was pointer-sized, so a rename or a reorder on
either side compiled clean on both and then called the wrong function pointer,
with the symptom surfacing far from the cause. It needed a build-time guard
script to police it. There is now nothing to police, and no such script.

The view comes from macdrv_client_surface_create() -- the call winemac's own
Vulkan driver makes to hand MoltenVK a Metal view -- registered with win32u via
add_window_client_surface(), which this patch moves from win32u_private.h to
gdi_driver.h so a driver can call it. Wine then owns repositioning on
move/resize (update_client_surfaces) and teardown on window destroy
(detach_client_surfaces), and the returned handle is the surface itself, so its
reference count is the whole lifetime rule: DXMT pairs create and release 1:1
(d3d11_swapchain.cpp:134/209) and never dereferences the handle.

Getting the view right is what this patch originally got wrong. It hand-rolled
one with macdrv_create_view() and only attached it when data->cocoa_window was
set -- true for a toplevel, never for a child HWND, which has no Cocoa window of
its own. Its own comment said as much: "Assumes the swapchain hwnd is its own
toplevel (true for the game windows DXMT renders into)." A browser is not:
Chromium/CEF and Qt WebEngine composite into a child HWND, so their GPU process
died the instant it created a swapchain -- a black window for a few seconds and
then nothing, which is what Steam and GOG showed.

Pairs with the RTLD_GLOBAL driver dlopen in dlls/ntdll/unix/loader.c, without
which dlsym cannot see driver symbols at all.

Covered by tests/dxmt-child-swapchain-test.c.

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 7c827ee2542..34f2d9c0a56 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -1010,7 +1010,21 @@ static NTSTATUS dlopen_dll( const char *so_name, UNICODE_STRING *nt_name, void *
     void *module, *handle;
     const IMAGE_NT_HEADERS *nt;
 
-    handle = dlopen( so_name, RTLD_NOW );
+    int flags = RTLD_NOW;
+
+#ifdef __APPLE__
+    /* The Mac driver only, and only so DXMT can find its Metal-view entry
+     * points with dlsym(RTLD_DEFAULT): Wine has no public interface for "give
+     * me the CAMetalLayer for this HWND", so the driver exports two functions
+     * for it (see patches/proton-wine/0009).
+     *
+     * Deliberately not RTLD_GLOBAL for every unixlib: that puts each one's
+     * default-visibility symbols into a single namespace, where a collision
+     * between two .so files silently binds to whichever loaded first. */
+    if (strstr( so_name, "winemac.so" )) flags |= RTLD_GLOBAL;
+#endif
+
+    handle = dlopen( so_name, flags );
     if (!handle)
     {
         WARN( "failed to load .so lib %s: %s\n", debugstr_a(so_name), dlerror() );
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
index dbc2d332c7e..05f73d18af6 100644
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -322,7 +322,6 @@ extern HWND get_shell_window(void);
 extern HWND get_progman_window(void);
 extern HWND get_taskman_window(void);
 extern BOOL is_client_surface_window( struct client_surface *surface, HWND hwnd );
-extern void add_window_client_surface( HWND hwnd, struct client_surface *surface );
 extern HICON get_window_icon_info( HWND hwnd, UINT type, HICON icon, ICONINFO *ret );
 extern void init_startup_info(void);
 
diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index 4f19100bbb8..f5b788311cf 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -1242,6 +1242,11 @@ void macdrv_DestroyWindow(HWND hwnd)
 
     TRACE("%p\n", hwnd);
 
+    /* Before get_win_data(): releasing the surface takes win32u's surfaces_lock
+     * and then win_data_mutex (via the detach callback), which is the order
+     * update_client_surfaces() uses. Doing it while already holding win_data
+     * would invert that pair and can deadlock against a concurrent update.
+     * Being first also means the early return below cannot leak the surface. */
     if (!(data = get_win_data(hwnd))) return;
 
     if (hwnd == get_capture()) macdrv_SetCapture(0, 0);
@@ -1644,6 +1649,7 @@ void macdrv_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UINT
 
 done:
     release_win_data(data);
+
 }
 
 
@@ -2162,3 +2168,62 @@ void init_win_context(void)
     pthread_mutex_init(&win_data_mutex, &attr);
     pthread_mutexattr_destroy(&attr);
 }
+
+/* ===== DXMT entry points =====
+ * DXMT needs one thing from this driver: a CAMetalLayer for an HWND. Wine has
+ * no public interface for that -- its supported graphics boundaries are OpenGL,
+ * Vulkan and GDI -- so DXMT resolves driver-internal symbols with
+ * dlsym(RTLD_DEFAULT), being written against 3Shain's own Wine fork. These two
+ * are what we export for it.
+ *
+ * Pairs with the RTLD_GLOBAL driver dlopen in dlls/ntdll/unix/loader.c, without
+ * which dlsym cannot see driver symbols at all. */
+
+/* Create a Metal view over hwnd's client area on DXMT's Metal device, and hand
+ * back the layer to render into.
+ *
+ * The returned handle is the client surface. DXMT stores it opaquely and only
+ * ever passes it back to the release below (d3d11_swapchain.cpp:134/209 pair
+ * them 1:1), so the surface's own reference count is the whole lifetime rule --
+ * no separate per-window registry, exactly as winemac's Vulkan driver does it.
+ *
+ * Registering with win32u also means Wine repositions the view on move/resize
+ * and detaches it on window destroy. Getting *that* wrong is what this patch
+ * originally got wrong: a child HWND has no Cocoa window of its own, the
+ * hand-rolled view was never created for one, and DXMT reads a NULL view as a
+ * broken Wine and calls abort() -- so a browser, which composites into child
+ * HWNDs, lost its GPU process the instant it made a swapchain.
+ *
+ * Returns 0 on failure with both outputs zeroed. */
+__attribute__((visibility("default")))
+int macdrv_dxmt_create_metal_view( UINT64 hwnd, UINT64 device, UINT64 *ret_view, UINT64 *ret_layer )
+{
+    struct macdrv_client_surface *surface;
+    macdrv_metal_view view;
+
+    *ret_view = *ret_layer = 0;
+    if (!(surface = macdrv_client_surface_create( (HWND)(ULONG_PTR)hwnd ))) return 0;
+    if (!(view = macdrv_view_create_metal_view( surface->cocoa_view,
+                                                (macdrv_metal_device)(ULONG_PTR)device )))
+    {
+        client_surface_release( &surface->client );
+        return 0;
+    }
+
+    /* Hand the view to the surface so macdrv_client_surface_destroy() releases
+     * it; DXMT owns the device, so metal_device stays NULL and is not touched. */
+    surface->metal_view = view;
+    add_window_client_surface( (HWND)(ULONG_PTR)hwnd, &surface->client );
+
+    *ret_view = (UINT64)(ULONG_PTR)surface;
+    *ret_layer = (UINT64)(ULONG_PTR)macdrv_view_get_metal_layer( view );
+    return 1;
+}
+
+__attribute__((visibility("default")))
+void macdrv_dxmt_release_metal_view( UINT64 handle )
+{
+    struct macdrv_client_surface *surface = (struct macdrv_client_surface *)(ULONG_PTR)handle;
+
+    if (surface) client_surface_release( &surface->client );
+}
diff --git a/include/wine/gdi_driver.h b/include/wine/gdi_driver.h
index 34075ed7cfa..b3de8cf4747 100644
--- a/include/wine/gdi_driver.h
+++ b/include/wine/gdi_driver.h
@@ -273,6 +273,7 @@ W32KAPI void client_surface_add_ref( struct client_surface *surface );
 W32KAPI void client_surface_release( struct client_surface *surface );
 W32KAPI void client_surface_present( struct client_surface *surface );
 W32KAPI void client_surface_update( struct client_surface *surface );
+W32KAPI void add_window_client_surface( HWND hwnd, struct client_surface *surface );
 W32KAPI void detach_client_surfaces( HWND hwnd );
 
 static inline const char *debugstr_client_surface( struct client_surface *surface )
