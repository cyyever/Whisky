+    MEV_CACHE_FULL    = 12,  /* add_to_list failed -> STATUS_NO_MEMORY */
+    MEV_SIGWAIT_SRV   = 13,  /* signal_and_wait fell through to server_wait_for_object */
+    MEV_SIGWAIT_RET   = 14,  /* ...and what that returned (a = status) */
+};
