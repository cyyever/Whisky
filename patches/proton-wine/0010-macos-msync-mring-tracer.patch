+/* ---- MRING: lock-free client wait-path tracer (heisenbug-safe) -------------
+ * Records, with no syscall/lock/fprintf on the hot path (one atomic fetch-add +
+ * plain stores), the exact msync objects each thread is about to block on. A
+ * background thread snapshots it to /tmp/mring_<pid>.log so we can read which
+ * shm_idx+type a STUCK thread is parked on -- the fprintf probes add latency
+ * that reorders the sub-microsecond race away. Enabled by WINE_MRING=1. Remove
+ * after use. */
+#define MRING_N 8192
+struct mring_ent { unsigned long long seq; unsigned int tid, shm_idx; int ev, type, a, b; };
+static struct mring_ent mring[MRING_N];
+static unsigned long long mring_pos;
+int msync_mring_on;
+
+void msync_mrec( int ev, unsigned int shm_idx, int type, int a, int b )
+{
+    unsigned long long s;
+    unsigned int i;
+    if (!msync_mring_on) return;
+    s = __atomic_fetch_add( &mring_pos, 1, __ATOMIC_RELAXED );
+    i = (unsigned int)(s & (MRING_N - 1));
+    mring[i].tid = GetCurrentThreadId();
+    mring[i].shm_idx = shm_idx;
+    mring[i].ev = ev;
+    mring[i].type = type;
+    mring[i].a = a;
+    mring[i].b = b;
+    __atomic_store_n( &mring[i].seq, s + 1, __ATOMIC_RELEASE ); /* seq = s+1 so 0 means empty */
+}
+
+/* Read an already-mapped slot, or NULL. Deliberately cannot map: see the dump
+ * thread below. */
+static void *peek_shm( unsigned int idx )
+{
+    int entry  = (idx * MSYNC_SHM_SLOT_SIZE) / shm_map.pagesize;
+    int offset = (idx * MSYNC_SHM_SLOT_SIZE) % shm_map.pagesize;
+    void *ret = NULL;
+
+    os_unfair_lock_lock( &shm_addrs_lock );
+    if (entry < shm_map.addrs_size && shm_map.addrs[entry])
+        ret = (char *)shm_map.addrs[entry] + offset;
+    os_unfair_lock_unlock( &shm_addrs_lock );
+
+    return ret;
+}
+
+static void *mring_dump_thread( void *arg )
+{
+    char path[64];
+    snprintf( path, sizeof(path), "/tmp/mring_%d.log", (int)getpid() );
+    for (;;)
+    {
+        FILE *f;
+        unsigned long long pos, start, k;
+        usleep( 300000 );
+        pos = __atomic_load_n( &mring_pos, __ATOMIC_ACQUIRE );
+        if (!pos || !(f = fopen( path, "w" ))) continue;
+        start = pos > MRING_N ? pos - MRING_N : 0;
+        for (k = start; k < pos; k++)
+        {
+            struct mring_ent *e = &mring[k & (MRING_N - 1)];
+            int cur = -1;
+            if (__atomic_load_n( &e->seq, __ATOMIC_ACQUIRE ) != k + 1) continue;
+            /* Current signaled value of the object NOW (dump-time): distinguishes a
+             * lost wakeup (cur=1 but the thread still parked) from a legit wait
+             * (cur=0). peek_shm(), not msync_get_shm(): the dumper must not map pages.
+             * cur=-1 means "not mapped in this process". Note the index can have
+             * been recycled since the entry was written, so cur is a hint. */
+            if (e->ev == MEV_WAIT && e->shm_idx)
+            {
+                int *addr = peek_shm( e->shm_idx );
+                if (addr) cur = __atomic_load_n( addr, __ATOMIC_ACQUIRE );
+            }
+            fprintf( f, "%llu tid=%04x ev=%d idx=%u type=%d a=%d b=%d cur=%d\n",
+                     k, e->tid, e->ev, e->shm_idx, e->type, e->a, e->b, cur );
+        }
+        fclose( f );
+    }
+    return NULL;
+}
+
 void msync_init(void)
 {
     struct stat st;
@@ -292,4 +372,16 @@ void msync_init(void)
         exit(1);
     }
 
+    /* MRING */
+    {
+        const char *e = getenv( "WINE_MRING" );
+
+        if (e && *e != '0')
+        {
+            pthread_t t;
+
+            msync_mring_on = 1;
+            if (!pthread_create( &t, NULL, mring_dump_thread, NULL )) pthread_detach( t );
+        }
+    }
 }
