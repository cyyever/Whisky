+/* Temporary, paired with the client's MRING (patches/proton-wine 0010).
+ *
+ * Every rejection added by the 2026-08-07 hardening is silent: the pump's
+ * fprintf()s are gated on debug_level, and Whisky launches with WINEDEBUG=-all,
+ * so a wait that gets dropped here looks identical to one that never arrived.
+ * If any of these fire during a Steam session they are the regression; if none
+ * do, the server half is cleared and the hunt moves to the client. Writes to
+ * /tmp/msync_srv_<pid>.log, armed by WINE_MRING like its client counterpart. */
+void msync_srv_note( const char *fmt, ... )
+{
+    static int armed = -1;
+    static FILE *f;
+    va_list ap;
+
+    if (armed == -1)
+    {
+        const char *e = getenv( "WINE_MRING" );
+        armed = e && *e != '0';
+        if (armed)
+        {
+            char path[64];
+            snprintf( path, sizeof(path), "/tmp/msync_srv_%d.log", (int)getpid() );
+            f = fopen( path, "w" );
+        }
+    }
+    if (!armed || !f) return;
+    va_start( ap, fmt );
+    vfprintf( f, fmt, ap );
+    va_end( ap );
+    fputc( '\n', f );
+    fflush( f );
+}
