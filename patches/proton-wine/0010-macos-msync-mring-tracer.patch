diff --git a/dlls/ntdll/unix/msync_shm.c b/dlls/ntdll/unix/msync_shm.c
index a6f18f60d40..beb889d17c0 100644
--- a/dlls/ntdll/unix/msync_shm.c
+++ b/dlls/ntdll/unix/msync_shm.c
@@ -233,6 +233,86 @@ void *msync_get_shm( unsigned int idx )
     return ret;
