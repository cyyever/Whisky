Subject: TEMP probe: where the quartz streaming thread parks

Delete when the SSFIV movie stall is understood.
---
--- a/dlls/winegstreamer/quartz_parser.c
+++ b/dlls/winegstreamer/quartz_parser.c
@@ -1478,8 +1478,18 @@
 
         EnterCriticalSection(&filter->streaming_cs);
 
-        while (filter->flushing)
-            SleepConditionVariableCS(&filter->flushing_cv, &filter->streaming_cs, INFINITE);
+        if (filter->flushing)
+        {
+            /* Probe: the streaming thread parks here whenever the filter is
+             * flushing, and if flushing is never cleared it never asks for
+             * another buffer -- gstreamer then blocks in sink_chain_cb with a
+             * full queue, which is the shape of SSFIV's movie stall. Report
+             * entering and leaving so a stall shows as an enter with no exit. */
+            ERR("QZSTALL pin %p entering FLUSHING wait\n", pin);
+            while (filter->flushing)
+                SleepConditionVariableCS(&filter->flushing_cv, &filter->streaming_cs, INFINITE);
+            ERR("QZSTALL pin %p left FLUSHING wait\n", pin);
+        }
 
         if (!filter->streaming)
         {
@@ -1493,11 +1503,20 @@
 
         if (pin->eos)
         {
+            ERR("QZSTALL pin %p entering EOS wait\n", pin);
             SleepConditionVariableCS(&pin->eos_cv, &pin->flushing_cs, INFINITE);
+            ERR("QZSTALL pin %p left EOS wait\n", pin);
             LeaveCriticalSection(&pin->flushing_cs);
             continue;
         }
 
+        {
+            /* Sampled: one line in 500 keeps the pulse visible without the I/O
+             * of logging every buffer, and a stall shows as the pulse stopping. */
+            static LONG probe_n;
+            if (!(InterlockedIncrement(&probe_n) % 500))
+                ERR("QZSTALL pin %p get_buffer pulse n=%ld\n", pin, probe_n);
+        }
         if (wg_parser_stream_get_buffer(filter->wg_parser, pin->wg_stream, &buffer))
         {
             send_buffer(pin, filter, &buffer);
