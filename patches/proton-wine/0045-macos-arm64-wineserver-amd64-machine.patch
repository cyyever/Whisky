Subject: [PATCH] server: advertise AMD64/I386 machines for arm64 wineserver on macOS

On Apple Silicon, wine64 clients run as x86_64 under Rosetta 2 while
wineserver is an independent daemon that executes no Windows code and
can run natively as arm64. When built for arm64 on macOS, advertise
IMAGE_FILE_MACHINE_AMD64 + IMAGE_FILE_MACHINE_I386 instead of ARM64 so
64-bit x86_64 prefixes and Rosetta clients work seamlessly.

--- a/server/registry.c
+++ b/server/registry.c
@@ -1872,7 +1872,7 @@
     unsigned int count = 0;
 #ifdef __i386__
     if (prefix_type == PREFIX_32BIT) supported_machines[count++] = IMAGE_FILE_MACHINE_I386;
-#elif defined(__x86_64__)
+#elif defined(__x86_64__) || (defined(__aarch64__) && defined(__APPLE__))
     if (prefix_type == PREFIX_64BIT) supported_machines[count++] = IMAGE_FILE_MACHINE_AMD64;
     supported_machines[count++] = IMAGE_FILE_MACHINE_I386;
 #elif defined(__arm__)
