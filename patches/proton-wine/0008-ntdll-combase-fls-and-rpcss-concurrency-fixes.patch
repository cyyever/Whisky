Subject: [PATCH] ntdll/combase: unlock around FLS callbacks and fix rpcss cold-start race

Consolidated patches:
  - (0010) combase: wait for the RpcSs endpoint on cold start
subj='combase: wait for the RpcSs endpoint on cold start'
  - (0011) ntdll: do not hold fls_section while running FLS callbacks

---
diff --git a/dlls/combase/rpc.c b/dlls/combase/rpc.c
index c51b59de..c5baab84 100644
--- a/dlls/combase/rpc.c
+++ b/dlls/combase/rpc.c
@@ -184,53 +184,57 @@ static LONG WINAPI rpc_filter(EXCEPTION_POINTERS *eptr)
 
 static BOOL start_rpcss(void)
 {
-    SERVICE_STATUS_PROCESS status;
+    /* ncalrpc maps IRPCSS_ENDPOINT to this pipe; derive it so it can't drift. */
+    static const WCHAR ncalrpc_pipe_prefixW[] = L"\\\\.\\pipe\\lrpc\\";
+    unsigned short irpcss_endpoint[] = IRPCSS_ENDPOINT;
+    WCHAR irpcss_pipeW[ARRAY_SIZE(ncalrpc_pipe_prefixW) + ARRAY_SIZE(irpcss_endpoint)];
     SC_HANDLE scm, service;
-    BOOL ret = FALSE;
+    ULONGLONG start_time;
 
     TRACE("\n");
 
-    if (!(scm = OpenSCManagerW(NULL, NULL, 0)))
-    {
-        ERR("Failed to open service manager\n");
-        return FALSE;
-    }
-
-    if (!(service = OpenServiceW(scm, L"RpcSs", SERVICE_START | SERVICE_QUERY_STATUS)))
-    {
-        ERR("Failed to open RpcSs service\n");
-        CloseServiceHandle( scm );
-        return FALSE;
-    }
+    wcscpy( irpcss_pipeW, ncalrpc_pipe_prefixW );
+    wcscat( irpcss_pipeW, (const WCHAR *)irpcss_endpoint );
 
-    if (StartServiceW(service, 0, NULL) || GetLastError() == ERROR_SERVICE_ALREADY_RUNNING)
+    /* Best-effort: nudge the SCM to start RpcSs. On a cold start the SCM itself,
+     * or the RpcSs service entry, may not be reachable yet (services.exe is
+     * still coming up) -- that is not fatal here, since RpcSs is also started
+     * automatically by services.exe. We wait for its endpoint below regardless
+     * of how it ends up getting started. */
+    if ((scm = OpenSCManagerW(NULL, NULL, 0)))
     {
-        ULONGLONG start_time = GetTickCount64();
-        do
+        if ((service = OpenServiceW(scm, L"RpcSs", SERVICE_START | SERVICE_QUERY_STATUS)))
         {
-            DWORD dummy;
-
-            if (!QueryServiceStatusEx(service, SC_STATUS_PROCESS_INFO, (BYTE *)&status, sizeof(status), &dummy))
-                break;
-            if (status.dwCurrentState == SERVICE_RUNNING)
-            {
-                ret = TRUE;
-                break;
-            }
-            if (GetTickCount64() - start_time > 30000) break;
-            Sleep( 100 );
-
-        } while (status.dwCurrentState == SERVICE_START_PENDING);
-
-        if (status.dwCurrentState != SERVICE_RUNNING)
-            WARN("RpcSs failed to start %lu\n", status.dwCurrentState);
+            if (!StartServiceW(service, 0, NULL) && GetLastError() != ERROR_SERVICE_ALREADY_RUNNING)
+                WARN("Failed to start RpcSs service\n");
+            CloseServiceHandle(service);
+        }
+        else
+            WARN("Failed to open RpcSs service\n");
+        CloseServiceHandle(scm);
     }
     else
-        ERR("Failed to start RpcSs service\n");
-
-    CloseServiceHandle(service);
-    CloseServiceHandle(scm);
-    return ret;
+        WARN("Failed to open service manager\n");
+
+    /* Wait for rpcss to actually be connectable before telling the caller to
+     * retry. Relying on the service state alone is racy: on slow cold starts
+     * (notably macOS under Rosetta, where services boot asynchronously and far
+     * more slowly) rpcss may not be running yet when we get here, or may report
+     * SERVICE_RUNNING before it has created its ncalrpc endpoint -- in which
+     * case the COM activation that called us would simply fail again with
+     * RPC_S_SERVER_UNAVAILABLE, and the client would crash. Block until the
+     * endpoint pipe exists, bounded so we still give up if rpcss genuinely
+     * never appears. */
+    start_time = GetTickCount64();
+    do
+    {
+        if (WaitNamedPipeW( irpcss_pipeW, 1000 ))
+            return TRUE;
+        Sleep( 50 );
+    } while (GetTickCount64() - start_time < 30000);
+
+    ERR("timed out waiting for the RpcSs endpoint to become available\n");
+    return FALSE;
 }
 
 static RPC_BINDING_HANDLE get_rpc_handle(unsigned short *protseq, unsigned short *endpoint)
diff --git a/dlls/ntdll/thread.c b/dlls/ntdll/thread.c
index 0869b3b4..437dca66 100644
--- a/dlls/ntdll/thread.c
+++ b/dlls/ntdll/thread.c
@@ -621,20 +621,29 @@ NTSTATUS WINAPI DECLSPEC_HOTPATCH RtlFlsFree( ULONG index )
         return STATUS_INVALID_PARAMETER;
     }
 
+restart:
     for (entry = fls_data.fls_list_head.Flink; entry != &fls_data.fls_list_head; entry = entry->Flink)
     {
         TEB_FLS_DATA *fls = CONTAINING_RECORD(entry, TEB_FLS_DATA, fls_list_entry);
+        void *fls_arg;
 
-        if (fls->fls_data_chunks[chunk_index] && fls->fls_data_chunks[chunk_index][idx + 1])
+        if (!fls->fls_data_chunks[chunk_index] || !(fls_arg = fls->fls_data_chunks[chunk_index][idx + 1]))
+            continue;
+
+        /* Clear the slot before invoking so a rescan or concurrent teardown
+         * never calls it twice. */
+        fls->fls_data_chunks[chunk_index][idx + 1] = NULL;
+        if (callback != (void *)~(ULONG_PTR)0)
         {
-            if (callback != (void *)~(ULONG_PTR)0)
-            {
-                TRACE_(relay)("Calling FLS callback %p, arg %p.\n", callback,
-                        fls->fls_data_chunks[chunk_index][idx + 1]);
+            TRACE_(relay)("Calling FLS callback %p, arg %p.\n", callback, fls_arg);
 
-                callback( fls->fls_data_chunks[chunk_index][idx + 1] );
-            }
-            fls->fls_data_chunks[chunk_index][idx + 1] = NULL;
+            /* Call without fls_section held: a callback may block on a thread
+             * that itself needs the lock (Windows holds no lock here). The list
+             * can change while unlocked, so rescan from the head afterwards. */
+            unlock_fls_data();
+            callback( fls_arg );
+            lock_fls_data();
+            goto restart;
         }
     }
 
@@ -711,6 +720,7 @@ void WINAPI DECLSPEC_HOTPATCH RtlProcessFlsData( void *teb_fls_data, ULONG flags
     if (flags & 1)
     {
         lock_fls_data();
+restart:
         for (i = 0; i < ARRAY_SIZE(fls->fls_data_chunks); ++i)
         {
             if (!fls->fls_data_chunks[i] || !fls_data.fls_callback_chunks[i]
@@ -720,18 +730,23 @@ void WINAPI DECLSPEC_HOTPATCH RtlProcessFlsData( void *teb_fls_data, ULONG flags
             for (index = 0; index < fls_chunk_size( i ); ++index)
             {
                 PFLS_CALLBACK_FUNCTION callback = fls_data.fls_callback_chunks[i]->callbacks[index].callback;
+                void *fls_arg = fls->fls_data_chunks[i][index + 1];
 
-                if (!fls->fls_data_chunks[i][index + 1])
+                if (!fls_arg)
                     continue;
 
+                /* Clear before invoking so a rescan or concurrent free can't double-call. */
+                fls->fls_data_chunks[i][index + 1] = NULL;
                 if (callback && callback != (void *)~(ULONG_PTR)0)
                 {
-                    TRACE_(relay)("Calling FLS callback %p, arg %p.\n", callback,
-                            fls->fls_data_chunks[i][index + 1]);
+                    TRACE_(relay)("Calling FLS callback %p, arg %p.\n", callback, fls_arg);
 
-                    callback( fls->fls_data_chunks[i][index + 1] );
+                    /* Call without fls_section held (see RtlFlsFree); rescan after. */
+                    unlock_fls_data();
+                    callback( fls_arg );
+                    lock_fls_data();
+                    goto restart;
                 }
-                fls->fls_data_chunks[i][index + 1] = NULL;
             }
         }
         /* Not using RemoveEntryList() as Windows does not zero list entry here. */
