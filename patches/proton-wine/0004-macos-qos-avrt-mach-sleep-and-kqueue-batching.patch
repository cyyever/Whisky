@@ -2505,7 +2505,67 @@ NTSTATUS WINAPI NtDelayExecution( BOOLEAN alertable, const LARGE_INTEGER *timeou
         LARGE_INTEGER now;
         timeout_t when, diff;
 
-        if ((when = timeout->QuadPart) < 0)
+        when = timeout->QuadPart;
+        if (!when) return NtYieldExecution();
+
+#ifdef __APPLE__
+        {
+            static int mach_sleep_mode = -1;
+            if (mach_sleep_mode == -1)
+            {
+                const char *no_mach = getenv( "WHISKY_NO_MACH_SLEEP" );
+                const char *do_yield = getenv( "WHISKY_MACH_SLEEP_YIELD" );
+                const char *dbg = getenv( "WHISKY_SCHED_DEBUG" );
+                if (no_mach && atoi( no_mach )) mach_sleep_mode = 1;
+                else if (do_yield && atoi( do_yield )) mach_sleep_mode = 2;
+                else mach_sleep_mode = 0;
+                if (dbg && atoi( dbg ))
+                    fprintf( stderr, "[whisky-sched] NtDelayExecution mode=%s\n",
+                             mach_sleep_mode == 1 ? "select+yield" :
+                             mach_sleep_mode == 2 ? "mach+yield" : "mach" );
+            }
+            if (mach_sleep_mode != 1)
+            {
+                if (mach_sleep_mode == 2) NtYieldExecution();
+                if (when < 0)
+                {
+                    ULONGLONG rel_100ns = (ULONGLONG)(-when);
+                    if (rel_100ns <= 30 * (ULONGLONG)TICKSPERSEC)
+                    {
+                        static mach_timebase_info_data_t tb;
+                        uint64_t ticks, deadline;
+
+                        if (!tb.denom) mach_timebase_info( &tb );
+                        ticks = (uint64_t)(((__uint128_t)rel_100ns * 100 * tb.denom + tb.numer - 1) / tb.numer);
+                        deadline = mach_absolute_time() + ticks;
+                        while (mach_wait_until( deadline ) == KERN_ABORTED && mach_absolute_time() < deadline) {}
+                        return STATUS_SUCCESS;
+                    }
+                    NtQuerySystemTime( &now );
+                    when = now.QuadPart - when;
+                }
+                else
+                {
+                    NtQuerySystemTime( &now );
+                    diff = when - now.QuadPart;
+                    if (diff <= 0) return STATUS_SUCCESS;
+                    if (diff <= 30 * (timeout_t)TICKSPERSEC)
+                    {
+                        static mach_timebase_info_data_t tb;
+                        uint64_t ticks, deadline;
+
+                        if (!tb.denom) mach_timebase_info( &tb );
+                        ticks = (uint64_t)(((__uint128_t)(ULONGLONG)diff * 100 * tb.denom + tb.numer - 1) / tb.numer);
+                        deadline = mach_absolute_time() + ticks;
+                        while (mach_wait_until( deadline ) == KERN_ABORTED && mach_absolute_time() < deadline) {}
+                        return STATUS_SUCCESS;
+                    }
+                }
+                goto do_select;
+            }
+        }
+#endif
+        if (when < 0)
         {
             NtQuerySystemTime( &now );
             when = now.QuadPart - when;
@@ -2516,6 +2576,9 @@ NTSTATUS WINAPI NtDelayExecution( BOOLEAN alertable, const LARGE_INTEGER *timeou
         status = NtYieldExecution();
         if (!when) return status;
 
+#ifdef __APPLE__
+    do_select:
+#endif
         for (;;)
         {
             struct timeval tv;
