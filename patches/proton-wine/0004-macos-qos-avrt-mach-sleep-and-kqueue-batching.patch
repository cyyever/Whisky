diff --git a/server/fd.c b/server/fd.c
index aa71e6df..47455991 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -644,47 +644,79 @@ static inline void main_loop_epoll(void)
 #elif defined(HAVE_KQUEUE)
 
 static int kqueue_fd = -1;
+static struct kevent kq_changes[128];
+static int kq_nchanges = 0;
 
 static inline void init_epoll(void)
 {
     kqueue_fd = kqueue();
+    kq_nchanges = 0;
 }
 
-static inline void set_fd_epoll_events( struct fd *fd, int user, int events )
+static void flush_kqueue_changes(void)
 {
-    struct kevent ev[2];
+    if (kqueue_fd == -1 || !kq_nchanges) return;
+
+    if (kevent( kqueue_fd, kq_changes, kq_nchanges, NULL, 0, NULL ) == -1)
+    {
+        if (errno == ENOMEM)  /* not enough memory, give up on kqueue */
+        {
+            close( kqueue_fd );
+            kqueue_fd = -1;
+        }
+        else if (errno != ENOENT && errno != EBADF)
+            perror( "kevent" );  /* should not happen */
+    }
+    kq_nchanges = 0;
+}
 
+static inline void queue_kqueue_change( uintptr_t ident, short filter, u_short flags,
+                                        u_int fflags, intptr_t data, void *udata )
+{
+    if (kq_nchanges >= (int)ARRAY_SIZE( kq_changes )) flush_kqueue_changes();
     if (kqueue_fd == -1) return;
+    EV_SET( &kq_changes[kq_nchanges++], ident, filter, flags, fflags, data, udata );
+}
 
-    EV_SET( &ev[0], fd->unix_fd, EVFILT_READ, 0, NOTE_LOWAT, 1, (void *)(long)user );
-    EV_SET( &ev[1], fd->unix_fd, EVFILT_WRITE, 0, NOTE_LOWAT, 1, (void *)(long)user );
+static inline void set_fd_epoll_events( struct fd *fd, int user, int events )
+{
+    if (kqueue_fd == -1) return;
 
     if (events == -1)  /* stop waiting on this fd completely */
     {
+        struct kevent ev[2];
         if (pollfd[user].fd == -1) return;  /* already removed */
-        ev[0].flags |= EV_DELETE;
-        ev[1].flags |= EV_DELETE;
+        /* Flush pending adds/enables before synchronous delete so fd close/reuse
+         * can never race with a deferred changelist entry. */
+        flush_kqueue_changes();
+        if (kqueue_fd == -1) return;
+        EV_SET( &ev[0], fd->unix_fd, EVFILT_READ, EV_DELETE, 0, 0, 0 );
+        EV_SET( &ev[1], fd->unix_fd, EVFILT_WRITE, EV_DELETE, 0, 0, 0 );
+        kevent( kqueue_fd, ev, 2, NULL, 0, NULL );
+        return;
     }
-    else if (pollfd[user].fd == -1)
+
+    if (pollfd[user].fd == -1)
     {
-        ev[0].flags |= EV_ADD | ((events & POLLIN) ? EV_ENABLE : EV_DISABLE);
-        ev[1].flags |= EV_ADD | ((events & POLLOUT) ? EV_ENABLE : EV_DISABLE);
+        queue_kqueue_change( fd->unix_fd, EVFILT_READ,
+                             EV_ADD | ((events & POLLIN) ? EV_ENABLE : EV_DISABLE),
+                             NOTE_LOWAT, 1, (void *)(long)user );
+        queue_kqueue_change( fd->unix_fd, EVFILT_WRITE,
+                             EV_ADD | ((events & POLLOUT) ? EV_ENABLE : EV_DISABLE),
+                             NOTE_LOWAT, 1, (void *)(long)user );
     }
     else
     {
-        if (pollfd[user].events == events) return;  /* nothing to do */
-        ev[0].flags |= (events & POLLIN) ? EV_ENABLE : EV_DISABLE;
-        ev[1].flags |= (events & POLLOUT) ? EV_ENABLE : EV_DISABLE;
-    }
-
-    if (kevent( kqueue_fd, ev, 2, NULL, 0, NULL ) == -1)
-    {
-        if (errno == ENOMEM)  /* not enough memory, give up on kqueue */
-        {
-            close( kqueue_fd );
-            kqueue_fd = -1;
-        }
-        else perror( "kevent" );  /* should not happen */
+        int diff = pollfd[user].events ^ events;
+        if (!diff) return;  /* nothing to do */
+        if (diff & POLLIN)
+            queue_kqueue_change( fd->unix_fd, EVFILT_READ,
+                                 (events & POLLIN) ? EV_ENABLE : EV_DISABLE,
+                                 NOTE_LOWAT, 1, (void *)(long)user );
+        if (diff & POLLOUT)
+            queue_kqueue_change( fd->unix_fd, EVFILT_WRITE,
+                                 (events & POLLOUT) ? EV_ENABLE : EV_DISABLE,
+                                 NOTE_LOWAT, 1, (void *)(long)user );
     }
 }
 
@@ -696,6 +728,8 @@ static inline void remove_epoll_user( struct fd *fd, int user )
     {
         struct kevent ev[2];
 
