Subject: [PATCH] macos: AVRT QoS, Mach high-res sleep, and kqueue changelist batching

Consolidated patches:
  - (0038) macos: mach_wait_until NtDelayExecution, avrt MMCSS, LatencyCritical, batched kqueue, and sched debug

---
diff --git a/dlls/avrt/main.c b/dlls/avrt/main.c
index 68af35c8..98f1a3ba 100644
--- a/dlls/avrt/main.c
+++ b/dlls/avrt/main.c
@@ -18,6 +18,8 @@
  */
 
 #include <stdarg.h>
+#include <stdlib.h>
+#include <wchar.h>
 
 #include "windef.h"
 #include "winbase.h"
@@ -54,9 +56,51 @@ HANDLE WINAPI AvSetMmThreadCharacteristicsA(const char *name, DWORD *index)
     return ret;
 }
 
+#define AVRT_HANDLE_BASE 0x12340000u
+#define AVRT_MAX_TASKS   64
+
+struct avrt_task
+{
+    BOOL in_use;
+    int saved_priority;
+};
+
+static struct avrt_task avrt_tasks[AVRT_MAX_TASKS];
+static CRITICAL_SECTION avrt_cs;
+static CRITICAL_SECTION_DEBUG avrt_cs_debug =
+{
+    0, 0, &avrt_cs,
+    { &avrt_cs_debug.ProcessLocksList, &avrt_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": avrt_cs") }
+};
+static CRITICAL_SECTION avrt_cs = { &avrt_cs_debug, -1, 0, 0, 0, 0 };
+
+static int avrt_task_base_priority(const WCHAR *name)
+{
+    /* Map MMCSS audio/games tasks to THREAD_PRIORITY_HIGHEST (macOS
+     * USER_INTERACTIVE + TIER_0 QoS with timeshare=1) rather than
+     * THREAD_PRIORITY_TIME_CRITICAL (fixed non-timeshare priority), which
+     * risks priority inversion / starving normal threads on non-PI futexes
+     * when a game runs heavy CPU DSP work on an audio thread. */
+    if (!_wcsicmp(name, L"Pro Audio") || !_wcsicmp(name, L"Audio") || !_wcsicmp(name, L"Games") ||
+        !_wcsicmp(name, L"Playback") || !_wcsicmp(name, L"Capture") || !_wcsicmp(name, L"DisplayPostProcessing"))
+        return THREAD_PRIORITY_HIGHEST;
+    return THREAD_PRIORITY_ABOVE_NORMAL;
+}
+
+static int avrt_handle_to_index(HANDLE handle)
+{
+    ULONG_PTR val = (ULONG_PTR)handle;
+    if (val < AVRT_HANDLE_BASE || val >= AVRT_HANDLE_BASE + AVRT_MAX_TASKS)
+        return -1;
+    return (int)(val - AVRT_HANDLE_BASE);
+}
+
 HANDLE WINAPI AvSetMmThreadCharacteristicsW(const WCHAR *name, DWORD *index)
 {
-    FIXME("(%s,%p): stub\n", debugstr_w(name), index);
+    int slot = -1, i;
+
+    TRACE("(%s,%p)\n", debugstr_w(name), index);
 
     if (!name)
     {
@@ -70,7 +114,23 @@ HANDLE WINAPI AvSetMmThreadCharacteristicsW(const WCHAR *name, DWORD *index)
         return NULL;
     }
 
-    return (HANDLE)0x12345678;
+    EnterCriticalSection(&avrt_cs);
+    for (i = 0; i < AVRT_MAX_TASKS; i++)
+    {
+        if (!avrt_tasks[i].in_use)
+        {
+            avrt_tasks[i].in_use = TRUE;
+            avrt_tasks[i].saved_priority = GetThreadPriority(GetCurrentThread());
+            slot = i;
+            break;
+        }
+    }
+    LeaveCriticalSection(&avrt_cs);
+
+    SetThreadPriority(GetCurrentThread(), avrt_task_base_priority(name));
+    if (slot < 0)
+        return (HANDLE)(ULONG_PTR)0x12345678u;
+    return (HANDLE)(ULONG_PTR)(AVRT_HANDLE_BASE + (ULONG_PTR)slot);
 }
 
 BOOL WINAPI AvQuerySystemResponsiveness(HANDLE AvrtHandle, ULONG *value)
@@ -81,14 +141,72 @@ BOOL WINAPI AvQuerySystemResponsiveness(HANDLE AvrtHandle, ULONG *value)
 
 BOOL WINAPI AvRevertMmThreadCharacteristics(HANDLE AvrtHandle)
 {
-    FIXME("(%p): stub\n", AvrtHandle);
+    int slot = avrt_handle_to_index(AvrtHandle);
+    int saved = THREAD_PRIORITY_ERROR_RETURN;
+
+    TRACE("(%p)\n", AvrtHandle);
+
+    if (slot < 0)
+    {
+        if ((ULONG_PTR)AvrtHandle == 0x12345678u) return TRUE;
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+
+    EnterCriticalSection(&avrt_cs);
+    if (!avrt_tasks[slot].in_use)
+    {
+        LeaveCriticalSection(&avrt_cs);
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    saved = avrt_tasks[slot].saved_priority;
+    avrt_tasks[slot].in_use = FALSE;
+    LeaveCriticalSection(&avrt_cs);
+
+    if (saved != THREAD_PRIORITY_ERROR_RETURN)
+        SetThreadPriority(GetCurrentThread(), saved);
     return TRUE;
 }
 
 BOOL WINAPI AvSetMmThreadPriority(HANDLE AvrtHandle, AVRT_PRIORITY prio)
 {
-    FIXME("(%p)->(%u) stub\n", AvrtHandle, prio);
-    return TRUE;
+    int slot = avrt_handle_to_index(AvrtHandle);
+    int win_prio;
+
+    TRACE("(%p)->(%d)\n", AvrtHandle, prio);
+
+    if (slot < 0 && (ULONG_PTR)AvrtHandle != 0x12345678u)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (slot >= 0)
+    {
+        BOOL valid;
+        EnterCriticalSection(&avrt_cs);
+        valid = avrt_tasks[slot].in_use;
+        LeaveCriticalSection(&avrt_cs);
+        if (!valid)
+        {
+            SetLastError(ERROR_INVALID_HANDLE);
+            return FALSE;
+        }
+    }
+
+    switch (prio)
+    {
+    case AVRT_PRIORITY_CRITICAL: win_prio = THREAD_PRIORITY_HIGHEST; break;
+    case AVRT_PRIORITY_HIGH:     win_prio = THREAD_PRIORITY_HIGHEST; break;
+    case AVRT_PRIORITY_NORMAL:   win_prio = THREAD_PRIORITY_ABOVE_NORMAL; break;
+    case AVRT_PRIORITY_LOW:      win_prio = THREAD_PRIORITY_NORMAL; break;
+    case AVRT_PRIORITY_VERYLOW:  win_prio = THREAD_PRIORITY_BELOW_NORMAL; break;
+    default:
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+
+    return SetThreadPriority(GetCurrentThread(), win_prio);
 }
 
 HANDLE WINAPI AvSetMmMaxThreadCharacteristicsA(const char *task1, const char *task2, DWORD *index)
diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
