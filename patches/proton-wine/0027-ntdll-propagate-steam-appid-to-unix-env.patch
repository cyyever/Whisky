+    static const WCHAR SteamGameIdW[] = {'S','t','e','a','m','G','a','m','e','I','d',0};
+    static const WCHAR SteamAppIdW[] = {'S','t','e','a','m','A','p','p','I','d',0};
+    static const WCHAR SteamCompatAppIdW[] =
+        {'S','T','E','A','M','_','C','O','M','P','A','T','_','A','P','P','_','I','D',0};
     WCHAR *ptr = params->Environment;
 
     while (*ptr)
     {
-        static const WCHAR WINEDEBUG[] = {'W','I','N','E','D','E','B','U','G','=',0};
-        if (!*winedebug && !wcsncmp( ptr, WINEDEBUG, ARRAY_SIZE( WINEDEBUG ) - 1 ))
+        if (!unix_env->winedebug && !wcsncmp( ptr, WINEDEBUG, ARRAY_SIZE( WINEDEBUG ) - 1 ))
         {
             DWORD len = wcslen(ptr) * 3 + 1;
-            if ((*winedebug = malloc( len )))
-                ntdll_wcstoumbs( ptr, wcslen(ptr) + 1, *winedebug, len, FALSE );
+            if ((unix_env->winedebug = malloc( len )))
+                ntdll_wcstoumbs( ptr, wcslen(ptr) + 1, unix_env->winedebug, len, FALSE );
         }
+        else if (!unix_env->steam_game_id &&
+                 (unix_env->steam_game_id = extract_unix_env_var( ptr, SteamGameIdW, ARRAY_SIZE(SteamGameIdW) - 1, "SteamGameId" )))
+            ;
+        else if (!unix_env->steam_app_id &&
+                 (unix_env->steam_app_id = extract_unix_env_var( ptr, SteamAppIdW, ARRAY_SIZE(SteamAppIdW) - 1, "SteamAppId" )))
+            ;
+        else if (!unix_env->steam_compat_app_id &&
+                 (unix_env->steam_compat_app_id = extract_unix_env_var( ptr, SteamCompatAppIdW, ARRAY_SIZE(SteamCompatAppIdW) - 1, "STEAM_COMPAT_APP_ID" )))
+            ;
         ptr += wcslen(ptr) + 1;
     }
+    if (!unix_env->steam_game_id && unix_env->steam_app_id)
+        unix_env->steam_game_id = dup_unix_env_pair( "SteamGameId", strchr( unix_env->steam_app_id, '=' ) + 1 );
+    if (!unix_env->steam_app_id && unix_env->steam_game_id)
+        unix_env->steam_app_id = dup_unix_env_pair( "SteamAppId", strchr( unix_env->steam_game_id, '=' ) + 1 );
+    if (!unix_env->steam_compat_app_id && unix_env->steam_app_id)
+        unix_env->steam_compat_app_id = dup_unix_env_pair( "STEAM_COMPAT_APP_ID", strchr( unix_env->steam_app_id, '=' ) + 1 );
     ptr++;
     return (ptr - params->Environment) * sizeof(WCHAR);
 }
