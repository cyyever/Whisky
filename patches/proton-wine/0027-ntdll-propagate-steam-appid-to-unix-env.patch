Subject: ntdll: propagate SteamAppId/SteamGameId from Windows env to child Unix env

Proton contains ~70 per-game fixes across win32u, winegstreamer, ntdll/unix,
opengl32, mfreadwrite, gameinput, etc. gated on Unix getenv("SteamGameId"),
getenv("SteamAppId"), or getenv("STEAM_COMPAT_APP_ID"). On Linux those are
injected into the host Unix environment by the native Steam client before
launching Wine.

When running the Windows Steam client inside Wine (as on macOS/Whisky),
Steam.exe passes SteamAppId and SteamGameId only in the child's Windows PE
environment block (params->Environment). Previously NtCreateUserProcess only
propagated WINEDEBUG= to the spawned child's Unix environ, leaving almost all
Unix-side Proton game adaptations inert.

Extract SteamGameId, SteamAppId, and STEAM_COMPAT_APP_ID case-insensitively
from params->Environment in get_env_size(), normalize their Unix names (and
mirror SteamAppId <-> SteamGameId / STEAM_COMPAT_APP_ID when only one is set),
and putenv() them in the forked grandchild before exec_wineloader() so the
parent process's own Unix environment is never polluted.

diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index ef1ab960..031e718d 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -313,24 +313,83 @@ static unsigned int get_pe_file_info( OBJECT_ATTRIBUTES *attr, UNICODE_STRING *n
 }
 
 
+struct child_unix_env
+{
+    char *winedebug;
+    char *steam_game_id;
+    char *steam_app_id;
+    char *steam_compat_app_id;
+};
+
+static char *dup_unix_env_pair( const char *name, const char *val )
+{
+    size_t nlen = strlen( name ), vlen = strlen( val );
+    char *buf = malloc( nlen + 1 + vlen + 1 );
+
+    if (!buf) return NULL;
+    memcpy( buf, name, nlen );
+    buf[nlen] = '=';
+    memcpy( buf + nlen + 1, val, vlen + 1 );
+    return buf;
+}
+
+static char *extract_unix_env_var( const WCHAR *entry, const WCHAR *wname, size_t wname_len,
+                                   const char *unix_name )
+{
+    const WCHAR *val;
+    DWORD vlen, utf8_len;
+    char *utf8_val, *ret;
+
+    if (wcsnicmp( entry, wname, wname_len ) || entry[wname_len] != '=') return NULL;
+    val = entry + wname_len + 1;
+    if (!*val) return NULL;
+    vlen = wcslen( val );
+    utf8_len = vlen * 3 + 1;
+    if (!(utf8_val = malloc( utf8_len ))) return NULL;
+    ntdll_wcstoumbs( val, vlen + 1, utf8_val, utf8_len, FALSE );
+    ret = dup_unix_env_pair( unix_name, utf8_val );
+    free( utf8_val );
+    return ret;
+}
+
+
