Subject: opengl32: trace WGL lock ownership transitions on demand

WINE_WGL_LOCK_TRACE=1 records native thread IDs, per-thread lock depth and
call sites around all WGL mutex operations. Keep mutex behavior unchanged.
Update the generator as well as its generated wrappers. Pair with
WINE_SEGV_TRACE=1 to distinguish reentry from exception escape.

diff --git a/dlls/opengl32/make_opengl b/dlls/opengl32/make_opengl
index 0eeaee4..54d6f88 100755
--- a/dlls/opengl32/make_opengl
+++ b/dlls/opengl32/make_opengl
@@ -657,7 +657,7 @@ sub generate_unix_thunk($$$$)
     }
     $ret .= "    resolve_default_fbo( $teb );\n" if defined $resolve_default_fbo_thunks{$name};
     $ret .= "    push_default_fbo( $teb );\n" if defined $hide_default_fbo_thunks{$name};
-    $ret .= "    pthread_mutex_lock( &wgl_lock );\n$invalidation" if $need_lock;
+    $ret .= "    wgl_lock_enter( __func__ );\n$invalidation" if $need_lock;
     $ret .= "    $ret_expr";
     $call_args =~ s/,$/ /;
     if ($manual_wow64_wrapper)
@@ -673,7 +673,7 @@ sub generate_unix_thunk($$$$)
         $ret .= "($func_ret)" if defined $remap_types{$func_ret};
         $ret .= "funcs->p_$name($call_args);\n";
     }
-    $ret .= "    pthread_mutex_unlock( &wgl_lock );\n" if $need_lock;
+    $ret .= "    wgl_lock_leave( __func__ );\n" if $need_lock;
     $ret .= "    set_current_fbo( $teb, params->target, params->framebuffer );\n" if $name =~ /glBindFramebuffer/;
     $ret .= "    pop_default_fbo( $teb );\n" if defined $hide_default_fbo_thunks{$name};
     if (defined $textures_out_thunks{$name})
