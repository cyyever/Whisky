diff --git a/dlls/opengl32/unix_wgl.c b/dlls/opengl32/unix_wgl.c
index 5f6449b..b88d4e6 100644
--- a/dlls/opengl32/unix_wgl.c
+++ b/dlls/opengl32/unix_wgl.c
@@ -27,6 +27,8 @@
 #include <stdarg.h>
 #include <stdlib.h>
 #include <assert.h>
+#include <errno.h>
+#include <stdio.h>
 
 #include <pthread.h>
 
@@ -60,6 +62,54 @@ static void pop_default_fbo_buffers( TEB *teb );
 
 static UINT64 call_gl_debug_message_callback;
 pthread_mutex_t wgl_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_once_t wgl_trace_once = PTHREAD_ONCE_INIT;
+static BOOL wgl_trace_enabled;
+static __thread unsigned int wgl_lock_depth;
+
+static void init_wgl_trace(void)
+{
+    const char *value = getenv("WINE_WGL_LOCK_TRACE");
+    wgl_trace_enabled = value && *value && strcmp(value, "0");
+}
+
+static void trace_wgl_lock(const char *event, const char *caller)
+{
+    int saved_errno = errno, length;
+    char line[256];
+    unsigned long long tid;
+
+    pthread_once(&wgl_trace_once, init_wgl_trace);
+    if (wgl_trace_enabled)
+    {
+#ifdef __APPLE__
+        uint64_t native_tid = 0;
+        pthread_threadid_np(NULL, &native_tid);
+        tid = native_tid;
+#else
+        tid = (unsigned long long)(uintptr_t)pthread_self();
+#endif
+        length = snprintf(line, sizeof(line), "wgl-lock pid=%u tid=%llu depth=%u %s %s\n",
+                          (unsigned int)getpid(), tid, wgl_lock_depth, event, caller);
+        if (length > 0) write(STDERR_FILENO, line, min((size_t)length, sizeof(line) - 1));
+    }
+    errno = saved_errno;
+}
+
+void wgl_lock_enter(const char *caller)
+{
+    trace_wgl_lock("wait", caller);
+    pthread_mutex_lock(&wgl_lock);
+    ++wgl_lock_depth;
+    trace_wgl_lock("acquired", caller);
+}
+
+void wgl_lock_leave(const char *caller)
+{
+    trace_wgl_lock("release", caller);
+    --wgl_lock_depth;
+    pthread_mutex_unlock(&wgl_lock);
+    trace_wgl_lock("released", caller);
+}
 
