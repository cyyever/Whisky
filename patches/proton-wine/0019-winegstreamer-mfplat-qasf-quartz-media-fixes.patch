Subject: [PATCH] media: winegstreamer macOS fixes, mfplat copy bounds, qasf live/stopped seek, and dsoundrender flush/pause

Consolidated patches:
  - (0004) winegstreamer: macOS build, GL display, and decoder autoplug fixes
subj='winegstreamer: macOS build, GL display, and decoder autoplug fixes'
  - (0032) 
subj=''
  - (0039) qasf: decommit allocators before stopping WMReader and flush all streams on seek
subj='qasf: decommit allocators before stopping WMReader and flush all streams on seek'
  - (0041) quartz/dsoundrender: fix flush sample release, pause wait, wrap check, and queue leak

---
diff --git a/dlls/mfplat/sample.c b/dlls/mfplat/sample.c
index 60d78dc8..6de99239 100644
--- a/dlls/mfplat/sample.c
+++ b/dlls/mfplat/sample.c
@@ -880,12 +880,20 @@ static HRESULT WINAPI sample_CopyToBuffer(IMFSample *iface, IMFMediaBuffer *buff
             && SUCCEEDED(IMFMediaBuffer_QueryInterface(buffer, &IID_IMF2DBuffer, (void **)&buffer2d)))
     {
         if (SUCCEEDED(IMFMediaBuffer_GetCurrentLength(sample->buffers[0], &current_length))
-                && SUCCEEDED(IMF2DBuffer_GetContiguousLength(buffer2d, &dst_length))
-                && current_length == dst_length
-                && SUCCEEDED(IMFMediaBuffer_Lock(sample->buffers[0], &src_ptr, &src_max_length, &current_length)))
+                && SUCCEEDED(IMF2DBuffer_GetContiguousLength(buffer2d, &dst_length)))
         {
-            hr = IMF2DBuffer_ContiguousCopyFrom(buffer2d, src_ptr, current_length);
-            IMFMediaBuffer_Unlock(sample->buffers[0]);
+            if (current_length > dst_length)
+            {
+                hr = MF_E_BUFFERTOOSMALL;
+                IMF2DBuffer_Release(buffer2d);
+                goto done;
+            }
+            if (current_length == dst_length
+                    && SUCCEEDED(IMFMediaBuffer_Lock(sample->buffers[0], &src_ptr, &src_max_length, &current_length)))
+            {
+                hr = IMF2DBuffer_ContiguousCopyFrom(buffer2d, src_ptr, current_length);
+                IMFMediaBuffer_Unlock(sample->buffers[0]);
+            }
         }
         IMF2DBuffer_Release(buffer2d);
         if (SUCCEEDED(hr))
diff --git a/dlls/qasf/asfreader.c b/dlls/qasf/asfreader.c
index 46a3d7e4..937dd3af 100644
--- a/dlls/qasf/asfreader.c
+++ b/dlls/qasf/asfreader.c
@@ -285,9 +285,9 @@ static HRESULT asf_reader_start_stream(struct asf_reader *filter, LONGLONG start
 
     EnterCriticalSection(&filter->status_cs);
 
+    filter->status = -1;
     if (SUCCEEDED(hr = IWMReader_Start(filter->reader, start, duration, rate, NULL)))
     {
-        filter->status = -1;
         while (filter->status != WMT_STARTED)
             SleepConditionVariableCS(&filter->status_cv, &filter->status_cs, INFINITE);
         hr = filter->result;
@@ -304,9 +304,9 @@ static HRESULT asf_reader_stop_stream(struct asf_reader *filter)
 
     EnterCriticalSection(&filter->status_cs);
 
+    filter->status = -1;
     if (SUCCEEDED(hr = IWMReader_Stop(filter->reader)))
     {
-        filter->status = -1;
         while (filter->status != WMT_STOPPED)
             SleepConditionVariableCS(&filter->status_cv, &filter->status_cs, INFINITE);
         hr = filter->result;
@@ -332,21 +332,34 @@ static HRESULT WINAPI media_seeking_ChangeCurrent(IMediaSeeking *iface)
 
     TRACE("iface %p.\n", iface);
 
-    /* Send begin flush commands downstream. */
+    /* Do not stop/start WMReader while the filter is stopped; the updated
+     * seek->llCurrent will be honored when asf_reader_init_stream() starts. */
+    if (filter->filter.state == State_Stopped)
+        return S_OK;
+
+    /* Send begin flush commands downstream and decommit allocators so any
+     * stream_read_thread blocked in IMemAllocator_GetBuffer() wakes up before
+     * asf_reader_stop_stream() waits for WMT_STOPPED (prevents AB-BA deadlock). */
     for (i = 0; i < filter->stream_count; ++i)
     {
-        if (FAILED(IPin_BeginFlush(stream->source.pin.peer)))
+        struct asf_stream *s = &filter->streams[i];
+        if (s->source.pin.peer && FAILED(IPin_BeginFlush(s->source.pin.peer)))
             WARN("Failed to BeginFlush for stream %u.\n", i);
+        if (s->source.pin.peer && s->source.pAllocator && FAILED(IMemAllocator_Decommit(s->source.pAllocator)))
+            WARN("Failed to decommit allocator for stream %u.\n", i);
     }
 
     /* Stop the reader. */
     hr = asf_reader_stop_stream(filter);
 
-    /* Send end flush commands downstream. */
+    /* Send end flush commands downstream and re-commit allocators. */
     for (i = 0; i < filter->stream_count; ++i)
     {
-        if (FAILED(IPin_EndFlush(stream->source.pin.peer)))
+        struct asf_stream *s = &filter->streams[i];
+        if (s->source.pin.peer && FAILED(IPin_EndFlush(s->source.pin.peer)))
             WARN("Failed to EndFlush for stream %u.\n", i);
+        if (s->source.pin.peer && s->source.pAllocator && FAILED(IMemAllocator_Commit(s->source.pAllocator)))
+            WARN("Failed to commit allocator for stream %u.\n", i);
     }
 
     /* Start the reader. */
@@ -566,7 +579,14 @@ static HRESULT asf_reader_init_stream(struct strmbase_filter *iface)
     if (FAILED(hr))
         return hr;
 
-    if (FAILED(hr = asf_reader_start_stream(filter, 0, 0, 1.0)))
+    if (filter->stream_count)
+    {
+        struct SourceSeeking *seek = &filter->streams[0].seek;
+        hr = asf_reader_start_stream(filter, seek->llCurrent, 0, seek->dRate);
+    }
+    else
+        hr = asf_reader_start_stream(filter, 0, 0, 1.0);
+    if (FAILED(hr))
         WARN("Failed to start WMReader %p, hr %#lx\n", filter->reader, hr);
 
     return hr;
@@ -575,28 +595,35 @@ static HRESULT asf_reader_init_stream(struct strmbase_filter *iface)
 static HRESULT asf_reader_cleanup_stream(struct strmbase_filter *iface)
 {
     struct asf_reader *filter = impl_from_strmbase_filter(iface);
-    HRESULT hr = S_OK;
+    HRESULT hr = S_OK, decommit_hr;
     int i;
 
     TRACE("iface %p\n", iface);
 
-    if (FAILED(hr = asf_reader_stop_stream(filter)))
-        WARN("Failed to stop WMReader %p, hr %#lx\n", filter->reader, hr);
-
+    /* Decommit downstream allocators before stopping WMReader so any
+     * stream_read_thread blocked in IMemAllocator_GetBuffer() wakes up with
+     * VFW_E_NOT_COMMITTED instead of deadlocking ASYNC_OP_STOP -> WMT_STOPPED. */
     for (i = 0; i < filter->stream_count; ++i)
     {
         struct asf_stream *stream = filter->streams + i;
 
-        if (!stream->source.pin.peer)
+        if (!stream->source.pin.peer || !stream->source.pAllocator)
             continue;
 
-        if (FAILED(hr = IMemAllocator_Decommit(stream->source.pAllocator)))
+        if (FAILED(decommit_hr = IMemAllocator_Decommit(stream->source.pAllocator)) && SUCCEEDED(hr))
         {
-            WARN("Failed to decommit stream %u allocator, hr %#lx\n", i, hr);
-            break;
+            WARN("Failed to decommit stream %u allocator, hr %#lx\n", i, decommit_hr);
+            hr = decommit_hr;
         }
     }
 
+    if (FAILED(decommit_hr = asf_reader_stop_stream(filter)))
+    {
+        WARN("Failed to stop WMReader %p, hr %#lx\n", filter->reader, decommit_hr);
+        if (SUCCEEDED(hr))
+            hr = decommit_hr;
+    }
+
     return hr;
 }
 
@@ -697,9 +724,9 @@ static HRESULT WINAPI file_source_Load(IFileSourceFilter *iface, LPCOLESTR file_
     }
 
     EnterCriticalSection(&filter->status_cs);
+    filter->status = -1;
     if (SUCCEEDED(hr = IWMReader_Open(filter->reader, filter->file_name, filter->callback, NULL)))
     {
-        filter->status = -1;
         while (filter->status != WMT_OPENED)
             SleepConditionVariableCS(&filter->status_cv, &filter->status_cs, INFINITE);
         hr = filter->result;
diff --git a/dlls/quartz/dsoundrender.c b/dlls/quartz/dsoundrender.c
index e72b743e..1a19941a 100644
--- a/dlls/quartz/dsoundrender.c
+++ b/dlls/quartz/dsoundrender.c
@@ -51,6 +51,7 @@ struct dsound_render
     IMediaSample **queued_samples;
     size_t queued_sample_count, queued_samples_capacity;
     bool render_thread_shutdown;
+    bool render_running;
 
     /* Signaled when the filter has completed a state change. The filter waits
      * for this event in IBaseFilter::GetState(). */
@@ -112,14 +113,11 @@ static void update_positions(struct dsound_render *filter, DWORD *seqwritepos, D
 {
     WAVEFORMATEX *wfx = (WAVEFORMATEX *)filter->sink.pin.mt.pbFormat;
     BYTE *buf1, *buf2;
-    DWORD size1, size2, playpos, writepos, old_writepos, old_playpos, adv;
+    DWORD size1, size2, playpos, writepos, old_playpos, adv;
     BOOL writepos_set = filter->writepos < filter->buf_size;
 
     /* Update position and zero */
-    old_writepos = filter->writepos;
     old_playpos = filter->last_playpos;
-    if (old_writepos <= old_playpos)
-        old_writepos += filter->buf_size;
 
     IDirectSoundBuffer_GetCurrentPosition(filter->dsbuffer, &playpos, &writepos);
     if (old_playpos > playpos)
@@ -137,17 +135,26 @@ static void update_positions(struct dsound_render *filter, DWORD *seqwritepos, D
         IDirectSoundBuffer_Unlock(filter->dsbuffer, buf1, size1, buf2, size2);
     }
     *minwritepos = writepos;
-    if (!writepos_set || old_writepos < writepos)
+    if (!writepos_set)
     {
-        if (writepos_set)
+        *seqwritepos = writepos;
+    }
+    else
+    {
+        DWORD write_dist = adv + (writepos >= playpos ? writepos - playpos : filter->buf_size + writepos - playpos);
+        DWORD old_write_dist = filter->writepos > old_playpos
+                ? filter->writepos - old_playpos
+                : filter->buf_size + filter->writepos - old_playpos;
+
+        if (old_write_dist < write_dist)
         {
             filter->writepos = filter->buf_size;
-            FIXME("Underrun of data occurred!\n");
+            WARN("Underrun of data occurred!\n");
+            *seqwritepos = writepos;
         }
-        *seqwritepos = writepos;
+        else
+            *seqwritepos = filter->writepos;
     }
-    else
-        *seqwritepos = filter->writepos;
 }
 
 static void get_write_pos(struct dsound_render *filter,
@@ -224,7 +231,7 @@ static HRESULT send_sample_data(struct dsound_render *filter,
         DWORD writepos, free, size1, size2;
         BYTE *buf1, *buf2;
 
-        if (filter->filter.state == State_Running)
+        if (filter->render_running && filter->filter.state != State_Stopped)
         {
             get_write_pos(filter, &writepos, tStart, &free);
             hr = free ? S_OK : S_FALSE;
@@ -391,7 +398,7 @@ static DWORD WINAPI render_thread_run(void *arg)
             return 0;
         }
 
-        if (!filter->queued_sample_count)
+        if (!filter->queued_sample_count || !filter->render_running)
         {
             SleepConditionVariableCS(&filter->render_cv, &filter->render_cs, INFINITE);
             continue;
@@ -490,6 +497,7 @@ static HRESULT dsound_render_sink_connect(struct strmbase_sink *iface, IPin *pee
     buf_desc.lpwfxFormat = (WAVEFORMATEX *)format;
     hr = IDirectSound8_CreateSoundBuffer(filter->dsound, &buf_desc, &filter->dsbuffer, NULL);
     filter->writepos = filter->buf_size;
+    filter->last_playpos = 0;
     if (FAILED(hr))
         ERR("Failed to create sound buffer, hr %#lx.\n", hr);
 
@@ -546,6 +554,12 @@ static HRESULT dsound_render_sink_begin_flush(struct strmbase_sink *iface)
     struct dsound_render *filter = impl_from_strmbase_pin(&iface->pin);
 
     SetEvent(filter->flush_event);
+    EnterCriticalSection(&filter->render_cs);
+    for (unsigned int i = 0; i < filter->queued_sample_count; ++i)
+        IMediaSample_Release(filter->queued_samples[i]);
+    filter->queued_sample_count = 0;
+    LeaveCriticalSection(&filter->render_cs);
+    WakeConditionVariable(&filter->render_cv);
     return S_OK;
 }
 
@@ -579,6 +593,7 @@ static HRESULT dsound_render_sink_end_flush(struct strmbase_sink *iface)
         IDirectSoundBuffer_Lock(filter->dsbuffer, 0, 0, &buffer, &size, NULL, NULL, DSBLOCK_ENTIREBUFFER);
         memset(buffer, 0, size);
         IDirectSoundBuffer_Unlock(filter->dsbuffer, buffer, size, NULL, 0);
+        IDirectSoundBuffer_GetCurrentPosition(filter->dsbuffer, &filter->last_playpos, NULL);
         filter->writepos = filter->buf_size;
     }
 
@@ -624,6 +639,7 @@ static void dsound_render_destroy(struct strmbase_filter *iface)
 
     strmbase_passthrough_cleanup(&filter->passthrough);
     strmbase_filter_cleanup(&filter->filter);
+    free(filter->queued_samples);
     free(filter);
 }
 
@@ -672,6 +688,7 @@ static HRESULT dsound_render_init_stream(struct strmbase_filter *iface)
     ResetEvent(filter->state_event);
 
     filter->render_thread_shutdown = false;
+    filter->render_running = false;
     if (!(filter->render_thread = CreateThread(NULL, 0, render_thread_run, filter, 0, NULL)))
         return HRESULT_FROM_WIN32(GetLastError());
 
@@ -689,7 +706,15 @@ static HRESULT dsound_render_start_stream(struct strmbase_filter *iface, REFEREN
     SetEvent(filter->state_event);
 
     if (filter->sink.pin.peer)
+    {
+        IDirectSoundBuffer_GetCurrentPosition(filter->dsbuffer, &filter->last_playpos, NULL);
         IDirectSoundBuffer_Play(filter->dsbuffer, 0, 0, DSBPLAY_LOOPING);
+    }
+
+    EnterCriticalSection(&filter->render_cs);
+    filter->render_running = true;
+    LeaveCriticalSection(&filter->render_cs);
+    WakeConditionVariable(&filter->render_cv);
 
     if ((filter->eos || !filter->sink.pin.peer) && graph
             && SUCCEEDED(IFilterGraph_QueryInterface(graph,
@@ -710,8 +735,13 @@ static HRESULT dsound_render_stop_stream(struct strmbase_filter *iface)
     if (filter->sink.pin.peer)
     {
         IDirectSoundBuffer_Stop(filter->dsbuffer);
+        IDirectSoundBuffer_GetCurrentPosition(filter->dsbuffer, &filter->last_playpos, NULL);
         filter->writepos = filter->buf_size;
     }
+    EnterCriticalSection(&filter->render_cs);
+    filter->render_running = false;
+    LeaveCriticalSection(&filter->render_cs);
+    WakeConditionVariable(&filter->render_cv);
     return S_OK;
 }
 
diff --git a/dlls/winegstreamer/media-converter/media-converter.h b/dlls/winegstreamer/media-converter/media-converter.h
index 3dd8864d..c893a217 100644
--- a/dlls/winegstreamer/media-converter/media-converter.h
+++ b/dlls/winegstreamer/media-converter/media-converter.h
@@ -22,6 +22,7 @@
 #define _FILE_OFFSET_BITS 64
 
 #include <string.h>
