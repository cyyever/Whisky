Subject: TEMP probe: the DirectShow graph state and its sample pushes

Delete when the SSFIV movie freeze is understood.
---
--- a/dlls/quartz/filtergraph.c
+++ b/dlls/quartz/filtergraph.c
@@ -1916,6 +1916,8 @@
     struct filter *filter;
     FILTER_STATE state;
     HRESULT hr = S_OK;
+
+    ERR("QZPROBE graph %p RUN\n", graph);
 
     TRACE("graph %p.\n", graph);
 
@@ -1985,6 +1987,7 @@
 {
     struct filter_graph *graph = impl_from_IMediaControl(iface);
 
+    ERR("QZPROBE graph %p PAUSE\n", graph);
     TRACE("graph %p.\n", graph);
 
     return IMediaFilter_Pause(&graph->IMediaFilter_iface);
@@ -1994,6 +1997,7 @@
 {
     struct filter_graph *graph = impl_from_IMediaControl(iface);
 
+    ERR("QZPROBE graph %p STOP\n", graph);
     TRACE("graph %p.\n", graph);
 
     return IMediaFilter_Stop(&graph->IMediaFilter_iface);
--- a/dlls/winegstreamer/quartz_parser.c
+++ b/dlls/winegstreamer/quartz_parser.c
@@ -1317,7 +1317,21 @@
     if (!pin->pin.pin.peer)
         return VFW_E_NOT_CONNECTED;
 
-    hr = IMemInputPin_Receive(pin->pin.pMemInputPin, sample);
+    {
+        /* The downstream renderer blocks here until presentation time, so a
+         * Receive that never returns is the graph stalling at exactly the
+         * point gstreamer then backs up behind. Report the slow ones, and one
+         * in every 200 so a healthy stream still shows a pulse. */
+        static LONG probe_n;
+        LONG probe_i = InterlockedIncrement(&probe_n);
+        DWORD probe_t0 = GetTickCount(), probe_dt;
+
+        hr = IMemInputPin_Receive(pin->pin.pMemInputPin, sample);
+        probe_dt = GetTickCount() - probe_t0;
+        if (probe_dt > 500 || !(probe_i % 200))
+            ERR("QZPROBE send_sample #%ld: Receive took %lu ms, hr %#lx\n",
+                probe_i, probe_dt, hr);
+    }
     TRACE("Receive() returned hr %#lx.\n", hr);
     return hr;
 }
