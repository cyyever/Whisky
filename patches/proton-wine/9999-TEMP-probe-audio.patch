--- a/dlls/xaudio2_7/xaudio_dll.c
+++ b/dlls/xaudio2_7/xaudio_dll.c
@@ -1649,6 +1649,7 @@
     src->effect_chain = chain;
     faudio_sends = wrap_voice_sends(pSendList);
 
