Subject: TEMP probe: sampled waits and Sleep(0) yields per thread

Delete when the SSFIV main-thread spin is understood.
---
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -2450,6 +2450,15 @@
     for (i = 0; i < count; i++)
     {
         if (is_pseudo_handle( handles[i] )) return STATUS_INVALID_HANDLE;
+    }
+
+    {
+        static __thread unsigned probe_n;
+
+        if (!(++probe_n & 511))
+            ERR( "WAITPROBE tid=%04x multi count=%u h0=%p timeout=%s n=%u\n",
+                 (unsigned)(ULONG_PTR)NtCurrentTeb()->ClientId.UniqueThread, count,
+                 handles[0], timeout ? "finite" : "INFINITE", probe_n );
     }
 
     if ((ret = inproc_wait( count, handles, type, alertable, timeout )) != STATUS_NOT_IMPLEMENTED)
@@ -2521,6 +2530,19 @@
 
     TRACE( "handle %p, alertable %u, timeout %s\n", handle, alertable, debugstr_timeout(timeout) );
 
+    /* Sampled, not per call: the previous version logged whenever the handle
+     * changed, and a thread alternating between two handles then logged every
+     * call -- 119k lines that turned out to be a normal 60 fps frame loop. One
+     * line in 512 keeps the ratio between handles visible at 1/500th the I/O. */
+    {
+        static __thread unsigned probe_n;
+
+        if (!(++probe_n & 511))
+            ERR( "WAITPROBE tid=%04x single h=%p timeout=%s n=%u\n",
+                 (unsigned)(ULONG_PTR)NtCurrentTeb()->ClientId.UniqueThread, handle,
+                 timeout ? "finite" : "INFINITE", probe_n );
+    }
+
     if ((ret = inproc_wait( 1, &handle, WaitAny, alertable, timeout )) != STATUS_NOT_IMPLEMENTED)
     {
         TRACE( "-> %#x\n", ret );
@@ -2665,6 +2687,13 @@
 
         /* Note that we yield after establishing the desired timeout, but
            we only care about the result of the yield for zero timeouts */
+        {
+            static __thread unsigned probe_n;
+
+            if (!when && !(++probe_n & 4095))
+                ERR( "WAITPROBE tid=%04x Sleep(0) yield n=%u\n",
+                     (unsigned)(ULONG_PTR)NtCurrentTeb()->ClientId.UniqueThread, probe_n );
+        }
         status = NtYieldExecution();
         if (!when) return status;
 
