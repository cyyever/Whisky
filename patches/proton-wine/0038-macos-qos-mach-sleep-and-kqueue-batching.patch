-        if ((when = timeout->QuadPart) < 0)
+        when = timeout->QuadPart;
+        if (!when) return NtYieldExecution();
+
+#ifdef __APPLE__
+        if (when < 0)
+        {
+            ULONGLONG rel_100ns = (ULONGLONG)(-when);
+            if (rel_100ns <= 30 * (ULONGLONG)TICKSPERSEC)
+            {
+                static mach_timebase_info_data_t tb;
+                uint64_t ticks, deadline;
+
+                if (!tb.denom) mach_timebase_info( &tb );
+                ticks = (uint64_t)(((__uint128_t)rel_100ns * 100 * tb.denom + tb.numer - 1) / tb.numer);
+                deadline = mach_absolute_time() + ticks;
+                while (mach_wait_until( deadline ) == KERN_ABORTED && mach_absolute_time() < deadline) {}
+                return STATUS_SUCCESS;
+            }
+            NtQuerySystemTime( &now );
+            when = now.QuadPart - when;
+        }
+        else
+        {
+            NtQuerySystemTime( &now );
+            diff = when - now.QuadPart;
+            if (diff <= 0) return STATUS_SUCCESS;
+            if (diff <= 30 * (timeout_t)TICKSPERSEC)
+            {
+                static mach_timebase_info_data_t tb;
+                uint64_t ticks, deadline;
+
+                if (!tb.denom) mach_timebase_info( &tb );
+                ticks = (uint64_t)(((__uint128_t)(ULONGLONG)diff * 100 * tb.denom + tb.numer - 1) / tb.numer);
+                deadline = mach_absolute_time() + ticks;
+                while (mach_wait_until( deadline ) == KERN_ABORTED && mach_absolute_time() < deadline) {}
+                return STATUS_SUCCESS;
+            }
+        }
+#else
+        if (when < 0)
         {
             NtQuerySystemTime( &now );
             when = now.QuadPart - when;
@@ -2667,6 +2706,7 @@ NTSTATUS WINAPI NtDelayExecution( BOOLEAN alertable, const LARGE_INTEGER *timeou
