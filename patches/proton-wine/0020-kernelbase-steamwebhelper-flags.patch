Subject: kernelbase: append --no-sandbox --in-process-gpu to steamwebhelper.exe

Keep Steam CEF GPU initialization in the browser process to work around
previous cross-process ANGLE surface creation failures on macOS.
Disable the CEF sandbox for compatibility with Wine.
The compatibility entry applies to all steamwebhelper.exe launches.

diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index fe337dc..4f7bf30 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -630,6 +630,7 @@ static const WCHAR *hack_append_command_line( const WCHAR *cmd )
         {L"Red Tie Runner.exe", L" --use-angle=gl"},
         {L"UnrealCEFSubProcess.exe", L" --use-gl=swiftshader", "2316580"},
         {L"UnrealCEFSubProcess.exe", L" --use-angle=d3d9", "2684500"},
+        {L"steamwebhelper.exe", L" --no-sandbox --in-process-gpu"},
     };
     unsigned int i;
     char sgi[64];
