+#ifdef __APPLE__
+            return do_getsockopt_byte_or_int( handle, io, IPPROTO_IP, IP_MULTICAST_LOOP, out_buffer, out_size, TRUE, TRUE );
+#else
             return do_getsockopt( handle, io, IPPROTO_IP, IP_MULTICAST_LOOP, out_buffer, out_size );
+#endif
