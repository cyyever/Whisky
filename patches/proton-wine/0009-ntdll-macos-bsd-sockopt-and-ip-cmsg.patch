             if (sock_type != SOCK_DGRAM && sock_type != SOCK_RAW) return STATUS_INVALID_PARAMETER;
+#ifdef __APPLE__
+            {
+                unsigned int val = 0;
+                unsigned char v;
+                if (!in_size) return STATUS_BUFFER_TOO_SMALL;
+                memcpy( &val, in_buffer, min( in_size, (ULONG)sizeof(val) ) );
+                v = !!val;
+                return do_setsockopt( handle, io, IPPROTO_IP, IP_MULTICAST_LOOP, &v, sizeof(v) );
+            }
+#else
             return do_setsockopt( handle, io, IPPROTO_IP, IP_MULTICAST_LOOP, in_buffer, in_size );
+#endif
         }
 
         case IOCTL_AFD_WINE_GET_IP_MULTICAST_TTL:
         {
             int sock_type = get_sock_type( handle );
             if (sock_type != SOCK_DGRAM && sock_type != SOCK_RAW) return STATUS_INVALID_PARAMETER;
+#ifdef __APPLE__
+            return do_getsockopt_byte_or_int( handle, io, IPPROTO_IP, IP_MULTICAST_TTL, out_buffer, out_size, TRUE, FALSE );
+#else
             return do_getsockopt( handle, io, IPPROTO_IP, IP_MULTICAST_TTL, out_buffer, out_size );
+#endif
         }
 
         case IOCTL_AFD_WINE_SET_IP_MULTICAST_TTL:
         {
             int sock_type = get_sock_type( handle );
             if (sock_type != SOCK_DGRAM && sock_type != SOCK_RAW) return STATUS_INVALID_PARAMETER;
