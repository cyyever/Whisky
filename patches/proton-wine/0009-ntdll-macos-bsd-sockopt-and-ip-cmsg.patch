Subject: [PATCH] ntdll: macOS BSD sockopt normalization and IP_RECVTOS/IP_RECVTTL cmsg conversion

Consolidated patches:
  - (0029) ntdll: normalize macOS BSD getsockopt/setsockopt booleans and option lengths
subj='ntdll: normalize macOS BSD getsockopt/setsockopt booleans and option lengths'
  - (0040) ntdll: handle macOS IP_RECVTOS and IP_RECVTTL control messages

---
diff --git a/dlls/ntdll/unix/socket.c b/dlls/ntdll/unix/socket.c
index 96e81525..77be1b1b 100644
--- a/dlls/ntdll/unix/socket.c
+++ b/dlls/ntdll/unix/socket.c
@@ -429,8 +429,13 @@ static int convert_control_headers(struct msghdr *hdr, WSABUF *control)
                     }
 #endif /* IP_PKTINFO */
 
+#if defined(IP_TOS) || defined(IP_RECVTOS)
 #if defined(IP_TOS)
                     case IP_TOS:
+#endif
+#if defined(IP_RECVTOS) && (!defined(IP_TOS) || IP_RECVTOS != IP_TOS)
+                    case IP_RECVTOS:
+#endif
                     {
                         INT tos = *(unsigned char *)CMSG_DATA(cmsg_unix);
                         ptr = fill_control_message( WS_IPPROTO_IP, WS_IP_TOS, ptr, &ctlsize,
@@ -438,17 +443,27 @@ static int convert_control_headers(struct msghdr *hdr, WSABUF *control)
                         if (!ptr) goto error;
                         break;
                     }
-#endif /* IP_TOS */
+#endif /* IP_TOS || IP_RECVTOS */
 
+#if defined(IP_TTL) || defined(IP_RECVTTL)
 #if defined(IP_TTL)
                     case IP_TTL:
+#endif
+#if defined(IP_RECVTTL) && (!defined(IP_TTL) || IP_RECVTTL != IP_TTL)
+                    case IP_RECVTTL:
+#endif
                     {
+                        INT ttl;
+                        if (cmsg_unix->cmsg_len >= CMSG_LEN(sizeof(INT)))
+                            memcpy( &ttl, CMSG_DATA(cmsg_unix), sizeof(INT) );
+                        else
+                            ttl = *(unsigned char *)CMSG_DATA(cmsg_unix);
                         ptr = fill_control_message( WS_IPPROTO_IP, WS_IP_TTL, ptr, &ctlsize,
-                                                    CMSG_DATA(cmsg_unix), sizeof(INT) );
+                                                    &ttl, sizeof(INT) );
                         if (!ptr) goto error;
                         break;
                     }
-#endif /* IP_TTL */
+#endif /* IP_TTL || IP_RECVTTL */
 
                     default:
                         FIXME("Unhandled IPPROTO_IP message header type %d\n", cmsg_unix->cmsg_type);
@@ -1595,6 +1610,79 @@ static NTSTATUS do_getsockopt( HANDLE handle, IO_STATUS_BLOCK *io, int level,
     return STATUS_SUCCESS;
 }
 
+static NTSTATUS do_getsockopt_bool( HANDLE handle, IO_STATUS_BLOCK *io, int level,
+                                    int option, void *out_buffer, ULONG out_size )
+{
+    int fd, needs_close = FALSE;
+    int val = 0;
+    socklen_t len = sizeof(val);
+    NTSTATUS status;
+    int ret;
+
+    if (!out_size) return STATUS_BUFFER_TOO_SMALL;
+    if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )))
+        return status;
+
+    ret = getsockopt( fd, level, option, &val, &len );
+    if (needs_close) close( fd );
+    if (ret) return sock_errno_to_status( errno );
+
+    /* macOS/BSD returns kernel bitmasks (e.g. SO_BROADCAST=0x20, SO_OOBINLINE=0x100,
+     * SO_KEEPALIVE=0x8, TCP_NODELAY=0x4) instead of 0/1. Normalize to boolean so
+     * callers comparing == 1 or reading 1-byte buffers (where 0x100 truncates to 0)
+     * match Windows/Linux semantics. */
+    val = !!val;
+    len = min( out_size, (ULONG)sizeof(val) );
+    memcpy( out_buffer, &val, len );
+    if (io)
+    {
+        io->Status = STATUS_SUCCESS;
+        io->Information = len;
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS do_getsockopt_byte_or_int( HANDLE handle, IO_STATUS_BLOCK *io, int level,
+                                           int option, void *out_buffer, ULONG out_size,
+                                           BOOL unix_is_uchar, BOOL is_bool )
+{
+    int fd, needs_close = FALSE;
+    int val = 0;
+    NTSTATUS status;
+    int ret;
+
+    if (!out_size) return STATUS_BUFFER_TOO_SMALL;
+    if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )))
+        return status;
+
+    if (unix_is_uchar)
+    {
+        unsigned char uc = 0;
+        socklen_t len = sizeof(uc);
+        ret = getsockopt( fd, level, option, &uc, &len );
+        val = uc;
+    }
+    else
+    {
+        socklen_t len = sizeof(val);
+        ret = getsockopt( fd, level, option, &val, &len );
+    }
+    if (needs_close) close( fd );
+    if (ret) return sock_errno_to_status( errno );
+
+    if (is_bool) val = !!val;
+    {
+        ULONG out_len = (out_size >= sizeof(int)) ? (ULONG)sizeof(int) : 1;
+        memcpy( out_buffer, &val, out_len );
+        if (io)
+        {
+            io->Status = STATUS_SUCCESS;
+            io->Information = out_len;
+        }
+    }
+    return STATUS_SUCCESS;
+}
+
 
 static NTSTATUS do_setsockopt( HANDLE handle, IO_STATUS_BLOCK *io, int level,
                                int option, const void *optval, socklen_t optlen )
@@ -1613,6 +1701,25 @@ static NTSTATUS do_setsockopt( HANDLE handle, IO_STATUS_BLOCK *io, int level,
     return STATUS_SUCCESS;
 }
 
+static NTSTATUS do_setsockopt_int_flex( HANDLE handle, IO_STATUS_BLOCK *io, int level,
+                                        int option, const void *in_buffer, ULONG in_size,
+                                        BOOL is_bool, unsigned int max_val )
+{
+    unsigned int val = 0;
+    int v;
+
+    if (!in_size) return STATUS_BUFFER_TOO_SMALL;
+    memcpy( &val, in_buffer, min( in_size, (ULONG)sizeof(val) ) );
+    if (is_bool)
+        v = !!val;
+    else
+    {
+        if (max_val && val > max_val) return STATUS_INVALID_PARAMETER;
+        v = (int)val;
+    }
+    return do_setsockopt( handle, io, level, option, &v, sizeof(v) );
+}
+
 
 static int get_sock_type( HANDLE handle )
 {
@@ -2087,13 +2194,13 @@ NTSTATUS sock_ioctl( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, void *apc
             break;
 
