From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Whisky <whisky@local>
Date: Sat, 28 Nov 2026 13:08:00 +0800
Subject: [PATCH] gstreamer: use atomic ref_count read in gst_object_unref and atomic last_flowret in gstpad

Eliminate two ThreadSanitizer data-race sites in GStreamer core:
1. gst_object_unref() read ((GObject *) object)->ref_count non-atomically
   for its precondition/tracer check while other threads concurrently mutate
   ref_count atomically via g_object_ref/g_object_unref.
2. gstpad.c wrote pad->ABI.abi.last_flowret under STREAM_LOCK in data-flow
   paths while GST_EVENT_RECONFIGURE read/reset it under OBJECT_LOCK. Use
   g_atomic_int_set() and g_atomic_int_compare_and_exchange() consistently.
---
 subprojects/gstreamer/gst/gstobject.c |  9 ++--
 subprojects/gstreamer/gst/gstpad.c    | 80 +++++++++++++++++------------------
 2 files changed, 45 insertions(+), 44 deletions(-)

diff --git a/subprojects/gstreamer/gst/gstobject.c b/subprojects/gstreamer/gst/gstobject.c
index ced436f9..a7ab965d 100644
--- a/subprojects/gstreamer/gst/gstobject.c
+++ b/subprojects/gstreamer/gst/gstobject.c
@@ -258,13 +258,16 @@ gst_object_ref (gpointer object)
 void
 gst_object_unref (gpointer object)
 {
+  gint refcount;
+
   g_return_if_fail (object != NULL);
-  g_return_if_fail (((GObject *) object)->ref_count > 0);
+  refcount = g_atomic_int_get (&((GObject *) object)->ref_count);
+  g_return_if_fail (refcount > 0);
 
-  GST_TRACER_OBJECT_UNREFFED (object, ((GObject *) object)->ref_count - 1);
+  GST_TRACER_OBJECT_UNREFFED (object, refcount - 1);
 #ifdef DEBUG_REFCOUNT
   GST_CAT_TRACE_OBJECT (GST_CAT_REFCOUNTING, object, "%p unref %d->%d", object,
-      ((GObject *) object)->ref_count, ((GObject *) object)->ref_count - 1);
+      refcount, refcount - 1);
 #endif
   g_object_unref (object);
 }
