     GST_OBJECT_UNLOCK (pad);
     GST_PAD_STREAM_UNLOCK (pad);
     gst_mini_object_unref (GST_MINI_OBJECT_CAST (data));
@@ -4697,7 +4697,7 @@ wrong_mode:
   {
     g_critical ("chain on pad %s:%s but it was not in push mode",
         GST_DEBUG_PAD_NAME (pad));
-    pad->ABI.abi.last_flowret = GST_FLOW_ERROR;
+    g_atomic_int_set ((gint *) &pad->ABI.abi.last_flowret, GST_FLOW_ERROR);
     GST_OBJECT_UNLOCK (pad);
     GST_PAD_STREAM_UNLOCK (pad);
     gst_mini_object_unref (GST_MINI_OBJECT_CAST (data));
@@ -4723,7 +4723,7 @@ probe_stopped:
